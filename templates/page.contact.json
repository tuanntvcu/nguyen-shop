{
  "sections": {
    "ngp_breadcrumbs": {
      "type": "ngp-breadcrumbs",
      "settings": {
        "text_alignment": "center"
      }
    },
    "main": {
      "type": "main-page",
      "disabled": true,
      "settings": {
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "form": {
      "type": "contact-form",
      "custom_css": [
        ".contact {max-width: 68rem; padding-top: 0;}",
        ".contact .title {color: #102a43; font-size: clamp(2.8rem, 4vw, 4.4rem); margin-bottom: 2.4rem;}",
        ".contact form {display: grid; gap: 1.2rem;}",
        ".contact .field {margin: 0;}",
        ".contact .field__input, .contact .text-area {border-color: #d0d5dd; border-radius: .6rem;}",
        ".contact .contact__button .button {background: #006b5e; min-height: 5.2rem; min-width: 18rem;}",
        "@media (max-width: 767px) {.contact {padding-bottom: 4.8rem;} .contact .contact__button .button {width: 100%;}}"
      ],
      "settings": {
        "heading": "Contact us",
        "heading_size": "h2",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 100
      }
    }
  },
  "order": [
    "ngp_breadcrumbs",
    "main",
    "form"
  ]
}
