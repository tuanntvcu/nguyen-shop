    #AltaeronPdp-{{ section.id }} .apdp-support__icon{background:#e5f5f1;border-radius:50%;grid-row:1/3;height:40px;margin:0;width:40px}
    #AltaeronPdp-{{ section.id }} .apdp-support__icon svg{height:25px;width:25px}
    #AltaeronPdp-{{ section.id }} .apdp-support__features h3{font-size:14px;line-height:1.3;margin:0}
    #AltaeronPdp-{{ section.id }} .apdp-support__features p{font-size:11px;line-height:1.4;margin:0}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits{grid-template-columns:repeat(2,minmax(0,1fr))}
    #AltaeronPdp-{{ section.id }} .apdp-day__layout{display:block}
    #AltaeronPdp-{{ section.id }} .apdp-day__media{aspect-ratio:9/16;border-radius:12px;box-shadow:0 8px 22px rgba(11,38,26,.15);height:auto;margin:0 auto;max-width:420px;overflow:hidden;width:100%}
    #AltaeronPdp-{{ section.id }} .apdp-day__visual{aspect-ratio:auto;inset:0;position:absolute}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits{gap:10px;margin:18px 0 0}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article,#AltaeronPdp-{{ section.id }} .apdp-day__benefits article+article,#AltaeronPdp-{{ section.id }} .apdp-day__benefits article:nth-child(even),#AltaeronPdp-{{ section.id }} .apdp-day__benefits article:nth-child(n+3){align-items:center;background:#f7faf7;border:1px solid #dfe7e1;border-radius:11px;display:flex;flex-direction:column;gap:10px;min-width:0;padding:14px 10px;text-align:center}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article>span{height:52px;margin:0;width:52px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article>span svg{height:30px;width:30px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits h3{font-size:15px;line-height:1.3;margin:0 0 5px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits p{font-size:13px;line-height:1.45;margin:0 auto;max-width:160px}
    #AltaeronPdp-{{ section.id }} .apdp-spacer-grid{display:block}
    #AltaeronPdp-{{ section.id }} .apdp-reels-section{padding-top:calc(var(--alta-pdp-section-gap-tight-mobile) / 2)}
    #AltaeronPdp-{{ section.id }} .apdp-reels-full{width:calc(100% - 30px)}
    #AltaeronPdp-{{ section.id }} .apdp-tail-faq{padding-bottom:40px}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story{grid-row:auto;margin:0 15px 20px;order:5;padding:22px 0 0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story-wrap .apdp-gallery-story{margin:0;padding-top:22px}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2{font-size:clamp(27px,8vw,34px);line-height:1.16;margin-bottom:22px}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story__copy{font-size:15px;line-height:1.62}
    #AltaeronPdp-{{ section.id }} .apdp-payment-terms{display:none}
  }
  @media(max-width:390px){
    #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits{gap:12px;margin-top:0}
    #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits li{grid-template-columns:20px minmax(0,1fr);min-height:0;padding:0}
  }
  #AltaeronPdp-{{ section.id }} .apdp-day__benefits article{background:var(--altaeron-off-white,#F8FAF9);border-color:var(--altaeron-border,#E4E7EC)}
  #AltaeronPdp-{{ section.id }} :where(.apdp-gallery-story__copy,.apdp-gallery-story__consequence){color:var(--altaeron-body,#344054)}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2{color:var(--altaeron-navy,#102A43)}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result>span:first-child{background:var(--altaeron-primary,#006B5E)}
  #AltaeronPdp-{{ section.id }} :where(.apdp-gallery-story h2 strong,.apdp-gallery-story__result strong){color:var(--altaeron-primary,#006B5E)}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__consequence{text-decoration-color:var(--altaeron-primary,#006B5E)}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result{background:var(--altaeron-soft-teal,#EAF5F2);color:var(--altaeron-body,#344054)}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}#AltaeronPdp-{{ section.id }} .apdp-narrative__evidence-links *{transition:none!important}}
  {% render 'altaeron-reels-responsive-main', section_id: section.id, template_class: 'altaeron-reels-v3' %}
</style>

<div
  id="AltaeronPdp-{{ section.id }}"
  class="altaeron-pdp altaeron-pdp--cro-hero altaeron-pdp--reels-v3"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="{{ 'altaeron_pdp_reels_v2.common.save' | t | escape }}"
  data-save-template="{{ 'altaeron_pdp_reels_v2.common.save_template' | t | escape }}"
  data-add-to-cart-label="{{ reel_cta_label | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
>
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery{% unless show_hero_video %} is-viewer-active{% endunless %}" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.product_media' | t | escape }}">
          {%- if show_hero_video -%}
          <button type="button" class="apdp-gallery__thumb is-active" role="tab" aria-selected="true" aria-controls="AltaeronDemo-{{ section.id }}" data-apdp-thumb="demo" data-apdp-demo-thumb>
            {%- if hero_thumbnail != blank -%}
              {{ hero_thumbnail | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: support_demo_alt }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if hero_video != blank -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
          </button>
          {%- endif -%}
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if show_hero_video == false and forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if show_hero_video == false and forloop.first %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        {%- if show_hero_video -%}
        <div id="AltaeronDemo-{{ section.id }}" class="apdp-gallery__stage apdp-gallery__hero is-active" role="tabpanel" data-apdp-media="demo" aria-hidden="false"{% if hero_poster != blank %} style="--apdp-hero-poster:url('{{ hero_poster }}')"{% endif %}>
          {%- if hero_video != blank -%}
            {%- liquid
              assign hero_mobile_source = blank
              assign hero_desktop_source = blank
              for hero_source in hero_video.sources
                if hero_source.format == 'mp4'
                  if hero_desktop_source == blank or hero_source.height > hero_desktop_source.height
                    assign hero_desktop_source = hero_source
                  endif
                  if hero_source.height <= 720
                    if hero_mobile_source == blank or hero_source.height > hero_mobile_source.height
                      assign hero_mobile_source = hero_source
                    endif
                  endif
                endif
              endfor
              assign hero_desktop_source = hero_desktop_source | default: hero_video.sources.first
              assign hero_mobile_source = hero_mobile_source | default: hero_desktop_source
            -%}
            <video data-apdp-hero-video autoplay muted playsinline loop preload="metadata" poster="{{ hero_poster }}" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.hero_video' | t | escape }}">
              {%- if hero_desktop_source.url == hero_mobile_source.url -%}
                <source src="{{ hero_desktop_source.url }}" type="{{ hero_desktop_source.mime_type | default: 'video/mp4' }}">
              {%- else -%}
                <source src="{{ hero_mobile_source.url }}" type="{{ hero_mobile_source.mime_type | default: 'video/mp4' }}" media="(max-width: 767px)">
                <source src="{{ hero_desktop_source.url }}" type="{{ hero_desktop_source.mime_type | default: 'video/mp4' }}" media="(min-width: 768px)">
              {%- endif -%}
            </video>
          {%- elsif hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: product.title }}
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        {%- endif -%}
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if show_hero_video == false and forloop.first %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}" aria-hidden="{% if show_hero_video == false and forloop.first %}false{% else %}true{% endif %}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless show_hero_video == false and forloop.first %} hidden{% endunless %}>
              {% render 'altaeron-pdp-media', media: media, product: product, loading: 'lazy', fetchpriority: 'auto', sizes: '(min-width: 1024px) 560px, 55vw', autoplay: true, loop: true, muted: true %}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.open_image' | t: index: forloop.index | escape }}"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
          {%- if show_hero_video -%}
            <button type="button" class="apdp-gallery__return" data-apdp-return-demo aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.return_demo' | t | escape }}"><span aria-hidden="true">←</span> {{ 'altaeron_pdp_reels_v2.accessibility.back_to_demo' | t }}</button>
          {%- endif -%}
        </div>
      </div>

      <div class="apdp-narrative">
        {%- if review_count > 0 and review_rating > 0 -%}
          <a class="apdp-rating" href="#AltaeronV3Reviews" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.rating' | t: rating: review_rating_display, count: review_count | escape }}">
            {% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{{ 'altaeron_pdp_reels_v2.common.atf_rating' | t: rating: review_rating_display, count: review_count }}</strong>
          </a>
        {%- endif -%}
        <p class="apdp-narrative__product">{{ reel_product_name }}</p>
        <h1 id="AltaeronTitle-{{ section.id }}"><span class="apdp-title-lines">{{ reel_headline }}</span></h1>
        <p class="apdp-narrative__subheadline">{{ reel_subheadline | newline_to_br }}</p>
        <ul class="apdp-narrative__benefits" role="list">
          {%- for i in (1..4) -%}
            {%- capture benefit_key -%}altaeron_pdp_reels_v3.hero.benefit_{{ i }}{%- endcapture -%}
            <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ benefit_key | t }}</span></li>
          {%- endfor -%}
        </ul>
        <figure class="apdp-hero-review">
          <div class="apdp-tail-avatar">
            {%- if section.settings.review_avatar != blank -%}
              {{ section.settings.review_avatar | image_url: width: 160 | image_tag: loading: 'eager', widths: '80, 120, 160', sizes: '56px', alt: section.settings.review_avatar.alt | default: section.settings.reviewer_name }}
            {%- else -%}
              <span class="apdp-tail-avatar__initial" aria-hidden="true">{{ section.settings.reviewer_name | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <div>
            {% render 'altaeron-pdp-stars', rating: 5 %}
            <blockquote>{{ reel_review_content }}</blockquote>
            <figcaption><strong>{{ section.settings.reviewer_name }}</strong> &middot; {{ 'altaeron_pdp.reviews.verified_buyer' | t }}</figcaption>
          </div>
        </figure>
      </div>

      <aside id="AltaeronBuy-{{ section.id }}" class="apdp-buy" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.purchase' | t: product: product.title | escape }}" data-apdp-primary-purchase>
        <h2 class="apdp-buy__title">{{ 'altaeron_pdp_reels_v2.common.choose_bundle' | t }}</h2>
        <div class="apdp-buy__price-line">
          <div><p class="apdp-buy__from">{{ reel_price_label }}</p><div class="apdp-price" aria-live="polite"><span class="apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="apdp-price__compare" data-apdp-compare-price{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></div></div>
          <span class="apdp-price__save" data-apdp-savings{% if savings <= 0 %} hidden{% endif %}>{{ 'altaeron_pdp_reels_v2.common.save_amount' | t: amount: savings_money }}</span>
        </div>
        {%- form 'product', product, id: product_form_id, class: 'apdp-form main-product-form', is: 'product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="product-form__error-message-wrapper" role="alert" hidden><div class="product-form__error-message alert alert--error" role="alert" hidden></div></div>
          {%- unless product.has_only_default_variant -%}
            <fieldset class="apdp-variants">
              <legend>{{ 'altaeron_pdp_reels_v2.buy.choose_option' | t }}</legend>
              {%- if product.variants.size > 6 -%}
                <label class="visually-hidden" for="AltaeronVariant-{{ section.id }}">{{ 'altaeron_pdp_reels_v2.buy.product_option' | t }}</label>
                <select id="AltaeronVariant-{{ section.id }}" data-apdp-variant-select>{%- for variant in product.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}</select>
              {%- else -%}
                <div class="apdp-variants__grid">{%- for variant in product.variants limit: 3 -%}<input class="visually-hidden" type="radio" id="AltaeronVariant-{{ section.id }}-{{ variant.id }}" name="apdp-variant" value="{{ variant.id }}" data-apdp-variant-option data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} checked{% endif %}><label for="AltaeronVariant-{{ section.id }}-{{ variant.id }}">{{ variant.title }}</label>{%- endfor -%}</div>
              {%- endif -%}
            </fieldset>
          {%- endunless -%}
          <bundle-deals-widget id="AltaeronBundles-{{ section.id }}" tabindex="-1" product-id="{{ product.id }}"></bundle-deals-widget>
          <p class="apdp-new-customer-offer">{{ 'altaeron_pdp_reels_v3.hero.purchase_clarification' | t }}</p>
          <button type="submit" name="add" class="apdp-button apdp-button--primary product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ reel_cta_label }}">{% if current_variant.available %}{{ reel_cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span><span data-apdp-cta-price{% unless current_variant.available %} hidden{% endunless %}>{% if current_variant.available %} — {{ current_variant.price | money }}{% endif %}</span></span><span class="loading__spinner hidden">{% render 'loading-spinner' %}</span></button>
          <p class="apdp-cta-reassurance">{% render 'altaeron-pdp-icon', icon: 'lock' %}<span>{{ 'altaeron_pdp_reels_v3.hero.trust_row' | t }}</span></p>
          <div class="apdp-payment-terms" data-apdp-installments>{{ 'altaeron_pdp_reels_v2.buy.installments' | t: amount: installment_amount }} <strong>shop<span>Pay</span></strong></div>
          {%- if shop.enabled_payment_types.size > 0 -%}
            {%- liquid
              assign mobile_payment_prefix = 'apdp-buy-mobile-' | append: section.id | append: '-'
              assign mobile_payment_id = ' id="' | append: mobile_payment_prefix
              assign mobile_payment_labelledby = 'aria-labelledby="' | append: mobile_payment_prefix
              assign mobile_payment_url = 'url(#' | append: mobile_payment_prefix
              assign mobile_payment_href = 'href="#' | append: mobile_payment_prefix
            -%}
            <details class="apdp-payment-options">
              <summary>{{ 'altaeron_pdp_reels_v2.buy.more_payment_options' | t: default: 'More payment options' }}</summary>
              <ul class="apdp-payment-icons list list-payment" role="list" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.payment_methods' | t | escape }}">
              {%- for type in shop.enabled_payment_types -%}
                {%- capture payment_svg -%}{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}{%- endcapture -%}
                <li class="list-payment__item">{{ payment_svg | replace: ' id="', mobile_payment_id | replace: 'aria-labelledby="', mobile_payment_labelledby | replace: 'url(#', mobile_payment_url | replace: 'href="#', mobile_payment_href }}</li>
              {%- endfor -%}
              </ul>
            </details>
          {%- endif -%}
        {%- endform -%}
        <div class="apdp-buy__trust apdp-buy__trust--three">
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{% render 'altaeron-pdp-icon', icon: 'truck' %}<b>{{ 'altaeron_pdp_reels_v2.buy.shipping' | t }}</b></a>
          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{% render 'altaeron-pdp-icon', icon: 'return' %}<b>{{ 'altaeron_pdp_reels_v2.buy.returns_30' | t: default: '30-Day Returns' }}</b></a>
          <a href="/pages/contact">{% render 'altaeron-pdp-icon', icon: 'support' %}<b>{{ 'storefront.pdp.fast_shipping' | t }}</b></a>
        </div>
      </aside>
    </div>
  </section>


  <div class="apdp-sticky" data-apdp-sticky hidden><div class="apdp-sticky__product">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '52px', alt: product.featured_image.alt | default: product.title }}{%- endif -%}<span><small><span>{{ reel_price_label }}</span> <b data-apdp-sticky-price>{{ current_variant.price | money }}</b> <s data-apdp-sticky-compare{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></small><em data-apdp-sticky-savings{% if savings <= 0 %} hidden{% endif %}>{{ 'altaeron_pdp_reels_v2.common.save_amount' | t: amount: savings_money }}</em><small class="apdp-sticky__bundle-title" data-apdp-sticky-bundle-title hidden></small></span></div><button type="button" class="apdp-button apdp-button--primary" data-apdp-sticky-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-sticky-text>{% if current_variant.available %}{{ reel_cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span></button></div>
  <script type="application/json" data-apdp-product-json>{{ product.variants | json }}</script>
  <script>
    (() => {
      const root = document.getElementById('AltaeronPdp-{{ section.id }}');
      const gallery = root?.querySelector('[data-apdp-gallery]');
      const heroVideo = gallery?.querySelector('[data-apdp-hero-video]');
      const demoThumb = gallery?.querySelector('[data-apdp-demo-thumb]');
      const returnButton = gallery?.querySelector('[data-apdp-return-demo]');
      const desktop = window.matchMedia('(min-width: 1100px)');
      if (!gallery || !returnButton) return;

      const showDemo = (resume = false) => {
        gallery.classList.remove('is-viewer-active');
        gallery.querySelectorAll('[data-apdp-media] video').forEach((video) => video.pause());
        if (resume && heroVideo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          heroVideo.play().catch(() => {});
        }
      };

      gallery.querySelectorAll('[data-apdp-thumb]:not([data-apdp-demo-thumb])').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          gallery.classList.add('is-viewer-active');
          heroVideo?.pause();
        });
      });
      demoThumb?.addEventListener('click', () => showDemo(true));
      returnButton.addEventListener('click', () => demoThumb ? demoThumb.click() : showDemo(true));
      desktop.addEventListener?.('change', (event) => {
        if (!event.matches) showDemo(false);
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Altaeron Reels V3 PDP",
  "tag": "section",
  "class": "section-altaeron-pdp section-altaeron-pdp-reels-v3",
  "settings": [
    { "type": "header", "content": "Reels hero" },
    { "type": "checkbox", "id": "show_hero_video", "label": "Show metafield video first in gallery", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Product name", "default": "Altaeron™ Adjustable Bunion Corrector" },
    { "type": "textarea", "id": "headline", "label": "Core benefit", "default": "Relieve Bunion Pressure. Realign Your Big Toe." },
    { "type": "textarea", "id": "subheadline", "label": "Explanation", "default": "Altaeron uses adjustable corrective tension to guide your big toe away from inward drift and back toward a straighter, more natural position — relieving pressure while progressively restoring healthier alignment." },
    { "type": "header", "content": "Above-the-fold review" },
    { "type": "image_picker", "id": "review_avatar", "label": "Reviewer image" },
    { "type": "richtext", "id": "review_content", "label": "Review content", "default": "<p>I started with gentle tension and adjusted it until it felt comfortable. Simple to use and surprisingly supportive</p>" },
    { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Karen M." },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "From" },
    { "type": "text", "id": "cta_label", "label": "Add to cart label", "default": "START YOUR CORRECTION" }
  ],
  "blocks": [
