{%- liquid
  assign ngp_enable_sticky_column = section.settings.enable_sticky_column
  assign ngp_swipe_on_mobile = section.settings.swipe_on_mobile
  assign ngp_swipe_on_tablet = false

  if section.blocks.size == 3
    assign ngp_swipe_on_tablet = true
  endif

  if ngp_swipe_on_mobile and section.blocks.size > 2
    assign ngp_column_size_modulo = section.blocks.size | modulo: 2
    if ngp_column_size_modulo > 0
      assign ngp_swipe_on_tablet = true
    endif
  endif

  assign ngp_card_overlay_blocks = section.blocks | where: 'type', 'promotion_card'
-%}
{% if ngp_card_overlay_blocks.size > 0 %}
  {{ 'ngp-component-promotion-card.css' | asset_url | stylesheet_tag }}
{% endif %}
{% render 'ngp-divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<div
  class="ngp-section ngp-section-{{ section.id }} ngp-section--padding ngp-section--custom-content{% if section.settings.container != 'full' %} ngp-page-width{% endif %} ngp-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-id="{{ section.id }}"
>
  {% render 'ngp-section-heading', section_settings: section.settings %}
  <div class="ngp-section__content ngp-f-grid--gap-{{ section.settings.column_gap }}{% if ngp_swipe_on_tablet %} ngp-swipe-tablet{% endif %}{% if ngp_swipe_on_mobile %} ngp-swipe-mobile ngp-swipe-mobile--{{ section.settings.columns_mobile }}-cols{% endif %}">
    <div class="ngp-f-flex ngp-f-grid--gap-{{ section.settings.column_gap }} ngp-f-grid--row-gap-{{ section.settings.row_gap }}{% if ngp_swipe_on_tablet %} ngp-swipe-tablet__inner{% endif %}{% if ngp_swipe_on_mobile %} ngp-swipe-mobile__inner{% endif %}">
      {%- for ngp_block in section.blocks -%}
        {%- liquid
          assign ngp_vertical_alignment = ngp_block.settings.alignment
          case ngp_block.settings.width
            when '16%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-2/12'
            when '20%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-1/5'
            when '25%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-1/4'
            when '33%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-1/3'
            when '41%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-5/12'
            when '50%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-1/2'
            when '58%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-7/12'
            when '66%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-8/12'
            when '75%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-9/12'
            when '80%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-4/5'
            when '83%'
              assign ngp_block_width = 'ngp-w-full ngp-md:w-1/2 ngp-lg:w-10/12'
            else
              assign ngp_block_width = 'ngp-w-full'
          endcase
        -%}
        <div
          id="block-{{ ngp_block.id }}"
          class="ngp-f-column ngp-relative ngp-custom-content-block--{{ ngp_block.type }} ngp-md:ngp-flex ngp-items-{{ ngp_vertical_alignment | default: 'center' }} {{ ngp_block_width }} {{ ngp_block.settings.block_custom_class }}{% if ngp_block.settings.full_column_height %} ngp-full-col-height{% endif %}"
          data-block-type="{{ ngp_block.type }}"
          {{ ngp_block.shopify_attributes }}
        >
          <div class="ngp-custom__block ngp-custom__block--{{ ngp_block.type }} ngp-w-full ngp-text-{{ ngp_block.settings.content_alignment }}{% if ngp_enable_sticky_column %} ngp-sticky-element{% endif %}{% if ngp_block.settings.full_column_height %} ngp-h-full{% endif %}">
            {%- case ngp_block.type -%}
              {%- when 'text' -%}
                {%- assign ngp_motion_delay = 50 -%}
                <div class="ngp-rich-text">
                  {%- if ngp_block.settings.subheading != blank -%}
                    <ngp-motion-element
                      data-motion="fade-up"
                      data-motion-delay="{{ ngp_motion_delay }}"
                      class="ngp-block ngp-rich-text__subheading ngp-text-subheading"
                    >
                      {{ ngp_block.settings.subheading }}
                    </ngp-motion-element>
                    {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                  {%- endif -%}
                  {%- if ngp_block.settings.heading != blank -%}
                    <h2 class="ngp-rich-text__heading ngp-inline-richtext {{ ngp_block.settings.heading_size }}">
                      <ngp-motion-element class="ngp-block" data-motion="fade-up" data-motion-delay="{{ ngp_motion_delay }}">
                        {% render 'ngp-highlight-text',
                          text: ngp_block.settings.heading,
                          style: ngp_block.settings.heading_highlight_style
                        %}
                      </ngp-motion-element>
                    </h2>
                    {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                  {%- endif -%}
                  {%- if ngp_block.settings.description != blank -%}
                    <ngp-motion-element
                      data-motion="fade-up"
                      data-motion-delay="{{ ngp_motion_delay }}"
                      class="ngp-block ngp-rich-text__text ngp-rte {{ ngp_block.settings.text_size }}"
                    >
                      {{ ngp_block.settings.description }}
                    </ngp-motion-element>
                    {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                  {%- endif -%}
                  {%- if ngp_block.settings.button_label != blank -%}
                    <ngp-motion-element
                      data-motion="fade-up"
                      data-motion-delay="{{ ngp_motion_delay }}"
                      class="ngp-block ngp-rich-text__button"
                    >
                      <a
                        class="ngp-btn {{ ngp_block.settings.button_style }}"
                        {% if ngp_block.settings.button_link != blank %}
                          href="{{ ngp_block.settings.button_link }}"
                        {% else %}
                          aria-disabled="true"
                        {% endif %}
                      >
                        {{- ngp_block.settings.button_label -}}
                      </a>
                    </ngp-motion-element>
                  {% endif %}
                </div>
              {%- when 'image' -%}
                {%- liquid
                  assign ngp_image = ngp_block.settings.image
                  if ngp_image != blank
                    assign ngp_image_ratio = ngp_image.aspect_ratio
                  else
                    assign ngp_image_ratio = '1'
                  endif

                  assign ngp_alt = ngp_image.alt | default: shop.name | escape
                  assign ngp_loading = 'lazy'
                  assign ngp_fetchpriority = 'low'
                  if section.index < 2
                    assign ngp_loading = 'eager'
                    assign ngp_fetchpriority = 'high'
                  endif
                -%}
                <div
                  class="ngp-media-wrapper ngp-blocks-radius{% if ngp_image == blank %} ngp-bg-none{% endif %}"
                  style="--aspect-ratio: {{ ngp_image_ratio }};"
                >
                  <ngp-motion-element class="ngp-block" data-motion="zoom-out-sm">
                    {%- if ngp_image != blank -%}
                      {{
                        ngp_image
                        | image_url: width: 1500
                        | image_tag:
                          ngp_loading: ngp_loading,
                          ngp_fetchpriority: ngp_fetchpriority,
                          class: 'motion-reduce',
                          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                          is: 'ngp-image-lazy',
                          ngp_alt: ngp_alt
                      }}
                    {%- else -%}
                      {{ 'ngp_image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </ngp-motion-element>
                </div>
              {%- when 'image_card' -%}
                {% render 'ngp-card-image',
                  parent_color_scheme: section.settings.color_scheme,
                  color_scheme: ngp_block.settings.color_scheme,
                  color_scheme_mobile: ngp_block.settings.color_scheme_mobile,
                  link: ngp_block.settings.card_link,
                  ngp_image: ngp_block.settings.image,
                  ngp_image_ratio: ngp_block.settings.image_ratio,
                  image_overlay_opacity: ngp_block.settings.image_overlay_opacity,
                  image_mobile: ngp_block.settings.image_mobile,
                  rich_text_size: 'medium',
                  heading: ngp_block.settings.heading,
                  heading_size: ngp_block.settings.heading_size,
                  heading_highlight_style: ngp_block.settings.heading_highlight_style,
                  subheading: ngp_block.settings.subheading,
                  description: ngp_block.settings.description,
                  button_label: ngp_block.settings.button_label,
                  button_style: ngp_block.settings.button_style,
                  content_spacing: ngp_block.settings.content_spacing,
                  content_position: ngp_block.settings.content_position,
                  content_alignment: ngp_block.settings.content_alignment,
                  content_alignment_mobile: ngp_block.settings.content_alignment_mobile,
                  show_text_below: ngp_block.settings.show_text_below
                %}
              {%- when 'promotion_card' -%}
                {% render 'ngp-card-promotion',
                  color_scheme: ngp_block.settings.color_scheme,
                  layout: ngp_block.settings.card_layout,
                  link: ngp_block.settings.card_link,
                  ngp_image: ngp_block.settings.image,
                  ngp_image_ratio: ngp_block.settings.image_ratio,
                  image_overlay_opacity: ngp_block.settings.image_overlay_opacity,
                  image_mobile: ngp_block.settings.image_mobile,
                  heading: ngp_block.settings.heading,
                  heading_size: ngp_block.settings.heading_size,
                  heading_highlight_style: ngp_block.settings.heading_highlight_style,
                  subheading: ngp_block.settings.subheading,
                  description: ngp_block.settings.description,
                  button_label: ngp_block.settings.button_label,
                  button_style: ngp_block.settings.button_style,
                  content_spacing: 'medium',
                  content_alignment: ngp_block.settings.content_alignment
                %}
              {%- when 'video' -%}
                {%- liquid
                  assign ngp_poster = section.settings.video.preview_image | default: section.settings.cover_image

                  if ngp_block.settings.video_ratio == 'adapt'
                    if ngp_poster != null
                      assign ngp_video_ratio = ngp_poster.aspect_ratio
                    else
                      assign ngp_video_ratio = '16/9'
                    endif
                  else
                    assign ngp_video_ratio = ngp_block.settings.video_ratio
                  endif
                -%}
                <div
                  class="ngp-media ngp-media--adapt ngp-blocks-radius"
                  style="--media-ratio: {{ ngp_video_ratio }};"
                >
                  {%- render 'ngp-video',
                    video: ngp_block.settings.video,
                    video_url: ngp_block.settings.video_url,
                    muted: ngp_block.settings.enable_video_autoplay,
                    autoplay: ngp_block.settings.enable_video_autoplay,
                    controls: true,
                    loop: ngp_block.settings.enable_video_looping,
                    description: ngp_block.settings.description,
                    cover_image: ngp_block.settings.cover_image,
                    show_play_button: true
                  -%}
                </div>
              {%- when 'lookbook_card' -%}
                {{ 'ngp-component-lookbook-card-modal.css' | asset_url | stylesheet_tag }}
                <script src="{{ 'ngp-lookbook-card.js' | asset_url }}" defer="defer"></script>
                {% render 'ngp-lookbook-card',
                  color_scheme: ngp_block.settings.color_scheme,
                  popup_color_scheme: ngp_block.settings.popup_color_scheme,
                  block_id: ngp_block.id,
                  product_list: ngp_block.settings.product_list,
                  pcard_image_ratio: ngp_block.settings.pcard_image_ratio,
                  ngp_image: ngp_block.settings.image,
                  heading: ngp_block.settings.heading,
                  heading_size: ngp_block.settings.heading_size
                %}
              {%- when 'collection_card' -%}
                {{ 'ngp-component-collection-card.css' | asset_url | stylesheet_tag }}
                {%- liquid
                  assign ngp_collection = collections[ngp_block.settings.collection]
                  assign ngp_block_width_int = ngp_block.settings.width | times: 0.01
                  assign ngp_card_color_scheme = settings.collection_card_color_scheme

                  if ngp_block.settings.card_color_inherited
                    assign ngp_card_color_scheme = section.settings.color_scheme
                  endif

                  assign ngp_card_has_bg = false
                  if section.settings.color_scheme != ngp_card_color_scheme
                    assign ngp_card_has_bg = true
                  endif
                -%}
                {%- capture ngp_image_sizes -%}
                {%- if ngp_block.settings.card_width == 'narrow' -%}
                (max-width: 767px) calc(100vw - 3rem), 400px
                {%- else -%}
                (max-width: 767px) calc(100vw - 3rem), (max-width: 1023px) calc((100vw - 3rem) / 2), calc(min(100vw, {{ settings.page_width }}px) * {{ ngp_block_width_int }})
                {%- endif -%}
                {%- endcapture -%}
                <div class="ngp-custom-card-collection ngp-card-width-{{ ngp_block.settings.card_width }}">
                  <ngp-motion-element class="ngp-block" data-motion="fade-up" data-motion-delay="{{ ngp_motion_delay }}">
                    {% render 'ngp-card-collection',
                      collection: ngp_collection,
                      ngp_card_style: ngp_block.settings.card_style,
                      ngp_color_scheme: ngp_card_color_scheme,
                      ngp_featured_image: ngp_block.settings.image,
                      ngp_image_sizes: ngp_image_sizes,
                      ngp_image_ratio: ngp_block.settings.image_ratio,
                      ngp_heading_size: 'h3',
                      has_bg: ngp_card_has_bg
                    %}
                  </ngp-motion-element>
                </div>
              {%- when 'collections' -%}
                {{ 'ngp-component-collection-item-slider.css' | asset_url | stylesheet_tag }}
                <script src="{{ 'ngp-collection-item-slider.js' | asset_url }}" defer="defer"></script>
                <div class="ngp-collection-list__sliders ngp-block ngp-w-full">
                  {%- if ngp_block.settings.collection_list != blank -%}
                    {%- for ngp_collection in ngp_block.settings.collection_list -%}
                      {% render 'ngp-collection-item-slider', collection: ngp_collection, block: ngp_block %}
                    {%- endfor -%}
                  {%- else -%}
                    {% render 'ngp-collection-item-slider', block: ngp_block %}
                  {%- endif -%}
                </div>
              {%- when 'image_with_text' -%}
                {{ 'ngp-component-custom-image-with-text.css' | asset_url | stylesheet_tag }}
                {%- liquid
                  assign ngp_image = ngp_block.settings.image
                  if ngp_image != blank
                    assign ngp_image_ratio = ngp_image.aspect_ratio
                  else
                    assign ngp_image_ratio = '1'
                  endif

                  assign ngp_alt = ngp_image.alt | default: shop.name | escape
                  assign ngp_loading = 'lazy'
                  assign ngp_fetchpriority = 'low'
                  if section.index < 2
                    assign ngp_loading = 'eager'
                    assign ngp_fetchpriority = 'high'
                  endif
                  assign ngp_motion_delay = 50
                -%}
                <div class="ngp-custom-image-with-text__wrapper ngp-flex ngp-flex-col ngp-lg:ngp-flex-row ngp-items-{{ ngp_block.settings.alignment }}{% if ngp_block.settings.image_badge_text == blank %} ngp-custom-image-with-text--no-badge{% endif %}">
                  <div
                    class="ngp-custom-image-with-text__image ngp-relative"
                  >
                    {%- if ngp_block.settings.image_badge_text != blank -%}
                      <ngp-motion-element
                        data-motion="zoom-out-sm"
                        class="ngp-custom-image-with-text__badge ngp-absolute ngp-flex ngp-justify-center ngp-items-center ngp-color-{{ ngp_block.settings.image_badge_color_scheme }}"
                      >
                        <div class="ngp-text-center ngp-font-heading">{{- ngp_block.settings.image_badge_text -}}</div>
                      </ngp-motion-element>
                    {%- endif -%}
                    <div class="ngp-media-wrapper ngp-blocks-radius{% if ngp_image == blank %} ngp-bg-none{% endif %}">
                      <ngp-motion-element
                        class="ngp-block"
                        data-motion="zoom-out-sm"
                        style="--aspect-ratio: {{ ngp_image_ratio }};"
                      >
                        {%- if ngp_image != blank -%}
                          {{
                            ngp_image
                            | image_url: width: 1500
                            | image_tag:
                              ngp_loading: ngp_loading,
                              ngp_fetchpriority: ngp_fetchpriority,
                              class: 'motion-reduce',
                              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                              is: 'ngp-image-lazy',
                              ngp_alt: ngp_alt
                          }}
                        {%- else -%}
                          {{ 'ngp_image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </ngp-motion-element>
                    </div>
                  </div>
                  <div class="ngp-custom-image-with-text__text">
                    <div class="ngp-rich-text">
                      {%- if ngp_block.settings.subheading != blank -%}
                        <ngp-motion-element
                          data-motion="fade-up"
                          data-motion-delay="{{ ngp_motion_delay }}"
                          class="ngp-block ngp-rich-text__subheading ngp-text-subheading"
                        >
                          {{ ngp_block.settings.subheading }}
                        </ngp-motion-element>
                        {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                      {%- endif -%}
                      {%- if ngp_block.settings.heading != blank -%}
                        <h2 class="ngp-rich-text__heading ngp-inline-richtext {{ ngp_block.settings.heading_size }}">
                          <ngp-motion-element class="ngp-block" data-motion="fade-up" data-motion-delay="{{ ngp_motion_delay }}">
                            {% render 'ngp-highlight-text',
                              text: ngp_block.settings.heading,
                              style: ngp_block.settings.heading_highlight_style
                            %}
                          </ngp-motion-element>
                        </h2>
                        {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                      {%- endif -%}
                      {%- if ngp_block.settings.description != blank -%}
                        <ngp-motion-element
                          data-motion="fade-up"
                          data-motion-delay="{{ ngp_motion_delay }}"
                          class="ngp-block ngp-rich-text__text ngp-rte {{ ngp_block.settings.text_size }}"
                        >
                          {{ ngp_block.settings.description }}
                        </ngp-motion-element>
                        {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                      {%- endif -%}
                      {%- if ngp_block.settings.button_label != blank -%}
                        <ngp-motion-element
                          data-motion="fade-up"
                          data-motion-delay="{{ ngp_motion_delay }}"
                          class="ngp-block ngp-rich-text__button"
                        >
                          <a
                            class="ngp-btn {{ ngp_block.settings.button_style }}"
                            {% if ngp_block.settings.button_link != blank %}
                              href="{{ ngp_block.settings.button_link }}"
                            {% else %}
                              aria-disabled="true"
                            {% endif %}
                          >
                            {{- ngp_block.settings.button_label -}}
                          </a>
                        </ngp-motion-element>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {%- when 'text_card_with_image' -%}
                {{ 'ngp-component-custom-text-card-with-image.css' | asset_url | stylesheet_tag }}
                {%- liquid
                  assign ngp_image = ngp_block.settings.image
                  assign ngp_motion_delay = 50
                -%}
                <div class="ngp-custom-text-card-with-image ngp-relative ngp-h-full ngp-flex ngp-items-center ngp-blocks-radius ngp-color-{{ ngp_block.settings.color_scheme }}">
                  <div class="ngp-rich-text ngp-text-center ngp-w-full">
                    {%- if ngp_block.settings.subheading != blank -%}
                      <ngp-motion-element
                        data-motion="fade-up"
                        data-motion-delay="{{ ngp_motion_delay }}"
                        class="ngp-block ngp-rich-text__subheading ngp-text-subheading"
                      >
                        {{ ngp_block.settings.subheading }}
                      </ngp-motion-element>
                      {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                    {%- endif -%}
                    {% if ngp_image != blank %}
                      {%- liquid
                        assign ngp_image_ratio = ngp_block.settings.image_ratio
                        if ngp_image_ratio == 'adapt'
                          assign ngp_image_ratio = ngp_image.aspect_ratio
                        endif

                        assign ngp_alt = ngp_image.alt | default: shop.name | escape
                        assign ngp_loading = 'lazy'
                        assign ngp_fetchpriority = 'low'
                        if section.index < 2
                          assign ngp_loading = 'eager'
                          assign ngp_fetchpriority = 'high'
                        endif
                      -%}
                      <ngp-motion-element
                        class="ngp-custom-text-card-with-image__image ngp-block"
                        data-motion="fade-up"
                        data-motion-delay="{{ ngp_motion_delay }}"
                        style="--image-width: {{ ngp_block.settings.image_width }}%"
                      >
                        <div
                          class="ngp-media-wrapper ngp-blocks-radius"
                          style="--aspect-ratio: {{ ngp_image_ratio }};"
                        >
                          {{
                            ngp_image
                            | image_url: width: 1500
                            | image_tag:
                              ngp_loading: ngp_loading,
                              ngp_fetchpriority: ngp_fetchpriority,
                              class: 'motion-reduce',
                              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                              is: 'ngp-image-lazy',
                              ngp_alt: ngp_alt
                          }}
                        </div>
                      </ngp-motion-element>
                      {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                    {% endif %}
                    {%- if ngp_block.settings.heading != blank -%}
                      <h2 class="ngp-rich-text__heading ngp-inline-richtext {{ ngp_block.settings.heading_size }}">
                        <ngp-motion-element class="ngp-block" data-motion="fade-up" data-motion-delay="{{ ngp_motion_delay }}">
                          {% render 'ngp-highlight-text',
                            text: ngp_block.settings.heading,
                            style: ngp_block.settings.heading_highlight_style
                          %}
                        </ngp-motion-element>
                      </h2>
                      {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                    {%- endif -%}
                    {%- if ngp_block.settings.description != blank -%}
                      <ngp-motion-element
                        data-motion="fade-up"
                        data-motion-delay="{{ ngp_motion_delay }}"
                        class="ngp-block ngp-rich-text__text ngp-rte {{ ngp_block.settings.text_size }}"
                      >
                        {{ ngp_block.settings.description }}
                      </ngp-motion-element>
                      {%- assign ngp_motion_delay = ngp_motion_delay | plus: 50 -%}
                    {%- endif -%}
                    {%- if ngp_block.settings.button_label != blank -%}
                      <ngp-motion-element
                        data-motion="fade-up"
                        data-motion-delay="{{ ngp_motion_delay }}"
                        class="ngp-block ngp-rich-text__button"
                      >
                        <a
                          class="ngp-btn {{ ngp_block.settings.button_style }}"
                          {% if ngp_block.settings.button_link != blank %}
                            href="{{ ngp_block.settings.button_link }}"
                          {% else %}
                            aria-disabled="true"
                          {% endif %}
                        >
                          {{- ngp_block.settings.button_label -}}
                        </a>
                      </ngp-motion-element>
                    {% endif %}
                  </div>
                </div>
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.ngp-custom-content.name",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://scalora.link/znnzfo)"
    },
    {
