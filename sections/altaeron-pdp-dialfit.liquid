{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_compare = current_variant.compare_at_price | default: 0
  assign mf = product.metafields.altaeron
  assign hero_video = section.settings.hero_video | default: mf.pdp_hero_video.value
  assign hero_image = section.settings.hero_image | default: mf.pdp_hero_image.value | default: product.featured_image
  assign hero_poster = hero_video.preview_image | image_url: width: 1200
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign reviews = review_data.reviews
  assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
  assign review_rating = review_data.average_rating | default: 0 | plus: 0
  assign review_rating_display = review_rating | times: 10 | floor | divided_by: 10.0
  assign product_form_id = 'product-form-' | append: section.id
  assign cta_label = 'altaeron_pdp_dialfit.buy.cta' | t
  assign compare_price = current_variant.compare_at_price | default: 0
  assign savings = 0
  if compare_price > current_variant.price
    assign savings = compare_price | minus: current_variant.price
  endif
  assign savings_money = savings | money
  assign installment_amount = current_variant.price | divided_by: 4 | money
  assign story_media_fallback = product.media[4].preview_image | default: product.featured_image
  assign story_media = section.settings.point_1_image | default: story_media_fallback
  assign mechanism_media_fallback = product.media[2].preview_image | default: product.featured_image
  assign mechanism_media = section.settings.point_2_image | default: mechanism_media_fallback
  assign compare_image_1 = section.settings.point_5_image_1 | default: product.media[4].preview_image
  assign compare_image_2 = section.settings.point_5_image_2 | default: product.media[5].preview_image
  assign proof_video = section.settings.point_6_video | default: hero_video
  assign proof_image_1 = section.settings.point_6_image_1 | default: product.media[6].preview_image
  assign proof_image_2 = section.settings.point_6_image_2 | default: product.media[7].preview_image
  assign expert_image = section.settings.point_7_image
  assign expert_fallback_alt = 'altaeron_pdp.accessibility.expert_portrait' | t
  assign expert_alt = expert_image.alt | default: expert_fallback_alt
  assign story_heading_id = 'DialFitGalleryStory-' | append: section.id
  assign mechanism_heading_id = 'DialFitMechanism-' | append: section.id
  assign benefits_heading_id = 'DialFitBenefits-' | append: section.id
  assign uses_heading_id = 'DialFitUses-' | append: section.id
  assign compare_heading_id = 'DialFitCompare-' | append: section.id
  assign how_heading_id = 'DialFitHow-' | append: section.id
  assign medical_heading_id = 'AltaeronExpertTitle-' | append: section.id
  assign faq_heading_id = 'AltaeronFaq-' | append: section.id
  assign reviews_heading_id = 'AltaeronVerifiedTitle-' | append: section.id
  assign final_cta_image = section.settings.final_cta_image
  if final_cta_image == blank
    assign final_cta_image = images['ChatGPT_Image_Aug_14_2026_01_46_46_PM.png']
  endif
-%}

