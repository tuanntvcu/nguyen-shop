  <script>
    (() => {
      const root = document.getElementById('AltaeronPdp-{{ section.id }}');
      if (!root) return;
      const dialog = root.querySelector('[data-dialfit-size-dialog]');
      const openButton = root.querySelector('[data-dialfit-size-open]');
      const closeButton = root.querySelector('[data-dialfit-size-close]');
      const gallery = root.querySelector('[data-apdp-gallery]');
      const heroVideo = gallery?.querySelector('[data-apdp-hero-video]');
      const returnButton = gallery?.querySelector('[data-apdp-return-demo]');
      openButton?.addEventListener('click', () => dialog?.showModal());
      closeButton?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      gallery?.querySelectorAll('[data-apdp-thumb]').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          gallery.classList.add('is-viewer-active');
          heroVideo?.pause();
        });
      });
      returnButton?.addEventListener('click', () => {
        gallery.classList.remove('is-viewer-active');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) heroVideo?.play().catch(() => {});
      });
    })();
  </script>
