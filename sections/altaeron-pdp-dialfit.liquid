    #AltaeronPdp-{{ section.id }} .apdp-dialfit-card-note>span{flex-basis:32px;height:32px;width:32px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-work-audiences{bottom:14px;font-size:10px;left:12px;right:12px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-uses__panel .apdp-dialfit-audience-strip{margin-top:16px;padding:0}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-audience-strip h3{font-size:17px;margin-bottom:11px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-audience-strip ul{gap:7px;grid-template-columns:repeat(2,minmax(0,1fr))}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-audience-strip li{font-size:11px;justify-content:flex-start;min-height:56px;padding:8px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-audience-strip li svg{flex-basis:25px;height:25px;width:25px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-compare__media{aspect-ratio:1/1}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-steps{gap:0;grid-template-columns:1fr;margin-left:16px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-step{min-height:88px;padding:3px 12px 27px 30px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-step__number{font-size:9px;height:24px;left:-12px;top:0;width:24px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-step__connector{bottom:-1px;height:auto;left:-1px;right:auto;top:12px;width:2px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-step__connector:after{background:linear-gradient(180deg,#0a6948,#23a06f);transform:scaleY(0);transform-origin:top}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-step[data-step-state="complete"] .apdp-dialfit-step__connector:after{transform:scaleY(1)}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-proof{padding:30px 0}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-proof__grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-proof__video{aspect-ratio:1;grid-column:1/-1;grid-row:auto}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-proof__image{aspect-ratio:1}
  }
</style>

<div
  id="AltaeronPdp-{{ section.id }}"
  class="altaeron-pdp altaeron-pdp--cro-hero altaeron-pdp--dialfit"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="{{ 'altaeron_pdp_dialfit.common.save' | t | escape }}"
  data-save-template="{{ 'altaeron_pdp_dialfit.common.save_amount' | t: amount: '[amount]' | escape }}"
  data-add-to-cart-label="{{ cta_label | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-bundle-title="{{ 'altaeron_pdp_dialfit.bundle.title' | t | escape }}"
  data-bundle-one="{{ 'altaeron_pdp_dialfit.bundle.one' | t | escape }}"
  data-bundle-many-template="{{ 'altaeron_pdp_dialfit.bundle.many' | t: count: '[count]' | escape }}"
  data-bundle-one-foot="{{ 'altaeron_pdp_dialfit.bundle.one_description' | t | escape }}"
  data-bundle-popular="{{ 'altaeron_pdp_dialfit.bundle.best_value' | t | escape }}"
  data-bundle-best-value="{{ 'altaeron_pdp_dialfit.bundle.biggest_savings' | t | escape }}"
  data-bundle-subtitle-template="{{ 'altaeron_pdp_dialfit.bundle.unit_price' | t: price: '[price]', amount: '[amount]' | escape }}"
  data-bundle-cta-one="{{ 'altaeron_pdp_dialfit.bundle.cta_one' | t: price: '[price]' | escape }}"
  data-bundle-cta-many="{{ 'altaeron_pdp_dialfit.bundle.cta_many' | t: count: '[count]', price: '[price]' | escape }}"
>
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="{{ 'altaeron_pdp_dialfit.accessibility.product_media' | t | escape }}">
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage apdp-gallery__hero"{% if hero_poster != blank %} style="--apdp-hero-poster:url('{{ hero_poster }}')"{% endif %}>
          {%- if hero_video != blank -%}
            {%- capture hero_video_markup -%}{{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1200x' }}{%- endcapture -%}
            {{- hero_video_markup | replace: '<video ', '<video data-apdp-hero-video ' -}}
          {%- elsif hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: product.title }}
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {% render 'altaeron-pdp-media', media: media, product: product, loading: 'lazy', fetchpriority: 'auto', sizes: '(min-width: 1024px) 560px, 100vw' %}
              {%- if media.media_type == 'image' -%}<button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="{{ 'altaeron_pdp_dialfit.accessibility.open_image' | t: index: forloop.index | escape }}"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>{%- endif -%}
            </div>
          {%- endfor -%}
          <button type="button" class="apdp-gallery__return" data-apdp-return-demo aria-label="{{ 'altaeron_pdp_dialfit.accessibility.return_demo' | t | escape }}"><span aria-hidden="true">←</span> {{ 'altaeron_pdp_dialfit.accessibility.back_demo' | t }}</button>
        </div>
      </div>

      <div class="apdp-narrative">
        <p class="apdp-eyebrow"><span>{{ 'altaeron_pdp_dialfit.hero.eyebrow' | t }}</span></p>
        {%- if review_count > 0 -%}
          <a class="apdp-rating" href="#AltaeronVerified-{{ section.id }}" aria-label="{{ 'altaeron_pdp_dialfit.hero.rating' | t: rating: review_rating_display, count: review_count | escape }}">{% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{{ 'altaeron_pdp_dialfit.hero.rating_short' | t: rating: review_rating_display, count: review_count }}</strong></a>
        {%- endif -%}
        <h1 id="AltaeronTitle-{{ section.id }}"><span class="apdp-title-lines">{{ 'altaeron_pdp_dialfit.hero.headline' | t }}</span></h1>
        <p class="apdp-narrative__subhead">{{ 'altaeron_pdp_dialfit.hero.subheadline' | t }}</p>
        <ul class="apdp-narrative__benefits" role="list">
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ 'altaeron_pdp_dialfit.hero.benefit_1' | t }}</span></li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ 'altaeron_pdp_dialfit.hero.benefit_2' | t }}</span></li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ 'altaeron_pdp_dialfit.hero.benefit_3' | t }}</span></li>
        </ul>
        <figure class="apdp-dialfit-review">
          <div class="apdp-tail-avatar">
            {%- if section.settings.review_avatar != blank -%}{{ section.settings.review_avatar | image_url: width: 160 | image_tag: loading: 'eager', widths: '80, 120, 160', sizes: '56px', alt: section.settings.review_avatar.alt | default: 'Jordan M.' }}{%- else -%}<span class="apdp-tail-avatar__initial" aria-hidden="true">J</span>{%- endif -%}
          </div>
          <div>{% render 'altaeron-pdp-stars', rating: 5 %}<blockquote><strong>{{ 'altaeron_pdp_dialfit.buy.review_title' | t }}</strong>{{ 'altaeron_pdp_dialfit.buy.review_body' | t }}<strong>{{ 'altaeron_pdp_dialfit.buy.review_close' | t }}</strong></blockquote><figcaption><strong>Jordan M.</strong> &middot; {{ 'altaeron_pdp_dialfit.buy.verified_customer' | t }}</figcaption></div>
        </figure>
      </div>

      <aside id="AltaeronBuy-{{ section.id }}" class="apdp-buy" aria-label="{{ 'altaeron_pdp_dialfit.accessibility.purchase' | t: product: product.title | escape }}" data-apdp-primary-purchase>
        {%- render 'altaeron-labor-day-promotion', section: section, sync_announcement: false -%}
        <h2 class="apdp-buy__title">{{ 'altaeron_pdp_dialfit.buy.title' | t }}</h2>
        <div class="apdp-buy__price-line"><div><div class="apdp-price" aria-live="polite"><span class="apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="apdp-price__compare" data-apdp-compare-price{% if current_compare <= current_variant.price %} hidden{% endif %}>{{ current_compare | money }}</s></div></div><span class="apdp-price__save" data-apdp-savings hidden></span></div>
        {%- form 'product', product, id: product_form_id, class: 'apdp-form main-product-form', is: 'product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="product-form__error-message-wrapper" role="alert" hidden><div class="product-form__error-message alert alert--error" role="alert" hidden></div></div>
          <div class="apdp-dialfit-size-trigger"><button type="button" data-dialfit-size-open aria-haspopup="dialog">{{ 'altaeron_pdp_dialfit.buy.size_guide' | t }}</button></div>
          <bundle-deals-widget id="AltaeronBundles-{{ section.id }}" tabindex="-1" product-id="{{ product.id }}"></bundle-deals-widget>
          <button type="submit" name="add" class="apdp-button apdp-button--primary product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ cta_label | escape }}">{{ cta_label }}</span><b data-apdp-cta-price> — {{ current_variant.price | money }}</b></span>{% render 'altaeron-pdp-icon', icon: 'cart' %}<span class="loading__spinner hidden">{% render 'loading-spinner' %}</span></button>
          {%- if shop.enabled_payment_types.size > 0 -%}<ul class="apdp-payment-icons list list-payment" role="list" aria-label="{{ 'altaeron_pdp.accessibility.accepted_payment_methods' | t | escape }}">{%- for type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul>{%- endif -%}
          {%- capture social_proof_count -%}<strong data-apdp-social-proof-count></strong>{%- endcapture -%}
          <p class="apdp-social-proof" data-apdp-social-proof data-store-date="{{ 'now' | date: '%Y-%m-%d' }}" data-store-utc-offset="{{ 'now' | date: '%z' }}" hidden>{{ 'altaeron_pdp.buy.social_proof_html' | t: count: social_proof_count }}</p>
        {%- endform -%}
        <div class="apdp-buy__trust">
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{% render 'altaeron-pdp-icon', icon: 'truck' %}<span><b>{{ 'altaeron_pdp_dialfit.buy.free_shipping' | t }}</b><small>{{ 'altaeron_pdp_dialfit.buy.every_order' | t }}</small></span></a>
          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{% render 'altaeron-pdp-icon', icon: 'return' %}<span><b>{{ 'altaeron_pdp_dialfit.buy.guarantee' | t }}</b><small>{{ 'altaeron_pdp_dialfit.buy.risk_free' | t }}</small></span></a>
          <span>{% render 'altaeron-pdp-icon', icon: 'lock' %}<span><b>{{ 'altaeron_pdp_dialfit.buy.secure_checkout' | t }}</b><small>{{ 'altaeron_pdp_dialfit.buy.encrypted_payment' | t }}</small></span></span>
          <span>{% render 'altaeron-pdp-icon', icon: 'support' %}<span><b>{{ 'altaeron_pdp_dialfit.buy.tracked_delivery' | t }}</b><small>{{ 'altaeron_pdp_dialfit.buy.follow_order' | t }}</small></span></span>
        </div>
      </aside>
    </div>
  </section>

  <dialog class="apdp-dialfit-size-dialog" data-dialfit-size-dialog aria-labelledby="DialFitSizeDialogTitle-{{ section.id }}">
    <div class="apdp-dialfit-size-dialog__inner">
      <button type="button" class="apdp-dialfit-size-dialog__close" data-dialfit-size-close aria-label="{{ 'altaeron_pdp_dialfit.size.close' | t | escape }}">×</button>
      <h2 id="DialFitSizeDialogTitle-{{ section.id }}">{{ 'altaeron_pdp_dialfit.size.title' | t }}</h2>
      <p class="apdp-dialfit-size-dialog__intro">{{ 'altaeron_pdp_dialfit.size.intro' | t }}</p>
      <div class="apdp-size-chart__controls">
        <span id="DialFitUnitLabel-{{ section.id }}">{{ 'altaeron_pdp_dialfit.size.units' | t }}</span>
        <div class="apdp-size-chart__toggle" role="group" aria-labelledby="DialFitUnitLabel-{{ section.id }}">
          <button type="button" data-size-unit="us" aria-pressed="true">{{ 'altaeron_pdp_dialfit.size.us' | t }}</button>
          <button type="button" data-size-unit="metric" aria-pressed="false">{{ 'altaeron_pdp_dialfit.size.metric' | t }}</button>
        </div>
      </div>
      <div class="apdp-size-chart__tip" aria-live="polite" data-us-copy="{{ 'altaeron_pdp_dialfit.size.us_copy' | t | escape }}" data-metric-copy="{{ 'altaeron_pdp_dialfit.size.metric_copy' | t | escape }}"><strong data-size-unit-badge>US</strong><span data-size-unit-copy>{{ 'altaeron_pdp_dialfit.size.us_copy' | t }}</span></div>
      <div class="apdp-size-chart">
        <table>
          <caption class="visually-hidden">{{ 'altaeron_pdp_dialfit.size.caption' | t }}</caption>
          <thead><tr><th scope="col">{{ 'altaeron_pdp_dialfit.size.size' | t }}</th><th scope="col">{{ 'altaeron_pdp_dialfit.size.brace_length' | t }}<small data-length-unit>in</small></th><th scope="col">{{ 'altaeron_pdp_dialfit.size.brace_width' | t }}<small data-length-unit>in</small></th><th scope="col">{{ 'altaeron_pdp_dialfit.size.weight' | t }}<small data-weight-unit>lb</small></th><th scope="col">{{ 'altaeron_pdp_dialfit.size.upper_knee' | t }}<small data-length-unit>in</small></th><th scope="col">{{ 'altaeron_pdp_dialfit.size.lower_knee' | t }}<small data-length-unit>in</small></th></tr></thead>
          <tbody>
            {%- assign size_names = 'M,L,XL,XXL' | split: ',' -%}
            {%- assign size_values = '31|16|45–65|30–40|25–30|12.2|6.3|99–143|11.8–15.7|9.8–11.8,31|17|65–85|32–48|28–38|12.2|6.7|143–187|12.6–18.9|11.0–15.0,31|18|85–105|36–56|32–45|12.2|7.1|187–231|14.2–22.0|12.6–17.7,31|19|105–125|42–64|37–51|12.2|7.5|231–276|16.5–25.2|14.6–20.1' | split: ',' -%}
            {%- for size_name in size_names -%}{%- assign values = size_values[forloop.index0] | split: '|' -%}
              <tr><th scope="row"><span class="apdp-size-chart__size">{{ size_name }}</span></th>{%- for value in values limit: 5 -%}{%- assign us_index = forloop.index0 | plus: 5 -%}{%- case forloop.index0 -%}{%- when 0 -%}{%- assign label = 'altaeron_pdp_dialfit.size.brace_length' | t -%}{%- when 1 -%}{%- assign label = 'altaeron_pdp_dialfit.size.brace_width' | t -%}{%- when 2 -%}{%- assign label = 'altaeron_pdp_dialfit.size.weight' | t -%}{%- when 3 -%}{%- assign label = 'altaeron_pdp_dialfit.size.upper_knee_short' | t -%}{%- else -%}{%- assign label = 'altaeron_pdp_dialfit.size.lower_knee_short' | t -%}{%- endcase -%}<td data-label="{{ label | escape }} ({% if forloop.index0 == 2 %}lb{% else %}in{% endif %})" data-label-base="{{ label | escape }}" data-metric="{{ value }}" data-us="{{ values[us_index] }}">{{ values[us_index] }}</td>{%- endfor -%}</tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <p class="apdp-size-chart__footer">{{ 'altaeron_pdp_dialfit.size.footer' | t }}</p>
    </div>
  </dialog>

  <section class="apdp-dialfit-story alta-pdp-flow-section" aria-labelledby="DialFitGalleryStory-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full apdp-dialfit-story__layout">
    <div class="apdp-dialfit-story__media apdp-tail-media">{%- if story_media != blank -%}{{ story_media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 768px) 46vw, 100vw', alt: story_media.alt | default: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div>
    <div class="apdp-dialfit-story__copy">
      {%- capture story_title -%}{{ 'altaeron_pdp_dialfit.story.title' | t }} <strong>{{ 'altaeron_pdp_dialfit.story.title_emphasis' | t }}</strong>{%- endcapture -%}
      {% render 'altaeron-pdp-section-heading', number: '1', title: story_title, heading_id: story_heading_id %}
      <p>{{ 'altaeron_pdp_dialfit.story.paragraph_1' | t }}</p>
      <p>{{ 'altaeron_pdp_dialfit.story.paragraph_2' | t }}</p>
      <p class="apdp-dialfit-highlight">{{ 'altaeron_pdp_dialfit.story.highlight' | t }}</p>
    </div>
  </div></section>

  <section class="apdp-education alta-pdp-flow-section apdp-dialfit-section apdp-dialfit-mechanism" aria-labelledby="DialFitMechanism-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full">
    <div class="apdp-dialfit-mechanism__layout">
      <div class="apdp-dialfit-mechanism__copy">
        {%- assign mechanism_title = 'altaeron_pdp_dialfit.mechanism.title' | t -%}{%- assign mechanism_subtitle = 'altaeron_pdp_dialfit.mechanism.subtitle' | t -%}
        {% render 'altaeron-pdp-section-heading', number: '2', title: mechanism_title, subtitle: mechanism_subtitle, heading_id: mechanism_heading_id %}
        <p>{{ 'altaeron_pdp_dialfit.mechanism.paragraph_1' | t }}</p>
        <p>{{ 'altaeron_pdp_dialfit.mechanism.paragraph_2' | t }}</p>
        <p>{{ 'altaeron_pdp_dialfit.mechanism.paragraph_3' | t }}</p>
        <div class="apdp-dialfit-support-states" aria-label="{{ 'altaeron_pdp_dialfit.mechanism.levels_label' | t | escape }}">
          {%- for level_index in (1..4) -%}{%- capture level_title_key -%}altaeron_pdp_dialfit.mechanism.level_{{ level_index }}_title{%- endcapture -%}{%- capture level_body_key -%}altaeron_pdp_dialfit.mechanism.level_{{ level_index }}_body{%- endcapture -%}<div><strong>{{ level_title_key | t }}</strong><span>{{ level_body_key | t }}</span></div>{%- endfor -%}
        </div>
        <p class="apdp-dialfit-highlight">{{ 'altaeron_pdp_dialfit.mechanism.highlight' | t }}</p>
        <p class="apdp-dialfit-mechanism__secondary">{{ 'altaeron_pdp_dialfit.mechanism.secondary' | t }}</p>
      </div>
      <div class="apdp-dialfit-mechanism__visual"><div class="apdp-dialfit-mechanism__media apdp-tail-media">{%- if mechanism_media != blank -%}{{ mechanism_media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 768px) 48vw, 100vw', alt: mechanism_media.alt | default: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div><div class="apdp-dialfit-mechanism__labels" aria-label="{{ 'altaeron_pdp_dialfit.mechanism.benefits_label' | t | escape }}">{%- for tag_index in (1..4) -%}{%- capture tag_key -%}altaeron_pdp_dialfit.mechanism.tag_{{ tag_index }}{%- endcapture -%}<span>{{ tag_key | t }}</span>{%- endfor -%}</div></div>
    </div>
  </div></section>

  <section class="apdp-education alta-pdp-flow-section apdp-dialfit-section" aria-labelledby="DialFitBenefits-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full">
    {%- assign benefits_title = 'altaeron_pdp_dialfit.benefits.title' | t -%}{% render 'altaeron-pdp-section-heading', number: '3', title: benefits_title, heading_id: benefits_heading_id %}
    <div class="apdp-dialfit-benefits">
      {%- for benefit_index in (1..4) -%}{%- capture benefit_title_key -%}altaeron_pdp_dialfit.benefits.item_{{ benefit_index }}_title{%- endcapture -%}{%- capture benefit_body_key -%}altaeron_pdp_dialfit.benefits.item_{{ benefit_index }}_body{%- endcapture -%}<article><h3>{{ benefit_title_key | t }}</h3><p>{{ benefit_body_key | t }}</p>{%- if benefit_index == 1 -%}<small>{{ 'altaeron_pdp_dialfit.benefits.item_1_note' | t }}</small>{%- endif -%}</article>{%- endfor -%}
    </div>
  </div></section>

  <section class="apdp-education alta-pdp-flow-section apdp-dialfit-section" aria-labelledby="DialFitUses-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full apdp-dialfit-uses__panel">
    {%- assign uses_title = 'altaeron_pdp_dialfit.uses.title' | t -%}{%- assign uses_subtitle = 'altaeron_pdp_dialfit.uses.subtitle' | t -%}{% render 'altaeron-pdp-section-heading', number: '4', title: uses_title, subtitle: uses_subtitle, heading_id: uses_heading_id %}
    <div class="apdp-dialfit-use-cases">
