  <script>
    (() => {
      const root = document.getElementById('AltaeronPdp-{{ section.id }}');
      if (!root) return;
      const dialog = root.querySelector('[data-dialfit-size-dialog]');
      const openButton = root.querySelector('[data-dialfit-size-open]');
      const closeButton = root.querySelector('[data-dialfit-size-close]');
      const unitButtons = dialog?.querySelectorAll('[data-size-unit]');
      const unitBadge = dialog?.querySelector('[data-size-unit-badge]');
      const unitCopy = dialog?.querySelector('[data-size-unit-copy]');
      const unitTip = dialog?.querySelector('.apdp-size-chart__tip');
      const gallery = root.querySelector('[data-apdp-gallery]');
      const heroVideo = gallery?.querySelector('[data-apdp-hero-video]');
      const returnButton = gallery?.querySelector('[data-apdp-return-demo]');
      openButton?.addEventListener('click', () => dialog?.showModal());
      closeButton?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      unitButtons?.forEach((button) => {
        button.addEventListener('click', () => {
          const unit = button.dataset.sizeUnit;
          unitButtons.forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
          dialog.querySelectorAll('[data-metric][data-us]').forEach((cell) => {
            cell.textContent = cell.dataset[unit];
            const unitLabel = cell.cellIndex === 3 ? (unit === 'us' ? 'lb' : 'kg') : (unit === 'us' ? 'in' : 'cm');
            cell.dataset.label = `${cell.dataset.labelBase} (${unitLabel})`;
          });
          dialog.querySelectorAll('[data-length-unit]').forEach((label) => {
            label.textContent = unit === 'us' ? 'in' : 'cm';
          });
          dialog.querySelectorAll('[data-weight-unit]').forEach((label) => {
            label.textContent = unit === 'us' ? 'lb' : 'kg';
          });
          unitBadge.textContent = unit === 'us' ? 'US' : 'CM';
          unitCopy.textContent = unit === 'us' ? unitTip.dataset.usCopy : unitTip.dataset.metricCopy;
        });
      });
      gallery?.querySelectorAll('[data-apdp-thumb]').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          gallery.classList.add('is-viewer-active');
          heroVideo?.pause();
        });
      });
      returnButton?.addEventListener('click', () => {
        gallery.classList.remove('is-viewer-active');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) heroVideo?.play().catch(() => {});
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Altaeron DialFit PDP",
  "tag": "section",
  "class": "section-altaeron-pdp section-altaeron-pdp-dialfit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Product label", "default": "Altaeron™ DialFit Knee Brace" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Turn the Dial. Lock In Knee Support." },
    { "type": "textarea", "id": "subheadline", "label": "Outcome sentence", "default": "Fine-tune the support around your knee in seconds to reduce strain, absorb impact and move with more confidence." },
    { "type": "text", "id": "cta_label", "label": "Add to cart label", "default": "GET MY DIALFIT →" },
    { "type": "header", "content": "Above-the-fold review" },
    { "type": "image_picker", "id": "review_avatar", "label": "Reviewer avatar" },
    { "type": "header", "content": "Hero media" },
    { "type": "video", "id": "hero_video", "label": "Hero video" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image fallback" },
    { "type": "header", "content": "Point 1 media" },
    { "type": "image_picker", "id": "point_1_image", "label": "Story image" },
    { "type": "header", "content": "Point 2 media" },
    { "type": "image_picker", "id": "point_2_image", "label": "Mechanism image" },
    { "type": "header", "content": "Point 5 media" },
    { "type": "image_picker", "id": "point_5_image_1", "label": "Comparison image 1" },
    { "type": "image_picker", "id": "point_5_image_2", "label": "Comparison image 2" },
    { "type": "header", "content": "Point 6 media" },
    { "type": "video", "id": "point_6_video", "label": "Proof video" },
    { "type": "image_picker", "id": "point_6_image_1", "label": "Proof image 1" },
    { "type": "image_picker", "id": "point_6_image_2", "label": "Proof image 2" },
    { "type": "header", "content": "Point 7 media" },
    { "type": "image_picker", "id": "point_7_image", "label": "Expert portrait" },
    { "type": "header", "content": "Final CTA media" },
    { "type": "image_picker", "id": "final_cta_image", "label": "Final CTA image" }
  ],
  "presets": [{ "name": "Altaeron DialFit PDP" }]
}
{% endschema %}
