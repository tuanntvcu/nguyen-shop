{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_compare = current_variant.compare_at_price | default: 0
  assign mf = product.metafields.altaeron
  assign hero_video = mf.pdp_hero_video.value
  assign hero_image = mf.pdp_hero_image.value | default: product.featured_image
  assign hero_poster = hero_video.preview_image | image_url: width: 1200
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign reviews = review_data.reviews
  assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
  assign review_rating = review_data.average_rating | default: 0 | plus: 0
  assign review_rating_display = review_rating | times: 10 | floor | divided_by: 10.0
  assign product_form_id = 'product-form-' | append: section.id
  assign cta_label = section.settings.cta_label | default: 'GET MY DIALFIT →'
  assign compare_price = current_variant.compare_at_price | default: 0
  assign savings = 0
  if compare_price > current_variant.price
    assign savings = compare_price | minus: current_variant.price
  endif
  assign savings_money = savings | money
  assign installment_amount = current_variant.price | divided_by: 4 | money
  assign final_cta_image = section.settings.final_cta_image
  if final_cta_image == blank
    assign final_cta_image = images['ChatGPT_Image_Aug_14_2026_01_46_46_PM.png']
  endif
-%}

