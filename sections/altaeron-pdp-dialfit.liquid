{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_compare = current_variant.compare_at_price | default: 0
  assign mf = product.metafields.altaeron
  assign hero_video = mf.pdp_hero_video.value
  assign hero_image = mf.pdp_hero_image.value | default: product.featured_image
  assign hero_poster = hero_video.preview_image | image_url: width: 1200
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign reviews = review_data.reviews
  assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
  assign review_rating = review_data.average_rating | default: 0 | plus: 0
  assign review_rating_display = review_rating | times: 10 | floor | divided_by: 10.0
  assign product_form_id = 'product-form-' | append: section.id
  assign cta_label = section.settings.cta_label | default: 'GET MY DIALFIT →'
-%}

{{ 'altaeron-pdp.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'altaeron-pdp.js' | asset_url }}" defer="defer"></script>

<style>
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-section{padding-top:var(--alta-pdp-section-gap-tight)}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-full{width:min(1180px,calc(100% - 80px))}
  #AltaeronPdp-{{ section.id }} .apdp-gallery__stage{display:none}
  #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits{display:grid;gap:9px;list-style:none;margin:16px 0 0;padding:0}
  #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits li{align-items:flex-start;color:#173f32;display:flex;font-size:14px;font-weight:650;gap:9px;line-height:1.4}
  #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits svg{background:#08724b;border-radius:50%;color:#fff;flex:0 0 19px;height:19px;margin-top:1px;padding:4px;width:19px}
  #AltaeronPdp-{{ section.id }} .apdp-rating[hidden]{display:none}
  #AltaeronPdp-{{ section.id }} .apdp-hero__reassurance{color:#3d5048;font-size:12px;font-weight:650;margin:9px 0 0;text-align:center}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-review{align-items:start;background:#f7faf7;border:1px solid #dfe7e1;border-radius:10px;display:grid;gap:10px;grid-template-columns:38px minmax(0,1fr);margin:12px 0;padding:12px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-review blockquote{color:#29483d;font-size:12px;line-height:1.5;margin:3px 0 0}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-review blockquote strong{color:#075c3b;display:block;margin-bottom:3px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-review figcaption{font-size:11px;margin-top:7px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-copy{color:#29483d;font-size:16px;line-height:1.65;margin:0 auto;max-width:760px;text-align:center}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-copy p{margin:0 0 14px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-highlight{background:#eef7f1;border-radius:10px;color:#075c3b;font-weight:750;margin:18px auto 0;padding:13px 16px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-grid{display:grid;gap:14px;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:24px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-card{background:#fff;border:1px solid #dfe7e1;border-radius:12px;box-shadow:0 2px 8px rgba(18,43,31,.06);padding:22px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-card h3{color:#173f32;font-size:17px;margin:0 0 8px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-card p{color:#52655d;font-size:14px;line-height:1.55;margin:0}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-steps{counter-reset:dialfit-step}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-steps .apdp-dialfit-card:before{align-items:center;background:#075c3b;border-radius:50%;color:#fff;content:counter(dialfit-step);counter-increment:dialfit-step;display:flex;font-size:13px;font-weight:800;height:30px;justify-content:center;margin-bottom:14px;width:30px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-compare{border:1px solid #dfe3df;border-radius:10px;margin-top:24px;overflow:hidden}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-compare>div{display:grid;grid-template-columns:1fr 1fr}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-compare>div+div{border-top:1px solid #dfe3df}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-compare span{align-items:center;display:flex;font-size:13px;min-height:48px;padding:10px 16px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-compare span+span{background:#f2f8f5;border-left:1px solid #dfe3df;color:#075c3b;font-weight:700}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-compare__head span{background:#f6f7f5;font-weight:800}
  #AltaeronPdp-{{ section.id }} .apdp-buy__price-line{margin-bottom:8px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-trigger{align-items:center;display:flex;justify-content:flex-end;margin:0 0 3px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-trigger button{align-items:center;background:none;border:0;color:#075c3b;cursor:pointer;display:inline-flex;font:inherit;font-size:13px;font-weight:750;height:auto;line-height:1.25;min-height:0;padding:2px 0;text-decoration:underline;text-underline-offset:3px}
  #AltaeronPdp-{{ section.id }} bundle-deals-widget .bd-widget{margin-top:7px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story{border-top:1px solid #d8e1db;grid-column:1;grid-row:3;margin-top:8px;padding:24px 4px 8px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2{color:#10251d;font-family:var(--alta-font-family);font-size:clamp(26px,2.1vw,34px);font-weight:800;letter-spacing:-.025em;line-height:1.18;margin:0 0 24px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2 strong{color:#08724b;font-weight:800}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__copy{color:#29483d;font-size:15px;line-height:1.62}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__copy p{margin:0 0 18px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__alert{color:#d6573f;font-weight:750}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__consequence{color:#29483d;text-decoration:underline;text-decoration-color:#08724b;text-decoration-thickness:1px;text-underline-offset:3px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result{align-items:flex-start;background:#eef7f1;border-radius:10px;color:#173f32;display:flex;font-size:14px;font-style:italic;font-weight:600;gap:10px;line-height:1.5;margin:22px 0 0;padding:13px 14px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result>span:first-child{align-items:center;background:#08724b;border-radius:50%;color:#fff;display:flex;flex:0 0 20px;height:20px;justify-content:center;margin-top:1px;width:20px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result svg{height:13px;stroke-width:2.5;width:13px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog{border:0;border-radius:16px;box-shadow:0 18px 60px rgba(12,35,25,.24);color:#173f32;margin:auto;max-height:min(760px,calc(100vh - 32px));max-width:900px;padding:0;width:calc(100% - 30px)}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog::backdrop{background:rgba(8,25,18,.64);backdrop-filter:blur(2px)}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog__inner{padding:30px;position:relative}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog__close{align-items:center;background:#eef7f1;border:0;border-radius:50%;color:#075c3b;cursor:pointer;display:flex;font-size:25px;height:38px;justify-content:center;line-height:1;padding:0;position:absolute;right:16px;top:16px;width:38px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog h2{color:#173f32;font-size:26px;margin:0;padding-right:44px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog__intro{color:#52655d;font-size:14px;margin:7px 0 0}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart__tip{align-items:center;background:#eef7f1;border-radius:9px;color:#29483d;display:flex;font-size:13px;gap:9px;line-height:1.45;margin:18px 0 14px;padding:10px 12px}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart__tip strong{align-items:center;background:#075c3b;border-radius:5px;color:#fff;display:flex;flex:0 0 34px;font-size:10px;height:25px;justify-content:center;letter-spacing:.06em}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart{border:1px solid #d8e3dc;border-radius:12px;overflow:hidden}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart table{border-collapse:collapse;table-layout:fixed;width:100%}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart th,#AltaeronPdp-{{ section.id }} .apdp-size-chart td{border-right:1px solid #d8e3dc;padding:13px 9px;text-align:center;vertical-align:middle}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart th:last-child,#AltaeronPdp-{{ section.id }} .apdp-size-chart td:last-child{border-right:0}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart thead{background:#f2f8f5;color:#173f32}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart thead th{font-size:11px;font-weight:800;letter-spacing:.025em;line-height:1.25;text-transform:uppercase}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart thead small{color:#63756d;display:block;font-size:9px;font-weight:650;margin-top:3px;text-transform:none}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody tr+tr{border-top:1px solid #d8e3dc}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody tr:hover{background:#fbfdfb}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody th{width:72px}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody td{color:#29483d;font-size:14px;font-weight:650}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody td:nth-child(4){background:#f6faf7;color:#075c3b;font-weight:800}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart__size{align-items:center;background:#075c3b;border-radius:7px;color:#fff;display:inline-flex;font-size:18px;font-weight:850;height:40px;justify-content:center;min-width:48px;padding:0 8px}
  #AltaeronPdp-{{ section.id }} .apdp-size-chart__footer{color:#63756d;font-size:11px;line-height:1.45;margin:11px 0 0}
  #AltaeronPdp-{{ section.id }} .apdp-tail-faq{padding-bottom:48px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-guarantee{background:#eef7f1;border-radius:14px;display:grid;gap:22px;grid-template-columns:auto 1fr auto;margin-top:28px;padding:28px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-guarantee svg{color:#075c3b;height:54px;width:54px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-guarantee h2{font-size:26px;margin:0 0 7px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-guarantee p{color:#52655d;line-height:1.55;margin:0}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-guarantee .apdp-button{align-self:center;min-width:230px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-bottom{background:#003d29;color:#fff;padding:44px 0}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-bottom h2,#AltaeronPdp-{{ section.id }} .apdp-dialfit-bottom p{color:#fff;text-align:center}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-bottom__selection{background:#fff;border-radius:12px;color:#173f32;margin:24px auto 0;max-width:680px;padding:22px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-bottom__summary{display:flex;flex-wrap:wrap;font-size:13px;gap:8px;justify-content:center;margin-bottom:14px}
  #AltaeronPdp-{{ section.id }} .apdp-dialfit-bottom__summary span{background:#eef7f1;border-radius:999px;padding:7px 10px}
  @media(min-width:1100px){
    #AltaeronPdp-{{ section.id }} .apdp-hero__grid{align-items:start;grid-template-columns:minmax(0,43fr) minmax(300px,29fr) minmax(360px,28fr);min-height:0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery{align-self:start;display:grid;gap:12px;grid-column:1;grid-row:1;grid-template-columns:1fr;grid-template-rows:auto auto;min-width:0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__stage{display:none}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__viewer{aspect-ratio:1;grid-column:1;grid-row:1;height:auto;max-height:720px}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__thumbs{display:flex;flex-direction:row;grid-column:1;grid-row:2;max-height:none;overflow-x:auto;overflow-y:hidden;padding:1px 2px 4px}
    #AltaeronPdp-{{ section.id }} .apdp-narrative{align-self:center;grid-column:2;grid-row:1}
    #AltaeronPdp-{{ section.id }} .apdp-buy{grid-column:3;grid-row:1;min-height:0}
  }
  @media(max-width:767px){
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-section{padding-top:var(--alta-pdp-section-gap-tight-mobile)}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-full{width:calc(100% - 30px)}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-grid{grid-template-columns:1fr}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog__inner{padding:24px 18px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-size-dialog h2{font-size:24px}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart{background:#f5f9f6;border:0;border-radius:0;overflow:visible}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart table,#AltaeronPdp-{{ section.id }} .apdp-size-chart tbody{display:block}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart thead{display:none}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody{display:grid;gap:10px}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody tr{background:#fff;border:1px solid #d8e3dc;border-radius:11px;display:grid;gap:7px;grid-template-columns:1fr 1fr;padding:12px}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody tr+tr{border-top:1px solid #d8e3dc}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody th{border:0;grid-column:1/-1;padding:0 0 3px;text-align:left;width:auto}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody td,#AltaeronPdp-{{ section.id }} .apdp-size-chart tbody td:nth-child(4){align-items:center;background:#f5f9f6;border:0;border-radius:7px;color:#29483d;display:flex;font-size:12px;justify-content:space-between;min-height:42px;padding:8px 9px;text-align:right}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody td:before{color:#63756d;content:attr(data-label);font-size:9px;font-weight:700;line-height:1.2;max-width:58%;text-align:left;text-transform:uppercase}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart tbody td:last-child{grid-column:1/-1}
    #AltaeronPdp-{{ section.id }} .apdp-size-chart__size{font-size:16px;height:34px;min-width:44px}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-guarantee{grid-template-columns:1fr;padding:22px;text-align:center}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-guarantee svg{margin:auto}
    #AltaeronPdp-{{ section.id }} .apdp-dialfit-copy{text-align:left}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__stage{display:none}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__viewer{margin:12px 15px 0;order:1;width:calc(100% - 30px)}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__thumbs{margin:0 15px;order:2;width:calc(100% - 30px)}
    #AltaeronPdp-{{ section.id }} .apdp-narrative{order:3;padding:5px 15px 0}
    #AltaeronPdp-{{ section.id }} .apdp-buy{order:4}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story{grid-row:auto;margin:0 15px 20px;order:5;padding:22px 0 0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2{font-size:clamp(27px,8vw,34px);line-height:1.16;margin-bottom:22px}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story__copy{font-size:15px;line-height:1.62}
  }
</style>

<div
  id="AltaeronPdp-{{ section.id }}"
  class="altaeron-pdp altaeron-pdp--cro-hero altaeron-pdp--dialfit"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="Save"
  data-save-template="Save [amount]"
  data-add-to-cart-label="{{ cta_label | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-bundle-title="Choose Your Bundle"
  data-bundle-one="1 Brace"
  data-bundle-many-template="[count] Braces"
  data-bundle-one-foot="One DialFit brace"
  data-bundle-popular="BEST VALUE"
  data-bundle-best-value="BIGGEST SAVINGS"
  data-bundle-subtitle-template="[price] each · Save [amount]"
  data-bundle-cta-one="GET MY DIALFIT — [price]"
  data-bundle-cta-many="GET [count] DIALFIT BRACES — [price]"
>
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="Altaeron DialFit product media">
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage apdp-gallery__hero"{% if hero_poster != blank %} style="--apdp-hero-poster:url('{{ hero_poster }}')"{% endif %}>
          {%- if hero_video != blank -%}
            {{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
          {%- elsif hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: 'Altaeron DialFit adjustable knee brace with dial tightening system' }}
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {% render 'altaeron-pdp-media', media: media, product: product, loading: 'lazy', fetchpriority: 'auto', sizes: '(min-width: 1024px) 560px, 100vw' %}
              {%- if media.media_type == 'image' -%}<button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="Open product image {{ forloop.index }}"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <article class="apdp-gallery-story" aria-labelledby="DialFitGalleryStory-{{ section.id }}">
          <h2 id="DialFitGalleryStory-{{ section.id }}">You’re One Turn Away From <strong>More Confident, Supported Movement.</strong></h2>
          <div class="apdp-gallery-story__copy">
            <p>If you’re reading this, chances are <span class="apdp-gallery-story__alert">knee discomfort is already changing the way you move.</span></p>
            <p>You notice it on stairs. During long shifts. Halfway through a walk. Or just as you start the workout you were looking forward to.</p>
            <p>The result? You slow down, avoid certain movements, or cut the day short because your knee doesn’t feel as steady as you want it to.</p>
            <p>Basic compression sleeves give you one fixed level of pressure. <span class="apdp-gallery-story__consequence">Too loose can feel unsupportive. Too tight can become uncomfortable fast.</span></p>
            <p>DialFit puts the adjustment in your hands. Its dial-controlled tension, cushioned patella ring and flexible side stabilization work together to provide a more secure, supported feel without the bulk of a rigid brace.</p>
            <p>Wear it for walks, workouts, errands or long hours on your feet—and adjust the tension whenever your activity changes.</p>
            <p class="apdp-gallery-story__result"><span aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span><span><strong>Turn the dial anytime</strong> to find the level of support that feels right for the moment.</span></p>
          </div>
        </article>
      </div>

      <div class="apdp-narrative">
        <p class="apdp-eyebrow"><span>{{ section.settings.eyebrow }}</span></p>
        {%- if review_count > 0 -%}
