<div
  id="AltaeronPdp-{{ section.id }}"
  class="altaeron-pdp altaeron-pdp--cro-hero altaeron-pdp--dialfit"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="Save"
  data-save-template="Save [amount]"
  data-add-to-cart-label="{{ cta_label | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-bundle-title="Choose Your Bundle"
  data-bundle-one="1 Brace"
  data-bundle-many-template="[count] Braces"
  data-bundle-one-foot="One DialFit brace"
  data-bundle-popular="BEST VALUE"
  data-bundle-best-value="BIGGEST SAVINGS"
  data-bundle-subtitle-template="[price] each · Save [amount]"
  data-bundle-cta-one="GET MY DIALFIT — [price]"
  data-bundle-cta-many="GET [count] DIALFIT BRACES — [price]"
>
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="Altaeron DialFit product media">
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage apdp-gallery__hero"{% if hero_poster != blank %} style="--apdp-hero-poster:url('{{ hero_poster }}')"{% endif %}>
          {%- if hero_video != blank -%}
            {%- capture hero_video_markup -%}{{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1200x' }}{%- endcapture -%}
            {{- hero_video_markup | replace: '<video ', '<video data-apdp-hero-video ' -}}
          {%- elsif hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: 'Altaeron DialFit adjustable knee brace with dial tightening system' }}
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {% render 'altaeron-pdp-media', media: media, product: product, loading: 'lazy', fetchpriority: 'auto', sizes: '(min-width: 1024px) 560px, 100vw' %}
              {%- if media.media_type == 'image' -%}<button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="Open product image {{ forloop.index }}"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>{%- endif -%}
            </div>
          {%- endfor -%}
          <button type="button" class="apdp-gallery__return" data-apdp-return-demo aria-label="Return to DialFit demonstration video"><span aria-hidden="true">←</span> Back to demo</button>
        </div>
      </div>

      <div class="apdp-narrative">
        <p class="apdp-eyebrow"><span>{{ section.settings.eyebrow }}</span></p>
        {%- if review_count > 0 -%}
          <a class="apdp-rating" href="#AltaeronVerified-{{ section.id }}" aria-label="{{ review_rating_display }} out of 5 from {{ review_count }} reviews">{% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{{ review_rating_display }}/5 · {{ review_count }} Reviews</strong></a>
        {%- endif -%}
        <h1 id="AltaeronTitle-{{ section.id }}"><span class="apdp-title-lines">{{ section.settings.headline }}</span></h1>
        <p class="apdp-narrative__subhead">{{ section.settings.subheadline }}</p>
        <ul class="apdp-narrative__benefits" role="list">
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>Turn the dial for precise, adjustable support</span></li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>Cushioned patella support helps absorb impact</span></li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>Flexible side stabilization without a bulky brace</span></li>
        </ul>
      </div>

      <aside id="AltaeronBuy-{{ section.id }}" class="apdp-buy" aria-label="Purchase {{ product.title | escape }}" data-apdp-primary-purchase>
        {%- render 'altaeron-labor-day-promotion', section: section, sync_announcement: false -%}
        <h2 class="apdp-buy__title">Choose Your DialFit</h2>
        <div class="apdp-buy__price-line"><div><div class="apdp-price" aria-live="polite"><span class="apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="apdp-price__compare" data-apdp-compare-price{% if current_compare <= current_variant.price %} hidden{% endif %}>{{ current_compare | money }}</s></div></div><span class="apdp-price__save" data-apdp-savings hidden></span></div>
        {%- form 'product', product, id: product_form_id, class: 'apdp-form main-product-form', is: 'product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="product-form__error-message-wrapper" role="alert" hidden><div class="product-form__error-message alert alert--error" role="alert" hidden></div></div>
          <div class="apdp-dialfit-size-trigger"><button type="button" data-dialfit-size-open aria-haspopup="dialog">View Size Guide</button></div>
          <bundle-deals-widget id="AltaeronBundles-{{ section.id }}" tabindex="-1" product-id="{{ product.id }}"></bundle-deals-widget>
          <button type="submit" name="add" class="apdp-button apdp-button--primary product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ cta_label | escape }}">{{ cta_label }}</span><b data-apdp-cta-price> — {{ current_variant.price | money }}</b></span>{% render 'altaeron-pdp-icon', icon: 'cart' %}<span class="loading__spinner hidden">{% render 'loading-spinner' %}</span></button>
          <p class="apdp-hero__reassurance">Free Shipping • 30-Day Guarantee • Secure Checkout</p>
        {%- endform -%}
        <figure class="apdp-dialfit-review">
          <div class="apdp-tail-avatar"><span class="apdp-tail-avatar__initial" aria-hidden="true">J</span></div>
          <div>{% render 'altaeron-pdp-stars', rating: 5 %}<blockquote><strong>Finally, a brace I can adjust while I'm wearing it.</strong>I'm on my feet most of the day, so I like being able to tighten the dial when my knee needs more support and loosen it again when I'm sitting. It feels secure without the bulk of my old knee brace.<strong>The dial is what makes the difference.</strong></blockquote><figcaption><strong>Jordan M.</strong> · Verified customer</figcaption></div>
        </figure>
        <div class="apdp-buy__trust">
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{% render 'altaeron-pdp-icon', icon: 'truck' %}<span><b>FREE SHIPPING</b><small>On every order</small></span></a>
          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{% render 'altaeron-pdp-icon', icon: 'return' %}<span><b>30-DAY GUARANTEE</b><small>Try it risk-free</small></span></a>
          <span>{% render 'altaeron-pdp-icon', icon: 'lock' %}<span><b>SECURE CHECKOUT</b><small>Encrypted payment</small></span></span>
          <span>{% render 'altaeron-pdp-icon', icon: 'support' %}<span><b>TRACKED DELIVERY</b><small>Follow your order</small></span></span>
        </div>
      </aside>
    </div>
  </section>

  <dialog class="apdp-dialfit-size-dialog" data-dialfit-size-dialog aria-labelledby="DialFitSizeDialogTitle-{{ section.id }}">
    <div class="apdp-dialfit-size-dialog__inner">
      <button type="button" class="apdp-dialfit-size-dialog__close" data-dialfit-size-close aria-label="Close size guide">×</button>
      <h2 id="DialFitSizeDialogTitle-{{ section.id }}">Find Your DialFit Size</h2>
      <p class="apdp-dialfit-size-dialog__intro">Use your recommended weight range, then confirm the fit with your upper and lower knee measurements.</p>
      <div class="apdp-size-chart__tip"><strong>CM</strong><span>Brace and circumference measurements are shown in centimeters. Recommended weight is shown in kilograms.</span></div>
      <div class="apdp-size-chart">
        <table>
          <caption class="visually-hidden">Altaeron DialFit knee brace size measurements</caption>
          <thead><tr><th scope="col">Size</th><th scope="col">Brace length<small>cm</small></th><th scope="col">Brace width<small>cm</small></th><th scope="col">Recommended weight<small>kg</small></th><th scope="col">Upper knee circumference<small>cm</small></th><th scope="col">Lower knee circumference<small>cm</small></th></tr></thead>
          <tbody>
            <tr><th scope="row"><span class="apdp-size-chart__size">M</span></th><td data-label="Brace length">31</td><td data-label="Brace width">16</td><td data-label="Recommended weight">45–65</td><td data-label="Upper knee">30–40</td><td data-label="Lower knee">25–30</td></tr>
            <tr><th scope="row"><span class="apdp-size-chart__size">L</span></th><td data-label="Brace length">31</td><td data-label="Brace width">17</td><td data-label="Recommended weight">65–85</td><td data-label="Upper knee">32–48</td><td data-label="Lower knee">28–38</td></tr>
            <tr><th scope="row"><span class="apdp-size-chart__size">XL</span></th><td data-label="Brace length">31</td><td data-label="Brace width">18</td><td data-label="Recommended weight">85–105</td><td data-label="Upper knee">36–56</td><td data-label="Lower knee">32–45</td></tr>
            <tr><th scope="row"><span class="apdp-size-chart__size">XXL</span></th><td data-label="Brace length">31</td><td data-label="Brace width">19</td><td data-label="Recommended weight">105–125</td><td data-label="Upper knee">42–64</td><td data-label="Lower knee">37–51</td></tr>
          </tbody>
        </table>
      </div>
      <p class="apdp-size-chart__footer">For the most reliable fit, compare both circumference measurements with the chart before selecting your size.</p>
    </div>
  </dialog>

  <section class="apdp-dialfit-story alta-pdp-flow-section" aria-labelledby="DialFitGalleryStory-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full apdp-dialfit-story__layout">
    <div class="apdp-dialfit-story__media apdp-tail-media">{%- assign story_media = product.media[4].preview_image | default: product.featured_image -%}{%- if story_media != blank -%}{{ story_media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 768px) 46vw, 100vw', alt: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div>
    <div class="apdp-dialfit-story__copy">
      <h2 id="DialFitGalleryStory-{{ section.id }}">You’re One Turn Away From <strong>More Confident, Supported Movement.</strong></h2>
      <p>Walking, stairs, workouts and long hours on your feet can put repeated stress through your knees.</p>
      <p>DialFit gives you adjustable support when you need it — helping your knee feel more secure through everyday movement without locking your leg inside a bulky rigid brace.</p>
      <p class="apdp-dialfit-highlight">Tighten it when you want more support. Ease it when you don't.</p>
    </div>
  </div></section>

  <section class="apdp-education alta-pdp-flow-section apdp-dialfit-section apdp-dialfit-mechanism" aria-labelledby="DialFitMechanism-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full">
    <div class="apdp-dialfit-mechanism__layout">
      <div class="apdp-dialfit-mechanism__copy">
        {% render 'altaeron-pdp-section-heading', number: '2', title: 'The Difference Is in the Dial.', subtitle: 'A normal knee sleeve decides the compression for you. DialFit lets you decide.', heading_id: 'DialFitMechanism' %}
        <p>Turn the dial and the tension system draws the brace more securely around your knee.</p>
        <p>Need more support before a workout, a long walk, stairs or a busy shift? Tighten it.</p>
        <p>Sitting down or want less pressure? Ease it back.</p>
        <div class="apdp-dialfit-support-states" aria-label="Adjustable support levels">
          <div><strong>LIGHT SUPPORT</strong><span>For relaxed everyday movement.</span></div>
          <div><strong>MORE SUPPORT</strong><span>Before a long walk or busy shift.</span></div>
          <div><strong>FIRMER FEEL</strong><span>For training, stairs or more demanding activity.</span></div>
          <div><strong>EASE IT BACK</strong><span>When sitting, resting or when you want less tension.</span></div>
        </div>
        <p class="apdp-dialfit-highlight">One brace. Multiple levels of support.</p>
        <p class="apdp-dialfit-mechanism__secondary">Dial in the support you want — without constantly removing and readjusting the brace.</p>
      </div>
      <div class="apdp-dialfit-mechanism__visual"><div class="apdp-dialfit-mechanism__media apdp-tail-media">{%- assign mechanism_media = product.media[2].preview_image | default: product.featured_image -%}{%- if mechanism_media != blank -%}{{ mechanism_media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 768px) 48vw, 100vw', alt: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div><div class="apdp-dialfit-mechanism__labels" aria-label="DialFit mechanism benefits"><span>MICRO-ADJUSTABLE TENSION</span><span>ADJUST WITHOUT TAKING IT OFF</span><span>SUPPORT ON DEMAND</span><span>LESS STRAP FUSS</span></div></div>
    </div>
  </div></section>

  <section class="apdp-education alta-pdp-flow-section apdp-dialfit-section" aria-labelledby="DialFitBenefits-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full">
    {% render 'altaeron-pdp-section-heading', number: '3', title: 'Why Your Knees Will Love DialFit', heading_id: 'DialFitBenefits' %}
    <div class="apdp-dialfit-benefits">
      <article><h3>Dial-Controlled Support</h3><p>Fine-tune the tension in seconds instead of being stuck with one fixed level of compression all day.</p><small>Adjust while you're wearing it.</small></article>
      <article><h3>Targeted Patella Cushioning</h3><p>Dedicated cushioning around the kneecap helps soften repeated impact and pressure during walking, stairs and active movement.</p></article>
      <article><h3>Flexible Side Stability</h3><p>Added support along both sides helps the knee feel steadier without locking your leg inside a bulky rigid brace.</p></article>
      <article><h3>Lightweight, Flexible Construction</h3><p>Flexible stretch construction moves with your leg and is designed for active everyday wear.</p></article>
    </div>
  </div></section>

  <section class="apdp-education alta-pdp-flow-section apdp-dialfit-section" aria-labelledby="DialFitUses-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full">
    {% render 'altaeron-pdp-section-heading', number: '4', title: 'From Morning Walks to 12-Hour Shifts', heading_id: 'DialFitUses' %}
    <div class="apdp-dialfit-use-cases">
      <article><h3>Walking, Stairs & Everyday Movement</h3><p>For knees that feel tired, strained or less confident through repeated steps, inclines, stairs, errands and everyday movement.</p></article>
      <article><h3>Training, Sports & Active Days</h3><p>Adjustable support for running, squats, gym sessions, hiking, recreational sports and days when your knees are working harder than usual.</p></article>
      <article><h3>Long Shifts on Your Feet</h3><p>For nurses, teachers, retail staff, warehouse workers, factory workers, hospitality staff, cooks, hairdressers, cleaners, security staff, delivery workers and anyone spending hours standing or walking.</p><p class="apdp-dialfit-card-note">When your shift doesn't give your knees a break, DialFit gives you adjustable backup.</p><p class="apdp-dialfit-card-note">For knees that take repeated load from lifting, carrying, bending, climbing and long hours on the job.</p><small class="apdp-dialfit-work-audiences">Construction workers · Movers · Mechanics · Landscapers · Tradespeople</small></article>
      <article><h3>Work, Travel & Life on the Move</h3><p>For lifting, carrying, bending, climbing, commuting, airport walking, sightseeing, gardening, housework and other days when your knees take more load than usual.</p><p class="apdp-dialfit-card-note">Useful for airport walking, sightseeing, long days out and trips where sitting down isn't always an option.</p></article>
    </div>
    <div class="apdp-dialfit-audience-strip"><h3>DialFit Can Also Be Useful When...</h3><ul><li>Your knees feel tired after standing all day</li><li>Stairs feel harder than they used to</li><li>You're getting back into regular walking or exercise</li><li>Extra body weight makes everyday movement feel more demanding on your knees</li><li>Long days of work, travel or errands leave your knees feeling overworked</li><li>You want extra external support without wearing a heavy rigid brace</li></ul><p>Extra support for knees that don't feel as young as they used to.</p></div>
  </div></section>

  <section class="apdp-tail alta-pdp-flow-section apdp-dialfit-section" aria-labelledby="DialFitCompare-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full">
    {% render 'altaeron-pdp-section-heading', number: '5', title: 'Not Just Another Knee Sleeve', subtitle: 'More control than a basic sleeve. Less bulk than a rigid brace.', heading_id: 'DialFitCompare' %}
    <div class="apdp-dialfit-compare" role="table" aria-label="Basic knee sleeve and traditional rigid brace compared with DialFit"><div class="apdp-dialfit-compare__head" role="row"><span role="columnheader">Basic Knee Sleeve</span><span role="columnheader">DialFit</span></div><div role="row"><span role="cell">Fixed compression</span><span role="cell">Adjustable dial-controlled tension</span></div><div role="row"><span role="cell">One feel all day</span><span role="cell">Change support as your activity changes</span></div><div role="row"><span role="cell">Basic stretch fabric around the kneecap</span><span role="cell">Targeted patella cushioning</span></div><div role="row"><span role="cell">Limited structure</span><span role="cell">Added flexible side stability</span></div><div role="row"><span class="apdp-dialfit-compare__rigid" role="cell"><small>Traditional Rigid Brace</small>Can feel bulky and restrictive for everyday use</span><span role="cell">Flexible support designed to move with your leg</span></div></div>
    <p class="apdp-dialfit-highlight">Your activity changes throughout the day. Your knee support should too.</p>
  </div></section>

  <section class="apdp-education alta-pdp-flow-section apdp-dialfit-section" aria-labelledby="DialFitHow-{{ section.id }}"><div class="apdp-shell apdp-dialfit-full">
    {% render 'altaeron-pdp-section-heading', number: '6', title: 'Support Your Knee in Seconds', heading_id: 'DialFitHow' %}
    <div class="apdp-dialfit-steps"><article><h3>SLIDE IT ON</h3><p>Pull the brace onto the correct knee.</p></article><article><h3>CENTER YOUR KNEECAP</h3><p>Position the cushioned support around the kneecap.</p></article><article><h3>TURN THE DIAL</h3><p>Adjust until it feels secure and supportive.</p></article><article><h3>MOVE</h3><p>Walk, work or train — and readjust the tension when needed.</p></article></div>
