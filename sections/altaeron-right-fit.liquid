{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign callout_heading = section.settings.callout_heading
  assign callout_body = section.settings.callout_body
  unless request.locale.iso_code == 'en'
    assign eyebrow = 'altaeron_pdp_reels_v3.right_fit.eyebrow' | t
    assign heading = 'altaeron_pdp_reels_v3.right_fit.heading_html' | t
    assign subheading = 'altaeron_pdp_reels_v3.right_fit.subheading' | t
    assign callout_heading = 'altaeron_pdp_reels_v3.right_fit.callout_heading' | t
    assign callout_body = 'altaeron_pdp_reels_v3.right_fit.callout_body' | t
  endunless
-%}

<style>
  #AltaeronRightFit-{{ section.id }} {
    --alta-fit-ink: var(--altaeron-navy, #102a43);
    --alta-fit-body: var(--altaeron-body, #344054);
    --alta-fit-accent: var(--altaeron-primary, #006b5e);
    --alta-fit-soft: var(--altaeron-soft-teal, #eaf5f2);
    --alta-fit-line: var(--altaeron-border, #e4e7ec);
    background: #fff;
    color: var(--alta-fit-body);
    padding: 26px 0 52px;
  }
  #AltaeronRightFit-{{ section.id }} * { box-sizing: border-box; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__shell { margin-inline: auto; width: min(1040px, calc(100% - 48px)); }
  #AltaeronRightFit-{{ section.id }} .alta-fit__header { margin: 0 auto 30px; max-width: 920px; text-align: center; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__eyebrow { align-items: center; color: var(--alta-fit-accent); display: flex; font-size: 12px; font-weight: 750; gap: 16px; justify-content: center; letter-spacing: .24em; line-height: 1.3; margin: 0 0 12px; text-transform: uppercase; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__eyebrow::before,
  #AltaeronRightFit-{{ section.id }} .alta-fit__eyebrow::after { background: currentColor; content: ''; flex: 0 1 44px; height: 1px; opacity: .42; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__heading { color: var(--alta-fit-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: clamp(30px, 3vw, 42px); font-weight: 750; letter-spacing: -.035em; line-height: 1.08; margin: 0; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__heading strong { color: var(--alta-fit-accent); font-weight: inherit; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__subheading { color: var(--alta-fit-body); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.5; margin: 10px 0 0; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__cards { display: grid; gap: 22px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #AltaeronRightFit-{{ section.id }} .alta-fit-card { align-content: center; align-items: start; background: linear-gradient(135deg, #fff 18%, #f2faf8 100%); border: 1px solid var(--alta-fit-line); border-radius: 18px; display: grid; gap: 18px; grid-template-columns: auto minmax(0, 1fr); min-height: 190px; min-width: 0; overflow: hidden; padding: 28px; position: relative; transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
  #AltaeronRightFit-{{ section.id }} .alta-fit-card::after { background: rgba(0,107,94,.045); border-radius: 50%; content: ''; height: 150px; pointer-events: none; position: absolute; right: -55px; top: -65px; width: 150px; }
  #AltaeronRightFit-{{ section.id }} .alta-fit-card:hover { border-color: rgba(0,107,94,.3); box-shadow: 0 14px 34px rgba(16,42,67,.08); transform: translateY(-2px); }
  #AltaeronRightFit-{{ section.id }} .alta-fit-card__number { align-items: center; background: var(--alta-fit-accent); border: 3px solid rgba(255,255,255,.92); border-radius: 50%; box-shadow: 0 5px 14px rgba(0,107,94,.16); color: #fff; display: flex; font-size: 20px; font-weight: 750; height: 48px; justify-content: center; line-height: 1; width: 48px; z-index: 1; }
  #AltaeronRightFit-{{ section.id }} .alta-fit-card__copy { min-width: 0; position: relative; z-index: 1; }
  #AltaeronRightFit-{{ section.id }} .alta-fit-card h3 { color: var(--alta-fit-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: 21px; font-weight: 750; letter-spacing: -.02em; line-height: 1.28; margin: 0 0 5px; }
  #AltaeronRightFit-{{ section.id }} .alta-fit-card p { color: var(--alta-fit-body); font-size: 16px; line-height: 1.48; margin: 0; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__callout { background: linear-gradient(90deg, #edf8f7, #e4f4f2, #edf8f7); border: 1px solid rgba(0,107,94,.1); border-radius: 18px; margin-top: 26px; padding: 30px 42px; text-align: center; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__callout h3 { color: var(--alta-fit-accent); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: clamp(24px, 2.4vw, 32px); font-weight: 750; letter-spacing: -.025em; line-height: 1.18; margin: 0; }
  #AltaeronRightFit-{{ section.id }} .alta-fit__callout p { color: #226375; font-size: 18px; line-height: 1.45; margin: 0; }

  @media (max-width: 749px) {
    #AltaeronRightFit-{{ section.id }} { padding: 24px 0 48px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__shell { width: calc(100% - 30px); }
    #AltaeronRightFit-{{ section.id }} .alta-fit__header { margin-bottom: 20px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__eyebrow { font-size: 10px; gap: 9px; letter-spacing: .18em; margin-bottom: 9px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__eyebrow::before,
    #AltaeronRightFit-{{ section.id }} .alta-fit__eyebrow::after { flex-basis: 24px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__heading { font-size: 29px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__subheading { font-size: 15px; line-height: 1.45; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__cards { gap: 14px; grid-template-columns: 1fr; }
    #AltaeronRightFit-{{ section.id }} .alta-fit-card { border-radius: 13px; gap: 14px; min-height: 0; padding: 20px 17px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit-card__number { border-width: 2px; font-size: 16px; height: 40px; width: 40px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit-card h3 { font-size: 18px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit-card p { font-size: 14px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__callout { margin-top: 16px; padding: 22px 18px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__callout h3 { font-size: 20px; }
    #AltaeronRightFit-{{ section.id }} .alta-fit__callout p { font-size: 14px; }
  }
</style>

<section id="AltaeronRightFit-{{ section.id }}" class="alta-fit" aria-labelledby="AltaeronRightFitHeading-{{ section.id }}">
  <div class="alta-fit__shell">
    <header class="alta-fit__header">
      {%- if eyebrow != blank -%}<p class="alta-fit__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
      <h2 id="AltaeronRightFitHeading-{{ section.id }}" class="alta-fit__heading">{{ heading }}</h2>
      {%- if subheading != blank -%}<p class="alta-fit__subheading">{{ subheading | escape }}</p>{%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="alta-fit__cards">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_title = block.settings.title
            assign card_body = block.settings.body
            unless request.locale.iso_code == 'en'
              capture title_key
                echo 'altaeron_pdp_reels_v3.right_fit.card_' | append: forloop.index | append: '_title'
              endcapture
              capture body_key
                echo 'altaeron_pdp_reels_v3.right_fit.card_' | append: forloop.index | append: '_body'
              endcapture
              assign card_title = title_key | t
              assign card_body = body_key | t
            endunless
          -%}
          <article class="alta-fit-card" {{ block.shopify_attributes }}>
            <span class="alta-fit-card__number" aria-hidden="true">{{ forloop.index }}</span>
            <div class="alta-fit-card__copy">
              {%- if card_title != blank -%}<h3>{{ card_title }}</h3>{%- endif -%}
              {%- if card_body != blank -%}<p>{{ card_body | escape }}</p>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_callout -%}
      <aside class="alta-fit__callout">
        {%- if callout_heading != blank -%}<h3>{{ callout_heading | escape }}</h3>{%- endif -%}
        {%- if callout_body != blank -%}<p>{{ callout_body | escape }}</p>{%- endif -%}
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Altaeron: Right Fit",
  "tag": "section",
  "class": "section-altaeron-custom",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIND YOUR RIGHT FIT" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Is Altaeron™ <strong>Right for You?</strong>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The Adjustable Bunion Corrector may be a good fit if:" },
    { "type": "header", "content": "Bottom callout" },
    { "type": "checkbox", "id": "show_callout", "label": "Show callout", "default": true },
    { "type": "text", "id": "callout_heading", "label": "Callout heading", "default": "A more comfortable tomorrow can start today." },
    { "type": "text", "id": "callout_body", "label": "Callout body", "default": "Support your feet. Keep doing what you love." }
  ],
  "blocks": [
    {
      "type": "fit_card",
      "name": "Fit card",
      "limit": 4,
      "settings": [
        { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Fit card title" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Add supporting details for this card." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Altaeron: Right Fit",
      "blocks": [
        { "type": "fit_card", "settings": { "title": "You have a mild to moderate bunion", "body": "and your big toe has started drifting toward the other toes." } },
        { "type": "fit_card", "settings": { "title": "You regularly experience aching, pressure, or discomfort", "body": "that interferes with walking, relaxing, or everyday activities." } },
        { "type": "fit_card", "settings": { "title": "You're looking for a conservative, non-surgical way to manage discomfort at home", "body": "before considering more invasive treatment." } },
        { "type": "fit_card", "settings": { "title": "You want adjustable support rather than a fixed toe spacer", "body": "so you can gradually control the amount of correction and pressure based on your comfort." } }
      ]
    }
  ]
}
{% endschema %}
