<div id="AltaeronPdp-{{ section.id }}" class="altaeron-pdp altaeron-pdp--cro-hero altaeron-pdp--dialfit altaeron-pdp--massager" data-section="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-money-format="{{ shop.money_format | escape }}" data-zoom-close-label="{{ 'altaeron_pdp_massager.close_image_viewer' | t | escape_once }}" data-zoom-previous-label="{{ 'altaeron_pdp_massager.previous_image' | t | escape_once }}" data-zoom-next-label="{{ 'altaeron_pdp_massager.next_image' | t | escape_once }}" data-save-label="{{ 'altaeron_pdp_massager.save' | t | escape_once }}" data-save-template="{{ 'altaeron_pdp_massager.save_amount' | t | escape_once }}" data-add-to-cart-label="{{ cta_label | escape_once }}" data-sold-out-label="{{ 'products.product.sold_out' | t | escape_once }}">
<section class="apdp-hero"><div class="apdp-shell apdp-hero__grid">{% if hero_image != blank or hero_video != blank %}      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="{{ 'altaeron_pdp_massager.product_media' | t | escape_once }}">
          {%- for media in product.media -%}{%- assign media_id_string = media.id | append: '' -%}{%- if media_id_string == section.settings.excluded_media_id -%}{%- continue -%}{%- endif -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage apdp-gallery__hero"{% if hero_poster != blank %} style="--apdp-hero-poster:url('{{ hero_poster }}')"{% endif %}>
          {%- if hero_video != blank -%}
            {%- capture hero_video_markup -%}{{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1200x' }}{%- endcapture -%}
            {{- hero_video_markup | replace: '<video ', '<video data-apdp-hero-video ' -}}
          {%- elsif hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: product.title }}
          {%- else -%}

          {%- endif -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}{%- assign media_id_string = media.id | append: '' -%}{%- if media_id_string == section.settings.excluded_media_id -%}{%- continue -%}{%- endif -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {% render 'altaeron-pdp-media', media: media, product: product, loading: 'lazy', fetchpriority: 'auto', sizes: '(min-width: 1024px) 560px, 100vw' %}
              {%- if media.media_type == 'image' -%}<button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="{{ 'altaeron_pdp_massager.open_product_image' | t | escape_once }}"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>{%- endif -%}
            </div>
          {%- endfor -%}
          <button type="button" class="apdp-gallery__return" data-apdp-return-demo aria-label="{{ 'altaeron_pdp_massager.return_to_product_overview' | t | escape_once }}"><span aria-hidden="true">←</span> {{ 'altaeron_pdp_massager.product_overview' | t | escape_once }}</button>
        </div>
      </div>

{% endif %}
<div class="apdp-narrative"><p class="apdp-eyebrow">{{ product.title | escape }}</p>{% if review_count > 0 %}<a class="apdp-rating" href="#AltaeronVerified-{{ section.id }}">{% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{{ review_rating }} / 5 · {{ review_count }} {{ 'altaeron_pdp_massager.reviews' | t | escape_once }}</strong></a>{% endif %}<h1>{{ massager_headline | escape_once }}</h1><p class="apdp-narrative__subhead">{{ massager_subheadline | escape_once }}</p><ul class="apdp-narrative__benefits" role="list"><li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ 'altaeron_pdp_massager.3_way_relief_compression_heat_vibration' | t | escape_once }}</span></li><li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ 'altaeron_pdp_massager.helps_ease_swelling_stiffness_end_of_day_aching' | t | escape_once }}</span></li><li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ 'altaeron_pdp_massager.5_intensity_levels_from_gentle_comfort_to_deeper_compression' | t | escape_once }}</span></li><li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ 'altaeron_pdp_massager.cordless_15_minute_relief_while_you_sit_work_or_unwind' | t | escape_once }}</span></li></ul></div>
