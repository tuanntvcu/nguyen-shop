  #AltaeronPdp-{{ section.id }} :where(.apdp-narrative__benefits li,.apdp-massager-card h3,.apdp-massager-size-dialog,.apdp-massager-size-dialog h2,.apdp-size-chart thead,.apdp-massager-audience-strip h3,.apdp-massager-audience-strip li,.apdp-massager-bottom__selection){color:var(--altaeron-navy,#102A43)}
  #AltaeronPdp-{{ section.id }} :where(.apdp-massager-review blockquote,.apdp-massager-copy,.apdp-gallery-story__copy,.apdp-gallery-story__consequence,.apdp-size-chart__tip,.apdp-size-chart tbody td,.apdp-massager-story__copy>p:not(.apdp-massager-highlight),.apdp-massager-mechanism__copy>p,.apdp-massager-mechanism__secondary){color:var(--altaeron-body,#344054)}
  #AltaeronPdp-{{ section.id }} :where(.apdp-narrative__benefits svg,.apdp-massager-steps .apdp-massager-card:before,.apdp-gallery-story__result>span:first-child,.apdp-size-chart__toggle button[aria-pressed="true"],.apdp-size-chart__tip strong,.apdp-size-chart__size,.apdp-massager-card-note>span,.apdp-massager-step__number){background:var(--altaeron-primary,#006B5E)}
  #AltaeronPdp-{{ section.id }} :where(.apdp-massager-review blockquote strong,.apdp-massager-size-trigger button,.apdp-gallery-story h2 strong,.apdp-massager-story__copy h2 strong,.apdp-massager-support-states strong,.apdp-massager-benefits small,.apdp-massager-work-audiences,.apdp-massager-audience-strip p,.apdp-massager-guarantee svg,.apdp-massager-gifting svg){color:var(--altaeron-primary,#006B5E)}
  #AltaeronPdp-{{ section.id }} :where(.apdp-massager-review,.apdp-massager-card,.apdp-massager-use-cases article){background:var(--altaeron-off-white,#F8FAF9);border-color:var(--altaeron-border,#E4E7EC)}
  #AltaeronPdp-{{ section.id }} :where(.apdp-massager-highlight,.apdp-gallery-story__result,.apdp-size-chart__tip,.apdp-massager-mechanism__labels span,.apdp-massager-guarantee,.apdp-massager-bottom__summary span){background:var(--altaeron-soft-teal,#EAF5F2);color:var(--altaeron-body,#344054)}
