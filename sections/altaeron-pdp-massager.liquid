{%- liquid
 assign current_variant = product.selected_or_first_available_variant
 assign current_compare = current_variant.compare_at_price | default: 0
 assign sticky_image = blank
 for media in product.media
   assign media_id_string = media.id | append: ''
   if media_id_string == section.settings.excluded_media_id
     continue
   endif
   assign sticky_image = media.preview_image
   break
 endfor
 assign product_form_id = 'product-form-' | append: section.id
 assign massager_headline = section.settings.headline
 if massager_headline == blank or massager_headline == 'Heavy, Swollen Feet? Give Them 15 Minutes.'
   assign massager_headline = 'altaeron_pdp_massager.heavy_swollen_feet_give_them_15_minutes' | t
 endif
 assign massager_subheadline = section.settings.subheadline
 if massager_subheadline == blank or massager_subheadline == 'Air compression, warming heat and vibration surround tired feet and ankles to ease aching pressure, loosen tightness and help that heavy, puffy feeling melt away.'
   assign massager_subheadline = 'altaeron_pdp_massager.air_compression_warming_heat_and_vibration_surround_tired_feet_an' | t
 endif
 assign cta_label = section.settings.cta_label
 if cta_label == blank or cta_label == 'GET MY AIRRELIEF'
   assign cta_label = 'altaeron_pdp_massager.get_my_airrelief' | t
 endif
 assign massager_medical_body = section.settings.medical_body
 if massager_medical_body == blank or massager_medical_body == 'Combining rhythmic compression, warmth and vibration can provide a practical way to relax tired feet and ankles after prolonged standing, walking or physical activity. Adjustable intensity is particularly useful because comfort and pressure tolerance can vary significantly from person to person.'
   assign massager_medical_body = 'altaeron_pdp_massager.combining_rhythmic_compression_warmth_and_vibration_can_provide_a' | t
 endif
 assign hero_image = section.settings.hero_image
 if hero_image == blank
   for candidate in product.media
     assign candidate_id = candidate.id | append: ''
     if candidate_id != section.settings.excluded_media_id
       assign hero_image = candidate.preview_image
       break
     endif
   endfor
 endif
 assign hero_video = section.settings.hero_video
 if hero_video == blank and section.settings.preview_hero_video
   assign hero_video = product.metafields.altaeron.massager_preview_hero_video.value
 endif
 if hero_video != blank
   assign hero_poster = hero_video.preview_image | image_url: width: 1200
 endif
 assign review_data = product.metafields.judgeme.review_widget_data.value
 assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
 assign review_rating = review_data.average_rating | default: 0 | plus: 0
-%}
