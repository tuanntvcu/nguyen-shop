<style>
  #AltaeronTimeline-{{ section.id }} {
    --alta-timeline-ink: var(--altaeron-navy, #102a43);
    --alta-timeline-body: var(--altaeron-body, #344054);
    --alta-timeline-accent: var(--altaeron-primary, #006b5e);
    --alta-timeline-line: var(--altaeron-border, #e4e7ec);
    background: #fff;
    color: var(--alta-timeline-body);
    padding: 36px 0 80px;
  }
  #AltaeronTimeline-{{ section.id }} * { box-sizing: border-box; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__shell { margin-inline: auto; width: min(1360px, calc(100% - 80px)); }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__header { margin-bottom: 24px; max-width: 1120px; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__eyebrow { align-items: center; color: var(--alta-timeline-accent); display: flex; font-size: 12px; font-weight: 750; gap: 12px; letter-spacing: .24em; line-height: 1.3; margin: 0 0 10px; text-transform: uppercase; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__eyebrow::before { background: currentColor; content: ''; flex: 0 0 40px; height: 3px; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__heading { color: var(--alta-timeline-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: clamp(30px, 3vw, 46px); font-weight: 750; letter-spacing: -.035em; line-height: 1.08; margin: 0; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__subheading { color: var(--alta-timeline-body); font-size: clamp(16px, 1.5vw, 21px); line-height: 1.5; margin: 10px 0 0; max-width: 1050px; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__stages { counter-reset: alta-stage; display: grid; gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card { background: #fff; border: 1px solid var(--alta-timeline-line); border-radius: 16px; min-width: 0; overflow: visible; position: relative; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card:not(:last-child)::after { align-items: center; background: #fff; border: 1px solid #d8e2e4; border-radius: 50%; color: #577286; content: '›'; display: flex; font-family: Arial, sans-serif; font-size: 34px; font-weight: 400; height: 48px; justify-content: center; line-height: 1; position: absolute; right: -34px; top: calc(50% - 24px); width: 48px; z-index: 2; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card__copy { min-height: 176px; padding: 20px 22px 22px; text-align: center; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card__label { background: #edf2f6; border-radius: 999px; color: #274b64; display: inline-block; font-size: 12px; font-weight: 750; letter-spacing: .16em; line-height: 1.2; margin: 0 0 10px; padding: 6px 18px; text-transform: uppercase; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card h3 { color: var(--alta-timeline-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: 28px; font-weight: 750; letter-spacing: -.025em; line-height: 1.1; margin: 0 0 7px; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card__body { color: var(--alta-timeline-body); font-size: 16px; line-height: 1.4; margin: 0 auto; max-width: 330px; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card__media { aspect-ratio: 4 / 3; background: #eef2f3; border-radius: 0 0 15px 15px; overflow: hidden; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline-card__media :is(img, video, svg) { display: block; height: 100%; object-fit: cover; width: 100%; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance { align-items: center; background: linear-gradient(90deg, #edf8f7, #e4f4f2, #edf8f7); border-radius: 13px; color: #0b6270; display: grid; gap: 2px 18px; grid-template-columns: auto auto; justify-content: center; margin-top: 20px; min-height: 78px; padding: 14px 22px; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance svg { grid-row: 1 / 3; height: 34px; stroke-width: 1.7; width: 34px; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance strong { color: #0b5663; font-size: 18px; line-height: 1.25; }
  #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance span { color: #226375; font-size: 15px; line-height: 1.35; }
  @media (max-width: 749px) {
    #AltaeronTimeline-{{ section.id }} { padding: 24px 0 56px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__shell { width: calc(100% - 30px); }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__header { margin-bottom: 18px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__eyebrow { font-size: 10px; gap: 9px; letter-spacing: .2em; margin-bottom: 8px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__eyebrow::before { flex-basis: 28px; height: 2px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__heading { font-size: 29px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__subheading { font-size: 15px; line-height: 1.45; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__stages { gap: 12px; grid-template-columns: 1fr; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card { border-radius: 13px; display: grid; grid-template-columns: minmax(132px, 42%) 1fr; overflow: hidden; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card:not(:last-child)::after { display: none; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card__copy { align-self: center; min-height: 0; padding: 16px 12px; text-align: left; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card__label { font-size: 9px; letter-spacing: .11em; margin-bottom: 7px; padding: 5px 9px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card h3 { font-size: 22px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card__body { font-size: 13px; margin: 0; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card__media { aspect-ratio: auto; border-radius: 0; grid-column: 1; grid-row: 1; min-height: 174px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline-card__copy { grid-column: 2; grid-row: 1; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance { gap: 3px 11px; grid-template-columns: auto 1fr; margin-top: 14px; min-height: 72px; padding: 13px 15px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance svg { height: 28px; width: 28px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance strong { font-size: 14px; }
    #AltaeronTimeline-{{ section.id }} .alta-timeline__reassurance span { font-size: 12px; }
  }
</style>

<section id="AltaeronTimeline-{{ section.id }}" class="alta-support-timeline" aria-labelledby="AltaeronTimelineHeading-{{ section.id }}">
  <div class="alta-timeline__shell">
    <header class="alta-timeline__header">
      {%- if section.settings.eyebrow != blank -%}<p class="alta-timeline__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="AltaeronTimelineHeading-{{ section.id }}" class="alta-timeline__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="alta-timeline__subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="alta-timeline__stages">
        {%- for block in section.blocks -%}
          {%- assign stage_alt = block.settings.image.alt | default: block.settings.title -%}
          <article class="alta-timeline-card" {{ block.shopify_attributes }}>
            <div class="alta-timeline-card__copy">
              <p class="alta-timeline-card__label">{{ block.settings.label | escape }}</p>
              <h3>{{ block.settings.title | escape }}</h3>
              <p class="alta-timeline-card__body">{{ block.settings.body | escape }}</p>
            </div>
            <div class="alta-timeline-card__media">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1000x' }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '260, 400, 560, 760, 1000', sizes: '(min-width: 750px) 32vw, 42vw', alt: stage_alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.reassurance_heading != blank or section.settings.reassurance_text != blank -%}
      <div class="alta-timeline__reassurance">
        <svg aria-hidden="true" viewBox="0 0 32 32" fill="none" stroke="currentColor"><rect x="4.5" y="7.5" width="23" height="20" rx="2"/><path d="M10 4v7M22 4v7M4.5 13h23M9 18h3M15 18h3M21 18h3M9 23h3M15 23h3M21 23h3"/></svg>
        {%- if section.settings.reassurance_heading != blank -%}<strong>{{ section.settings.reassurance_heading | escape }}</strong>{%- endif -%}
        {%- if section.settings.reassurance_text != blank -%}<span>{{ section.settings.reassurance_text | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Altaeron: Timeline",
  "tag": "section",
  "class": "section-altaeron-custom",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT TO EXPECT OVER TIME" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What consistent support can look like over time." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Altaeron is designed to move from comfortable relief toward regular alignment support as part of your routine." },
    { "type": "text", "id": "reassurance_heading", "label": "Reassurance heading", "default": "Consistency matters more than force." },
    { "type": "text", "id": "reassurance_text", "label": "Reassurance secondary text", "default": "Start gently. Adjust gradually. Use regularly." }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Timeline stage",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Stage label", "default": "STAGE" },
        { "type": "text", "id": "title", "label": "Title", "default": "Stage title" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Short stage explanation." },
        { "type": "video", "id": "video", "label": "Video", "info": "Video is shown instead of the image when both are selected." },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{
    "name": "Altaeron: Timeline",
    "blocks": [
      { "type": "stage", "settings": { "label": "FIRST FEW WEARS", "title": "Relieve", "body": "Ease pressure, crowding & rubbing while worn." } },
      { "type": "stage", "settings": { "label": "WEEKS 1–2", "title": "Realign", "body": "Support a straighter big-toe position with regular sessions." } },
      { "type": "stage", "settings": { "label": "CONTINUED USE", "title": "Reinforce", "body": "Encourage more balanced positioning over time." } }
    ]
  }]
}
{% endschema %}
