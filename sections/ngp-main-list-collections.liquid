          "value": "alphabetical",
          "label": "t:sections.ngp-main-list-collections.settings.sort.options__1.label"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.ngp-main-list-collections.settings.sort.options__2.label"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.ngp-main-list-collections.settings.sort.options__3.label"
        },
        {
          "value": "date",
          "label": "t:sections.ngp-main-list-collections.settings.sort.options__4.label"
        },
        {
          "value": "products_high",
          "label": "t:sections.ngp-main-list-collections.settings.sort.options__5.label"
        },
        {
          "value": "products_low",
          "label": "t:sections.ngp-main-list-collections.settings.sort.options__6.label"
        }
      ],
      "default": "alphabetical",
      "label": "t:sections.ngp-main-list-collections.settings.sort.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_header.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.ngp-main-list-collections.settings.title.label",
