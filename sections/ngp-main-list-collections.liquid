{{ 'ngp-component-collection-card.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign collections = collections
  case section.settings.sort
    when 'products_high', 'products_low'
      assign collections = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign collections = collections | sort: 'published_at'
  endcase

  if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
    assign collections = collections | reverse
  endif

  assign ngp_modulo_result = 28 | modulo: section.settings.columns_desktop
  assign ngp_paginate_by = 30
  if ngp_modulo_result == 0
    assign ngp_paginate_by = 28
  endif

  assign ngp_columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign ngp_columns_desktop = section.settings.columns_desktop
  assign ngp_columns_tablet = ngp_columns_desktop
  if ngp_columns_desktop > 3
    assign ngp_columns_tablet = ngp_columns_desktop | divided_by: 2.0 | ceil
  endif

  assign ngp_card_has_bg = false
  assign ngp_default_color_scheme = settings.color_schemes | first
  if ngp_default_color_scheme != settings.collection_card_color_scheme
    assign ngp_card_has_bg = true
  endif

  assign ngp_header_alignment = settings.section_header_alignment
  assign ngp_header_alignment_mobile = settings.section_header_alignment_mobile
  if ngp_header_alignment_mobile == 'inherit'
    assign ngp_header_alignment_mobile = ngp_header_alignment
  endif
-%}
{%- capture ngp_image_sizes -%}
(max-width: 767px) calc((100vw - 3rem) / {{ ngp_columns_mobile_int }}), (max-width: 1023px) calc((100vw - 3rem) / {{ ngp_columns_tablet }}), calc(min(100vw, {{ settings.page_width }}px) / {{ ngp_columns_desktop }} )
{%- endcapture -%}
<div
  class="ngp-section ngp-section-{{ section.id }} ngp-section--padding ngp-collection-list-template"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ngp-page-width">
    {%- if section.settings.title != blank -%}
      <div class="ngp-section__header ngp-spacing--large ngp-md:ngp-text-{{ ngp_header_alignment }} ngp-text-{{ ngp_header_alignment_mobile }}">
        <h1 class="ngp-inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h1>
      </div>
    {%- endif -%}
    {%- paginate collections by ngp_paginate_by -%}
      <ngp-grid-list class="ngp-collection-list__items ngp-f-grid ngp-f-grid-{{ ngp_columns_mobile_int }}-cols ngp-md:ngp-f-grid-{{ ngp_columns_tablet }}-cols ngp-lg:ngp-f-grid-{{ ngp_columns_desktop }}-cols ngp-f-grid--gap-{{ section.settings.column_gap }}">
        {%- for ngp_collection in collections -%}
          <div class="ngp-f-column">
            {% render 'ngp-card-collection',
              collection: ngp_collection,
              has_bg: ngp_card_has_bg,
              ngp_image_sizes: ngp_image_sizes,
              image_ratio: section.settings.card_image_ratio
            %}
          </div>
        {%- endfor -%}
      </ngp-grid-list>
      {% render 'ngp-pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>
{% schema %}
{
  "name": "t:sections.ngp-main-list-collections.name",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general.name"
