{{ 'altaeron-reels-v3-reasons.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reasons_eyebrow = section.settings.eyebrow
  assign reasons_heading = section.settings.heading
  if request.locale.iso_code != 'en'
    assign localized_eyebrow = 'altaeron_pdp_reasons.eyebrow' | t
    assign localized_heading = 'altaeron_pdp_reasons.heading' | t
    unless localized_heading contains 'Translation missing:'
      assign reasons_eyebrow = localized_eyebrow
      assign reasons_heading = localized_heading
    endunless
  endif
-%}

<section
  id="AltaeronReasons-{{ section.id }}"
  class="altaeron-reels-v3-reasons"
  aria-labelledby="AltaeronReasonsHeading-{{ section.id }}"
>
  <div class="altaeron-reels-v3-reasons__shell">
    {% if reasons_eyebrow != blank %}
      <p class="altaeron-reels-v3-reasons__eyebrow">{{ reasons_eyebrow | escape }}</p>
    {% endif %}
    <h2 id="AltaeronReasonsHeading-{{ section.id }}" class="altaeron-reels-v3-reasons__heading">
      {{ reasons_heading | escape }}
    </h2>
    {% if section.blocks.size > 0 %}
      <div class="altaeron-reels-v3-reasons__grid">
        {% for block in section.blocks %}
          <article class="altaeron-reels-v3-reasons__point" {{ block.shopify_attributes }}>
            <span class="altaeron-reels-v3-reasons__icon" aria-hidden="true">
              {% case forloop.index %}
                {% when 1 %}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M8 29.5c4.7-1.1 7.3-5 9.7-10.2l3.1-6.7c.6-1.3 2.5-.9 2.5.5v8.7l7.3 2.1c4.9 1.4 8.3 5.9 8.3 11v2.6H12.6A5.6 5.6 0 0 1 7 32c0-1.2.3-2 1-2.5Z"/><path d="m17.5 12-2.1-2.1M12.7 18.5H9.8M22.5 7.8V5"/></svg>
                {% when 2 %}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M24 5 39 11v11c0 9.2-6.2 16.4-15 21-8.8-4.6-15-11.8-15-21V11l15-6Z"/><path d="M18.5 25.5c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6-2.5 6.5-5.5 9c-3-2.5-5.5-5.5-5.5-9Z"/><path d="M24 22v5"/></svg>
                {% when 3 %}
                  <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="18"/><path d="m15 33 18-18M17 15l16 18"/><path d="m14 34-2 3m21-22 3-2"/></svg>
                {% when 4 %}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M17 5v11l-4 5v7l4 5v10M31 5v11l4 5v7l-4 5v10"/><circle cx="24" cy="24.5" r="5.5"/><path d="M9 20h5m-7 5h6m-5 5h5m21-10h5m-4 5h6m-7 5h5"/></svg>
                {% when 5 %}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M8 13h32M8 24h32M8 35h32"/><circle cx="18" cy="13" r="3.5"/><circle cx="30" cy="24" r="3.5"/><circle cx="21" cy="35" r="3.5"/></svg>
                {% when 6 %}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M15 39v-4c0-5 4-8 9-8s9 3 9 8v4H15Z"/><path d="M17 17a7 7 0 0 1 14 0v3a7 7 0 0 1-14 0v-3Z"/><path d="m17 31 7 5 7-5M12 39v-3a5 5 0 0 1 4-5m20 8v-3a5 5 0 0 0-4-5"/><circle cx="13" cy="20" r="3"/><circle cx="35" cy="20" r="3"/></svg>
                {% when 7 %}
                  <svg viewBox="0 0 48 48" fill="none"><rect x="21" y="8" width="17" height="17" rx="3"/><path d="M26 8V5h7v3M5 29h7l5 4h12a3 3 0 0 1 0 6H17l-5-3H5v-7Z"/><path d="M12 30c4-3 7-4 10-4h5a3 3 0 0 1 0 6h-5"/></svg>
                {% when 8 %}
                  <svg viewBox="0 0 48 48" fill="none"><path d="M24 5 39 11v11c0 9.2-6.2 16.4-15 21-8.8-4.6-15-11.8-15-21V11l15-6Z"/><path d="m16.5 24 5 5 10-11"/></svg>
              {% endcase %}
            </span>
            <div class="altaeron-reels-v3-reasons__copy">
              {% if request.locale.iso_code == 'en' %}
                {{ block.settings.content }}
              {% else %}
                {%- capture point_key -%}altaeron_pdp_reasons.point_{{ forloop.index }}{%- endcapture -%}
                {%- assign localized_point = point_key | t | replace: '&lt;', '<' | replace: '&gt;', '>' -%}
                {% if localized_point contains 'Translation missing:' %}
                  {{ block.settings.content }}
                {% else %}
                  {{ localized_point }}
                {% endif %}
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Altaeron: 8 reasons",
  "tag": "section",
  "class": "section-altaeron-reels-v3-reasons",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BENEFITS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "8 Reasons Why You Will Love It" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Benefit point",
      "limit": 8,
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p><strong>Benefit</strong> description.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Altaeron: 8 reasons" }]
}
{% endschema %}
