{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign reassurance = section.settings.reassurance
  unless request.locale.iso_code == 'en'
    assign eyebrow = 'altaeron_pdp_reels_v3.adjustable.eyebrow' | t
    assign heading = 'altaeron_pdp_reels_v3.adjustable.heading' | t
    assign subheading = 'altaeron_pdp_reels_v3.adjustable.subheading' | t
    assign reassurance = 'altaeron_pdp_reels_v3.adjustable.reassurance' | t
  endunless
-%}

<style>
  #AltaeronAdjustable-{{ section.id }} {
    --alta-custom-ink: var(--altaeron-navy, #102a43);
    --alta-custom-body: var(--altaeron-body, #344054);
    --alta-custom-accent: var(--altaeron-primary, #006b5e);
    --alta-custom-line: var(--altaeron-border, #e4e7ec);
    background: #fff;
    color: var(--alta-custom-body);
    padding: 36px 0 72px;
  }
  #AltaeronAdjustable-{{ section.id }} * { box-sizing: border-box; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__shell { margin-inline: auto; width: min(1360px, calc(100% - 80px)); }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__header { margin-bottom: 24px; max-width: 1120px; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__eyebrow { align-items: center; color: var(--alta-custom-accent); display: flex; font-size: 12px; font-weight: 750; gap: 12px; letter-spacing: .24em; line-height: 1.3; margin: 0 0 10px; text-transform: uppercase; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__eyebrow::before { background: currentColor; content: ''; flex: 0 0 40px; height: 3px; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__heading { color: var(--alta-custom-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: clamp(30px, 3vw, 46px); font-weight: 750; letter-spacing: -.035em; line-height: 1.08; margin: 0; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__subheading { color: var(--alta-custom-body); font-size: clamp(16px, 1.5vw, 21px); line-height: 1.5; margin: 10px 0 0; max-width: 1050px; }
  #AltaeronAdjustable-{{ section.id }} .alta-adjustable__hero { background: #eef2f3; border: 1px solid var(--alta-custom-line); border-radius: 18px; overflow: hidden; }
  #AltaeronAdjustable-{{ section.id }} .alta-adjustable__hero :is(img, svg) { display: block; height: auto; width: 100%; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom-card__media :is(img, svg) { display: block; height: 100%; object-fit: cover; width: 100%; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__cards { display: grid; gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 20px; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom-card { background: #fff; border: 1px solid var(--alta-custom-line); border-radius: 15px; min-width: 0; overflow: hidden; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom-card__media { aspect-ratio: 16 / 8.4; background: #eef2f3; overflow: hidden; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom-card__copy { padding: 18px 20px 22px; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom-card h3 { color: var(--alta-custom-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: 19px; font-weight: 750; letter-spacing: -.02em; line-height: 1.25; margin: 0 0 5px; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom-card p { color: var(--alta-custom-body); font-size: 15px; line-height: 1.45; margin: 0; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__reassurance { align-items: center; background: linear-gradient(90deg, #edf8f7, #e4f4f2, #edf8f7); border-radius: 13px; color: #0b6270; display: flex; font-size: 17px; font-weight: 650; gap: 16px; justify-content: center; line-height: 1.4; margin: 20px 0 0; min-height: 66px; padding: 14px 22px; text-align: center; }
  #AltaeronAdjustable-{{ section.id }} .alta-custom__reassurance svg { flex: 0 0 31px; height: 31px; stroke-width: 1.7; width: 31px; }
  @media (min-width: 750px) {
    #AltaeronAdjustable-{{ section.id }} { padding: 40px 0 clamp(64px, 6vw, 88px); }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__shell { width: min(1240px, calc(100% - 48px)); }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__header { margin-bottom: 32px; max-width: 850px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__subheading { max-width: 780px; }
    #AltaeronAdjustable-{{ section.id }} .alta-adjustable__hero { box-shadow: 0 18px 50px rgba(16,42,67,.06); }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__cards { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card { transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card:hover { border-color: rgba(0,107,94,.3); box-shadow: 0 14px 34px rgba(16,42,67,.08); transform: translateY(-2px); }
  }
  @media (min-width: 1100px) {
    #AltaeronAdjustable-{{ section.id }} .alta-custom__shell { width: min(1240px, calc(100% - 80px)); }
    #AltaeronAdjustable-{{ section.id }} .alta-adjustable__hero { max-height: 560px; }
    #AltaeronAdjustable-{{ section.id }} .alta-adjustable__hero :is(img, svg) { height: 100%; max-height: 560px; object-fit: cover; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card__media { aspect-ratio: 16 / 8; }
  }
  @media (max-width: 749px) {
    #AltaeronAdjustable-{{ section.id }} { padding: 24px 0 48px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__shell { width: calc(100% - 30px); }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__header { margin-bottom: 18px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__eyebrow { font-size: 10px; gap: 9px; letter-spacing: .2em; margin-bottom: 8px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__eyebrow::before { flex-basis: 28px; height: 2px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__heading { font-size: 29px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__subheading { font-size: 15px; line-height: 1.45; }
    #AltaeronAdjustable-{{ section.id }} .alta-adjustable__hero { border-radius: 13px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__cards { gap: 12px; grid-template-columns: 1fr; margin-top: 14px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card { border-radius: 12px; display: grid; grid-template-columns: minmax(120px, 42%) 1fr; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card__media { aspect-ratio: auto; min-height: 132px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card__copy { align-self: center; padding: 16px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card h3 { font-size: 16px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom-card p { font-size: 13px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__reassurance { font-size: 14px; gap: 10px; margin-top: 14px; min-height: 58px; padding: 12px 14px; }
    #AltaeronAdjustable-{{ section.id }} .alta-custom__reassurance svg { flex-basis: 26px; height: 26px; width: 26px; }
  }
  {%- if template.suffix == 'altaeron-reels-v3' -%}
    {% render 'altaeron-reels-v3-responsive-section', section_kind: 'adjustable', section_id: section.id %}
  {%- endif -%}
</style>

<section id="AltaeronAdjustable-{{ section.id }}" class="alta-custom alta-adjustable" aria-labelledby="AltaeronAdjustableHeading-{{ section.id }}">
  <div class="alta-custom__shell">
    <header class="alta-custom__header">
      {%- if eyebrow != blank -%}<p class="alta-custom__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
      <h2 id="AltaeronAdjustableHeading-{{ section.id }}" class="alta-custom__heading">{{ heading | escape }}</h2>
      {%- if subheading != blank -%}<p class="alta-custom__subheading">{{ subheading | escape }}</p>{%- endif -%}
    </header>

    {%- assign hero_alt = section.settings.hero_image.alt | default: heading -%}
    <div class="alta-adjustable__hero">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1440px) 1360px, (min-width: 750px) calc(100vw - 80px), calc(100vw - 30px)', alt: hero_alt }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="alta-custom__cards">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_title = block.settings.title
            assign block_body = block.settings.body
            unless request.locale.iso_code == 'en'
              capture title_key
                echo 'altaeron_pdp_reels_v3.adjustable.benefit_' | append: forloop.index | append: '_title'
              endcapture
              capture body_key
                echo 'altaeron_pdp_reels_v3.adjustable.benefit_' | append: forloop.index | append: '_body'
              endcapture
              assign block_title = title_key | t
              assign block_body = body_key | t
            endunless
            assign image_alt = block.settings.image.alt | default: block_title
          -%}
          <article class="alta-custom-card" {{ block.shopify_attributes }}>
            <div class="alta-custom-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 520, 700, 900', sizes: '(min-width: 750px) 32vw, 42vw', alt: image_alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="alta-custom-card__copy"><h3>{{ block_title | escape }}</h3><p>{{ block_body | escape }}</p></div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if reassurance != blank -%}
      <p class="alta-custom__reassurance">
        <svg aria-hidden="true" viewBox="0 0 32 32" fill="none" stroke="currentColor"><path d="M16 27.3 5.1 16.8C-1 10.8 2.7 3.8 9 3.8c3.2 0 5.3 1.8 7 4.1 1.7-2.3 3.8-4.1 7-4.1 6.3 0 10 7 3.9 13L16 27.3Z"/></svg>
        <span>{{ reassurance | escape }}</span>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Altaeron: Adjustable",
  "tag": "section",
  "class": "section-altaeron-custom",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ADJUSTABLE SUPPORT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every bunion feels different. Your support should too." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Unlike fixed spacers, Altaeron lets you choose the level of support that feels right for your foot." },
    { "type": "image_picker", "id": "hero_image", "label": "Large adjustment image" },
    { "type": "text", "id": "reassurance", "label": "Reassurance", "default": "Your foot sets the pace — not the device." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Short benefit explanation." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{
    "name": "Altaeron: Adjustable",
    "blocks": [
      { "type": "benefit", "settings": { "title": "You Control the Support", "body": "Adjust to your comfort." } },
      { "type": "benefit", "settings": { "title": "Start Gentle", "body": "Begin light. Increase gradually." } },
      { "type": "benefit", "settings": { "title": "No Fixed-Tension Guesswork", "body": "Find the level that suits your foot." } }
    ]
  }]
}
{% endschema %}
