{%- liquid
 assign current_variant = product.selected_or_first_available_variant
 assign ngp_current_compare = current_variant.compare_at_price | default: 0
 assign ngp_sticky_image = blank
 for media in product.media
   assign ngp_media_id_string = media.id | append: ''
   if ngp_media_id_string == section.settings.excluded_media_id
     continue
   endif
   assign ngp_sticky_image = media.preview_image
   break
 endfor
 assign ngp_product_form_id = 'product-form-' | append: section.id
 assign ngp_massager_headline = section.settings.headline
 if ngp_massager_headline == blank or ngp_massager_headline == 'Heavy, Swollen Feet? Give Them 15 Minutes.'
   assign ngp_massager_headline = 'altaeron_pdp_massager.heavy_swollen_feet_give_them_15_minutes' | t
 endif
 assign ngp_massager_subheadline = section.settings.subheadline
 if ngp_massager_subheadline == blank or ngp_massager_subheadline == 'Air compression, warming heat and vibration surround tired feet and ankles to ease aching pressure, loosen tightness and help that heavy, puffy feeling melt away.'
   assign ngp_massager_subheadline = 'altaeron_pdp_massager.air_compression_warming_heat_and_vibration_surround_tired_feet_an' | t
 endif
 assign ngp_cta_label = section.settings.cta_label
 if ngp_cta_label == blank or ngp_cta_label == 'GET MY AIRRELIEF'
   assign ngp_cta_label = 'altaeron_pdp_massager.get_my_airrelief' | t
 endif
 assign ngp_expert_image = section.settings.reviewer_portrait
 assign ngp_expert_fallback_alt = 'altaeron_pdp.accessibility.expert_portrait' | t
 assign ngp_expert_alt = ngp_expert_image.alt | default: ngp_expert_fallback_alt
 assign ngp_medical_heading_id = 'AltaeronExpertTitle-' | append: section.id
 assign ngp_hero_image = section.settings.hero_image
 if ngp_hero_image == blank
   for ngp_candidate in product.media
     assign ngp_candidate_id = ngp_candidate.id | append: ''
     if ngp_candidate_id != section.settings.excluded_media_id
       assign ngp_hero_image = ngp_candidate.preview_image
       break
     endif
   endfor
 endif
 assign ngp_hero_video = section.settings.hero_video | default: product.metafields.altaeron.pdp_hero_video.value
 if ngp_hero_video == blank and section.settings.preview_hero_video
   assign ngp_hero_video = product.metafields.altaeron.massager_preview_hero_video.value
 endif
 assign ngp_review_data = product.metafields.judgeme.review_widget_data.value
 assign ngp_review_count = ngp_review_data.number_of_reviews | default: 0 | plus: 0
 assign ngp_review_rating = ngp_review_data.average_rating | default: 0 | plus: 0
 assign ngp_atf_review_body = section.settings.review_body | strip
 assign ngp_atf_reviewer_name = section.settings.review_name | strip
 assign ngp_atf_review_title = section.settings.review_title | strip
 assign ngp_atf_review_close = section.settings.review_close | strip
 assign ngp_atf_review_rating = section.settings.review_rating
 assign ngp_atf_reviewer_initial = ngp_atf_reviewer_name | slice: 0 | upcase
-%}
<script src="{{ 'ngp-altaeron-pdp-massager.js' | asset_url }}" defer></script>


