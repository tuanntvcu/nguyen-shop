{%- liquid
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign reviews = review_data.reviews
  assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
  assign review_rating = review_data.average_rating | default: 0 | plus: 0
  assign review_rating_display = review_rating | times: 10 | floor | divided_by: 10.0
  assign reviews_title = 'altaeron_pdp_reels_v2.reviews.full_title' | t
  assign reviews_subtitle = 'altaeron_pdp_reels_v2.reviews.full_subtitle' | t: rating: review_rating_display, count: review_count
  assign faq_title = 'altaeron_pdp_reels_v3.faq.title' | t
  assign faq_subtitle = 'altaeron_pdp_reels_v3.faq.subtitle' | t
  assign has_legacy_judgeme_widget = false
  if product.metafields.judgeme.widget.size > 20
    assign has_legacy_judgeme_widget = true
  endif
-%}

{{ 'altaeron-pdp.css' | asset_url | stylesheet_tag }}

<style>
  #AltaeronV3Tail-{{ section.id }} {
    --alta-custom-accent: #0d7466;
    --alta-custom-body: #43566a;
    --alta-custom-ink: #102a43;
    background: #fff;
  }
  #AltaeronV3Tail-{{ section.id }} .alta-v3-tail__section { padding: 76px 0; }
  #AltaeronV3Tail-{{ section.id }} .alta-v3-tail__section + .alta-v3-tail__section { border-top: 1px solid #e4e7ec; }
  #AltaeronV3Tail-{{ section.id }} .alta-v3-tail__section--reviews { background: #f7faf8; }
  #AltaeronV3Tail-{{ section.id }} .alta-v3-tail__shell { margin-inline: auto; width: min(1360px, calc(100% - 80px)); }
  #AltaeronV3Tail-{{ section.id }} .alta-custom__header { margin-bottom: 28px; max-width: 1080px; }
  #AltaeronV3Tail-{{ section.id }} .alta-custom__eyebrow { align-items: center; color: var(--alta-custom-accent); display: flex; font-size: 12px; font-weight: 750; gap: 12px; letter-spacing: .24em; line-height: 1.3; margin: 0 0 10px; text-transform: uppercase; }
  #AltaeronV3Tail-{{ section.id }} .alta-custom__eyebrow::before { background: currentColor; content: ''; flex: 0 0 40px; height: 3px; }
  #AltaeronV3Tail-{{ section.id }} .alta-custom__heading { color: var(--alta-custom-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: clamp(30px, 3vw, 46px); font-weight: 750; letter-spacing: -.035em; line-height: 1.08; margin: 0; }
  #AltaeronV3Tail-{{ section.id }} .alta-custom__subheading { color: var(--alta-custom-body); font-size: clamp(16px, 1.5vw, 21px); line-height: 1.5; margin: 10px 0 0; max-width: 1050px; }
  #AltaeronV3Tail-{{ section.id }} .apdp-review-summary { margin-top: 0; }
  #AltaeronV3Tail-{{ section.id }} .apdp-judgeme-widget { margin-top: 0; }
  #AltaeronV3Tail-{{ section.id }} .apdp-tail-accordion { background: #fff; }

  @media (max-width: 749px) {
    #AltaeronV3Tail-{{ section.id }} .alta-v3-tail__section { padding: 50px 0; }
    #AltaeronV3Tail-{{ section.id }} .alta-v3-tail__shell { width: calc(100% - 30px); }
    #AltaeronV3Tail-{{ section.id }} .alta-custom__header { margin-bottom: 20px; }
    #AltaeronV3Tail-{{ section.id }} .alta-custom__eyebrow { font-size: 10px; gap: 9px; letter-spacing: .2em; margin-bottom: 8px; }
    #AltaeronV3Tail-{{ section.id }} .alta-custom__eyebrow::before { flex-basis: 28px; height: 2px; }
    #AltaeronV3Tail-{{ section.id }} .alta-custom__heading { font-size: 29px; }
    #AltaeronV3Tail-{{ section.id }} .alta-custom__subheading { font-size: 15px; line-height: 1.45; }
  }
</style>

<div id="AltaeronV3Tail-{{ section.id }}" class="altaeron-pdp alta-v3-tail">
  <section id="AltaeronV3Reviews" class="alta-v3-tail__section alta-v3-tail__section--reviews" aria-labelledby="AltaeronV3ReviewsHeading-{{ section.id }}" data-apdp-review-slider-group>
    <div class="alta-v3-tail__shell apdp-review-summary">
      <header class="alta-custom__header">
        <p class="alta-custom__eyebrow">Customer reviews</p>
        <h2 id="AltaeronV3ReviewsHeading-{{ section.id }}" class="alta-custom__heading">{{ reviews_title }}</h2>
        <p class="alta-custom__subheading">{{ reviews_subtitle }}</p>
      </header>
      <div class="apdp-judgeme-widget">
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false" data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">{%- if has_legacy_judgeme_widget -%}<div class="jdgm-legacy-widget-content" style="display:none">{{ product.metafields.judgeme.widget }}</div>{%- endif -%}</div>
        {%- if product.metafields.judgeme.review_widget_data -%}<script>window.jdgm=window.jdgm||{};window.jdgm.data=window.jdgm.data||{};window.jdgm.data.reviewWidget=window.jdgm.data.reviewWidget||{};window.jdgm.data.reviewWidget[{{ product.id | json }}]={{ product.metafields.judgeme.review_widget_data }};</script>{%- endif -%}
        <noscript><div class="apdp-tail-review-viewport"><div class="apdp-tail-review-grid">{% render 'altaeron-pdp-review-cards', reviews: reviews, limit: 10 %}</div></div></noscript>
      </div>
    </div>
  </section>

  <section class="alta-v3-tail__section" aria-labelledby="AltaeronV3FaqHeading-{{ section.id }}">
    <div class="alta-v3-tail__shell">
      <header class="alta-custom__header">
        <p class="alta-custom__eyebrow">FAQ</p>
        <h2 id="AltaeronV3FaqHeading-{{ section.id }}" class="alta-custom__heading">{{ faq_title }}</h2>
        <p class="alta-custom__subheading">{{ faq_subtitle }}</p>
      </header>
      <div class="apdp-tail-accordion">
        {%- for faq_index in (1..7) -%}
          {%- capture question_key -%}altaeron_pdp_reels_v3.faq.question_{{ faq_index }}{%- endcapture -%}
          {%- capture answer_key -%}altaeron_pdp_reels_v3.faq.answer_{{ faq_index }}{%- endcapture -%}
          <details><summary>{{ question_key | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ answer_key | t }}</p></details>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Altaeron: Reviews FAQ",
  "tag": "section",
  "class": "section-altaeron-custom",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [{ "name": "Altaeron: Reviews FAQ" }]
}
{% endschema %}
