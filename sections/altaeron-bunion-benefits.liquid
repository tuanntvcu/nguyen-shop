{%- liquid
  assign progression_blocks = section.blocks | where: 'type', 'progression'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign reassurance = section.settings.reassurance
  assign how_it_works_video = section.settings.how_it_works_video
  assign mobile_gallery_images = ''
  for image_index in (1..5)
    assign image_setting_id = 'mobile_gallery_image_' | append: image_index
    if section.settings[image_setting_id] != blank
      assign mobile_gallery_images = mobile_gallery_images | append: '1'
    endif
  endfor
  assign translated_subheading = true
  for paragraph_index in (1..6)
    assign paragraph_key = 'altaeron_pdp_reels_v3.bunion.subheading_' | append: paragraph_index
    if paragraph_index == 1 or paragraph_index == 4
      assign paragraph_key = paragraph_key | append: '_before'
    endif
    assign paragraph_copy = paragraph_key | t
    if paragraph_copy contains 'Translation missing:'
      assign translated_subheading = false
      break
    endif
  endfor
  unless request.locale.iso_code == 'en'
    assign eyebrow = 'altaeron_pdp_reels_v3.bunion.eyebrow' | t
    assign heading = 'altaeron_pdp_reels_v3.bunion.heading' | t
    assign reassurance = 'altaeron_pdp_reels_v3.bunion.reassurance' | t | replace: '&lt;', '<' | replace: '&gt;', '>'
  endunless
-%}

<style>
  #AltaeronBunion-{{ section.id }} {
    --alta-custom-ink: var(--altaeron-navy, #102a43);
    --alta-custom-body: var(--altaeron-body, #344054);
    --alta-custom-accent: var(--altaeron-primary, #006b5e);
    --alta-custom-soft: var(--altaeron-soft-teal, #eaf5f2);
    --alta-custom-line: var(--altaeron-border, #e4e7ec);
    background: #fff;
    color: var(--alta-custom-body);
    padding: 72px 0 36px;
  }
  #AltaeronBunion-{{ section.id }} * { box-sizing: border-box; }
  #AltaeronBunion-{{ section.id }} .alta-custom__shell { margin-inline: auto; width: min(1360px, calc(100% - 80px)); }
  #AltaeronBunion-{{ section.id }} .alta-custom__header { margin-bottom: 24px; max-width: 1080px; }
  #AltaeronBunion-{{ section.id }} .alta-custom__eyebrow { align-items: center; color: var(--alta-custom-accent); display: flex; font-size: 12px; font-weight: 750; gap: 12px; letter-spacing: .24em; line-height: 1.3; margin: 0 0 10px; text-transform: uppercase; }
  #AltaeronBunion-{{ section.id }} .alta-custom__eyebrow::before { background: currentColor; content: ''; flex: 0 0 40px; height: 3px; }
  #AltaeronBunion-{{ section.id }} .alta-custom__heading { color: var(--alta-custom-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: clamp(30px, 3vw, 46px); font-weight: 750; letter-spacing: -.035em; line-height: 1.08; margin: 0; }
  #AltaeronBunion-{{ section.id }} .alta-custom__subheading { color: var(--alta-custom-body); font-size: clamp(16px, 1.5vw, 21px); line-height: 1.5; margin: 10px 0 0; max-width: 1050px; }
  #AltaeronBunion-{{ section.id }} .alta-custom__subheading p { margin: 0 0 .85em; }
  #AltaeronBunion-{{ section.id }} .alta-custom__subheading p:last-child { margin-bottom: 0; }
  #AltaeronBunion-{{ section.id }} .alta-custom__subheading strong { color: #9b2525; font-weight: 750; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__progression { background: #f7f9f9; border: 1px solid var(--alta-custom-line); border-radius: 18px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: hidden; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step { background: #fff; min-width: 0; position: relative; text-align: center; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step + .alta-bunion__step { border-left: 1px solid rgba(228, 231, 236, .75); }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step:not(:last-child)::after { align-items: center; background: rgba(255,255,255,.94); border: 1px solid rgba(0,107,94,.18); border-radius: 50%; color: var(--alta-custom-accent); content: '\2192'; display: flex; font-size: 25px; font-weight: 500; height: 42px; justify-content: center; position: absolute; right: -21px; top: calc(50% - 42px); width: 42px; z-index: 2; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step-media { aspect-ratio: 4 / 3; background: #eef2f3; overflow: hidden; }
  #AltaeronBunion-{{ section.id }} :is(.alta-bunion__step-media, .alta-custom-card__media) :is(img, svg) { display: block; height: 100%; object-fit: cover; width: 100%; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step-copy { background: rgba(255,255,255,.92); min-height: 94px; padding: 16px 12px 18px; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step h3 { background: var(--alta-custom-soft); border-radius: 999px; color: var(--alta-custom-accent); display: inline-block; font-family: inherit; font-size: 15px; font-weight: 750; line-height: 1.2; margin: 0 0 7px; padding: 6px 18px; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step:first-child h3 { background: #f8e8e8; color: #9b2525; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__step p { color: var(--alta-custom-body); font-size: 14px; line-height: 1.4; margin: 0; }
  #AltaeronBunion-{{ section.id }} .alta-custom__cards { display: grid; gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 20px; }
  #AltaeronBunion-{{ section.id }} .alta-custom-card { background: #fff; border: 1px solid var(--alta-custom-line); border-radius: 15px; min-width: 0; overflow: hidden; }
  #AltaeronBunion-{{ section.id }} .alta-custom-card__media { aspect-ratio: 16 / 8.4; background: #eef2f3; overflow: hidden; }
  #AltaeronBunion-{{ section.id }} .alta-custom-card__copy { padding: 18px 20px 22px; }
  #AltaeronBunion-{{ section.id }} .alta-custom-card h3 { color: var(--alta-custom-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: 19px; font-weight: 750; letter-spacing: -.02em; line-height: 1.25; margin: 0 0 5px; }
  #AltaeronBunion-{{ section.id }} .alta-custom-card p { color: var(--alta-custom-body); font-size: 15px; line-height: 1.45; margin: 0; }
  #AltaeronBunion-{{ section.id }} .alta-custom__reassurance { align-items: center; background: linear-gradient(90deg, #edf8f7, #e4f4f2, #edf8f7); border-radius: 13px; color: #0b6270; display: flex; flex-direction: column; font-size: 16px; font-weight: 500; gap: 0; justify-content: center; line-height: 1.5; margin: 20px 0 0; padding: 22px; text-align: center; }
  #AltaeronBunion-{{ section.id }} .alta-custom__reassurance strong { color: var(--altaeron-primary,#006B5E); font-weight: 750; }
  #AltaeronBunion-{{ section.id }} .alta-custom__reassurance-title { font-size: 18px; }
  #AltaeronBunion-{{ section.id }} .alta-custom__reassurance svg { flex: 0 0 29px; height: 29px; stroke-width: 1.8; width: 29px; }
  #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery { display: none; }
  #AltaeronBunion-{{ section.id }} .alta-custom__how-layout { display: grid; gap: 24px; }
  #AltaeronBunion-{{ section.id }} .alta-custom__copy { display: contents; }
  #AltaeronBunion-{{ section.id }} .alta-custom__header,
  #AltaeronBunion-{{ section.id }} .alta-custom__subheading { grid-column: 1; }
  #AltaeronBunion-{{ section.id }} .alta-custom__header { grid-row: 1; }
  #AltaeronBunion-{{ section.id }} .alta-custom__subheading { grid-row: 2; }
  #AltaeronBunion-{{ section.id }} .alta-custom__video { aspect-ratio: 1 / 1; background: #eef2f3; border-radius: 12px; overflow: hidden; width: 100%; }
  #AltaeronBunion-{{ section.id }} .alta-custom__video { grid-column: 2; grid-row: 1; }
  #AltaeronBunion-{{ section.id }} .alta-custom__video video { display: block; height: 100%; object-fit: cover; width: 100%; }
  @media (min-width: 750px) {
    #AltaeronBunion-{{ section.id }} { padding: clamp(64px, 6vw, 88px) 0 40px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__shell { width: min(1240px, calc(100% - 48px)); }
    #AltaeronBunion-{{ section.id }} .alta-custom__copy { display: flex; flex-direction: column; grid-column: 1; }
    #AltaeronBunion-{{ section.id }} .alta-custom__header { margin-bottom: 0; max-width: 850px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__subheading { max-width: none; }
    #AltaeronBunion-{{ section.id }} .alta-custom__how-layout { align-items: start; gap: clamp(28px, 5vw, 64px); grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr); }
    #AltaeronBunion-{{ section.id }} .alta-bunion__progression { box-shadow: 0 18px 50px rgba(16,42,67,.06); }
    #AltaeronBunion-{{ section.id }} .alta-custom__cards { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
    #AltaeronBunion-{{ section.id }} .alta-custom-card { transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
    #AltaeronBunion-{{ section.id }} .alta-custom-card:hover { border-color: rgba(0,107,94,.3); box-shadow: 0 14px 34px rgba(16,42,67,.08); transform: translateY(-2px); }
  }
  @media (min-width: 1100px) {
    #AltaeronBunion-{{ section.id }} .alta-custom__shell { width: min(1240px, calc(100% - 80px)); }
    #AltaeronBunion-{{ section.id }} .alta-bunion__step-media { aspect-ratio: 16 / 10; }
    #AltaeronBunion-{{ section.id }} .alta-custom-card__media { aspect-ratio: 16 / 7.8; }
  }
  @media (max-width: 749px) {
    #AltaeronBunion-{{ section.id }} { padding: 24px 0 12px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__shell { width: calc(100% - 30px); }
    #AltaeronBunion-{{ section.id }} .alta-custom__header { margin-bottom: 12px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__eyebrow { font-size: 10px; gap: 9px; letter-spacing: .2em; margin-bottom: 8px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__eyebrow::before { flex-basis: 28px; height: 2px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__heading { font-size: 29px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__subheading { font-size: 15px; line-height: 1.45; }
    #AltaeronBunion-{{ section.id }} .alta-custom__how-layout { gap: 0; grid-template-columns: minmax(0, 1fr); }
    #AltaeronBunion-{{ section.id }} .alta-custom__header { grid-column: 1; grid-row: 1; }
    #AltaeronBunion-{{ section.id }} .alta-custom__video { grid-column: 1; grid-row: 2; }
    #AltaeronBunion-{{ section.id }} .alta-custom__subheading { grid-column: 1; grid-row: 3; }
    #AltaeronBunion-{{ section.id }} .alta-custom__video { margin: 0 0 16px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__progression { border-radius: 13px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__step:not(:last-child)::after { font-size: 16px; height: 28px; right: -14px; top: calc(50% - 32px); width: 28px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__step-media { aspect-ratio: 4 / 5; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__step-copy { min-height: 100px; padding: 10px 4px 12px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__step h3 { border-radius: 8px; font-size: 10px; margin-bottom: 5px; max-width: calc(100% - 8px); padding: 5px 6px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__step p { font-size: 10px; line-height: 1.3; padding-inline: 3px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__cards { gap: 12px; grid-template-columns: 1fr; margin-top: 14px; }
    #AltaeronBunion-{{ section.id }} .alta-custom-card { border-radius: 12px; display: grid; grid-template-columns: minmax(120px, 42%) 1fr; }
    #AltaeronBunion-{{ section.id }} .alta-custom-card__media { aspect-ratio: auto; min-height: 132px; }
    #AltaeronBunion-{{ section.id }} .alta-custom-card__copy { align-self: center; padding: 16px; }
    #AltaeronBunion-{{ section.id }} .alta-custom-card h3 { font-size: 16px; }
    #AltaeronBunion-{{ section.id }} .alta-custom-card p { font-size: 13px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__reassurance { font-size: 14px; gap: 10px; margin-top: 14px; min-height: 58px; padding: 12px 14px; }
    #AltaeronBunion-{{ section.id }} .alta-custom__reassurance svg { flex-basis: 24px; height: 24px; width: 24px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery { display: block; margin: 0 0 14px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery-track { overflow: hidden; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery-slide { aspect-ratio: 1.22 / 1; background: #f1f3f3; border-radius: 12px; overflow: hidden; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery-slide img { display: block; height: 100%; object-fit: cover; width: 100%; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery .swiper-pagination { display: flex; gap: 6px; justify-content: center; margin-top: 9px; position: static; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery .swiper-pagination-bullet { background: #c8cece; height: 5px; margin: 0 !important; opacity: 1; width: 5px; }
    #AltaeronBunion-{{ section.id }} .alta-bunion__mobile-gallery .swiper-pagination-bullet-active { background: #152c2b; }
  }
  {%- if template.suffix == 'altaeron-reels-v3' -%}
    {% render 'altaeron-reels-v3-responsive-section', section_kind: 'bunion', section_id: section.id %}
  {%- endif -%}
</style>

<section id="AltaeronBunion-{{ section.id }}" class="alta-custom alta-bunion" aria-labelledby="AltaeronBunionHeading-{{ section.id }}">
  <div class="alta-custom__shell">
    <div class="alta-custom__how-layout">
      <div class="alta-custom__copy">
        <header class="alta-custom__header">
          {%- if eyebrow != blank -%}<p class="alta-custom__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
          <h2 id="AltaeronBunionHeading-{{ section.id }}" class="alta-custom__heading">{{ heading | escape }}</h2>
        </header>
      {%- if translated_subheading or subheading != blank -%}
        <div class="alta-custom__subheading">
          {%- if translated_subheading -%}
            {%- for paragraph_index in (1..6) -%}
              {%- capture paragraph_key -%}altaeron_pdp_reels_v3.bunion.subheading_{{ paragraph_index }}{%- endcapture -%}
              {%- if paragraph_index == 1 or paragraph_index == 4 -%}
                {%- assign before_key = paragraph_key | append: '_before' -%}
                {%- assign emphasis_key = paragraph_key | append: '_emphasis' -%}
                {%- assign after_key = paragraph_key | append: '_after' -%}
                <p>{{ before_key | t }}<strong>{{ emphasis_key | t }}</strong>{{ after_key | t }}</p>
              {%- else -%}
                <p>{{ paragraph_key | t }}</p>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {{ subheading | newline_to_br }}
          {%- endif -%}
        </div>
      {%- endif -%}
      </div>
      {%- if how_it_works_video != blank -%}
        <div class="alta-custom__video">
          {{ how_it_works_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
        </div>
      {%- endif -%}
    </div>

    {%- if progression_blocks.size > 0 -%}
      <div class="alta-bunion__progression" aria-label="{{ eyebrow | escape }}">
        {%- for block in progression_blocks -%}
          {%- liquid
            assign block_title = block.settings.title
            assign block_caption = block.settings.caption
            unless request.locale.iso_code == 'en'
              capture title_key
                echo 'altaeron_pdp_reels_v3.bunion.progression_' | append: forloop.index | append: '_title'
              endcapture
              capture caption_key
                echo 'altaeron_pdp_reels_v3.bunion.progression_' | append: forloop.index | append: '_caption'
              endcapture
              assign block_title = title_key | t
              assign block_caption = caption_key | t
            endunless
            assign image_alt = block.settings.image.alt | default: block_title
          -%}
          <article class="alta-bunion__step" {{ block.shopify_attributes }}>
            <div class="alta-bunion__step-media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '180, 280, 420, 600, 900', sizes: '(min-width: 750px) 32vw, 33vw', alt: image_alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="alta-bunion__step-copy"><h3>{{ block_title | escape }}</h3><p>{{ block_caption | escape }}</p></div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if benefit_blocks.size > 0 -%}
      <div class="alta-custom__cards">
        {%- for block in benefit_blocks -%}
          {%- liquid
            assign block_title = block.settings.title
            assign block_body = block.settings.body
            unless request.locale.iso_code == 'en'
              capture title_key
                echo 'altaeron_pdp_reels_v3.bunion.benefit_' | append: forloop.index | append: '_title'
              endcapture
              capture body_key
                echo 'altaeron_pdp_reels_v3.bunion.benefit_' | append: forloop.index | append: '_body'
              endcapture
              assign block_title = title_key | t
              assign block_body = body_key | t
            endunless
            assign image_alt = block.settings.image.alt | default: block_title
          -%}
          <article class="alta-custom-card" {{ block.shopify_attributes }}>
            <div class="alta-custom-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 520, 700, 900', sizes: '(min-width: 750px) 32vw, 42vw', alt: image_alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="alta-custom-card__copy"><h3>{{ block_title | escape }}</h3><p>{{ block_body | escape }}</p></div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if mobile_gallery_images != blank -%}
      <div class="alta-bunion__mobile-gallery" data-mobile-gallery>
        <div class="alta-bunion__mobile-gallery-track swiper" data-gallery-track>
          <div class="swiper-wrapper">
          {%- for image_index in (1..5) -%}
            {%- assign image_setting_id = 'mobile_gallery_image_' | append: image_index -%}
            {%- assign gallery_image = section.settings[image_setting_id] -%}
            {%- if gallery_image != blank -%}
              <div class="alta-bunion__mobile-gallery-slide swiper-slide" data-gallery-slide>
                {{ gallery_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 750, 1000, 1200', sizes: '(max-width: 749px) 88vw', alt: gallery_image.alt }}
              </div>
            {%- endif -%}
          {%- endfor -%}
          </div>
        </div>
        {%- if mobile_gallery_images.size > 1 -%}
          <div class="swiper-pagination" aria-label="Gallery slides"></div>
        {%- endif -%}
      </div>
      <script>
        (() => {
          const initializeGallery = () => {
            const slider = document.querySelector('#AltaeronBunion-{{ section.id }} [data-gallery-track]');
            if (!slider || slider.dataset.initialized || !window.ScaloraTheme?.Carousel) return;
            slider.dataset.initialized = 'true';
            const options = {
              slidesPerView: 1.12,
              spaceBetween: 10,
              watchOverflow: true,
              breakpoints: { 750: { enabled: false } },
            };
            const pagination = slider.parentElement.querySelector('.swiper-pagination');
            if (pagination) options.pagination = { el: pagination, clickable: true };
            const carousel = new window.ScaloraTheme.Carousel(slider, options);
            carousel.init();
          };
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeGallery, { once: true });
          } else {
            initializeGallery();
          }
        })();
      </script>
    {%- endif -%}

    {%- if reassurance != blank -%}
      <p class="alta-custom__reassurance">
        <span>{{ reassurance }}</span>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Altaeron: Bunion Help",
  "tag": "section",
  "class": "section-altaeron-custom",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "video", "id": "how_it_works_video", "label": "How it works video" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT IT DOES FOR YOUR BUNION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Support your big toe in a more natural position." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "As a bunion develops, the big toe moves inward toward the second toe. Altaeron works in the opposite direction with controlled outward tension." },
    { "type": "textarea", "id": "reassurance", "label": "Reassurance", "default": "Gentle support should feel controlled — never painful." },
    { "type": "header", "content": "Mobile image slider" },
    { "type": "image_picker", "id": "mobile_gallery_image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "mobile_gallery_image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "mobile_gallery_image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "mobile_gallery_image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "mobile_gallery_image_5", "label": "Image 5" }
  ],
  "blocks": [
    {
      "type": "progression",
      "name": "Progression step",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Progression step" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Short explanation" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Short benefit explanation." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Altaeron: Bunion Help",
    "blocks": [
      { "type": "progression", "settings": { "title": "Bunion position", "caption": "Big toe shifted inward" } },
      { "type": "progression", "settings": { "title": "Product support", "caption": "Guides the toe outward" } },
      { "type": "progression", "settings": { "title": "Supported position", "caption": "Big toe sits more naturally" } },
