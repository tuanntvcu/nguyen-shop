              <span class="apdp-reels-micro-review__author"><strong>Christina B.</strong><span class="apdp-reels-micro-review__verified-icon" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.verified_reviewer' | t | escape }}">{% render 'altaeron-pdp-icon', icon: 'check' %}</span></span>
