{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.altaeron
  assign hero_video = mf.pdp_hero_video.value
  assign hero_image = mf.pdp_hero_image.value | default: product.featured_image
  assign hero_poster = hero_video.preview_image | image_url: width: 1200
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign reviews = review_data.reviews
  assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
  assign review_rating = review_data.average_rating | default: 0 | plus: 0
  assign review_rating_display = review_rating | times: 10 | floor | divided_by: 10.0
  assign reel_eyebrow = section.settings.eyebrow
  assign reel_headline = section.settings.headline
  assign reel_subheadline = section.settings.subheadline
  assign reel_price_label = section.settings.price_label
  assign reel_cta_label = section.settings.cta_label
  unless request.locale.iso_code == 'en'
    assign reel_eyebrow = 'altaeron_pdp_reels_v2.hero.eyebrow' | t
    assign reel_headline = 'altaeron_pdp_reels_v2.hero.headline' | t
    assign reel_subheadline = 'altaeron_pdp_reels_v2.hero.subheadline_html' | t
    assign reel_price_label = 'altaeron_pdp_reels_v2.common.from' | t
    assign reel_cta_label = 'products.product.add_to_cart' | t
  endunless
  assign product_form_id = 'product-form-' | append: section.id
  assign compare_price = current_variant.compare_at_price
  assign savings = 0
  if compare_price > current_variant.price
    assign savings = compare_price | minus: current_variant.price
  endif
  assign savings_money = savings | money
  assign installment_amount = current_variant.price | divided_by: 4 | money
  assign support_demo_alt = 'altaeron_pdp_reels_v2.accessibility.support_demo' | t
  assign day_image_alt = 'altaeron_pdp_reels_v2.accessibility.day_media' | t
  assign day_video_label = 'altaeron_pdp_reels_v2.accessibility.day_video' | t | escape
  assign day_video_open = '<video data-apdp-lazy-video aria-label="' | append: day_video_label | append: '" data-apdp-localized-video '
  assign spacer_basic_alt = 'altaeron_pdp_reels_v2.accessibility.basic_spacer' | t
  assign spacer_altaeron_alt = 'altaeron_pdp_reels_v2.accessibility.altaeron_corrector' | t
  assign support_heading_id = 'AltaeronSupport-' | append: section.id
  assign expectations_heading_id = 'AltaeronCanCant-' | append: section.id
  assign stories_heading_id = 'AltaeronStoriesTitle-' | append: section.id
  assign spacer_heading_id = 'AltaeronSpacer-' | append: section.id
  assign day_heading_id = 'AltaeronDay-' | append: section.id
  assign expert_heading_id = 'AltaeronExpertTitle-' | append: section.id
  assign reviews_heading_id = 'AltaeronVerifiedTitle-' | append: section.id
  assign faq_heading_id = 'AltaeronFaq-' | append: section.id
  assign support_title = 'altaeron_pdp_reels_v2.support.title' | t
  assign support_subtitle = 'altaeron_pdp_reels_v2.support.subtitle' | t
  assign expectations_title = 'altaeron_pdp_reels_v2.expectations.title' | t
  assign expectations_subtitle = 'altaeron_pdp_reels_v2.expectations.subtitle' | t
  assign stories_title = 'altaeron_pdp_reels_v2.reviews.title' | t
  assign stories_subtitle = 'altaeron_pdp_reels_v2.reviews.subtitle' | t
  assign spacer_title = 'altaeron_pdp_reels_v2.spacer.title' | t
  assign spacer_subtitle = 'altaeron_pdp_reels_v2.spacer.subtitle' | t
  assign day_title = 'altaeron_pdp_reels_v2.day.title' | t
  assign day_subtitle = 'altaeron_pdp_reels_v2.day.subtitle' | t
  assign expert_title = 'altaeron_pdp_reels_v2.expert.title' | t
  assign expert_subtitle = 'altaeron_pdp_reels_v2.expert.subtitle' | t
  assign full_reviews_title = 'altaeron_pdp_reels_v2.reviews.full_title' | t
  assign faq_title = 'altaeron_pdp_reels_v2.faq.title' | t
  assign faq_subtitle = 'altaeron_pdp_reels_v2.faq.subtitle' | t
  assign full_reviews_subtitle = 'altaeron_pdp_reels_v2.reviews.full_subtitle' | t: rating: review_rating_display, count: review_count
  for block in section.blocks
    if block.type == 'education_media'
      case block.settings.slot
        when 'support_demo'
          assign support_demo_image = block.settings.image
          assign support_demo_video = block.settings.video
        when 'day_story'
          assign day_story_image = block.settings.image
          assign day_story_video = block.settings.video
      endcase
    elsif block.type == 'tail_media'
      case block.settings.slot
        when 'spacer'
          assign tail_spacer = block.settings.image
        when 'support'
          assign tail_support = block.settings.image
        when 'cta_product'
          assign tail_cta_product = block.settings.image
      endcase
    endif
  endfor
-%}

{{ 'altaeron-pdp.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'altaeron-pdp.js' | asset_url }}" defer="defer"></script>

<style>
  #AltaeronPdp-{{ section.id }} .apdp-support__features{grid-template-columns:repeat(3,minmax(0,1fr))}
  #AltaeronPdp-{{ section.id }} .apdp-support__media{grid-template-columns:1fr}
  #AltaeronPdp-{{ section.id }} .apdp-spacer-grid{grid-template-columns:minmax(0,1fr) 34px minmax(0,1.15fr)}
  #AltaeronPdp-{{ section.id }} .apdp-day__benefits{grid-template-columns:repeat(3,minmax(0,1fr))}
  #AltaeronPdp-{{ section.id }} .apdp-reels-section{padding-top:var(--alta-pdp-section-gap-tight)}
  #AltaeronPdp-{{ section.id }} .apdp-reels-full{width:min(1440px,calc(100% - 80px))}
  #AltaeronPdp-{{ section.id }} .apdp-gallery__return{align-items:center;background:rgba(0,47,32,.9);border:0;border-radius:999px;box-shadow:0 4px 14px rgba(0,0,0,.2);color:#fff;cursor:pointer;display:none;font:inherit;font-size:13px;font-weight:700;gap:7px;left:14px;min-height:40px;padding:9px 14px;position:absolute;top:14px;z-index:12}
  #AltaeronPdp-{{ section.id }} .apdp-day__layout{margin-inline:auto;max-width:1120px}
  #AltaeronPdp-{{ section.id }} .apdp-day__visual:after{display:none}
  #AltaeronPdp-{{ section.id }} .apdp-day__visual :where(video,img,svg){display:block;height:100%;object-fit:cover;width:100%}
  #AltaeronPdp-{{ section.id }} .apdp-tail-faq{padding-bottom:56px}
  #AltaeronPdp-{{ section.id }} .apdp-tail-faq+.apdp-final-cta{margin-top:0}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review{align-items:start;background:#f7faf7;border:1px solid #dfe7e1;border-radius:10px;display:grid;gap:10px;grid-template-columns:38px minmax(0,1fr);margin:0 0 12px;padding:12px}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review .apdp-tail-avatar{height:38px;margin:0;width:38px}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review .apdp-tail-avatar__initial{font-size:14px}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review__body{display:block;min-width:0}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review .apdp-stars{font-size:12px;margin:0 0 3px}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review blockquote{color:#29483d;font-size:12px;line-height:1.48;margin:0}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review figcaption{margin-top:9px}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review__author{align-items:center;color:#173f32;display:flex;font-size:12px;gap:5px;line-height:1.25}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review__verified-icon{align-items:center;background:#078351;border-radius:50%;color:#fff;display:inline-flex;flex:0 0 15px;height:15px;justify-content:center;width:15px}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review__verified-icon svg{height:10px;stroke-width:2.5;width:10px}
  #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review figcaption small{color:#5b6b64;display:block;font-size:9px;font-weight:650;letter-spacing:.08em;line-height:1.3;margin-top:4px;text-transform:uppercase}
  #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits{display:grid;gap:9px;list-style:none;margin:16px 0 0;max-width:600px;padding:0}
  #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits li{align-items:flex-start;color:#173f32;display:flex;font-size:14px;font-weight:650;gap:9px;line-height:1.4}
  #AltaeronPdp-{{ section.id }} .apdp-narrative__benefits svg{background:#08724b;border-radius:50%;color:#fff;flex:0 0 19px;height:19px;margin-top:1px;padding:4px;stroke-width:2.2;width:19px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story{border-top:1px solid #d8e1db;grid-column:1/-1;grid-row:3;margin-top:8px;padding:24px 4px 8px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2{color:#10251d;font-family:var(--alta-font-family);font-size:clamp(26px,2.1vw,34px);font-weight:800;letter-spacing:-.025em;line-height:1.18;margin:0 0 24px;max-width:620px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2 strong{color:#08724b;font-weight:800}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__copy{color:#29483d;font-size:15px;line-height:1.62;max-width:650px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__copy p{margin:0 0 18px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__alert{color:#d6573f;font-weight:750}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__consequence{color:#29483d;text-decoration:underline;text-decoration-color:#08724b;text-decoration-thickness:1px;text-underline-offset:3px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result{align-items:flex-start;background:#eef7f1;border-radius:10px;color:#173f32;display:flex;font-size:14px;font-style:italic;font-weight:600;gap:10px;line-height:1.5;margin:22px 0 0;padding:13px 14px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result>span:first-child{align-items:center;background:#08724b;border-radius:50%;color:#fff;display:flex;flex:0 0 20px;height:20px;justify-content:center;margin-top:1px;width:20px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result svg{height:13px;stroke-width:2.5;width:13px}
  #AltaeronPdp-{{ section.id }} .apdp-gallery-story__result strong{color:#08724b}
  @media(min-width:1100px){
    #AltaeronPdp-{{ section.id }} .apdp-hero__grid{align-items:start;grid-template-columns:minmax(0,43fr) minmax(300px,29fr) minmax(360px,28fr);min-height:0;row-gap:0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery{align-self:start;display:grid;gap:12px;grid-column:1;grid-row:1;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto;min-width:0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__stage{aspect-ratio:9/16;grid-column:1;grid-row:1;height:auto;max-height:900px;opacity:1;transition:opacity .2s ease,visibility .2s ease;visibility:visible}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__stage:before{background:var(--apdp-hero-poster) center/cover no-repeat;content:"";filter:blur(18px);inset:-26px;opacity:.44;position:absolute;transform:scale(1.08)}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__stage:after{background:rgba(4,27,20,.12);content:"";inset:0;pointer-events:none;position:absolute}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__hero>video{background:transparent;object-fit:contain;position:relative;z-index:1}
    #AltaeronPdp-{{ section.id }} .apdp-narrative{align-self:center;grid-column:2;grid-row:1}
    #AltaeronPdp-{{ section.id }} .apdp-buy{grid-column:3;grid-row:1;min-height:0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__viewer{aspect-ratio:9/16;grid-column:1;grid-row:1;height:auto;max-height:900px;opacity:0;pointer-events:none;transition:opacity .2s ease,visibility .2s ease;visibility:hidden}
    #AltaeronPdp-{{ section.id }} .apdp-gallery.is-viewer-active .apdp-gallery__stage{opacity:0;pointer-events:none;visibility:hidden}
    #AltaeronPdp-{{ section.id }} .apdp-gallery.is-viewer-active .apdp-gallery__viewer{opacity:1;pointer-events:auto;visibility:visible}
    #AltaeronPdp-{{ section.id }} .apdp-gallery.is-viewer-active .apdp-gallery__return{display:flex}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__thumbs{display:flex;flex-direction:row;grid-column:1;grid-row:2;max-height:none;overflow-x:auto;overflow-y:hidden;padding:1px 2px 4px}
    #AltaeronPdp-{{ section.id }} .apdp-day__layout{align-items:stretch;display:grid;gap:34px;grid-template-columns:minmax(300px,390px) minmax(0,1fr)}
    #AltaeronPdp-{{ section.id }} .apdp-day__media{aspect-ratio:9/16;height:auto;margin:0;max-width:390px;width:100%}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits{align-content:stretch;gap:14px;grid-template-columns:1fr;margin:0}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article,#AltaeronPdp-{{ section.id }} .apdp-day__benefits article+article{align-items:center;background:#f7faf7;border:1px solid #dfe7e1;border-radius:13px;display:grid;gap:20px;grid-template-columns:72px minmax(0,1fr);padding:24px 26px;text-align:left}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article>span{height:72px;margin:0;width:72px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article>span svg{height:40px;width:40px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits h3{font-size:18px;margin:0 0 7px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits p{font-size:15px;max-width:520px}
  }
  @media(max-width:1099px) and (min-width:768px){
    #AltaeronPdp-{{ section.id }} .apdp-spacer-grid{grid-template-columns:1fr 28px 1fr}
    #AltaeronPdp-{{ section.id }} .apdp-reels-full{width:calc(100% - 36px)}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story{grid-column:1/-1;grid-row:4;margin:8px 0 0;padding:24px 4px 8px}
    #AltaeronPdp-{{ section.id }} .apdp-buy{grid-row:5}
  }
  @media(max-width:767px){
    #AltaeronPdp-{{ section.id }} .apdp-gallery__stage{margin-top:0;order:1}
    #AltaeronPdp-{{ section.id }} .apdp-narrative{order:2}
    #AltaeronPdp-{{ section.id }} .apdp-buy{order:3}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__viewer{order:4}
    #AltaeronPdp-{{ section.id }} .apdp-gallery__thumbs{order:5}
    #AltaeronPdp-{{ section.id }} .apdp-support__features{grid-template-columns:1fr}
    #AltaeronPdp-{{ section.id }} .apdp-support__features article+article{margin-left:0;margin-top:8px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits{grid-template-columns:repeat(2,minmax(0,1fr))}
    #AltaeronPdp-{{ section.id }} .apdp-day__layout{display:block}
    #AltaeronPdp-{{ section.id }} .apdp-day__media{aspect-ratio:9/16;border-radius:12px;box-shadow:0 8px 22px rgba(11,38,26,.15);height:auto;margin:0 auto;max-width:420px;overflow:hidden;width:100%}
    #AltaeronPdp-{{ section.id }} .apdp-day__visual{aspect-ratio:auto;inset:0;position:absolute}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits{gap:10px;margin:18px 0 0}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article,#AltaeronPdp-{{ section.id }} .apdp-day__benefits article+article,#AltaeronPdp-{{ section.id }} .apdp-day__benefits article:nth-child(even),#AltaeronPdp-{{ section.id }} .apdp-day__benefits article:nth-child(n+3){align-items:center;background:#f7faf7;border:1px solid #dfe7e1;border-radius:11px;display:flex;flex-direction:column;gap:10px;min-width:0;padding:14px 10px;text-align:center}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article>span{height:52px;margin:0;width:52px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits article>span svg{height:30px;width:30px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits h3{font-size:15px;line-height:1.3;margin:0 0 5px}
    #AltaeronPdp-{{ section.id }} .apdp-day__benefits p{font-size:13px;line-height:1.45;margin:0 auto;max-width:160px}
    #AltaeronPdp-{{ section.id }} .apdp-spacer-grid{display:block}
    #AltaeronPdp-{{ section.id }} .apdp-reels-section{padding-top:var(--alta-pdp-section-gap-tight-mobile)}
    #AltaeronPdp-{{ section.id }} .apdp-reels-full{width:calc(100% - 30px)}
    #AltaeronPdp-{{ section.id }} .apdp-tail-faq{padding-bottom:40px}
    #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review{grid-template-columns:36px minmax(0,1fr);padding:10px 11px}
    #AltaeronPdp-{{ section.id }} .apdp-reels-micro-review .apdp-tail-avatar{height:36px;width:36px}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story{grid-row:auto;margin:0 15px 20px;order:6;padding:22px 0 0}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story h2{font-size:clamp(27px,8vw,34px);line-height:1.16;margin-bottom:22px}
    #AltaeronPdp-{{ section.id }} .apdp-gallery-story__copy{font-size:15px;line-height:1.62}
  }
</style>

<div
  id="AltaeronPdp-{{ section.id }}"
  class="altaeron-pdp altaeron-pdp--cro-hero altaeron-pdp--reels-v2"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="{{ 'altaeron_pdp_reels_v2.common.save' | t | escape }}"
  data-save-template="{{ 'altaeron_pdp_reels_v2.common.save_template' | t | escape }}"
  data-add-to-cart-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-bundle-title="{{ 'altaeron_pdp_reels_v2.common.choose_bundle' | t | escape }}"
  data-bundle-one="{{ 'altaeron_pdp_reels_v2.common.one_corrector' | t | escape }}"
  data-bundle-many-template="{{ 'altaeron_pdp_reels_v2.common.many_correctors' | t | escape }}"
  data-bundle-one-foot="{{ 'altaeron_pdp_reels_v2.common.one_foot' | t | escape }}"
  data-bundle-popular="{{ 'altaeron_pdp_reels_v2.common.most_popular' | t | escape }}"
  data-bundle-best-value="{{ 'altaeron_pdp_reels_v2.common.best_value' | t | escape }}"
  data-bundle-subtitle-template="{{ 'altaeron_pdp_reels_v2.common.bundle_subtitle' | t | escape }}"
>
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.product_media' | t | escape }}">
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage apdp-gallery__hero"{% if hero_poster != blank %} style="--apdp-hero-poster:url('{{ hero_poster }}')"{% endif %}>
          {%- if hero_video != blank -%}
            {%- liquid
              assign hero_mobile_source = blank
              assign hero_desktop_source = blank
              for hero_source in hero_video.sources
                if hero_source.format == 'mp4'
                  if hero_desktop_source == blank or hero_source.height > hero_desktop_source.height
                    assign hero_desktop_source = hero_source
                  endif
                  if hero_source.height <= 720
                    if hero_mobile_source == blank or hero_source.height > hero_mobile_source.height
                      assign hero_mobile_source = hero_source
                    endif
                  endif
                endif
              endfor
              assign hero_desktop_source = hero_desktop_source | default: hero_video.sources.first
              assign hero_mobile_source = hero_mobile_source | default: hero_desktop_source
            -%}
            <video data-apdp-hero-video muted playsinline loop preload="metadata" poster="{{ hero_poster }}" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.hero_video' | t | escape }}">
              {%- if hero_desktop_source.url == hero_mobile_source.url -%}
                <source src="{{ hero_desktop_source.url }}" type="{{ hero_desktop_source.mime_type | default: 'video/mp4' }}">
              {%- else -%}
                <source src="{{ hero_mobile_source.url }}" type="{{ hero_mobile_source.mime_type | default: 'video/mp4' }}" media="(max-width: 767px)">
                <source src="{{ hero_desktop_source.url }}" type="{{ hero_desktop_source.mime_type | default: 'video/mp4' }}" media="(min-width: 768px)">
              {%- endif -%}
            </video>
          {%- elsif hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: product.title }}
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
