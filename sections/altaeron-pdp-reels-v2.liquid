    {%- if product.metafields.judgeme.widget.size > 20 -%}{%- assign has_legacy_judgeme_widget = true -%}{%- endif -%}
    <div class="apdp-judgeme-widget">
      <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false" data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">{%- if has_legacy_judgeme_widget -%}<div class="jdgm-legacy-widget-content" style="display:none">{{ product.metafields.judgeme.widget }}</div>{%- endif -%}</div>
      {%- if product.metafields.judgeme.review_widget_data -%}<script>window.jdgm=window.jdgm||{};window.jdgm.data=window.jdgm.data||{};window.jdgm.data.reviewWidget=window.jdgm.data.reviewWidget||{};window.jdgm.data.reviewWidget[{{ product.id | json }}]={{ product.metafields.judgeme.review_widget_data }};</script>{%- endif -%}
      <noscript><div class="apdp-tail-review-viewport"><div class="apdp-tail-review-grid">{% render 'altaeron-pdp-review-cards', reviews: reviews, limit: 10 %}</div></div></noscript>
    </div>
  </section>

  <section class="apdp-tail apdp-tail-faq apdp-shell apdp-reels-full alta-pdp-flow-section apdp-reels-section" aria-labelledby="AltaeronFaq-{{ section.id }}">
    {% render 'altaeron-pdp-section-heading', number: '8', title: faq_title, subtitle: faq_subtitle, heading_id: faq_heading_id %}
    <div class="apdp-tail-accordion">
      <details><summary>{{ 'altaeron_pdp_reels_v2.faq.question_1' | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ 'altaeron_pdp_reels_v2.faq.answer_1' | t }}</p></details>
      <details><summary>{{ 'altaeron_pdp_reels_v2.faq.question_2' | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ 'altaeron_pdp_reels_v2.faq.answer_2' | t }}</p></details>
      <details><summary>{{ 'altaeron_pdp_reels_v2.faq.question_3' | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ 'altaeron_pdp_reels_v2.faq.answer_3' | t }}</p></details>
      <details><summary>{{ 'altaeron_pdp_reels_v2.faq.question_4' | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ 'altaeron_pdp_reels_v2.faq.answer_4' | t }}</p></details>
      <details><summary>{{ 'altaeron_pdp_reels_v2.faq.question_5' | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ 'altaeron_pdp_reels_v2.faq.answer_5' | t }}</p></details>
      <details><summary>{{ 'altaeron_pdp_reels_v2.faq.question_6' | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ 'altaeron_pdp_reels_v2.faq.answer_6' | t }}</p></details>
    </div>
  </section>

  <section class="apdp-final-cta alta-pdp-flow-section" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.final_cta' | t | escape }}"><div class="apdp-shell apdp-final-cta__inner">
    <div class="apdp-final-cta__product apdp-tail-media">{%- if tail_cta_product != blank -%}{{ tail_cta_product | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 500, 700', sizes: '(min-width: 768px) 330px, 48vw', alt: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div>
    <div class="apdp-final-cta__content">
      <h2>{{ 'altaeron_pdp_reels_v2.final_cta.title' | t }}</h2><p>{{ 'altaeron_pdp_reels_v2.final_cta.subtitle' | t }}</p>
      <div class="apdp-final-benefits"><span>{% render 'altaeron-pdp-icon', icon: 'shield' %}<b>{{ 'altaeron_pdp_reels_v2.buy.guarantee' | t }}</b></span><span>{% render 'altaeron-pdp-icon', icon: 'truck' %}<b>{{ 'altaeron_pdp_reels_v2.buy.shipping' | t }}</b></span><span>{% render 'altaeron-pdp-icon', icon: 'support' %}<b>{{ 'altaeron_pdp_reels_v2.buy.support' | t }}</b></span></div>
      <div class="apdp-final-payments">
        <span class="visually-hidden">{{ 'altaeron_pdp_reels_v2.accessibility.payment_methods' | t }}</span>
        {%- liquid
          assign final_payment_prefix = 'apdp-final-' | append: section.id | append: '-'
          assign final_payment_id = ' id="' | append: final_payment_prefix
          assign final_payment_labelledby = 'aria-labelledby="' | append: final_payment_prefix
          assign final_payment_url = 'url(#' | append: final_payment_prefix
          assign final_payment_href = 'href="#' | append: final_payment_prefix
        -%}
        <ul class="list list-payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            {%- capture payment_svg -%}{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}{%- endcapture -%}
            <li class="list-payment__item">{{ payment_svg | replace: ' id="', final_payment_id | replace: 'aria-labelledby="', final_payment_labelledby | replace: 'url(#', final_payment_url | replace: 'href="#', final_payment_href }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
    <div class="apdp-final-cta__buy"><div>{% render 'altaeron-pdp-stars', rating: review_rating %}<small>{{ 'altaeron_pdp_reels_v2.common.rating_parenthetical' | t: rating: review_rating_display, count: review_count }}</small><em data-apdp-final-savings{% if savings <= 0 %} hidden{% endif %}>{{ 'altaeron_pdp_reels_v2.common.save_amount' | t: amount: savings_money }}</em></div><p><strong data-apdp-final-price>{{ current_variant.price | money }}</strong><s data-apdp-final-compare{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></p><button type="button" class="apdp-final-button" data-apdp-final-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>{{ reel_cta_label }}<span data-apdp-final-button-price{% unless current_variant.available %} hidden{% endunless %}> — {{ current_variant.price | money }}</span></button><small data-apdp-installments>{{ 'altaeron_pdp_reels_v2.buy.installments' | t: amount: installment_amount }} shop<span>Pay</span></small><p class="apdp-final-fine">{{ 'altaeron_pdp_reels_v2.final_cta.fine_print' | t }}</p></div>
    <div class="apdp-final-badge"><img src="{{ 'altaeron-90-day-risk-free-badge.svg' | asset_url }}" width="384" height="384" loading="lazy" alt="{{ 'altaeron_pdp_reels_v2.accessibility.badge' | t | escape }}"></div>
  </div></section>

  <div class="apdp-sticky" data-apdp-sticky hidden><div class="apdp-sticky__product">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '52px', alt: product.featured_image.alt | default: product.title }}{%- endif -%}<span><small><span>{{ reel_price_label }}</span> <b data-apdp-sticky-price>{{ current_variant.price | money }}</b> <s data-apdp-sticky-compare{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></small><em data-apdp-sticky-savings{% if savings <= 0 %} hidden{% endif %}>{{ 'altaeron_pdp_reels_v2.common.save_amount' | t: amount: savings_money }}</em><small class="apdp-sticky__bundle-title" data-apdp-sticky-bundle-title hidden></small></span></div><button type="button" class="apdp-button apdp-button--primary" data-apdp-sticky-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-sticky-text>{% if current_variant.available %}{{ reel_cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span></button></div>
  <script type="application/json" data-apdp-product-json>{{ product.variants | json }}</script>
  <script>
    (() => {
      const root = document.getElementById('AltaeronPdp-{{ section.id }}');
      const gallery = root?.querySelector('[data-apdp-gallery]');
      const heroVideo = gallery?.querySelector('[data-apdp-hero-video]');
      const returnButton = gallery?.querySelector('[data-apdp-return-demo]');
      const desktop = window.matchMedia('(min-width: 1100px)');
      if (!gallery || !returnButton) return;

      const showDemo = (resume = false) => {
        gallery.classList.remove('is-viewer-active');
        gallery.querySelectorAll('[data-apdp-media] video').forEach((video) => video.pause());
        if (resume && heroVideo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          heroVideo.play().catch(() => {});
        }
      };

      gallery.querySelectorAll('[data-apdp-thumb]').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          if (!desktop.matches) return;
          gallery.classList.add('is-viewer-active');
          heroVideo?.pause();
        });
      });
      returnButton.addEventListener('click', () => showDemo(true));
      desktop.addEventListener?.('change', (event) => {
        if (!event.matches) showDemo(false);
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Altaeron Reels V2 PDP",
  "tag": "section",
  "class": "section-altaeron-pdp section-altaeron-pdp-reels-v2",
  "settings": [
    { "type": "header", "content": "Reels hero" },
    { "type": "text", "id": "eyebrow", "label": "Product label", "default": "Adjustable Bunion Corrector" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Give Your Big Toe More Room" },
    { "type": "textarea", "id": "subheadline", "label": "Outcome sentence", "default": "<strong>Painful Bunions?</strong> Realign your big toe, relieve pain and pressure, help stop further bunion progression, and visibly reduce the bump—without surgery." },
    { "type": "image_picker", "id": "micro_review_avatar", "label": "Micro review avatar" },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "From" },
    { "type": "text", "id": "cta_label", "label": "Add to cart label", "default": "Add to Cart" }
  ],
  "blocks": [
    {
      "type": "education_media",
      "name": "Demonstration media",
      "settings": [
        { "type": "select", "id": "slot", "label": "Media position", "options": [
          { "value": "support_demo", "label": "How it works demo" },
          { "value": "day_story", "label": "How to use demo" }
        ], "default": "support_demo" },
        { "type": "image_picker", "id": "image", "label": "Image fallback" },
        { "type": "video", "id": "video", "label": "Video" }
      ]
    },
    {
      "type": "tail_media",
      "name": "Product media",
      "settings": [
        { "type": "select", "id": "slot", "label": "Media position", "options": [
          { "value": "spacer", "label": "Basic toe spacer" },
          { "value": "support", "label": "Altaeron support" },
          { "value": "cta_product", "label": "Final CTA product" }
        ], "default": "spacer" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [{ "name": "Altaeron Reels V2 PDP" }]
}
{% endschema %}
