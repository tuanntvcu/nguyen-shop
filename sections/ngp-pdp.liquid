    if ngp_candidate_review.uuid == '1a70e381-a0b9-4cd3-adbe-939ad2c165f6'
      assign ngp_micro_review = ngp_candidate_review
      break
    endif
  endfor
  assign ngp_review_count = ngp_review_data.number_of_reviews | default: 0 | plus: 0
  assign ngp_review_rating = ngp_review_data.average_rating | default: 0 | plus: 0
  assign ngp_hero_rating_label = ngp_copy_prefix | append: '.hero.rating' | t: rating: ngp_review_rating, count: ngp_review_count
  assign ngp_hero_rating_display = ngp_review_rating | times: 10 | floor | divided_by: 10.0
  assign ngp_buy_rating_label = ngp_copy_prefix | append: '.buy.rating' | t: rating: ngp_review_rating, count: ngp_review_count
