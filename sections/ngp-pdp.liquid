              <a class="ngp-apdp-learn-card__link" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
                <div class="ngp-apdp-tail-media">
                  {%- if article.image != blank -%}
                    {{ article.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 240, 320, 480', sizes: '(min-width: 768px) 90px, 26vw', alt: article.image.alt | default: article.title }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div>
                  <h3>{{ article.title }}</h3>
                  <p>{{ ngp_article_summary }}</p>
                  <small>{{ ngp_copy_prefix | append: '.learn.reading_time' | t: minutes: ngp_guide_minutes }}</small>
