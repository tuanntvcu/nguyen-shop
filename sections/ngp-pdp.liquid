  {% if ngp_is_cro_v1 %}{% render 'ngp-pdp-popular', section: section %}{% endif %}

  <section class="ngp-apdp-final-cta ngp-alta-pdp-flow-section ngp-alta-pdp-flow-section--spacious" aria-label="{{ ngp_copy_prefix | append: '.final_cta.label' | t | escape }}"><div class="ngp-apdp-shell ngp-apdp-final-cta__inner">
    <div class="ngp-apdp-final-cta__product ngp-apdp-tail-media">{%- if ngp_tail_cta_product != blank -%}{{ ngp_tail_cta_product | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 500, 700', sizes: '(min-width: 768px) 330px, 48vw', alt: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div>
    <div class="ngp-apdp-final-cta__content"><h2>{{ ngp_copy_prefix | append: '.final_cta.title' | t }}</h2><p>{{ ngp_copy_prefix | append: '.final_cta.product' | t }}</p><div class="ngp-apdp-final-benefits"><span>{% render 'ngp-pdp-icon', ngp_icon: 'shield' %}<b>{{ ngp_copy_prefix | append: '.final_cta.guarantee_html' | t }}</b></span><span>{% render 'ngp-pdp-icon', ngp_icon: 'truck' %}<b>{{ ngp_copy_prefix | append: '.final_cta.shipping_html' | t }}</b></span><span>{% render 'ngp-pdp-icon', ngp_icon: 'support' %}<b>{{ ngp_copy_prefix | append: '.final_cta.support_html' | t }}</b></span></div><div class="ngp-apdp-final-payments"><span class="visually-hidden">{{ ngp_copy_prefix | append: '.accessibility.accepted_payment_methods' | t }}</span><ul class="list list-payment" role="list">{%- for ngp_type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ ngp_type | payment_type_svg_tag: class: 'ngp_icon icon--full-color' }}</li>{%- endfor -%}</ul></div></div>
    <div class="ngp-apdp-final-cta__buy"><div>{% render 'ngp-pdp-stars', rating: ngp_review_rating %}<small>{{ ngp_final_cta_rating_label }}</small><em data-apdp-final-savings{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_copy_prefix | append: '.common.save_amount' | t: amount: ngp_savings_money }}</em></div><p><strong data-apdp-final-price>{{ current_variant.price | money }}</strong><s data-apdp-final-compare{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_compare_price | money }}</s></p><button type="button" class="ngp-apdp-final-button" data-apdp-final-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>{{ ngp_copy_prefix | append: '.final_cta.button' | t }}{% if ngp_is_cro_v1 %}<span data-apdp-final-button-price{% unless current_variant.available %} hidden{% endunless %}> — {{ current_variant.price | money }}</span>{% else %} <span aria-hidden="true">→</span>{% endif %}</button><small data-apdp-installments>{{ ngp_copy_prefix | append: '.final_cta.installments' | t }} shop<span>Pay</span></small><p class="ngp-apdp-final-fine">{{ ngp_copy_prefix | append: '.final_cta.fine_print' | t }}</p></div>
    <div class="ngp-apdp-final-badge">
      <img src="{{ 'ngp-altaeron-30-day-risk-free-badge.svg' | asset_url }}" width="384" height="384" loading="lazy" alt="{{ ngp_copy_prefix | append: '.final_cta.badge_alt' | t | escape }}">
    </div>
  </div></section>

  <div class="ngp-apdp-sticky" data-apdp-sticky hidden><div class="ngp-apdp-sticky__product">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '52px', alt: product.featured_image.alt | default: product.title }}{%- endif -%}<span><small><span>{{ section.settings.price_label }}</span> <b data-apdp-sticky-price>{{ current_variant.price | money }}</b> <s data-apdp-sticky-compare{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_compare_price | money }}</s></small><em data-apdp-sticky-savings{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_copy_prefix | append: '.common.save_amount' | t: amount: ngp_savings_money }}</em><small class="ngp-apdp-sticky__bundle-title" data-apdp-sticky-bundle-title hidden></small></span></div><button type="button" class="ngp-apdp-button ngp-apdp-button--primary" data-apdp-sticky-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-sticky-text>{% if current_variant.available %}{{ section.settings.cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span></button></div>
  <script type="application/json" data-apdp-product-json>{{ product.variants | json }}</script>
</div>

{% schema %}
{
  "name": "Altaeron editorial PDP",
  "tag": "section",
  "class": "section-altaeron-pdp",
  "settings": [
    { "type": "checkbox", "id": "cro_v1", "label": "Use Altaeron CRO v1 copy", "default": false },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Relevance label", "default": "For Bunion Pain & Pressure" },
    { "type": "textarea", "id": "headline_override", "label": "Headline override", "default": "Walk Without Thinking About Your Feet Again." },
    { "type": "textarea", "id": "subheadline_override", "label": "Supporting copy override", "default": "Adjustable support designed to reduce bunion pressure and gently support big-toe alignment while worn." },
    { "type": "header", "content": "Rating customer avatars" },
    { "type": "image_picker", "id": "rating_avatar_1", "label": "Customer avatar 1" },
    { "type": "image_picker", "id": "rating_avatar_2", "label": "Customer avatar 2" },
    { "type": "image_picker", "id": "rating_avatar_3", "label": "Customer avatar 3" },
    { "type": "text", "id": "identity_heading", "label": "Identity list heading", "default": "You might see yourself here..." },
    { "type": "text", "id": "relief_heading", "label": "Relief card heading", "default": "Finally, Relief You Can Feel" },
    { "type": "textarea", "id": "relief_text", "label": "Relief card text", "default": "Designed to reduce bunion pressure and gently support big-toe alignment while worn, so your feet can feel more comfortable during your routine." },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "From" },
    { "type": "text", "id": "variant_label", "label": "Variant label", "default": "Device Pair" },
    { "type": "text", "id": "popular_label", "label": "Variant badge", "default": "Most Popular" },
    { "type": "text", "id": "cta_label", "label": "Default CTA", "default": "Start Walking Comfortably Again" },
    { "type": "text", "id": "order_help_heading", "label": "Order help heading", "default": "Risk-free ordering support" },
    { "type": "textarea", "id": "order_help_text", "label": "Order help text", "default": "Review the fit notes and policies, or contact us before ordering." },
    { "type": "header", "content": "Story and social proof" },
    { "type": "text", "id": "familiar_heading", "label": "Familiar section heading", "default": "Does this feel familiar?" },
    { "type": "text", "id": "reassurance_heading", "label": "Reassurance heading", "default": "If any of these feel familiar, you’re not imagining it." },
    { "type": "textarea", "id": "reassurance_text", "label": "Reassurance text", "default": "People dealing with the same frustration inspired the way Altaeron was designed." },
    { "type": "video", "id": "placeholder_video", "label": "Placeholder video" },
    { "type": "text", "id": "video_eyebrow", "label": "Video marker", "default": "See the routine" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "Imagine Leaving Home Without Thinking About Your Feet." },
    { "type": "text", "id": "reviews_heading", "label": "Reviews heading", "default": "See How Altaeron Fits Into Everyday Life" },
    { "type": "text", "id": "how_heading", "label": "How-to heading", "default": "How It Works" },
    { "type": "text", "id": "moments_heading", "label": "Lifestyle heading", "default": "Back To Moments You Missed." },
    { "type": "text", "id": "moments_subtitle", "label": "Lifestyle subtitle", "default": "Not just walking. Living." },
    { "type": "text", "id": "moments_fifth", "label": "Desktop fifth moment", "default": "Everyday plans without planning around foot pain." },
    { "type": "header", "content": "Routine" },
    { "type": "text", "id": "routine_heading", "label": "Routine heading", "default": "Make Comfort Part of Your Routine." },
    { "type": "text", "id": "routine_1_label", "label": "Routine card 1 label", "default": "Start Slow" },
    { "type": "textarea", "id": "routine_1_text", "label": "Routine card 1 description", "default": "Begin with a short, comfortable session and see how it feels." },
    { "type": "text", "id": "routine_2_label", "label": "Routine card 2 label", "default": "Adjust For Comfort" },
    { "type": "textarea", "id": "routine_2_text", "label": "Routine card 2 description", "default": "Use gentle, comfortable tension. More force isn't better." },
    { "type": "text", "id": "routine_3_label", "label": "Routine card 3 label", "default": "Build Your Routine" },
    { "type": "textarea", "id": "routine_3_text", "label": "Routine card 3 description", "default": "Gradually increase session length as comfort allows." },
    { "type": "text", "id": "bundle_label", "label": "Bundle link label", "info": "Only add a percentage when backed by actual pricing.", "default": "Build your support routine" },
    { "type": "url", "id": "bundle_link", "label": "Bundle link" },
    { "type": "header", "content": "Brand reassurance" },
    { "type": "text", "id": "values_heading", "label": "Heading", "default": "No Miracles. Just Small Changes That Add Up." },
    { "type": "text", "id": "value_1_title", "label": "Value 1 title", "default": "Helpful by design" },
    { "type": "text", "id": "value_1_text", "label": "Value 1 text", "default": "We design helpful products that support real people." },
    { "type": "text", "id": "value_2_title", "label": "Value 2 title", "default": "Consistency first" },
    { "type": "text", "id": "value_2_text", "label": "Value 2 text", "default": "We focus on consistency, not quick fixes." },
    { "type": "text", "id": "value_3_title", "label": "Value 3 title", "default": "Always improving" },
    { "type": "text", "id": "value_3_text", "label": "Value 3 text", "default": "We listen, learn, and keep improving." },
    { "type": "text", "id": "value_4_title", "label": "Value 4 title", "default": "Honest support" },
    { "type": "text", "id": "value_4_text", "label": "Value 4 text", "default": "We’re here with honest guidance and real support." },
    { "type": "text", "id": "guarantee_heading", "label": "Policy card heading", "default": "Order With Confidence" },
    { "type": "textarea", "id": "guarantee_text", "label": "Policy card text", "default": "Review our store policies and contact us if you need help before ordering." },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "You Ask, We Answer" },
    { "type": "textarea", "id": "faq_intro", "label": "FAQ intro", "default": "The answers to the questions we hear most about fit, comfort, safety, and results." },
    { "type": "text", "id": "faq_6_question", "label": "Fallback FAQ 6 question", "default": "Is it suitable for both men and women?" },
    { "type": "textarea", "id": "faq_6_answer", "label": "Fallback FAQ 6 answer", "default": "Choose the correct side and follow the product fit guidance. If you have a medical condition or are unsure whether the support is appropriate for you, consult a qualified healthcare professional." },
    { "type": "text", "id": "faq_7_question", "label": "Fallback FAQ 7 question", "default": "What if it doesn’t help me?" },
    { "type": "textarea", "id": "faq_7_answer", "label": "Fallback FAQ 7 answer", "default": "Stop using it if it causes discomfort. Review the store return policy or contact support for help with fit and available options." },
    { "type": "text", "id": "compatibility_heading", "label": "Compatibility heading", "default": "Made For The Moments When You Can Slow Down." },
    { "type": "text", "id": "shoe_1", "label": "Use case 1", "default": "Reading" },
    { "type": "text", "id": "shoe_2", "label": "Use case 2", "default": "Watching TV" },
    { "type": "text", "id": "shoe_3", "label": "Use case 3", "default": "Desk Work" },
    { "type": "text", "id": "shoe_4", "label": "Use case 4", "default": "Relaxing at Home" },
    { "type": "text", "id": "shoe_5", "label": "Use case 5", "default": "Evening Wind-Down" },
    { "type": "text", "id": "guides_heading", "label": "Guides heading", "default": "Helpful Guides" },
    { "type": "blog", "id": "learn_blog", "label": "Learn More blog" }
  ],
  "blocks": [
    {
      "type": "education_media",
      "name": "Education media",
      "settings": [
        { "type": "select", "id": "slot", "label": "Media position", "options": [
          { "value": "familiar_1", "label": "Familiar — morning pain" },
          { "value": "familiar_2", "label": "Familiar — sitting down" },
          { "value": "familiar_3", "label": "Familiar — skipping walks" },
          { "value": "familiar_4", "label": "Familiar — shoes" },
          { "value": "stage_1", "label": "Bunion stage 1" },
          { "value": "stage_2", "label": "Bunion stage 2" },
          { "value": "stage_3", "label": "Bunion stage 3" },
          { "value": "stage_4", "label": "Bunion stage 4" },
          { "value": "support_demo", "label": "Support demo (left)" },
          { "value": "support_detail", "label": "Support detail (right)" },
          { "value": "day_story", "label": "Point 4 — day story" }
        ], "default": "familiar_1" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video (Familiar, support demo, or day story)" }
      ]
    },
    { "type": "guide", "name": "Helpful guide", "limit": 3, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Helpful guide" },
      { "type": "textarea", "id": "text", "label": "Summary" },
      { "type": "url", "id": "url", "label": "Article link" }
    ] },
    {
      "type": "tail_media",
      "name": "Point 5–12 media",
      "settings": [
        { "type": "select", "id": "slot", "label": "Media position", "options": [
          { "value": "review_1", "label": "5 — Review portrait 1" },
          { "value": "review_2", "label": "5 — Review portrait 2" },
          { "value": "review_3", "label": "5 — Review portrait 3" },
          { "value": "review_4", "label": "5 — Review portrait 4" },
          { "value": "spacer", "label": "8 — Basic toe spacer" },
          { "value": "support", "label": "8 — Altaeron support" },
          { "value": "doctor", "label": "8 — Specialist portrait" },
          { "value": "moment_1", "label": "9 — Morning walks" },
          { "value": "moment_2", "label": "9 — Standing" },
          { "value": "moment_3", "label": "9 — Shopping" },
          { "value": "moment_4", "label": "9 — Vacation" },
          { "value": "moment_5", "label": "9 — Special events" },
          { "value": "guide_1", "label": "10 — Guide 1" },
          { "value": "guide_2", "label": "10 — Guide 2" },
          { "value": "guide_3", "label": "10 — Guide 3" },
          { "value": "guide_4", "label": "10 — Guide 4" },
          { "value": "cta_product", "label": "Final CTA — product" }
        ], "default": "review_1" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [{ "name": "Altaeron editorial PDP" }]
}
{% endschema %}
