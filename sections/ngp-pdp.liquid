  assign ngp_outcome_cards = ngp_mf.pdp_outcome_cards.value
  assign ngp_how_steps = ngp_mf.pdp_how_steps.value
  assign ngp_lifestyle_cards = ngp_mf.pdp_lifestyle_cards.value
