  <section class="ngp-apdp-education ngp-apdp-education--support ngp-alta-pdp-flow-section ngp-alta-pdp-flow-section--tight" aria-labelledby="AltaeronSupport-{{ section.id }}">
    <div class="ngp-apdp-shell">
      {%- assign ngp_chapter_heading_id = 'AltaeronSupport-' | append: section.id -%}
      {% render 'ngp-pdp-section-heading', number: '3', title: ngp_support_title, subtitle: ngp_support_subtitle, heading_id: ngp_chapter_heading_id %}
      <div class="ngp-apdp-support-grid">
        <div class="ngp-apdp-support__info">
          <div class="ngp-apdp-support__features">
            {%- assign ngp_support_icons = 'knob|dual-support|pressure-relief|comfort' | split: '|' -%}
            {%- for ngp_icon in ngp_support_icons -%}
              {%- capture ngp_support_title_key -%}{{ ngp_copy_prefix }}.support.item_{{ forloop.index }}_title_html{%- endcapture -%}
              {%- capture ngp_support_text_key -%}{{ ngp_copy_prefix }}.support.item_{{ forloop.index }}_text_html{%- endcapture -%}
              <article>
                <span class="ngp-apdp-support__icon">{% render 'ngp-pdp-icon', ngp_icon: ngp_icon %}</span>
                <h3>{{ ngp_support_title_key | t }}</h3>
                <p>{{ ngp_support_text_key | t }}</p>
              </article>
            {%- endfor -%}
          </div>
          <aside class="ngp-apdp-support__fit" aria-labelledby="AltaeronSupportFit-{{ section.id }}">
            <p class="ngp-apdp-support__fit-eyebrow" id="AltaeronSupportFit-{{ section.id }}">{{ ngp_copy_prefix | append: '.support.fit_heading' | t }}</p>
            <div class="ngp-apdp-support__fit-grid">
              <article>
                <span class="ngp-apdp-support__fit-icon">{% render 'ngp-pdp-icon', ngp_icon: 'age-person' %}</span>
                <p><strong>{{ ngp_copy_prefix | append: '.support.age_title' | t }}</strong><small>{{ ngp_copy_prefix | append: '.support.age_text' | t }}</small></p>
              </article>
              <article>
                <span class="ngp-apdp-support__fit-icon">{% render 'ngp-pdp-icon', ngp_icon: 'people' %}</span>
                <p><strong>{{ ngp_copy_prefix | append: '.support.unisex_title' | t }}</strong><small>{{ ngp_copy_prefix | append: '.support.unisex_text' | t }}</small></p>
              </article>
              <article>
                <span class="ngp-apdp-support__fit-icon">{% render 'ngp-pdp-icon', ngp_icon: 'sliders' %}</span>
                <p><strong>{{ ngp_copy_prefix | append: '.support.adjustable_title' | t }}</strong><small>{{ ngp_copy_prefix | append: '.support.adjustable_text' | t }}</small></p>
              </article>
              <article>
                <span class="ngp-apdp-support__fit-icon">{% render 'ngp-pdp-icon', ngp_icon: 'left-right' %}</span>
                <p><strong>{{ ngp_copy_prefix | append: '.support.either_foot_title' | t }}</strong><small>{{ ngp_copy_prefix | append: '.support.either_foot_text' | t }}</small></p>
              </article>
