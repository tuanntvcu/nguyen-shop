  <div{% if ngp_is_cro_v1 %} id="AltaeronCreated-{{ section.id }}"{% endif %} class="ngp-apdp-tail{% unless ngp_is_cro_v1 %} ngp-apdp-tail-split{% endunless %} ngp-apdp-shell ngp-alta-pdp-flow-section ngp-alta-pdp-flow-section--default-compact">
