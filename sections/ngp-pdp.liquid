          {%- for article in ngp_learn_blog.articles limit: 4 -%}
            {%- assign ngp_guide_minutes = article.id | modulo: 4 | plus: 5 -%}
            {%- assign ngp_article_summary = article.excerpt_or_content | strip_html | truncatewords: 12 -%}
