{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign ngp_is_cro_v1 = false
  assign ngp_copy_prefix = 'altaeron_pdp'
  assign ngp_comparison_number = '6'
  assign ngp_expectations_number = '7'
  assign ngp_spacer_number = '8'
  assign ngp_moments_number = '9'
  assign ngp_learn_number = '10'
  assign ngp_review_summary_number = '11'
  assign ngp_faq_number = '12'
  if section.settings.cro_v1
    assign ngp_is_cro_v1 = true
    assign ngp_copy_prefix = 'altaeron_pdp_cro_v1'
    unless request.locale.iso_code == 'en'
      assign ngp_copy_prefix = 'altaeron_pdp'
    endunless
    assign ngp_expectations_number = '6'
    assign ngp_spacer_number = '7'
    assign ngp_moments_number = '8'
    assign ngp_review_summary_number = '9'
    assign ngp_faq_number = '10'
  endif
  assign ngp_mf = product.metafields.altaeron
  assign ngp_hero_video = ngp_mf.pdp_hero_video.value
  assign ngp_hero_image = ngp_mf.pdp_hero_image.value | default: product.featured_image
  assign ngp_is_target_hero = false
  if product.handle == 'adjustable-bunion-corrector'
    assign ngp_is_target_hero = true
  endif
  assign ngp_eyebrow = section.settings.eyebrow | default: ngp_mf.pdp_eyebrow.value
  assign ngp_headline = section.settings.headline_override | default: ngp_mf.pdp_headline.value | default: product.title
  assign ngp_subheadline = section.settings.subheadline_override | default: ngp_mf.pdp_subheadline.value | default: product.description | strip_html | truncate: 180
  if ngp_is_target_hero
    assign ngp_eyebrow = ngp_copy_prefix | append: '.hero.target_eyebrow' | t
    assign ngp_headline = ngp_copy_prefix | append: '.hero.headline' | t
    assign ngp_subheadline = ngp_copy_prefix | append: '.hero.target_subheadline' | t
  endif
