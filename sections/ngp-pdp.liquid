          <li>
            <span class="ngp-apdp-stage__number">1</span><h3>{{ ngp_copy_prefix | append: '.causes.stage_1_title' | t }}</h3><p>{{ ngp_copy_prefix | append: '.causes.stage_1_text' | t }}</p>
            <div class="ngp-apdp-education__placeholder">{%- if ngp_stage_image_1 != blank -%}{{ ngp_stage_image_1 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: ngp_stage_image_1.alt | default: ngp_stage_1_alt }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
          </li>
          <li>
            <span class="ngp-apdp-stage__number">2</span><h3>{{ ngp_copy_prefix | append: '.causes.stage_2_title' | t }}</h3><p>{{ ngp_copy_prefix | append: '.causes.stage_2_text' | t }}</p>
            <div class="ngp-apdp-education__placeholder">{%- if ngp_stage_image_2 != blank -%}{{ ngp_stage_image_2 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: ngp_stage_image_2.alt | default: ngp_stage_2_alt }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
          </li>
          <li>
            <span class="ngp-apdp-stage__number">3</span><h3>{{ ngp_copy_prefix | append: '.causes.stage_3_title' | t }}</h3><p>{{ ngp_copy_prefix | append: '.causes.stage_3_text' | t }}</p>
            <div class="ngp-apdp-education__placeholder">{%- if ngp_stage_image_3 != blank -%}{{ ngp_stage_image_3 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: ngp_stage_image_3.alt | default: ngp_stage_3_alt }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
          </li>
          <li>
            <span class="ngp-apdp-stage__number">4</span><h3>{{ ngp_copy_prefix | append: '.causes.stage_4_title' | t }}</h3><p>{{ ngp_copy_prefix | append: '.causes.stage_4_text' | t }}</p>
            <div class="ngp-apdp-education__placeholder">{%- if ngp_stage_image_4 != blank -%}{{ ngp_stage_image_4 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: ngp_stage_image_4.alt | default: ngp_stage_4_alt }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
