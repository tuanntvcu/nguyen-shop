          <div class="ngp-apdp-causes__points">
            {%- for ngp_i in (1..4) -%}{%- capture ngp_cause_key -%}{{ ngp_copy_prefix }}.causes.point_{{ ngp_i }}_html{%- endcapture -%}<p><span aria-hidden="true">✓</span>{{ ngp_cause_key | t }}</p>{%- endfor -%}
          </div>
          <a class="ngp-apdp-causes__link" href="#AltaeronCreated-{{ section.id }}">{{ ngp_copy_prefix | append: '.causes.guide_link' | t }} <span aria-hidden="true">→</span></a>
        </div>
