        {% render 'ngp-pdp-section-heading', number: ngp_learn_number, title: ngp_learn_title, subtitle: ngp_learn_subtitle, heading_id: ngp_chapter_heading_id %}
        {%- liquid
          assign ngp_learn_blog = section.settings.learn_blog
