<script src="{{ 'ngp-altaeron-pdp.js' | asset_url }}" defer="defer"></script>

<div
  id="AltaeronPdp-{{ section.id }}"
  class="ngp-pdp{% if ngp_is_target_hero %} ngp-altaeron-pdp--cro-hero{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="{{ ngp_copy_prefix | append: '.common.save' | t | escape }}"
  data-save-template="{{ ngp_copy_prefix | append: '.common.save_amount' | t: amount: '[amount]' | escape }}"
  data-add-to-cart-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  {% if ngp_is_cro_v1 %}data-cro-v1="true"{% endif %}
>
  <section class="ngp-apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="ngp-apdp-shell ngp-apdp-hero__grid">
      <div class="ngp-apdp-gallery" data-apdp-gallery>
        <div class="ngp-apdp-gallery__thumbs" role="tablist" aria-label="{{ ngp_copy_prefix | append: '.accessibility.product_media' | t | escape }}">
          {%- for media in product.media -%}
            <button type="button" class="ngp-apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="ngp-apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="ngp-apdp-gallery__stage ngp-apdp-gallery__hero">
          {%- if ngp_hero_video != blank -%}
            {%- if ngp_is_target_hero -%}
              {%- liquid
                assign ngp_hero_mobile_source = blank
                assign ngp_hero_desktop_source = blank
                for ngp_hero_source in ngp_hero_video.sources
                  if ngp_hero_source.format == 'mp4'
                    if ngp_hero_desktop_source == blank or ngp_hero_source.height > ngp_hero_desktop_source.height
                      assign ngp_hero_desktop_source = ngp_hero_source
                    endif
                    if ngp_hero_source.height <= 720
                      if ngp_hero_mobile_source == blank or ngp_hero_source.height > ngp_hero_mobile_source.height
                        assign ngp_hero_mobile_source = ngp_hero_source
                      endif
                    endif
                  endif
                endfor
                assign ngp_hero_desktop_source = ngp_hero_desktop_source | default: ngp_hero_video.sources.first
                assign ngp_hero_mobile_source = ngp_hero_mobile_source | default: ngp_hero_desktop_source
                assign ngp_hero_poster = ngp_hero_video.preview_image | image_url: width: 900
              -%}
              {%- if ngp_hero_video.preview_image != blank -%}{{ ngp_hero_video.preview_image | image_url: width: 1200 | image_tag: class: 'ngp-apdp-gallery__video-poster', loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: product.title }}{%- endif -%}
              <video data-apdp-hero-video muted playsinline loop preload="none" poster="{{ ngp_hero_poster }}" aria-label="Adjustable bunion corrector product demonstration">
                {%- if ngp_hero_desktop_source.url == ngp_hero_mobile_source.url -%}
                  <source data-src="{{ ngp_hero_desktop_source.url }}" type="{{ ngp_hero_desktop_source.mime_type | default: 'video/mp4' }}">
                {%- else -%}
                  <source data-src="{{ ngp_hero_mobile_source.url }}" type="{{ ngp_hero_mobile_source.mime_type | default: 'video/mp4' }}" media="(max-width: 767px)">
                  <source data-src="{{ ngp_hero_desktop_source.url }}" type="{{ ngp_hero_desktop_source.mime_type | default: 'video/mp4' }}" media="(min-width: 768px)">
                {%- endif -%}
              </video>
            {%- else -%}
              {%- liquid
                assign ngp_hero_mobile_source = blank
                assign ngp_hero_desktop_source = blank
                for ngp_hero_source in ngp_hero_video.sources
                  if ngp_hero_source.format == 'mp4'
                    if ngp_hero_desktop_source == blank or ngp_hero_source.height > ngp_hero_desktop_source.height
                      assign ngp_hero_desktop_source = ngp_hero_source
                    endif
                    if ngp_hero_source.height <= 720
                      if ngp_hero_mobile_source == blank or ngp_hero_source.height > ngp_hero_mobile_source.height
                        assign ngp_hero_mobile_source = ngp_hero_source
                      endif
                    endif
                  endif
                endfor
                assign ngp_hero_desktop_source = ngp_hero_desktop_source | default: ngp_hero_video.sources.first
                assign ngp_hero_mobile_source = ngp_hero_mobile_source | default: ngp_hero_desktop_source
              -%}
              {%- if ngp_hero_video.preview_image != blank -%}{{ ngp_hero_video.preview_image | image_url: width: 1200 | image_tag: class: 'ngp-apdp-gallery__video-poster', loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: product.title }}{%- endif -%}
              <video data-apdp-hero-video muted playsinline loop preload="none" poster="{{ ngp_hero_poster }}" aria-label="Adjustable bunion corrector product demonstration">
                {%- if ngp_hero_desktop_source.url == ngp_hero_mobile_source.url -%}
                  <source data-src="{{ ngp_hero_desktop_source.url }}" type="{{ ngp_hero_desktop_source.mime_type | default: 'video/mp4' }}">
                {%- else -%}
                  <source data-src="{{ ngp_hero_mobile_source.url }}" type="{{ ngp_hero_mobile_source.mime_type | default: 'video/mp4' }}" media="(max-width: 767px)">
                  <source data-src="{{ ngp_hero_desktop_source.url }}" type="{{ ngp_hero_desktop_source.mime_type | default: 'video/mp4' }}" media="(min-width: 768px)">
                {%- endif -%}
              </video>
            {%- endif -%}
          {%- elsif ngp_hero_image != blank -%}
            {{ ngp_hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: ngp_hero_image.alt | default: product.title }}
          {%- else -%}
            <div class="ngp-apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        <div class="ngp-apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="ngp-apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {%- liquid
                assign ngp_media_loading = 'lazy'
                assign ngp_media_priority = 'auto'
                if forloop.first
                  assign ngp_media_loading = 'eager'
                  assign ngp_media_priority = 'high'
                endif
              -%}
              {% render 'ngp-pdp-media', media: media, product: product, loading: ngp_media_loading, fetchpriority: ngp_media_priority, sizes: '(min-width: 1024px) 560px, 55vw' %}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="ngp-apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="{{ 'products.product.media.open_media' | t: index: forloop.index | escape }}"><span aria-hidden="true">{% render 'ngp-icon-zoom' %}</span></button>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="ngp-apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>
      </div>

      {%- if ngp_is_target_hero -%}<div class="ngp-apdp-hero__copy">{%- endif -%}
      <div class="ngp-apdp-narrative">
        <p class="ngp-apdp-eyebrow"><span>{{ ngp_eyebrow }}</span></p>
        <h1 id="AltaeronTitle-{{ section.id }}"><span class="ngp-apdp-title-lines">{{ ngp_headline }}</span></h1>
        <p class="ngp-apdp-narrative__subhead">{{ ngp_subheadline }}</p>
        <a class="ngp-apdp-rating" href="#AltaeronVerified-{{ section.id }}" aria-label="{{ ngp_hero_rating_label | escape }}">
          <span class="ngp-apdp-rating__people" aria-hidden="true">
            {%- for ngp_i in (1..3) -%}
              {%- capture ngp_avatar_key -%}rating_avatar_{{ ngp_i }}{%- endcapture -%}
              {%- assign ngp_rating_avatar = section.settings[ngp_avatar_key] -%}
              <i>{%- if ngp_rating_avatar != blank -%}{{ ngp_rating_avatar | image_url: width: 96 | image_tag: loading: 'eager', widths: '48, 72, 96', sizes: '34px', alt: '' }}{%- endif -%}</i>
            {%- endfor -%}
          </span>{% render 'ngp-pdp-stars', rating: ngp_review_rating %}<strong>{% if ngp_is_target_hero %}{{ ngp_copy_prefix | append: '.hero.target_rating_html' | t: rating: ngp_hero_rating_display, count: ngp_review_count }}{% else %}{{ ngp_hero_rating_label }}{% endif %}</strong>
        </a>
        {%- unless ngp_is_target_hero -%}<div class="ngp-apdp-mobile-product" aria-hidden="true">
          {%- if ngp_how_image != blank -%}{{ ngp_how_image | image_url: width: 720 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '360, 540, 720', sizes: '55vw', alt: '' }}{%- endif -%}
        </div>{%- endunless -%}
        {%- unless ngp_is_target_hero -%}<div class="ngp-apdp-identity"><ul>{%- for ngp_i in (1..3) -%}{%- capture ngp_benefit_key -%}{{ ngp_copy_prefix }}.hero.benefit_{{ ngp_i }}{%- endcapture -%}<li>{% render 'ngp-pdp-icon', ngp_icon: 'check' %}<span>{{ ngp_benefit_key | t }}</span></li>{%- endfor -%}</ul></div>{%- endunless -%}
      </div>
      {%- if ngp_is_target_hero -%}
        <div class="ngp-apdp-hero__conversion">
          <div class="ngp-apdp-identity"><ul>
            <li>{% render 'ngp-pdp-icon', ngp_icon: 'check' %}<span>{{ ngp_copy_prefix | append: '.hero.target_benefit_1' | t }}</span></li>
            <li>{% render 'ngp-pdp-icon', ngp_icon: 'check' %}<span>{{ ngp_copy_prefix | append: '.hero.target_benefit_2' | t }}</span></li>
            <li>{% render 'ngp-pdp-icon', ngp_icon: 'check' %}<span>{{ ngp_copy_prefix | append: '.hero.target_benefit_3' | t }}</span></li>
          </ul></div>
          <div class="ngp-apdp-hero__purchase">
            <p class="ngp-apdp-hero__price"><span>{{ ngp_copy_prefix | append: '.hero.from' | t }}</span> <strong>{{ product.price_min | money }}</strong></p>
            <a class="ngp-apdp-button ngp-apdp-button--primary ngp-apdp-hero__cta" href="#AltaeronBundles-{{ section.id }}" data-apdp-bundle-cta>{{ ngp_copy_prefix | append: '.hero.choose_bundle' | t }} <span aria-hidden="true">&rarr;</span></a>
            <p class="ngp-apdp-hero__reassurance">{{ ngp_copy_prefix | append: '.buy.guarantee_title' | t }} <span aria-hidden="true">&middot;</span> {{ ngp_copy_prefix | append: '.buy.secure' | t }}</p>
          </div>
        </div>
      </div>
      {%- endif -%}

      <aside id="AltaeronBuy-{{ section.id }}" class="ngp-apdp-buy" aria-label="{{ ngp_copy_prefix | append: '.accessibility.purchase_product' | t: product: product.title | escape }}"{% if ngp_is_target_hero %} data-apdp-primary-purchase{% endif %}>
        <a class="ngp-apdp-buy__rating" href="#AltaeronVerified-{{ section.id }}">{% render 'ngp-pdp-stars', rating: ngp_review_rating %}<strong>{{ ngp_buy_rating_label }}</strong></a>
        {%- if product.handle == 'adjustable-bunion-corrector' -%}{%- render 'ngp-labor-day-promotion', section: section -%}{%- endif -%}
        <h2 class="ngp-apdp-buy__title">{{ ngp_copy_prefix | append: '.buy.title' | t }}</h2>
        <div class="ngp-apdp-buy__price-line">
          <div><p class="ngp-apdp-buy__from">{{ section.settings.price_label }}</p><div class="ngp-apdp-price" aria-live="polite"><span class="ngp-apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="ngp-apdp-price__compare" data-apdp-compare-price{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_compare_price | money }}</s></div></div>
          <span class="ngp-apdp-price__save" data-apdp-savings{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_copy_prefix | append: '.common.save_amount' | t: amount: ngp_savings_money }}</span>
        </div>
        {%- form 'product', product, id: ngp_product_form_id, class: 'ngp-apdp-form main-product-form', is: 'ngp-product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="ngp-product-form__error-message-wrapper" role="alert" hidden><div class="ngp-product-form__error-message alert alert--error" role="alert" hidden></div></div>
          {%- unless product.has_only_default_variant -%}
            <fieldset class="ngp-apdp-variants">
              <legend>{{ ngp_copy_prefix | append: '.buy.variant_label' | t }} <span>{{ ngp_copy_prefix | append: '.buy.popular' | t }}</span></legend>
              {%- if product.variants.size > 6 -%}
                <label class="visually-hidden" for="AltaeronVariant-{{ section.id }}">{{ section.settings.variant_label }}</label>
                <select id="AltaeronVariant-{{ section.id }}" data-apdp-variant-select>{%- for variant in product.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}</select>
              {%- else -%}
                <div class="ngp-apdp-variants__grid">{%- for variant in product.variants limit: 3 -%}{%- capture ngp_variant_key -%}{{ ngp_copy_prefix }}.buy.variant_{{ forloop.index }}{%- endcapture -%}<input class="visually-hidden" type="radio" id="AltaeronVariant-{{ section.id }}-{{ variant.id }}" name="apdp-variant" value="{{ variant.id }}" data-apdp-variant-option data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} checked{% endif %}><label for="AltaeronVariant-{{ section.id }}-{{ variant.id }}">{{ ngp_variant_key | t }}</label>{%- endfor -%}</div>
              {%- endif -%}
            </fieldset>
          {%- endunless -%}
          <bundle-deals-widget{% if ngp_is_target_hero %} id="AltaeronBundles-{{ section.id }}" tabindex="-1"{% endif %} product-id="{{ product.id }}"></bundle-deals-widget>
          <button type="submit" name="add" class="ngp-apdp-button ngp-apdp-button--primary ngp-product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ ngp_copy_prefix | append: '.buy.cta' | t }}">{% if current_variant.available %}{{ ngp_copy_prefix | append: '.buy.cta' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span><b data-apdp-cta-price{% unless current_variant.available %} hidden{% endunless %}> — {{ current_variant.price | money }}</b></span>{% render 'ngp-pdp-icon', ngp_icon: 'cart' %}<span class="loading__spinner hidden">{% render 'ngp-loading-spinner' %}</span></button>
          <div class="ngp-apdp-payment-terms" data-apdp-installments>{{ ngp_copy_prefix | append: '.buy.installments' | t }} <strong>shop<span>Pay</span></strong></div>
          {%- capture ngp_social_proof_count -%}<strong data-apdp-social-proof-count></strong>{%- endcapture -%}
          <p
            class="ngp-apdp-social-proof"
            data-apdp-social-proof
            data-store-date="{{ 'now' | date: '%Y-%m-%d' }}"
            data-store-utc-offset="{{ 'now' | date: '%z' }}"
            hidden
          >{{ ngp_copy_prefix | append: '.buy.social_proof_html' | t: count: ngp_social_proof_count }}</p>
        {%- endform -%}
        <div class="ngp-apdp-buy__policy">{% render 'ngp-pdp-icon', ngp_icon: 'shield' %}<div><strong>{{ ngp_copy_prefix | append: '.buy.guarantee_title' | t }}</strong><p>{{ ngp_copy_prefix | append: '.buy.guarantee_line_1' | t }}<br>{{ ngp_copy_prefix | append: '.buy.guarantee_line_2' | t }}</p></div></div>
        {%- if ngp_micro_review != blank -%}
          {%- liquid
            assign ngp_micro_review_body = ngp_micro_review.body.value | default: ngp_micro_review.body | strip_html | strip
            assign ngp_micro_review_name = ngp_micro_review.reviewer_name.value | default: ngp_micro_review.reviewer_name | strip
            assign ngp_micro_review_rating = ngp_micro_review.rating.value | default: ngp_micro_review.rating | plus: 0
          -%}
          <figure class="ngp-apdp-micro-review">
            <div>{% render 'ngp-pdp-stars', rating: ngp_micro_review_rating %}<strong>{{ ngp_copy_prefix | append: '.reviews.customer_review' | t }}</strong></div>
            <blockquote>“{{ ngp_micro_review_body | truncatewords: 28 | escape }}”</blockquote>
            <figcaption>— {{ ngp_micro_review_name | escape }} <a href="#AltaeronVerified-{{ section.id }}">{{ ngp_copy_prefix | append: '.reviews.read_all' | t }} <span aria-hidden="true">→</span></a></figcaption>
          </figure>
        {%- endif -%}
        <p class="ngp-apdp-buy__bonus"><span aria-hidden="true">🎁</span> <strong>{{ ngp_copy_prefix | append: '.buy.guide_bonus' | t }}</strong></p>
        <div class="ngp-apdp-buy__trust">
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{% render 'ngp-pdp-icon', ngp_icon: 'truck' %}<span><b>{{ ngp_copy_prefix | append: '.buy.shipping' | t }}</b><small>{{ ngp_copy_prefix | append: '.buy.shipping_note' | t }}</small></span></a>
          <span>{% render 'ngp-pdp-icon', ngp_icon: 'shield' %}<span><b>{{ ngp_copy_prefix | append: '.buy.warranty' | t }}</b><small>{{ ngp_copy_prefix | append: '.buy.warranty_note' | t }}</small></span></span>
          <span>{% render 'ngp-pdp-icon', ngp_icon: 'lock' %}<span><b>{{ ngp_copy_prefix | append: '.buy.secure' | t }}</b><small>{{ ngp_copy_prefix | append: '.buy.secure_note' | t }}</small></span></span>
          <a href="/pages/contact">{% render 'ngp-pdp-icon', ngp_icon: 'support' %}<span><b>{{ ngp_copy_prefix | append: '.buy.support' | t }}</b><small>{{ ngp_copy_prefix | append: '.buy.support_note' | t }}</small></span></a>
        </div>
        {%- if shop.enabled_payment_types.size > 0 -%}<ul class="ngp-apdp-payment-icons list list-payment" role="list" aria-label="{{ ngp_copy_prefix | append: '.accessibility.accepted_payment_methods' | t | escape }}">{%- for ngp_type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ ngp_type | payment_type_svg_tag: class: 'ngp_icon icon--full-color' }}</li>{%- endfor -%}</ul>{%- endif -%}
      </aside>

      {%- if ngp_is_target_hero -%}
        <aside class="ngp-apdp-compact-expert" aria-label="{{ 'altaeron_pdp.accessibility.product_guidance' | t | escape }}">
          <div class="ngp-apdp-shell ngp-apdp-compact-expert__inner">
            <div class="ngp-apdp-compact-expert__portrait">
              <img src="{{ 'ngp-altaeron-expert-portrait.png' | asset_url }}" width="1024" height="1536" loading="lazy" alt="{{ 'altaeron_pdp.accessibility.expert_portrait' | t | escape }}">
            </div>
            <div class="ngp-apdp-compact-expert__profile">
              <small>{{ 'altaeron_pdp.expert.reviewed_by' | t }}</small>
              <strong>{{ 'altaeron_pdp.expert.name' | t }}</strong>
              <span>{{ 'altaeron_pdp.expert.role' | t }}</span>
            </div>
            <a href="#AltaeronMedicalReview-{{ section.id }}" data-apdp-medical-review-link>{{ 'altaeron_pdp.expert.read_review' | t }} <span aria-hidden="true">&rarr;</span></a>
          </div>
        </aside>
      {%- endif -%}
    </div>
  </section>

  <section class="ngp-apdp-education ngp-apdp-education--familiar ngp-alta-pdp-flow-section ngp-alta-pdp-flow-section--tight" aria-labelledby="AltaeronFamiliar-{{ section.id }}">
    <div class="ngp-apdp-shell">
      {%- assign ngp_chapter_heading_id = 'AltaeronFamiliar-' | append: section.id -%}
      {% render 'ngp-pdp-section-heading', number: '1', title: ngp_familiar_title, subtitle: ngp_familiar_subtitle, heading_id: ngp_chapter_heading_id %}
      <div class="ngp-apdp-familiar-grid">
        {%- for ngp_i in (1..4) -%}
          {%- capture ngp_familiar_key -%}{{ ngp_copy_prefix }}.familiar.item_{{ ngp_i }}{%- endcapture -%}
          {%- assign ngp_copy = ngp_familiar_key | t -%}
          {%- liquid
            case forloop.index
              when 1
                assign ngp_familiar_image = ngp_familiar_image_1
                assign ngp_familiar_video = ngp_familiar_video_1
              when 2
                assign ngp_familiar_image = ngp_familiar_image_2
                assign ngp_familiar_video = ngp_familiar_video_2
              when 3
                assign ngp_familiar_image = ngp_familiar_image_3
                assign ngp_familiar_video = ngp_familiar_video_3
              when 4
                assign ngp_familiar_image = ngp_familiar_image_4
                assign ngp_familiar_video = ngp_familiar_video_4
            endcase
          -%}
          <article class="ngp-apdp-familiar-card">
            <div class="ngp-apdp-education__placeholder">
              {%- if ngp_familiar_video != blank -%}
                {%- capture ngp_familiar_video_markup -%}{{ ngp_familiar_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '900x' }}{%- endcapture -%}
                {{- ngp_familiar_video_markup | replace: '<video ', '<video data-apdp-lazy-video ' | replace: '<source src="', '<source data-src="' -}}
              {%- elsif ngp_familiar_image != blank -%}
                {{ ngp_familiar_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 768px) 25vw, 76vw', alt: ngp_familiar_image.alt | default: ngp_copy }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <p>{{ ngp_copy }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="ngp-apdp-education ngp-apdp-education--causes ngp-alta-pdp-flow-section ngp-alta-pdp-flow-section--default-compact" aria-labelledby="AltaeronCauses-{{ section.id }}">
    <div class="ngp-apdp-shell">
      <div class="ngp-apdp-causes-grid">
        <div class="ngp-apdp-causes__intro">
          {%- assign ngp_chapter_heading_id = 'AltaeronCauses-' | append: section.id -%}
