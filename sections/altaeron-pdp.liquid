{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.altaeron
  assign hero_image = mf.pdp_hero_image.value | default: product.featured_image
  assign eyebrow = section.settings.eyebrow | default: mf.pdp_eyebrow.value
  assign headline = section.settings.headline_override | default: mf.pdp_headline.value | default: product.title
  assign subheadline = section.settings.subheadline_override | default: mf.pdp_subheadline.value | default: product.description | strip_html | truncate: 180
  assign identity_points = mf.pdp_identity_points.value
  assign outcome_cards = mf.pdp_outcome_cards.value
  assign how_steps = mf.pdp_how_steps.value
  assign lifestyle_cards = mf.pdp_lifestyle_cards.value
  assign compatibility_items = mf.pdp_compatibility_items.value
  assign faq_items = mf.pdp_faq_items.value
  assign guide_cards = mf.pdp_guide_cards.value
  assign guide_blocks = section.blocks | where: 'type', 'guide'
  assign related_products = mf.pdp_related_products.value
  assign custom_reviews = mf.pdp_reviews.value
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign reviews = custom_reviews | default: review_data.reviews
  assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
  assign review_rating = review_data.average_rating | default: 0 | plus: 0
  if review_count == 0 and custom_reviews != blank
    assign review_count = custom_reviews.size
    assign review_rating_total = 0
    for custom_review in custom_reviews
      assign custom_review_rating = custom_review.rating.value | default: custom_review.rating | plus: 0
      assign review_rating_total = review_rating_total | plus: custom_review_rating
    endfor
    assign review_rating = review_rating_total | times: 1.0 | divided_by: review_count | round: 1
  endif
  assign hero_rating_label = 'altaeron_pdp.hero.rating' | t: rating: review_rating, count: review_count
  assign buy_rating_label = 'altaeron_pdp.buy.rating' | t: rating: review_rating, count: review_count
  assign final_cta_rating_label = 'altaeron_pdp.final_cta.rating' | t: rating: review_rating, count: review_count
  assign placeholder_video = shop.metafields.custom.homepage_demo_video.value | default: section.settings.placeholder_video
  assign story_video = mf.pdp_video.value | default: placeholder_video
  assign product_form_id = 'product-form-' | append: section.id
  assign compare_price = current_variant.compare_at_price
  assign savings = 0
  if compare_price > current_variant.price
    assign savings = compare_price | minus: current_variant.price
  endif
  assign savings_money = savings | money
  assign stage_1_alt = 'altaeron_pdp.causes.stage_1_alt' | t
  assign stage_2_alt = 'altaeron_pdp.causes.stage_2_alt' | t
  assign stage_3_alt = 'altaeron_pdp.causes.stage_3_alt' | t
  assign stage_4_alt = 'altaeron_pdp.causes.stage_4_alt' | t
  assign support_demo_alt = 'altaeron_pdp.support.demo_alt' | t
  assign support_detail_alt = 'altaeron_pdp.support.detail_alt' | t
  assign day_image_alt = 'altaeron_pdp.day.image_alt' | t
  assign spacer_basic_alt = 'altaeron_pdp.spacer.basic_alt' | t
  assign spacer_altaeron_alt = 'altaeron_pdp.spacer.altaeron_alt' | t
  assign spacer_expert_alt = 'altaeron_pdp.spacer.expert_alt' | t
  assign familiar_title = 'altaeron_pdp.familiar.title' | t
  assign familiar_subtitle = 'altaeron_pdp.familiar.subtitle' | t
  assign causes_title = 'altaeron_pdp.causes.title' | t
  assign causes_subtitle = 'altaeron_pdp.causes.subtitle' | t
  assign support_title = 'altaeron_pdp.support.title' | t
  assign support_subtitle = 'altaeron_pdp.support.subtitle' | t
  assign day_title = 'altaeron_pdp.day.title' | t
  assign day_heading_subtitle = 'altaeron_pdp.day.subtitle_html' | t
  assign reviews_title = 'altaeron_pdp.reviews.title' | t
  assign reviews_subtitle = 'altaeron_pdp.reviews.subtitle' | t: count: review_count
  assign comparison_title = 'altaeron_pdp.comparison.title' | t
  assign expectations_title = 'altaeron_pdp.expectations.title' | t
  assign spacer_title = 'altaeron_pdp.spacer.title' | t
  assign spacer_subtitle = 'altaeron_pdp.spacer.subtitle' | t
  assign moments_title = 'altaeron_pdp.moments.title' | t
  assign moments_subtitle = 'altaeron_pdp.moments.subtitle' | t
  assign learn_title = 'altaeron_pdp.learn.title' | t
  assign learn_subtitle = 'altaeron_pdp.learn.subtitle' | t
  assign faq_title = 'altaeron_pdp.faq.title' | t
  assign how_image = mf.pdp_how_image.value | default: product.images[1] | default: product.featured_image
  for block in section.blocks
    if block.type == 'education_media'
      case block.settings.slot
        when 'familiar_1'
          assign familiar_image_1 = block.settings.image
          assign familiar_video_1 = block.settings.video
        when 'familiar_2'
          assign familiar_image_2 = block.settings.image
          assign familiar_video_2 = block.settings.video
        when 'familiar_3'
          assign familiar_image_3 = block.settings.image
          assign familiar_video_3 = block.settings.video
        when 'familiar_4'
          assign familiar_image_4 = block.settings.image
          assign familiar_video_4 = block.settings.video
        when 'stage_1'
          assign stage_image_1 = block.settings.image
        when 'stage_2'
          assign stage_image_2 = block.settings.image
        when 'stage_3'
          assign stage_image_3 = block.settings.image
        when 'stage_4'
          assign stage_image_4 = block.settings.image
        when 'support_demo'
          assign support_demo_image = block.settings.image
          assign support_demo_video = block.settings.video
        when 'support_detail'
          assign support_detail_image = block.settings.image
        when 'day_story'
          assign day_story_image = block.settings.image
          assign day_story_video = block.settings.video
      endcase
    elsif block.type == 'tail_media'
      case block.settings.slot
        when 'review_1'
          assign tail_review_1 = block.settings.image
        when 'review_2'
          assign tail_review_2 = block.settings.image
        when 'review_3'
          assign tail_review_3 = block.settings.image
        when 'review_4'
          assign tail_review_4 = block.settings.image
        when 'spacer'
          assign tail_spacer = block.settings.image
        when 'support'
          assign tail_support = block.settings.image
        when 'doctor'
          assign tail_doctor = block.settings.image
        when 'moment_1'
          assign tail_moment_1 = block.settings.image
        when 'moment_2'
          assign tail_moment_2 = block.settings.image
        when 'moment_3'
          assign tail_moment_3 = block.settings.image
        when 'moment_4'
          assign tail_moment_4 = block.settings.image
        when 'moment_5'
          assign tail_moment_5 = block.settings.image
        when 'guide_1'
          assign tail_guide_1 = block.settings.image
        when 'guide_2'
          assign tail_guide_2 = block.settings.image
        when 'guide_3'
          assign tail_guide_3 = block.settings.image
        when 'guide_4'
          assign tail_guide_4 = block.settings.image
        when 'cta_product'
          assign tail_cta_product = block.settings.image
      endcase
    endif
  endfor
-%}

{{ 'altaeron-pdp.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'altaeron-pdp.js' | asset_url }}" defer="defer"></script>

<div id="AltaeronPdp-{{ section.id }}" class="altaeron-pdp" data-section="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-money-format="{{ shop.money_format | escape }}" data-save-label="{{ 'altaeron_pdp.common.save' | t | escape }}" data-add-to-cart-label="{{ 'products.product.add_to_cart' | t | escape }}" data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}">
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="{{ 'altaeron_pdp.accessibility.product_media' | t | escape }}">
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage apdp-gallery__hero">
          {%- if hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: product.title }}
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {%- liquid
                assign media_loading = 'lazy'
                assign media_priority = 'auto'
                if forloop.first
                  assign media_loading = 'eager'
                  assign media_priority = 'high'
                endif
              -%}
              {% render 'altaeron-pdp-media', media: media, product: product, loading: media_loading, fetchpriority: media_priority, sizes: '(min-width: 1024px) 560px, 55vw' %}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="{{ 'products.product.media.open_media' | t: index: forloop.index | escape }}"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>
      </div>

      <div class="apdp-narrative">
        <p class="apdp-eyebrow"><strong>{{ 'altaeron_pdp.hero.eyebrow_rank' | t }}</strong><span>{{ 'altaeron_pdp.hero.eyebrow_category' | t }}</span></p>
        <h1 id="AltaeronTitle-{{ section.id }}" aria-label="{{ 'altaeron_pdp.hero.headline' | t | escape }}"><span class="apdp-title-desktop" aria-hidden="true"><span>{{ 'altaeron_pdp.hero.headline_line_1' | t }}</span><span>{{ 'altaeron_pdp.hero.headline_line_2' | t }}</span><span>{{ 'altaeron_pdp.hero.headline_line_3' | t }}</span></span><span class="apdp-title-mobile" aria-hidden="true"><span>{{ 'altaeron_pdp.hero.headline_line_1' | t }}</span><span>{{ 'altaeron_pdp.hero.headline_line_2' | t }}</span><span>{{ 'altaeron_pdp.hero.headline_line_3' | t }}</span></span></h1>
        <p class="apdp-narrative__subhead">{{ 'altaeron_pdp.hero.subheadline' | t }}</p>
        <a class="apdp-rating" href="#AltaeronReviews-{{ section.id }}" aria-label="{{ hero_rating_label | escape }}">
          <span class="apdp-rating__people" aria-hidden="true"><i></i><i></i><i></i></span>{% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{{ hero_rating_label }}</strong>
        </a>
        <div class="apdp-mobile-product" aria-hidden="true">
          {%- if how_image != blank -%}{{ how_image | image_url: width: 720 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '360, 540, 720', sizes: '55vw', alt: '' }}{%- endif -%}
        </div>
        <div class="apdp-identity"><ul>{%- for i in (1..4) -%}{%- capture benefit_key -%}altaeron_pdp.hero.benefit_{{ i }}{%- endcapture -%}<li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ benefit_key | t }}</span></li>{%- endfor -%}</ul></div>
      </div>

      <aside id="AltaeronBuy-{{ section.id }}" class="apdp-buy" aria-label="{{ 'altaeron_pdp.accessibility.purchase_product' | t: product: product.title | escape }}">
        <h2 class="apdp-buy__title">{{ 'altaeron_pdp.buy.title' | t }}</h2>
        <a class="apdp-buy__rating" href="#AltaeronReviews-{{ section.id }}">{% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{{ buy_rating_label }}</strong></a>
        <div class="apdp-buy__price-line">
          <div><p class="apdp-buy__from">{{ section.settings.price_label }}</p><div class="apdp-price" aria-live="polite"><span class="apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="apdp-price__compare" data-apdp-compare-price{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></div></div>
          <span class="apdp-price__save" data-apdp-savings{% if savings <= 0 %} hidden{% endif %}>{{ 'altaeron_pdp.common.save_amount' | t: amount: savings_money }}</span>
        </div>
        {%- form 'product', product, id: product_form_id, class: 'apdp-form main-product-form', is: 'product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="product-form__error-message-wrapper" role="alert" hidden><div class="product-form__error-message alert alert--error" role="alert" hidden></div></div>
          {%- unless product.has_only_default_variant -%}
            <fieldset class="apdp-variants">
              <legend>{{ 'altaeron_pdp.buy.variant_label' | t }} <span>{{ 'altaeron_pdp.buy.popular' | t }}</span></legend>
              {%- if product.variants.size > 6 -%}
                <label class="visually-hidden" for="AltaeronVariant-{{ section.id }}">{{ section.settings.variant_label }}</label>
                <select id="AltaeronVariant-{{ section.id }}" data-apdp-variant-select>{%- for variant in product.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}</select>
              {%- else -%}
                <div class="apdp-variants__grid">{%- for variant in product.variants limit: 3 -%}{%- capture variant_key -%}altaeron_pdp.buy.variant_{{ forloop.index }}{%- endcapture -%}<input class="visually-hidden" type="radio" id="AltaeronVariant-{{ section.id }}-{{ variant.id }}" name="apdp-variant" value="{{ variant.id }}" data-apdp-variant-option data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} checked{% endif %}><label for="AltaeronVariant-{{ section.id }}-{{ variant.id }}">{{ variant_key | t }}</label>{%- endfor -%}</div>
              {%- endif -%}
            </fieldset>
          {%- endunless -%}
          <bundle-deals-widget product-id="{{ product.id }}"></bundle-deals-widget>
          <button type="submit" name="add" class="apdp-button apdp-button--primary product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ 'altaeron_pdp.buy.cta' | t }}">{% if current_variant.available %}{{ 'altaeron_pdp.buy.cta' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span><b data-apdp-cta-price{% unless current_variant.available %} hidden{% endunless %}> — {{ current_variant.price | money }}</b></span>{% render 'altaeron-pdp-icon', icon: 'cart' %}<span class="loading__spinner hidden">{% render 'loading-spinner' %}</span></button>
          <div class="apdp-payment-terms" data-apdp-installments>{{ 'altaeron_pdp.buy.installments' | t }} <strong>shop<span>Pay</span></strong></div>
        {%- endform -%}
        <div class="apdp-buy__policy">{% render 'altaeron-pdp-icon', icon: 'shield' %}<div><strong>{{ 'altaeron_pdp.buy.guarantee_title' | t }}</strong><p>{{ 'altaeron_pdp.buy.guarantee_line_1' | t }}<br>{{ 'altaeron_pdp.buy.guarantee_line_2' | t }}</p></div></div>
        <div class="apdp-buy__trust">
          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{% render 'altaeron-pdp-icon', icon: 'return' %}<span><b>{{ 'altaeron_pdp.buy.returns' | t }}</b><small>{{ 'altaeron_pdp.buy.returns_note' | t }}</small></span></a>
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{% render 'altaeron-pdp-icon', icon: 'truck' %}<span><b>{{ 'altaeron_pdp.buy.shipping' | t }}</b><small>{{ 'altaeron_pdp.buy.shipping_note' | t }}</small></span></a>
          <span>{% render 'altaeron-pdp-icon', icon: 'lock' %}<span><b>{{ 'altaeron_pdp.buy.secure' | t }}</b><small>{{ 'altaeron_pdp.buy.secure_note' | t }}</small></span></span>
          <a href="/pages/contact">{% render 'altaeron-pdp-icon', icon: 'support' %}<span><b>{{ 'altaeron_pdp.buy.support' | t }}</b><small>{{ 'altaeron_pdp.buy.support_note' | t }}</small></span></a>
        </div>
        {%- if shop.enabled_payment_types.size > 0 -%}<ul class="apdp-payment-icons list list-payment" role="list" aria-label="{{ 'altaeron_pdp.accessibility.accepted_payment_methods' | t | escape }}">{%- for type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul>{%- endif -%}
      </aside>
    </div>
  </section>

  <section class="apdp-expert alta-pdp-flow-section alta-pdp-flow-section--hero-authority" aria-label="{{ 'altaeron_pdp.accessibility.product_guidance' | t | escape }}">
    <div class="apdp-shell apdp-expert__panel">
      <div class="apdp-expert__portrait">
        <img src="{{ 'altaeron-expert-portrait.png' | asset_url }}" width="1024" height="1536" loading="lazy" alt="{{ 'altaeron_pdp.accessibility.expert_portrait' | t | escape }}">
      </div>
      <div class="apdp-expert__profile">
        <small>{{ 'altaeron_pdp.expert.reviewed_by' | t }}</small>
        <h2>{{ 'altaeron_pdp.expert.name' | t }}</h2>
        <p>{{ 'altaeron_pdp.expert.role' | t }}</p>
        <strong>{{ 'altaeron_pdp.expert.experience' | t }}</strong>
        <span class="apdp-expert__signature">{{ 'altaeron_pdp.expert.signature' | t }}</span>
      </div>
      <blockquote>
        <span aria-hidden="true">“</span>
        <p>{{ 'altaeron_pdp.expert.quote' | t }} <b aria-hidden="true">”</b></p>
      </blockquote>
      <div class="apdp-expert__criteria">
        <strong>{{ 'altaeron_pdp.expert.criteria_heading' | t }}</strong>
        <ul>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %} {{ 'altaeron_pdp.expert.criterion_1' | t }}</li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %} {{ 'altaeron_pdp.expert.criterion_2' | t }}</li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %} {{ 'altaeron_pdp.expert.criterion_3' | t }}</li>
        </ul>
        <p>{{ 'altaeron_pdp.expert.criteria_footer' | t }}</p>
      </div>
      <div class="apdp-expert__press" aria-label="{{ 'altaeron_pdp.accessibility.publications' | t | escape }}">
        <span>WebMD</span><span>healthline</span><span>Verywell<span>health</span></span><span>yahoo!<b>life</b></span><span>CNN</span>
      </div>
    </div>
  </section>

  <section class="apdp-education apdp-education--familiar alta-pdp-flow-section alta-pdp-flow-section--tight" aria-labelledby="AltaeronFamiliar-{{ section.id }}">
    <div class="apdp-shell">
      {%- assign chapter_heading_id = 'AltaeronFamiliar-' | append: section.id -%}
      {% render 'altaeron-pdp-section-heading', number: '1', title: familiar_title, subtitle: familiar_subtitle, heading_id: chapter_heading_id %}
      <div class="apdp-familiar-grid">
        {%- for i in (1..4) -%}
          {%- capture familiar_key -%}altaeron_pdp.familiar.item_{{ i }}{%- endcapture -%}
          {%- assign copy = familiar_key | t -%}
          {%- liquid
            case forloop.index
              when 1
                assign familiar_image = familiar_image_1
                assign familiar_video = familiar_video_1
              when 2
                assign familiar_image = familiar_image_2
                assign familiar_video = familiar_video_2
              when 3
                assign familiar_image = familiar_image_3
                assign familiar_video = familiar_video_3
              when 4
                assign familiar_image = familiar_image_4
                assign familiar_video = familiar_video_4
            endcase
          -%}
          <article class="apdp-familiar-card">
            <div class="apdp-education__placeholder">
              {%- if familiar_video != blank -%}
                {{ familiar_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '900x' }}
              {%- elsif familiar_image != blank -%}
                {{ familiar_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 768px) 25vw, 76vw', alt: familiar_image.alt | default: copy }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <p>{{ copy }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="apdp-education apdp-education--causes alta-pdp-flow-section alta-pdp-flow-section--default-compact" aria-labelledby="AltaeronCauses-{{ section.id }}">
    <div class="apdp-shell">
      <div class="apdp-causes-grid">
        <div class="apdp-causes__intro">
          {%- assign chapter_heading_id = 'AltaeronCauses-' | append: section.id -%}
          {% render 'altaeron-pdp-section-heading', number: '2', title: causes_title, subtitle: causes_subtitle, heading_id: chapter_heading_id %}
          <div class="apdp-causes__points">
            {%- for i in (1..4) -%}{%- capture cause_key -%}altaeron_pdp.causes.point_{{ i }}_html{%- endcapture -%}<p><span aria-hidden="true">✓</span>{{ cause_key | t }}</p>{%- endfor -%}
          </div>
          <a class="apdp-causes__link" href="#AltaeronCreated-{{ section.id }}">{{ 'altaeron_pdp.causes.guide_link' | t }} <span aria-hidden="true">→</span></a>
        </div>
        <ol class="apdp-causes__stages">
          <li>
            <span class="apdp-stage__number">1</span><h3>{{ 'altaeron_pdp.causes.stage_1_title' | t }}</h3><p>{{ 'altaeron_pdp.causes.stage_1_text' | t }}</p>
