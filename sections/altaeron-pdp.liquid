{{ 'altaeron-pdp.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'altaeron-pdp.js' | asset_url }}" defer="defer"></script>

<div
  id="AltaeronPdp-{{ section.id }}"
  class="altaeron-pdp{% if is_target_hero %} altaeron-pdp--cro-hero{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="{{ copy_prefix | append: '.common.save' | t | escape }}"
  data-save-template="{{ copy_prefix | append: '.common.save_amount' | t: amount: '[amount]' | escape }}"
  data-add-to-cart-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-bundle-title="{{ copy_prefix | append: '.bundle.title' | t | escape }}"
  data-bundle-one="{{ copy_prefix | append: '.bundle.one_corrector' | t | escape }}"
  data-bundle-many-template="{{ copy_prefix | append: '.bundle.many_correctors' | t: count: '[count]' | escape }}"
  data-bundle-one-foot="{{ copy_prefix | append: '.bundle.one_foot' | t | escape }}"
  data-bundle-popular="{{ copy_prefix | append: '.bundle.most_popular' | t | escape }}"
  data-bundle-best-value="{{ copy_prefix | append: '.bundle.best_value' | t | escape }}"
  data-bundle-subtitle-template="{{ copy_prefix | append: '.bundle.only_each_save' | t: price: '[price]', percent: '[percent]' | escape }}"
  {% if is_cro_v1 %}data-cro-v1="true"{% endif %}
>
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="{{ copy_prefix | append: '.accessibility.product_media' | t | escape }}">
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage apdp-gallery__hero">
          {%- if hero_video != blank -%}
            {%- if is_target_hero -%}
              {%- liquid
                assign hero_mobile_source = blank
                assign hero_desktop_source = blank
                for hero_source in hero_video.sources
                  if hero_source.format == 'mp4'
                    if hero_desktop_source == blank or hero_source.height > hero_desktop_source.height
                      assign hero_desktop_source = hero_source
                    endif
                    if hero_source.height <= 720
                      if hero_mobile_source == blank or hero_source.height > hero_mobile_source.height
                        assign hero_mobile_source = hero_source
                      endif
                    endif
                  endif
                endfor
                assign hero_desktop_source = hero_desktop_source | default: hero_video.sources.first
                assign hero_mobile_source = hero_mobile_source | default: hero_desktop_source
                assign hero_poster = hero_video.preview_image | image_url: width: 900
              -%}
              <video data-apdp-hero-video muted playsinline loop preload="metadata" poster="{{ hero_poster }}" aria-label="Adjustable bunion corrector product demonstration">
                {%- if hero_desktop_source.url == hero_mobile_source.url -%}
                  <source src="{{ hero_desktop_source.url }}" type="{{ hero_desktop_source.mime_type | default: 'video/mp4' }}">
                {%- else -%}
                  <source src="{{ hero_mobile_source.url }}" type="{{ hero_mobile_source.mime_type | default: 'video/mp4' }}" media="(max-width: 767px)">
                  <source src="{{ hero_desktop_source.url }}" type="{{ hero_desktop_source.mime_type | default: 'video/mp4' }}" media="(min-width: 768px)">
                {%- endif -%}
              </video>
            {%- else -%}
              {{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1800x' }}
            {%- endif -%}
          {%- elsif hero_image != blank -%}
            {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: hero_image.alt | default: product.title }}
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {%- liquid
                assign media_loading = 'lazy'
                assign media_priority = 'auto'
                if forloop.first
                  assign media_loading = 'eager'
                  assign media_priority = 'high'
                endif
              -%}
              {% render 'altaeron-pdp-media', media: media, product: product, loading: media_loading, fetchpriority: media_priority, sizes: '(min-width: 1024px) 560px, 55vw' %}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="{{ 'products.product.media.open_media' | t: index: forloop.index | escape }}"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>
      </div>

      {%- if is_target_hero -%}<div class="apdp-hero__copy">{%- endif -%}
      <div class="apdp-narrative">
        <p class="apdp-eyebrow"><span>{{ eyebrow }}</span></p>
        <h1 id="AltaeronTitle-{{ section.id }}"><span class="apdp-title-lines">{{ headline }}</span></h1>
        <p class="apdp-narrative__subhead">{{ subheadline }}</p>
        <a class="apdp-rating" href="#AltaeronVerified-{{ section.id }}" aria-label="{{ hero_rating_label | escape }}">
          <span class="apdp-rating__people" aria-hidden="true">
            {%- for i in (1..3) -%}
              {%- capture avatar_key -%}rating_avatar_{{ i }}{%- endcapture -%}
              {%- assign rating_avatar = section.settings[avatar_key] -%}
              <i>{%- if rating_avatar != blank -%}{{ rating_avatar | image_url: width: 96 | image_tag: loading: 'eager', widths: '48, 72, 96', sizes: '34px', alt: '' }}{%- endif -%}</i>
            {%- endfor -%}
          </span>{% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{% if is_target_hero %}{{ copy_prefix | append: '.hero.target_rating_html' | t: rating: hero_rating_display, count: review_count }}{% else %}{{ hero_rating_label }}{% endif %}</strong>
        </a>
        {%- unless is_target_hero -%}<div class="apdp-mobile-product" aria-hidden="true">
          {%- if how_image != blank -%}{{ how_image | image_url: width: 720 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '360, 540, 720', sizes: '55vw', alt: '' }}{%- endif -%}
        </div>{%- endunless -%}
        {%- unless is_target_hero -%}<div class="apdp-identity"><ul>{%- for i in (1..3) -%}{%- capture benefit_key -%}{{ copy_prefix }}.hero.benefit_{{ i }}{%- endcapture -%}<li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ benefit_key | t }}</span></li>{%- endfor -%}</ul></div>{%- endunless -%}
      </div>
      {%- if is_target_hero -%}
        <div class="apdp-hero__conversion">
          <div class="apdp-identity"><ul>
            <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ copy_prefix | append: '.hero.target_benefit_1' | t }}</span></li>
            <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ copy_prefix | append: '.hero.target_benefit_2' | t }}</span></li>
            <li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ copy_prefix | append: '.hero.target_benefit_3' | t }}</span></li>
          </ul></div>
          <div class="apdp-hero__purchase">
            <p class="apdp-hero__price"><span>{{ copy_prefix | append: '.hero.from' | t }}</span> <strong>{{ product.price_min | money }}</strong></p>
            <a class="apdp-button apdp-button--primary apdp-hero__cta" href="#AltaeronBundles-{{ section.id }}" data-apdp-bundle-cta>{{ copy_prefix | append: '.hero.choose_bundle' | t }} <span aria-hidden="true">&rarr;</span></a>
            <p class="apdp-hero__reassurance">{{ copy_prefix | append: '.buy.guarantee_title' | t }} <span aria-hidden="true">&middot;</span> {{ copy_prefix | append: '.buy.secure' | t }}</p>
          </div>
        </div>
      </div>
      {%- endif -%}

