{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.altaeron
  assign eyebrow = section.settings.eyebrow | default: mf.pdp_eyebrow.value
  assign headline = section.settings.headline_override | default: mf.pdp_headline.value | default: product.title
  assign subheadline = section.settings.subheadline_override | default: mf.pdp_subheadline.value | default: product.description | strip_html | truncate: 180
  assign identity_points = mf.pdp_identity_points.value
  assign outcome_cards = mf.pdp_outcome_cards.value
  assign how_steps = mf.pdp_how_steps.value
  assign lifestyle_cards = mf.pdp_lifestyle_cards.value
  assign compatibility_items = mf.pdp_compatibility_items.value
  assign faq_items = mf.pdp_faq_items.value
  assign guide_cards = mf.pdp_guide_cards.value
  assign guide_blocks = section.blocks | where: 'type', 'guide'
  assign related_products = mf.pdp_related_products.value
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign review_count = 2341
  assign review_rating = 4.8
  assign placeholder_video = shop.metafields.custom.homepage_demo_video.value | default: section.settings.placeholder_video
  assign story_video = mf.pdp_video.value | default: placeholder_video
  assign product_form_id = 'product-form-' | append: section.id
  assign compare_price = current_variant.compare_at_price
  assign savings = 0
  if compare_price > current_variant.price
    assign savings = compare_price | minus: current_variant.price
  endif
  assign how_image = mf.pdp_how_image.value | default: product.images[1] | default: product.featured_image
  for block in section.blocks
    if block.type == 'education_media'
      case block.settings.slot
        when 'familiar_1'
          assign familiar_image_1 = block.settings.image
        when 'familiar_2'
          assign familiar_image_2 = block.settings.image
        when 'familiar_3'
          assign familiar_image_3 = block.settings.image
        when 'familiar_4'
          assign familiar_image_4 = block.settings.image
        when 'stage_1'
          assign stage_image_1 = block.settings.image
        when 'stage_2'
          assign stage_image_2 = block.settings.image
        when 'stage_3'
          assign stage_image_3 = block.settings.image
        when 'stage_4'
          assign stage_image_4 = block.settings.image
        when 'support_demo'
          assign support_demo_image = block.settings.image
          assign support_demo_video = block.settings.video
        when 'support_detail'
          assign support_detail_image = block.settings.image
        when 'day_story'
          assign day_story_image = block.settings.image
          assign day_story_video = block.settings.video
      endcase
    elsif block.type == 'tail_media'
      case block.settings.slot
        when 'review_1'
          assign tail_review_1 = block.settings.image
        when 'review_2'
          assign tail_review_2 = block.settings.image
        when 'review_3'
          assign tail_review_3 = block.settings.image
        when 'review_4'
          assign tail_review_4 = block.settings.image
        when 'spacer'
          assign tail_spacer = block.settings.image
        when 'support'
          assign tail_support = block.settings.image
        when 'doctor'
          assign tail_doctor = block.settings.image
        when 'moment_1'
          assign tail_moment_1 = block.settings.image
        when 'moment_2'
          assign tail_moment_2 = block.settings.image
        when 'moment_3'
          assign tail_moment_3 = block.settings.image
        when 'moment_4'
          assign tail_moment_4 = block.settings.image
        when 'moment_5'
          assign tail_moment_5 = block.settings.image
        when 'guide_1'
          assign tail_guide_1 = block.settings.image
        when 'guide_2'
          assign tail_guide_2 = block.settings.image
        when 'guide_3'
          assign tail_guide_3 = block.settings.image
        when 'guide_4'
          assign tail_guide_4 = block.settings.image
        when 'cta_product'
          assign tail_cta_product = block.settings.image
      endcase
    endif
  endfor
-%}

{{ 'altaeron-pdp.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'altaeron-pdp.js' | asset_url }}" defer="defer"></script>

<div id="AltaeronPdp-{{ section.id }}" class="altaeron-pdp" data-section="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-money-format="{{ shop.money_format | escape }}">
  <section class="apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="Product media">
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tab" aria-selected="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__stage" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if media.id == product.featured_media.id %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}"{% unless media.id == product.featured_media.id %} hidden{% endunless %}>
              {%- liquid
                assign media_loading = 'lazy'
                assign media_priority = 'auto'
                if forloop.first
                  assign media_loading = 'eager'
                  assign media_priority = 'high'
                endif
              -%}
              {% render 'altaeron-pdp-media', media: media, product: product, loading: media_loading, fetchpriority: media_priority, sizes: '(min-width: 1024px) 560px, 55vw' %}
            </div>
          {%- else -%}
            <div class="apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>
      </div>

      <div class="apdp-narrative">
        <p class="apdp-eyebrow"><strong>{{ 'altaeron_pdp.hero.eyebrow_rank' | t }}</strong><span>{{ 'altaeron_pdp.hero.eyebrow_category' | t }}</span></p>
        <h1 id="AltaeronTitle-{{ section.id }}" aria-label="{{ 'altaeron_pdp.hero.headline' | t | escape }}"><span class="apdp-title-desktop" aria-hidden="true"><span>Walk Without</span><span>Thinking About</span><span>Your Feet Again.</span></span><span class="apdp-title-mobile" aria-hidden="true"><span>Walk Without</span><span>Thinking About</span><span>Your Feet Again.</span></span></h1>
        <p class="apdp-narrative__subhead">{{ 'altaeron_pdp.hero.subheadline' | t }}</p>
        <a class="apdp-rating" href="#AltaeronReviews-{{ section.id }}" aria-label="{{ 'altaeron_pdp.hero.rating' | t | escape }}">
          <span class="apdp-rating__people" aria-hidden="true"><i></i><i></i><i></i></span><span class="apdp-stars" aria-hidden="true">★★★★★</span><strong>{{ 'altaeron_pdp.hero.rating' | t }}</strong>
        </a>
        <div class="apdp-mobile-product" aria-hidden="true">
          {%- if how_image != blank -%}{{ how_image | image_url: width: 720 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '360, 540, 720', sizes: '55vw', alt: '' }}{%- endif -%}
        </div>
        <div class="apdp-identity"><ul>{%- for i in (1..4) -%}{%- capture benefit_key -%}altaeron_pdp.hero.benefit_{{ i }}{%- endcapture -%}<li>{% render 'altaeron-pdp-icon', icon: 'check' %}<span>{{ benefit_key | t }}</span></li>{%- endfor -%}</ul></div>
      </div>

      <aside id="AltaeronBuy-{{ section.id }}" class="apdp-buy" aria-label="Purchase {{ product.title | escape }}">
        <h2 class="apdp-buy__title">{{ 'altaeron_pdp.buy.title' | t }}</h2>
        <a class="apdp-buy__rating" href="#AltaeronReviews-{{ section.id }}"><span class="apdp-stars" aria-hidden="true">★★★★★</span><strong>{{ 'altaeron_pdp.buy.rating' | t }}</strong></a>
        <div class="apdp-buy__price-line">
          <div><p class="apdp-buy__from">{{ section.settings.price_label }}</p><div class="apdp-price" aria-live="polite"><span class="apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="apdp-price__compare" data-apdp-compare-price data-static-price="{{ 'altaeron_pdp.buy.compare_price' | t | escape }}">{{ 'altaeron_pdp.buy.compare_price' | t }}</s></div></div>
          <span class="apdp-price__save" data-apdp-savings data-static-savings="{{ 'altaeron_pdp.buy.saving' | t | escape }}">{{ 'altaeron_pdp.buy.saving' | t }}</span>
        </div>
        {%- form 'product', product, id: product_form_id, class: 'apdp-form main-product-form', is: 'product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="product-form__error-message-wrapper" role="alert" hidden><div class="product-form__error-message alert alert--error" role="alert" hidden></div></div>
          {%- unless product.has_only_default_variant -%}
            <fieldset class="apdp-variants">
              <legend>{{ 'altaeron_pdp.buy.variant_label' | t }} <span>{{ 'altaeron_pdp.buy.popular' | t }}</span></legend>
              {%- if product.variants.size > 6 -%}
                <label class="visually-hidden" for="AltaeronVariant-{{ section.id }}">{{ section.settings.variant_label }}</label>
                <select id="AltaeronVariant-{{ section.id }}" data-apdp-variant-select>{%- for variant in product.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}</select>
              {%- else -%}
                <div class="apdp-variants__grid">{%- for variant in product.variants limit: 3 -%}{%- capture variant_key -%}altaeron_pdp.buy.variant_{{ forloop.index }}{%- endcapture -%}<input class="visually-hidden" type="radio" id="AltaeronVariant-{{ section.id }}-{{ variant.id }}" name="apdp-variant" value="{{ variant.id }}" data-apdp-variant-option data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} checked{% endif %}><label for="AltaeronVariant-{{ section.id }}-{{ variant.id }}">{{ variant_key | t }}</label>{%- endfor -%}</div>
              {%- endif -%}
            </fieldset>
          {%- endunless -%}
          <button type="submit" name="add" class="apdp-button apdp-button--primary product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ 'altaeron_pdp.buy.cta' | t }}">{% if current_variant.available %}{{ 'altaeron_pdp.buy.cta' | t }}{% else %}Sold out{% endif %}</span><b data-apdp-cta-price{% unless current_variant.available %} hidden{% endunless %}> — {{ current_variant.price | money }}</b></span>{% render 'altaeron-pdp-icon', icon: 'cart' %}<span class="loading__spinner hidden">{% render 'loading-spinner' %}</span></button>
          <div class="apdp-payment-terms">{{ 'altaeron_pdp.buy.installments' | t }} <strong>shop<span>Pay</span></strong></div>
        {%- endform -%}
        <div class="apdp-buy__policy">{% render 'altaeron-pdp-icon', icon: 'shield' %}<div><strong>{{ 'altaeron_pdp.buy.guarantee_title' | t }}</strong><p>{{ 'altaeron_pdp.buy.guarantee_line_1' | t }}<br>{{ 'altaeron_pdp.buy.guarantee_line_2' | t }}</p></div></div>
        <div class="apdp-buy__trust">
          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{% render 'altaeron-pdp-icon', icon: 'return' %}<span><b>{{ 'altaeron_pdp.buy.returns' | t }}</b><small>{{ 'altaeron_pdp.buy.returns_note' | t }}</small></span></a>
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{% render 'altaeron-pdp-icon', icon: 'truck' %}<span><b>{{ 'altaeron_pdp.buy.shipping' | t }}</b><small>{{ 'altaeron_pdp.buy.shipping_note' | t }}</small></span></a>
          <span>{% render 'altaeron-pdp-icon', icon: 'lock' %}<span><b>{{ 'altaeron_pdp.buy.secure' | t }}</b><small>{{ 'altaeron_pdp.buy.secure_note' | t }}</small></span></span>
          <a href="/pages/contact">{% render 'altaeron-pdp-icon', icon: 'support' %}<span><b>{{ 'altaeron_pdp.buy.support' | t }}</b><small>{{ 'altaeron_pdp.buy.support_note' | t }}</small></span></a>
        </div>
        {%- if shop.enabled_payment_types.size > 0 -%}<ul class="apdp-payment-icons list list-payment" role="list" aria-label="Accepted payment methods">{%- for type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul>{%- endif -%}
      </aside>
    </div>
  </section>

  <section class="apdp-expert" aria-label="Product guidance">
    <div class="apdp-shell apdp-expert__panel">
      <div class="apdp-expert__portrait">
        <img src="{{ 'altaeron-expert-portrait.png' | asset_url }}" width="1024" height="1536" loading="lazy" alt="Foot-care professional reviewing the product">
      </div>
      <div class="apdp-expert__profile">
        <small>{{ 'altaeron_pdp.expert.reviewed_by' | t }}</small>
        <h2>{{ 'altaeron_pdp.expert.name' | t }}</h2>
        <p>{{ 'altaeron_pdp.expert.role' | t }}</p>
        <strong>{{ 'altaeron_pdp.expert.experience' | t }}</strong>
        <span class="apdp-expert__signature">{{ 'altaeron_pdp.expert.signature' | t }}</span>
      </div>
      <blockquote>
        <span aria-hidden="true">“</span>
        <p>{{ 'altaeron_pdp.expert.quote' | t }} <b aria-hidden="true">”</b></p>
      </blockquote>
      <div class="apdp-expert__criteria">
        <strong>{{ 'altaeron_pdp.expert.criteria_heading' | t }}</strong>
        <ul>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %} {{ 'altaeron_pdp.expert.criterion_1' | t }}</li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %} {{ 'altaeron_pdp.expert.criterion_2' | t }}</li>
          <li>{% render 'altaeron-pdp-icon', icon: 'check' %} {{ 'altaeron_pdp.expert.criterion_3' | t }}</li>
        </ul>
        <p>{{ 'altaeron_pdp.expert.criteria_footer' | t }}</p>
      </div>
      <div class="apdp-expert__press" aria-label="Health and lifestyle publications">
        <span>WebMD</span><span>healthline</span><span>Verywell<span>health</span></span><span>yahoo!<b>life</b></span><span>CNN</span>
      </div>
    </div>
  </section>

  <section class="apdp-education apdp-education--familiar" aria-labelledby="AltaeronFamiliar-{{ section.id }}">
    <div class="apdp-shell">
      <header class="apdp-education__heading">
        <span class="apdp-education__number" aria-hidden="true">1</span>
        <div>
          <h2 id="AltaeronFamiliar-{{ section.id }}">Does this feel familiar?</h2>
          <p>You’re not alone. These everyday moments can be more painful than they should be.</p>
        </div>
      </header>
      <div class="apdp-familiar-grid">
        {%- assign familiar_copy = "Morning pain that sets the tone for your day.|Relief when you finally sit down.|Skipping walks you used to enjoy.|Shoes you love but can’t wear anymore." | split: "|" -%}
        {%- for copy in familiar_copy -%}
          {%- liquid
            case forloop.index
              when 1
                assign familiar_image = familiar_image_1
              when 2
                assign familiar_image = familiar_image_2
              when 3
                assign familiar_image = familiar_image_3
              when 4
                assign familiar_image = familiar_image_4
            endcase
          -%}
          <article class="apdp-familiar-card">
            <div class="apdp-education__placeholder">{%- if familiar_image != blank -%}{{ familiar_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 768px) 25vw, 76vw', alt: familiar_image.alt | default: copy }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
            <p>{{ copy }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="apdp-education apdp-education--causes" aria-labelledby="AltaeronCauses-{{ section.id }}">
    <div class="apdp-shell">
      <div class="apdp-causes-grid">
        <div class="apdp-causes__intro">
          <header class="apdp-education__heading">
            <span class="apdp-education__number" aria-hidden="true">2</span>
            <div>
              <h2 id="AltaeronCauses-{{ section.id }}">Why Do Bunions Happen? <span aria-hidden="true">↝</span></h2>
              <p>Understanding the problem is the first step to feeling better.</p>
            </div>
          </header>
          <div class="apdp-causes__points">
            <p><span aria-hidden="true">✓</span><strong>Toe misalignment</strong> – The big toe shifts toward the other toes.</p>
            <p><span aria-hidden="true">✓</span><strong>Pressure &amp; friction</strong> – Shoes and daily movement increase stress on the joint.</p>
            <p><span aria-hidden="true">✓</span><strong>Progressive pain</strong> – Activities that once felt comfortable become painful.</p>
            <p><span aria-hidden="true">✓</span><strong>Irritation</strong> – Pain builds gradually over time.</p>
          </div>
          <a class="apdp-causes__link" href="/pages/bunion-guide">Learn more in our Bunion Guide <span aria-hidden="true">→</span></a>
        </div>
        <ol class="apdp-causes__stages">
          <li>
            <span class="apdp-stage__number">1</span><h3>Misalignment</h3><p>Big toe shifts toward smaller toes.</p>
            <div class="apdp-education__placeholder">{%- if stage_image_1 != blank -%}{{ stage_image_1 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: stage_image_1.alt | default: 'Bunion misalignment stage' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
          </li>
          <li>
            <span class="apdp-stage__number">2</span><h3>Pressure</h3><p>Rubbing causes pressure &amp; inflammation.</p>
            <div class="apdp-education__placeholder">{%- if stage_image_2 != blank -%}{{ stage_image_2 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: stage_image_2.alt | default: 'Bunion pressure stage' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
          </li>
          <li>
            <span class="apdp-stage__number">3</span><h3>Inflammation</h3><p>The joint becomes irritated &amp; swollen.</p>
            <div class="apdp-education__placeholder">{%- if stage_image_3 != blank -%}{{ stage_image_3 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: stage_image_3.alt | default: 'Bunion inflammation stage' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
          </li>
          <li>
            <span class="apdp-stage__number">4</span><h3>Pain Over Time</h3><p>Discomfort interferes with daily life.</p>
            <div class="apdp-education__placeholder">{%- if stage_image_4 != blank -%}{{ stage_image_4 | image_url: width: 520 | image_tag: loading: 'lazy', widths: '240, 360, 520', sizes: '(min-width: 768px) 15vw, 66vw', alt: stage_image_4.alt | default: 'Bunion pain over time stage' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="apdp-education apdp-education--support" aria-labelledby="AltaeronSupport-{{ section.id }}">
    <div class="apdp-shell">
      <header class="apdp-education__heading">
        <span class="apdp-education__number" aria-hidden="true">3</span>
        <div>
          <h2 id="AltaeronSupport-{{ section.id }}">How Altaeron Supports Your Toe</h2>
          <p>Adjustable alignment &amp; gentle support for everyday relief.</p>
        </div>
      </header>
      <div class="apdp-support-grid">
        <div class="apdp-support__features">
          <article><span class="apdp-support__icon">{% render 'altaeron-pdp-icon', icon: 'knob' %}</span><h3>Adjustable<br>Knob</h3><p>Fine-tune angle<br>&amp; tension</p></article>
          <article><span class="apdp-support__icon">{% render 'altaeron-pdp-icon', icon: 'dual-support' %}</span><h3>Dual Support<br>System</h3><p>Stabilizes toe &amp;<br>joint</p></article>
          <article><span class="apdp-support__icon">{% render 'altaeron-pdp-icon', icon: 'pressure-relief' %}</span><h3>Pressure<br>Relief</h3><p>Reduces rubbing<br>&amp; irritation</p></article>
          <article><span class="apdp-support__icon">{% render 'altaeron-pdp-icon', icon: 'comfort' %}</span><h3>Designed for<br>Comfort</h3><p>Wear with most<br>shoes</p></article>
        </div>
        <div class="apdp-support__media">
          <div class="apdp-support__video">
            <div class="apdp-education__placeholder">{%- if support_demo_video != blank -%}{{ support_demo_video | video_tag: controls: true, muted: true, playsinline: true, preload: 'metadata', image_size: '900x' }}{%- elsif support_demo_image != blank -%}{{ support_demo_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 768px) 18vw, 100vw', alt: support_demo_image.alt | default: 'Altaeron adjustment demonstration' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
            {%- if support_demo_video == blank -%}<span class="apdp-support__play" aria-hidden="true">▶</span>{%- endif -%}
          </div>
          <div class="apdp-education__placeholder">{%- if support_detail_image != blank -%}{{ support_detail_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 768px) 42vw, 100vw', alt: support_detail_image.alt | default: 'Altaeron toe support detail' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="apdp-education apdp-education--day" aria-labelledby="AltaeronDay-{{ section.id }}">
    <div class="apdp-shell">
      <header class="apdp-day__header">
        <p class="apdp-day__marker"><span aria-hidden="true">4</span> Imagine Leaving Home Without Thinking About Your Feet.</p>
        <h2 id="AltaeronDay-{{ section.id }}">Imagine Leaving Home<br>Without Thinking About Your Feet.</h2>
        <p class="apdp-day__intro">No checking which shoes will hurt. No planning your day around your feet.<br>Just put them on—<strong><em>and go.</em></strong></p>
      </header>

      <div class="apdp-day__media" aria-label="A comfortable day with Altaeron">
        <div class="apdp-day__visual apdp-education__placeholder">
          {%- if day_story_video != blank -%}
            {{ day_story_video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1800x' }}
          {%- elsif day_story_image != blank -%}
