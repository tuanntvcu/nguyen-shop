        {%- assign chapter_heading_id = 'AltaeronStoriesTitle-' | append: section.id -%}
        {% render 'altaeron-pdp-section-heading', number: '5', title: illustrative_stories_title, subtitle: illustrative_stories_subtitle, heading_id: chapter_heading_id %}
        <div class="apdp-tail-review-nav" aria-label="{{ copy_prefix | append: '.reviews.slider_controls' | t | escape }}"><button type="button" data-apdp-review-prev aria-label="{{ copy_prefix | append: '.reviews.previous' | t | escape }}">{% render 'altaeron-pdp-icon', icon: 'arrow' %}</button><button type="button" data-apdp-review-next aria-label="{{ copy_prefix | append: '.reviews.next' | t | escape }}">{% render 'altaeron-pdp-icon', icon: 'arrow' %}</button></div>
      </div>
      <div class="apdp-tail-review-viewport" data-apdp-review-slider>
      <div class="apdp-tail-review-grid">
        {% render 'altaeron-pdp-review-cards', reviews: custom_reviews, limit: 10, require_mock: true %}
      </div>
      </div>
      <div class="apdp-tail-trust" aria-label="{{ copy_prefix | append: '.accessibility.purchase_reassurance' | t | escape }}">
        <span>{% render 'altaeron-pdp-icon', icon: 'shield' %}<b>{{ copy_prefix | append: '.trust.warranty' | t }}</b></span>
        <span>{% render 'altaeron-pdp-icon', icon: 'lock' %}<b>{{ copy_prefix | append: '.trust.secure_checkout' | t }}</b></span>
        <span>{% render 'altaeron-pdp-icon', icon: 'return' %}<b>{{ copy_prefix | append: '.trust.returns' | t }}</b></span>
        <span>{% render 'altaeron-pdp-icon', icon: 'support' %}<b>{{ copy_prefix | append: '.trust.support' | t }}</b></span>
      </div>
    </div>
  </section>

  <div{% if is_cro_v1 %} id="AltaeronCreated-{{ section.id }}"{% endif %} class="apdp-tail{% unless is_cro_v1 %} apdp-tail-split{% endunless %} apdp-shell alta-pdp-flow-section alta-pdp-flow-section--default-compact">
    {%- unless is_cro_v1 -%}
    <section class="apdp-tail-panel apdp-created" aria-labelledby="AltaeronCreated-{{ section.id }}">
      {%- assign chapter_heading_id = 'AltaeronCreated-' | append: section.id -%}
      {% render 'altaeron-pdp-section-heading', number: comparison_number, title: comparison_title, heading_id: chapter_heading_id %}
      <div class="apdp-tail-card">
        <div class="apdp-compare-table" role="table" aria-label="{{ copy_prefix | append: '.comparison.table_label' | t | escape }}">
          <div class="apdp-compare-head" role="row"><span></span><b>{{ copy_prefix | append: '.comparison.altaeron_html' | t }}</b><b>{{ copy_prefix | append: '.comparison.others_html' | t }}</b></div>
          {%- for i in (1..6) -%}{%- capture compare_key -%}{{ copy_prefix }}.comparison.row_{{ i }}{%- endcapture -%}<div role="row"><strong>{{ compare_key | t }}</strong><span class="is-yes" aria-label="{{ copy_prefix | append: '.common.yes' | t | escape }}">✓</span><span class="is-no" aria-label="{{ copy_prefix | append: '.common.no' | t | escape }}">×</span></div>{%- endfor -%}
        </div>
      </div>
    </section>
    {%- endunless -%}

    <section class="apdp-tail-panel{% unless is_cro_v1 %} alta-pdp-subsection alta-pdp-subsection--tight{% endunless %}" aria-labelledby="AltaeronCanCant-{{ section.id }}">
      {%- assign chapter_heading_id = 'AltaeronCanCant-' | append: section.id -%}
      {% render 'altaeron-pdp-section-heading', number: expectations_number, title: expectations_title, heading_id: chapter_heading_id %}
      <div class="apdp-tail-card apdp-can-cant">
        <div class="apdp-can-cant__grid">
          <div><h3>{{ copy_prefix | append: '.expectations.can_title' | t }}</h3><ul>{%- for i in (1..4) -%}{%- capture can_key -%}{{ copy_prefix }}.expectations.can_{{ i }}{%- endcapture -%}<li>{{ can_key | t }}</li>{%- endfor -%}</ul></div>
          <div><h3>{{ copy_prefix | append: '.expectations.cannot_title' | t }}</h3><ul>{%- for i in (1..3) -%}{%- capture cannot_key -%}{{ copy_prefix }}.expectations.cannot_{{ i }}{%- endcapture -%}<li>{{ cannot_key | t }}</li>{%- endfor -%}</ul></div>
        </div>
        <p class="apdp-consistency">{% render 'altaeron-pdp-icon', icon: 'guide' %}<span>{{ copy_prefix | append: '.expectations.consistency' | t }}</span></p>
      </div>
    </section>
  </div>

  <section class="apdp-tail apdp-spacer alta-pdp-flow-section alta-pdp-flow-section--tight" aria-labelledby="AltaeronSpacer-{{ section.id }}"><div class="apdp-shell">
    {%- assign chapter_heading_id = 'AltaeronSpacer-' | append: section.id -%}
    {% render 'altaeron-pdp-section-heading', number: spacer_number, title: spacer_title, subtitle: spacer_subtitle, heading_id: chapter_heading_id %}
    <div class="apdp-spacer-grid">
      <article class="apdp-spacer-product">
        <div class="apdp-tail-media">{%- if tail_spacer != blank -%}{{ tail_spacer | image_url: width: 500 | image_tag: loading: 'lazy', widths: '240, 360, 500', sizes: '(min-width: 768px) 170px, 34vw', alt: spacer_basic_alt }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div>
        <div><h3>{{ copy_prefix | append: '.spacer.basic_title' | t }}</h3><ul>{%- for i in (1..4) -%}{%- capture basic_key -%}{{ copy_prefix }}.spacer.basic_{{ i }}{%- endcapture -%}<li>{{ basic_key | t }}</li>{%- endfor -%}</ul></div>
      </article>
      <span class="apdp-versus">{{ copy_prefix | append: '.spacer.versus' | t }}</span>
      <article class="apdp-spacer-product apdp-spacer-product--altaeron">
        <div class="apdp-tail-media">{%- if tail_support != blank -%}{{ tail_support | image_url: width: 600 | image_tag: loading: 'lazy', widths: '280, 420, 600', sizes: '(min-width: 768px) 220px, 40vw', alt: spacer_altaeron_alt }}{%- else -%}{{ 'product-2' | placeholder_svg_tag }}{%- endif -%}</div>
        <div><h3>{{ copy_prefix | append: '.spacer.altaeron_title' | t }}</h3><ul>{%- for i in (1..4) -%}{%- capture altaeron_key -%}{{ copy_prefix }}.spacer.altaeron_{{ i }}{%- endcapture -%}<li>{{ altaeron_key | t }}</li>{%- endfor -%}</ul></div>
      </article>
      <aside class="apdp-doctor-note"><div class="apdp-tail-media">{%- if is_target_hero -%}<img src="{{ 'altaeron-expert-portrait.png' | asset_url }}" width="1024" height="1536" loading="lazy" alt="{{ 'altaeron_pdp.accessibility.expert_portrait' | t | escape }}">{%- elsif tail_doctor != blank -%}{{ tail_doctor | image_url: width: 400 | image_tag: loading: 'lazy', widths: '180, 280, 400', sizes: '150px', alt: spacer_expert_alt }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div><p>{%- if is_target_hero -%}{{ 'altaeron_pdp.expert.quote' | t }}<strong>{{ 'altaeron_pdp.expert.name' | t }}</strong><small>{{ 'altaeron_pdp.expert.role' | t }}</small>{%- else -%}{{ copy_prefix | append: '.spacer.expert_note_html' | t }}{%- endif -%}</p></aside>
    </div>
  </div></section>

  <section class="apdp-tail apdp-moments alta-pdp-flow-section alta-pdp-flow-section--spacious" aria-labelledby="AltaeronMoments-{{ section.id }}"><div class="apdp-shell">
    {%- assign chapter_heading_id = 'AltaeronMoments-' | append: section.id -%}
    {% render 'altaeron-pdp-section-heading', number: moments_number, title: moments_title, subtitle: moments_subtitle, heading_id: chapter_heading_id %}
    <div class="apdp-moment-grid">{%- for i in (1..5) -%}{%- capture moment_key -%}{{ copy_prefix }}.moments.item_{{ i }}{%- endcapture -%}{%- assign copy = moment_key | t -%}{%- case forloop.index -%}{%- when 1 -%}{%- assign moment_image = tail_moment_1 -%}{%- when 2 -%}{%- assign moment_image = tail_moment_2 -%}{%- when 3 -%}{%- assign moment_image = tail_moment_3 -%}{%- when 4 -%}{%- assign moment_image = tail_moment_4 -%}{%- else -%}{%- assign moment_image = tail_moment_5 -%}{%- endcase -%}<article><div class="apdp-tail-media">{%- if moment_image != blank -%}{{ moment_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280, 480, 700', sizes: '(min-width: 768px) 19vw, 66vw', alt: copy }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}</div><p>{{ copy }}</p></article>{%- endfor -%}</div>
  </div></section>

  <div class="apdp-tail apdp-tail-lower apdp-shell alta-pdp-flow-section alta-pdp-flow-section--default-compact">
    <div>
      {%- unless is_cro_v1 -%}
      <section class="apdp-learn" aria-labelledby="AltaeronLearn-{{ section.id }}">
        {%- assign chapter_heading_id = 'AltaeronLearn-' | append: section.id -%}
        {% render 'altaeron-pdp-section-heading', number: learn_number, title: learn_title, subtitle: learn_subtitle, heading_id: chapter_heading_id %}
        {%- liquid
          assign learn_blog = section.settings.learn_blog
          if learn_blog == blank
            assign learn_blog = blogs['news']
          endif
        -%}
        <div class="apdp-learn-grid">
          {%- for article in learn_blog.articles limit: 4 -%}
            {%- assign guide_minutes = article.id | modulo: 4 | plus: 5 -%}
            {%- assign article_summary = article.excerpt_or_content | strip_html | truncatewords: 12 -%}
            <article>
              <a class="apdp-learn-card__link" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
                <div class="apdp-tail-media">
                  {%- if article.image != blank -%}
                    {{ article.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 240, 320, 480', sizes: '(min-width: 768px) 90px, 26vw', alt: article.image.alt | default: article.title }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div>
                  <h3>{{ article.title }}</h3>
                  <p>{{ article_summary }}</p>
                  <small>{{ copy_prefix | append: '.learn.reading_time' | t: minutes: guide_minutes }}</small>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>
      </section>
      {%- endunless -%}

      <section id="AltaeronVerified-{{ section.id }}" class="apdp-review-summary alta-pdp-subsection alta-pdp-subsection--default-compact" aria-labelledby="AltaeronVerifiedTitle-{{ section.id }}" data-apdp-review-slider-group>
        {%- assign verified_reviews_title = copy_prefix | append: '.review_summary.title' | t: count: review_count -%}
        {%- assign verified_reviews_subtitle = copy_prefix | append: '.review_summary.rating' | t: rating: review_rating -%}
        {%- assign chapter_heading_id = 'AltaeronVerifiedTitle-' | append: section.id -%}
        <div class="apdp-review-summary__head">
          {% render 'altaeron-pdp-section-heading', number: review_summary_number, title: verified_reviews_title, subtitle: verified_reviews_subtitle, heading_id: chapter_heading_id %}
        </div>

        {%- comment -%}
          review_widget_data only contains Judge.me's initial review page. The official
          widget uses that cached page for the first paint, then loads every remaining
          published review through Judge.me's own pagination.
        {%- endcomment -%}
        {%- assign has_legacy_judgeme_widget = false -%}
        {%- if product.metafields.judgeme.widget.size > 20 -%}
          {%- assign has_legacy_judgeme_widget = true -%}
        {%- endif -%}
        <div class="apdp-judgeme-widget">
          <div
            id="judgeme_product_reviews"
            class="jdgm-widget jdgm-review-widget"
            data-product-title="{{ product.title | escape }}"
            data-id="{{ product.id }}"
            data-product-id="{{ product.id }}"
            data-widget="review"
            data-auto-install="false"
            data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
            data-entry-point="review_widget.js"
            data-entry-key="review-widget/main.js"
          >
            {%- if has_legacy_judgeme_widget -%}
              <div class="jdgm-legacy-widget-content" style="display:none">{{ product.metafields.judgeme.widget }}</div>
            {%- endif -%}
          </div>

          {%- if product.metafields.judgeme.review_widget_data -%}
            <script>
              window.jdgm = window.jdgm || {};
              window.jdgm.data = window.jdgm.data || {};
              window.jdgm.data.reviewWidget = window.jdgm.data.reviewWidget || {};
              window.jdgm.data.reviewWidget[{{ product.id | json }}] = {{ product.metafields.judgeme.review_widget_data }};
            </script>
          {%- endif -%}

          <noscript>
            <div class="apdp-tail-review-viewport">
              <div class="apdp-tail-review-grid">
                {% render 'altaeron-pdp-review-cards', reviews: reviews, limit: 10 %}
              </div>
            </div>
          </noscript>
        </div>
      </section>
    </div>

    <section class="apdp-tail-faq alta-pdp-subsection alta-pdp-subsection--tight" aria-labelledby="AltaeronFaq-{{ section.id }}">
      {%- assign chapter_heading_id = 'AltaeronFaq-' | append: section.id -%}
      {% render 'altaeron-pdp-section-heading', number: faq_number, title: faq_title, heading_id: chapter_heading_id %}
      <div class="apdp-tail-accordion">
        {%- for i in (1..6) -%}{%- capture question_key -%}{{ copy_prefix }}.faq.question_{{ i }}{%- endcapture -%}{%- capture answer_key -%}{{ copy_prefix }}.faq.answer_{{ i }}{%- endcapture -%}<details><summary>{{ question_key | t }}{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>{{ answer_key | t }}</p></details>{%- endfor -%}
      </div>
    </section>
  </div>

  <section class="apdp-final-cta alta-pdp-flow-section alta-pdp-flow-section--spacious" aria-label="{{ copy_prefix | append: '.final_cta.label' | t | escape }}"><div class="apdp-shell apdp-final-cta__inner">
    <div class="apdp-final-cta__product apdp-tail-media">{%- if tail_cta_product != blank -%}{{ tail_cta_product | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 500, 700', sizes: '(min-width: 768px) 330px, 48vw', alt: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div>
    <div class="apdp-final-cta__content"><h2>{{ copy_prefix | append: '.final_cta.title' | t }}</h2><p>{{ copy_prefix | append: '.final_cta.product' | t }}</p><div class="apdp-final-benefits"><span>{% render 'altaeron-pdp-icon', icon: 'shield' %}<b>{{ copy_prefix | append: '.final_cta.guarantee_html' | t }}</b></span><span>{% render 'altaeron-pdp-icon', icon: 'truck' %}<b>{{ copy_prefix | append: '.final_cta.shipping_html' | t }}</b></span><span>{% render 'altaeron-pdp-icon', icon: 'support' %}<b>{{ copy_prefix | append: '.final_cta.support_html' | t }}</b></span></div><div class="apdp-final-payments"><span class="visually-hidden">{{ copy_prefix | append: '.accessibility.accepted_payment_methods' | t }}</span><ul class="list list-payment" role="list">{%- for type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul></div></div>
    <div class="apdp-final-cta__buy"><div>{% render 'altaeron-pdp-stars', rating: review_rating %}<small>{{ final_cta_rating_label }}</small><em data-apdp-final-savings{% if savings <= 0 %} hidden{% endif %}>{{ copy_prefix | append: '.common.save_amount' | t: amount: savings_money }}</em></div><p><strong data-apdp-final-price>{{ current_variant.price | money }}</strong><s data-apdp-final-compare{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></p><button type="button" class="apdp-final-button" data-apdp-final-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>{{ copy_prefix | append: '.final_cta.button' | t }}{% if is_cro_v1 %}<span data-apdp-final-button-price{% unless current_variant.available %} hidden{% endunless %}> — {{ current_variant.price | money }}</span>{% else %} <span aria-hidden="true">→</span>{% endif %}</button><small data-apdp-installments>{{ copy_prefix | append: '.final_cta.installments' | t }} shop<span>Pay</span></small><p class="apdp-final-fine">{{ copy_prefix | append: '.final_cta.fine_print' | t }}</p></div>
    <div class="apdp-final-badge">
      <img src="{{ 'altaeron-90-day-risk-free-badge.svg' | asset_url }}" width="384" height="384" loading="lazy" alt="{{ copy_prefix | append: '.final_cta.badge_alt' | t | escape }}">
    </div>
  </div></section>

  <div class="apdp-sticky" data-apdp-sticky hidden><div class="apdp-sticky__product">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '52px', alt: product.featured_image.alt | default: product.title }}{%- endif -%}<span><small><span>{{ section.settings.price_label }}</span> <b data-apdp-sticky-price>{{ current_variant.price | money }}</b> <s data-apdp-sticky-compare{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></small><em data-apdp-sticky-savings{% if savings <= 0 %} hidden{% endif %}>{{ copy_prefix | append: '.common.save_amount' | t: amount: savings_money }}</em><small class="apdp-sticky__bundle-title" data-apdp-sticky-bundle-title hidden></small></span></div><button type="button" class="apdp-button apdp-button--primary" data-apdp-sticky-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>{% render 'altaeron-pdp-icon', icon: 'lock' %}<span data-apdp-sticky-text>{% if current_variant.available %}{{ section.settings.cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span></button></div>
  <script type="application/json" data-apdp-product-json>{{ product.variants | json }}</script>
</div>

{% schema %}
{
  "name": "Altaeron editorial PDP",
  "tag": "section",
  "class": "section-altaeron-pdp",
  "settings": [
    { "type": "checkbox", "id": "cro_v1", "label": "Use Altaeron CRO v1 copy", "default": false },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Relevance label", "default": "For Bunion Pain & Pressure" },
    { "type": "textarea", "id": "headline_override", "label": "Headline override", "default": "Walk Without Thinking About Your Feet Again." },
    { "type": "textarea", "id": "subheadline_override", "label": "Supporting copy override", "default": "Adjustable support designed to reduce bunion pressure and gently support big-toe alignment while worn." },
    { "type": "header", "content": "Rating customer avatars" },
    { "type": "image_picker", "id": "rating_avatar_1", "label": "Customer avatar 1" },
    { "type": "image_picker", "id": "rating_avatar_2", "label": "Customer avatar 2" },
    { "type": "image_picker", "id": "rating_avatar_3", "label": "Customer avatar 3" },
    { "type": "text", "id": "identity_heading", "label": "Identity list heading", "default": "You might see yourself here..." },
    { "type": "text", "id": "relief_heading", "label": "Relief card heading", "default": "Finally, Relief You Can Feel" },
    { "type": "textarea", "id": "relief_text", "label": "Relief card text", "default": "Designed to reduce bunion pressure and gently support big-toe alignment while worn, so your feet can feel more comfortable during your routine." },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "From" },
    { "type": "text", "id": "variant_label", "label": "Variant label", "default": "Device Pair" },
    { "type": "text", "id": "popular_label", "label": "Variant badge", "default": "Most Popular" },
    { "type": "text", "id": "cta_label", "label": "Default CTA", "default": "Start Walking Comfortably Again" },
    { "type": "text", "id": "order_help_heading", "label": "Order help heading", "default": "Risk-free ordering support" },
    { "type": "textarea", "id": "order_help_text", "label": "Order help text", "default": "Review the fit notes and policies, or contact us before ordering." },
    { "type": "header", "content": "Story and social proof" },
    { "type": "text", "id": "familiar_heading", "label": "Familiar section heading", "default": "Does this feel familiar?" },
    { "type": "text", "id": "reassurance_heading", "label": "Reassurance heading", "default": "If any of these feel familiar, you’re not imagining it." },
    { "type": "textarea", "id": "reassurance_text", "label": "Reassurance text", "default": "People dealing with the same frustration inspired the way Altaeron was designed." },
    { "type": "video", "id": "placeholder_video", "label": "Placeholder video" },
    { "type": "text", "id": "video_eyebrow", "label": "Video marker", "default": "See the routine" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "Imagine Leaving Home Without Thinking About Your Feet." },
    { "type": "text", "id": "reviews_heading", "label": "Reviews heading", "default": "See How Altaeron Fits Into Everyday Life" },
    { "type": "text", "id": "how_heading", "label": "How-to heading", "default": "How It Works" },
    { "type": "text", "id": "moments_heading", "label": "Lifestyle heading", "default": "Back To Moments You Missed." },
    { "type": "text", "id": "moments_subtitle", "label": "Lifestyle subtitle", "default": "Not just walking. Living." },
    { "type": "text", "id": "moments_fifth", "label": "Desktop fifth moment", "default": "Everyday plans without planning around foot pain." },
    { "type": "header", "content": "Routine" },
    { "type": "text", "id": "routine_heading", "label": "Routine heading", "default": "Make Comfort Part of Your Routine." },
    { "type": "text", "id": "routine_1_label", "label": "Routine card 1 label", "default": "Start Slow" },
    { "type": "textarea", "id": "routine_1_text", "label": "Routine card 1 description", "default": "Begin with a short, comfortable session and see how it feels." },
    { "type": "text", "id": "routine_2_label", "label": "Routine card 2 label", "default": "Adjust For Comfort" },
    { "type": "textarea", "id": "routine_2_text", "label": "Routine card 2 description", "default": "Use gentle, comfortable tension. More force isn't better." },
    { "type": "text", "id": "routine_3_label", "label": "Routine card 3 label", "default": "Build Your Routine" },
    { "type": "textarea", "id": "routine_3_text", "label": "Routine card 3 description", "default": "Gradually increase session length as comfort allows." },
    { "type": "text", "id": "bundle_label", "label": "Bundle link label", "info": "Only add a percentage when backed by actual pricing.", "default": "Build your support routine" },
    { "type": "url", "id": "bundle_link", "label": "Bundle link" },
    { "type": "header", "content": "Brand reassurance" },
    { "type": "text", "id": "values_heading", "label": "Heading", "default": "No Miracles. Just Small Changes That Add Up." },
    { "type": "text", "id": "value_1_title", "label": "Value 1 title", "default": "Helpful by design" },
    { "type": "text", "id": "value_1_text", "label": "Value 1 text", "default": "We design helpful products that support real people." },
    { "type": "text", "id": "value_2_title", "label": "Value 2 title", "default": "Consistency first" },
    { "type": "text", "id": "value_2_text", "label": "Value 2 text", "default": "We focus on consistency, not quick fixes." },
    { "type": "text", "id": "value_3_title", "label": "Value 3 title", "default": "Always improving" },
    { "type": "text", "id": "value_3_text", "label": "Value 3 text", "default": "We listen, learn, and keep improving." },
    { "type": "text", "id": "value_4_title", "label": "Value 4 title", "default": "Honest support" },
    { "type": "text", "id": "value_4_text", "label": "Value 4 text", "default": "We’re here with honest guidance and real support." },
    { "type": "text", "id": "guarantee_heading", "label": "Policy card heading", "default": "Order With Confidence" },
