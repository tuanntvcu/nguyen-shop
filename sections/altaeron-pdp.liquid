          >{{ copy_prefix | append: '.buy.social_proof_html' | t: count: social_proof_count }}</p>
        {%- endform -%}
        <div class="apdp-buy__policy">{% render 'altaeron-pdp-icon', icon: 'shield' %}<div><strong>{{ copy_prefix | append: '.buy.guarantee_title' | t }}</strong><p>{{ copy_prefix | append: '.buy.guarantee_line_1' | t }}<br>{{ copy_prefix | append: '.buy.guarantee_line_2' | t }}</p></div></div>
        {%- if micro_review != blank -%}
          {%- liquid
