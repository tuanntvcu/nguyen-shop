{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_cro_v1 = false
  assign copy_prefix = 'altaeron_pdp'
  assign comparison_number = '6'
  assign expectations_number = '7'
  assign spacer_number = '8'
  assign moments_number = '9'
  assign learn_number = '10'
  assign review_summary_number = '11'
  assign faq_number = '12'
  if section.settings.cro_v1
    assign is_cro_v1 = true
    assign copy_prefix = 'altaeron_pdp_cro_v1'
    unless request.locale.iso_code == 'en'
      assign copy_prefix = 'altaeron_pdp'
    endunless
    assign expectations_number = '6'
    assign spacer_number = '7'
    assign moments_number = '8'
    assign review_summary_number = '9'
    assign faq_number = '10'
  endif
  assign mf = product.metafields.altaeron
  assign hero_video = mf.pdp_hero_video.value
  assign hero_image = mf.pdp_hero_image.value | default: product.featured_image
  assign is_target_hero = false
  if product.handle == 'adjustable-bunion-corrector'
    assign is_target_hero = true
  endif
  assign eyebrow = section.settings.eyebrow | default: mf.pdp_eyebrow.value
  assign headline = section.settings.headline_override | default: mf.pdp_headline.value | default: product.title
  assign subheadline = section.settings.subheadline_override | default: mf.pdp_subheadline.value | default: product.description | strip_html | truncate: 180
  if is_target_hero
    assign eyebrow = copy_prefix | append: '.hero.target_eyebrow' | t
    assign headline = copy_prefix | append: '.hero.headline' | t
    assign subheadline = copy_prefix | append: '.hero.target_subheadline' | t
  endif
  assign identity_points = mf.pdp_identity_points.value
  assign outcome_cards = mf.pdp_outcome_cards.value
  assign how_steps = mf.pdp_how_steps.value
  assign lifestyle_cards = mf.pdp_lifestyle_cards.value
  assign compatibility_items = mf.pdp_compatibility_items.value
  assign faq_items = mf.pdp_faq_items.value
  assign guide_cards = mf.pdp_guide_cards.value
  assign guide_blocks = section.blocks | where: 'type', 'guide'
  assign related_products = mf.pdp_related_products.value
  assign custom_reviews = mf.pdp_reviews.value
  assign review_data = product.metafields.judgeme.review_widget_data.value
  assign reviews = review_data.reviews
  assign micro_review = blank
  for candidate_review in review_data.reviews
    if candidate_review.uuid == '1a70e381-a0b9-4cd3-adbe-939ad2c165f6'
      assign micro_review = candidate_review
      break
    endif
  endfor
  assign review_count = review_data.number_of_reviews | default: 0 | plus: 0
  assign review_rating = review_data.average_rating | default: 0 | plus: 0
  assign hero_rating_label = copy_prefix | append: '.hero.rating' | t: rating: review_rating, count: review_count
  assign hero_rating_display = review_rating | times: 10 | floor | divided_by: 10.0
  assign buy_rating_label = copy_prefix | append: '.buy.rating' | t: rating: review_rating, count: review_count
  assign final_cta_rating_label = copy_prefix | append: '.final_cta.rating' | t: rating: review_rating, count: review_count
  assign placeholder_video = shop.metafields.custom.homepage_demo_video.value | default: section.settings.placeholder_video
  assign story_video = mf.pdp_video.value | default: placeholder_video
  assign product_form_id = 'product-form-' | append: section.id
  assign compare_price = current_variant.compare_at_price
  assign savings = 0
  if compare_price > current_variant.price
    assign savings = compare_price | minus: current_variant.price
  endif
  assign savings_money = savings | money
  assign stage_1_alt = copy_prefix | append: '.causes.stage_1_alt' | t
  assign stage_2_alt = copy_prefix | append: '.causes.stage_2_alt' | t
  assign stage_3_alt = copy_prefix | append: '.causes.stage_3_alt' | t
  assign stage_4_alt = copy_prefix | append: '.causes.stage_4_alt' | t
  assign support_demo_alt = copy_prefix | append: '.support.demo_alt' | t
  assign support_detail_alt = copy_prefix | append: '.support.detail_alt' | t
  assign day_image_alt = copy_prefix | append: '.day.image_alt' | t
  assign spacer_basic_alt = copy_prefix | append: '.spacer.basic_alt' | t
  assign spacer_altaeron_alt = copy_prefix | append: '.spacer.altaeron_alt' | t
  assign spacer_expert_alt = copy_prefix | append: '.spacer.expert_alt' | t
  assign familiar_title = copy_prefix | append: '.familiar.title' | t
  assign familiar_subtitle = copy_prefix | append: '.familiar.subtitle' | t
  assign causes_title = copy_prefix | append: '.causes.title' | t
  assign causes_subtitle = copy_prefix | append: '.causes.subtitle' | t
  assign support_title = copy_prefix | append: '.support.title' | t
  assign support_subtitle = copy_prefix | append: '.support.subtitle' | t
  assign day_title = copy_prefix | append: '.day.title' | t
  assign day_heading_subtitle = copy_prefix | append: '.day.subtitle_html' | t
  assign reviews_title = copy_prefix | append: '.reviews.title' | t
  assign reviews_subtitle = copy_prefix | append: '.reviews.subtitle' | t: count: review_count
  assign illustrative_stories_title = copy_prefix | append: '.reviews.illustrative_title' | t
  assign illustrative_stories_subtitle = copy_prefix | append: '.reviews.illustrative_subtitle' | t
  assign comparison_title = copy_prefix | append: '.comparison.title' | t
  assign expectations_title = copy_prefix | append: '.expectations.title' | t
  assign spacer_title = copy_prefix | append: '.spacer.title' | t
  assign spacer_subtitle = copy_prefix | append: '.spacer.subtitle' | t
  assign moments_title = copy_prefix | append: '.moments.title' | t
  assign moments_subtitle = copy_prefix | append: '.moments.subtitle' | t
  assign learn_title = copy_prefix | append: '.learn.title' | t
