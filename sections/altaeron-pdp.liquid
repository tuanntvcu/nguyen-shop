          <div class="apdp-payment-terms" data-apdp-installments>{{ copy_prefix | append: '.buy.installments' | t }} <strong>shop<span>Pay</span></strong></div>
          {%- capture social_proof_count -%}<strong data-apdp-social-proof-count></strong>{%- endcapture -%}
