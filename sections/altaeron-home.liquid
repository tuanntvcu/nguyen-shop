{{ 'altaeron-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'altaeron-home.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign popular_collection = section.settings.popular_collection
  assign hero_product = section.settings.hero_product
  if hero_product == blank and popular_collection != blank
    assign hero_product = popular_collection.products.first
  endif
  assign hero_desktop_image = section.settings.hero_image
  if hero_desktop_image == blank and hero_product != blank
    assign hero_desktop_image = hero_product.metafields.custom.homepage_card_image.value | default: hero_product.featured_image
  endif
  assign hero_mobile_image = section.settings.hero_mobile_image | default: hero_desktop_image
  assign demo_video = shop.metafields.custom.homepage_demo_video.value
-%}

<altaeron-home class="altaeron-home" data-section-id="{{ section.id }}" data-slide-label="{{ 'altaeron_home.accessibility.go_to_slide' | t | escape }}" data-demo-title="{{ 'altaeron_home.accessibility.product_demonstration' | t | escape }}">
  <section class="ah-hero" aria-labelledby="HeroHeading-{{ section.id }}" style="--ah-hero-desktop-x:{{ section.settings.hero_desktop_x }}%;--ah-hero-desktop-y:{{ section.settings.hero_desktop_y }}%;--ah-hero-mobile-x:{{ section.settings.hero_mobile_x }}%;--ah-hero-mobile-y:{{ section.settings.hero_mobile_y }}%;--ah-hero-overlay:{{ section.settings.hero_mobile_overlay }}">
    <div class="ah-shell ah-hero__grid">
      <div class="ah-hero__copy">
        <h1 id="HeroHeading-{{ section.id }}">{{ section.settings.hero_heading | escape | newline_to_br }}</h1>
        <div class="ah-hero__text rte">{{ section.settings.hero_text }}</div>
        <div class="ah-actions">
          <a class="ah-button" href="#AltaeronConcerns" data-track="hero_primary_cta_click">{{ section.settings.primary_label }}</a>
          <a class="ah-button ah-button--secondary" href="#AltaeronQuiz-{{ section.id }}" data-track="hero_secondary_cta_click">{{ section.settings.secondary_label }}</a>
        </div>
      </div>
      <div class="ah-hero__media ah-media">
        {%- if hero_desktop_image != blank -%}
          <picture>
            {%- if hero_mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ hero_mobile_image | image_url: width: 480 }} 480w, {{ hero_mobile_image | image_url: width: 750 }} 750w" sizes="100vw">{%- endif -%}
            {{ hero_desktop_image | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1440, 1800', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image_alt }}
          </picture>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="ah-trust" aria-label="{{ 'altaeron_home.accessibility.store_benefits' | t | escape }}">
    <div class="ah-shell ah-trust__grid">
      {%- for block in section.blocks -%}{%- if block.type == 'trust' and block.settings.text != blank -%}
        <div class="ah-trust__item" {{ block.shopify_attributes }}>
          <span class="ah-icon" aria-hidden="true">{% render 'altaeron-icon', type: block.settings.icon %}</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endif -%}{%- endfor -%}
    </div>
  </section>

  <section id="AltaeronConcerns" class="ah-section ah-concerns" aria-labelledby="ConcernHeading-{{ section.id }}">
    <div class="ah-shell">
      <h2 id="ConcernHeading-{{ section.id }}">{{ section.settings.concern_heading }}</h2>
      <div class="ah-concern-grid">
        {%- for block in section.blocks -%}{%- if block.type == 'concern' -%}
          {%- assign concern_collection = block.settings.collection -%}
          {%- assign concern_product = concern_collection.products.first -%}
          {%- assign concern_image = block.settings.image | default: concern_product.metafields.custom.homepage_card_image.value | default: concern_collection.image | default: concern_product.featured_image -%}
          {%- if concern_collection != blank -%}
            <a class="ah-concern" href="{{ concern_collection.url }}" data-track="concern_card_click" data-concern-title="{{ concern_collection.title | escape }}" {{ block.shopify_attributes }}>
              <div class="ah-concern__media ah-media">{% if concern_image %}{{ concern_image | image_url: width: 620 | image_tag: loading: 'lazy', widths: '220, 360, 480, 620', sizes: '(min-width: 990px) 25vw, 48vw', alt: concern_collection.title }}{% endif %}</div>
              <div class="ah-concern__body">
                <h3>{{ block.settings.heading | default: concern_collection.title }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- elsif concern_collection.description != blank -%}<p>{{ concern_collection.description | strip_html | truncatewords: 12 }}</p>{%- endif -%}
                <span>{{ section.settings.explore_label }} →</span>
              </div>
            </a>
          {%- endif -%}
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- if popular_collection != blank and popular_collection.products_count > 0 -%}
    <section class="ah-section ah-popular" aria-labelledby="PopularHeading-{{ section.id }}">
      <div class="ah-shell">
        <div class="ah-section-head"><h2 id="PopularHeading-{{ section.id }}">{{ section.settings.popular_heading }}</h2><a href="{{ popular_collection.url }}"><span>{{ section.settings.view_all_label }}</span><span aria-hidden="true">→</span></a></div>
        <div class="ah-carousel-wrap"><button class="ah-slider-arrow ah-slider-arrow--prev" type="button" data-slider-prev aria-label="{{ 'altaeron_home.accessibility.previous_products' | t | escape }}">{% render 'icon-slider-prev' %}</button><div class="ah-products ah-slider" data-slider tabindex="0" aria-label="{{ section.settings.popular_heading | escape }}">
          {%- for product in popular_collection.products limit: 8 -%}{% render 'altaeron-home-product', product: product %}{%- endfor -%}
        </div><button class="ah-slider-arrow ah-slider-arrow--next" type="button" data-slider-next aria-label="{{ 'altaeron_home.accessibility.next_products' | t | escape }}">{% render 'icon-slider-next' %}</button></div>
        <div class="ah-dots" data-slider-dots aria-label="{{ 'altaeron_home.accessibility.product_carousel_pagination' | t | escape }}"></div>
      </div>
    </section>
  {%- endif -%}

  <section id="AltaeronQuiz-{{ section.id }}" class="ah-section ah-quiz-section" aria-labelledby="QuizHeading-{{ section.id }}">
    <div class="ah-shell ah-quiz">
      <div class="ah-quiz__intro"><h2 id="QuizHeading-{{ section.id }}">{{ section.settings.quiz_heading }}</h2><p>{{ section.settings.quiz_text }}</p></div>
      <div class="ah-quiz__main" data-quiz>
        <div class="ah-progress" aria-label="{{ 'altaeron_home.accessibility.question_progress' | t | escape }}"><span class="is-active">1</span><i></i><span>2</span><i></i><span>3</span></div>
        <fieldset class="ah-quiz__step is-active" data-quiz-step="1"><legend>{{ section.settings.quiz_question_one }}</legend><div class="ah-quiz__answer-row"><div class="ah-quiz__choices">
          {%- for block in section.blocks -%}{%- if block.type == 'concern' and block.settings.collection != blank -%}
            <button type="button" data-quiz-choice data-title="{{ block.settings.heading | default: block.settings.collection.title | escape }}" data-url="{{ block.settings.collection.url }}"><span class="ah-quiz__choice-icon" aria-hidden="true">{% render 'altaeron-icon', type: block.settings.quiz_icon %}</span><span>{{ block.settings.quiz_label | default: block.settings.heading | default: block.settings.collection.title }}</span></button>
          {%- endif -%}{%- endfor -%}
        </div><div class="ah-quiz__nav"><button class="ah-button ah-quiz__next" type="button" data-quiz-next disabled>{{ 'altaeron_home.quiz.next' | t }} →</button></div></div></fieldset>
        <fieldset class="ah-quiz__step" data-quiz-step="2"><legend>{{ section.settings.quiz_question_two }}</legend><div class="ah-quiz__answer-row"><div class="ah-quiz__choices ah-quiz__choices--three"><button type="button" data-quiz-choice><span>{{ 'altaeron_home.quiz.daytime' | t }}</span></button><button type="button" data-quiz-choice><span>{{ 'altaeron_home.quiz.nighttime' | t }}</span></button><button type="button" data-quiz-choice><span>{{ 'altaeron_home.quiz.both' | t }}</span></button></div><div class="ah-quiz__nav"><button class="ah-quiz__back" type="button" data-quiz-back>← {{ 'altaeron_home.quiz.back' | t }}</button><button class="ah-button ah-quiz__next" type="button" data-quiz-next disabled>{{ 'altaeron_home.quiz.next' | t }} →</button></div></div></fieldset>
        <fieldset class="ah-quiz__step" data-quiz-step="3"><legend>{{ section.settings.quiz_question_three }}</legend><div class="ah-quiz__answer-row"><div class="ah-quiz__choices ah-quiz__choices--three"><button type="button" data-quiz-choice><span>{{ 'altaeron_home.quiz.gentle' | t }}</span></button><button type="button" data-quiz-choice><span>{{ 'altaeron_home.quiz.adjustable' | t }}</span></button><button type="button" data-quiz-choice><span>{{ 'altaeron_home.quiz.firm' | t }}</span></button></div><div class="ah-quiz__nav"><button class="ah-quiz__back" type="button" data-quiz-back>← {{ 'altaeron_home.quiz.back' | t }}</button><button class="ah-button ah-quiz__next" type="button" data-quiz-next disabled>{{ 'altaeron_home.quiz.results' | t }} →</button></div></div></fieldset>
        <div class="ah-quiz__result" data-quiz-result hidden><p>{{ section.settings.quiz_result_prefix }} <strong data-quiz-result-title></strong></p><a class="ah-button" href="{{ routes.all_products_collection_url }}" data-quiz-result-link data-track="quiz_result_clicked">{{ section.settings.quiz_result_label }} →</a></div>
        <p class="ah-quiz__disclaimer">{{ 'altaeron_home.quiz.disclaimer' | t }}</p>
      </div>
    </div>
  </section>

  {%- assign demo_count = section.blocks | where: 'type', 'demonstration' | size -%}
  {%- if demo_count > 0 -%}
    {%- assign has_demo_video = false -%}
    <section class="ah-section ah-demo" aria-labelledby="DemoHeading-{{ section.id }}">
      <div class="ah-shell"><div class="ah-centered"><h2 id="DemoHeading-{{ section.id }}">{{ section.settings.demo_heading }}</h2><p>{{ section.settings.demo_text }}</p></div>
        <div class="ah-demo__rail ah-slider" data-slider tabindex="0">
          {%- for block in section.blocks -%}{%- if block.type == 'demonstration' and block.settings.product != blank -%}
            {%- liquid
              assign demo_product = block.settings.product
              assign demo_block_video = block.settings.video | default: demo_video
              assign demo_poster = block.settings.poster | default: block.settings.video.preview_image | default: demo_product.metafields.custom.homepage_card_image.value | default: demo_product.featured_image | default: demo_video.preview_image
              assign demo_accessibility_label = block.settings.accessibility_label | default: block.settings.heading | default: demo_product.title
              assign demo_video_source = blank
              if demo_block_video != blank
                assign has_demo_video = true
                for source in demo_block_video.sources
                  if source.mime_type contains 'mp4'
                    assign demo_video_source = source.url
                    break
                  endif
                endfor
              endif
            -%}
            <article class="ah-video-card" {{ block.shopify_attributes }}>
              <div class="ah-video-card__media ah-media">{% if demo_poster %}{{ demo_poster | image_url: width: 600 | image_tag: loading: 'lazy', widths: '220, 360, 600', sizes: '(min-width: 990px) 20vw, 34vw', alt: demo_accessibility_label }}{% endif %}{% if demo_video_source != blank %}<button class="ah-play" type="button" aria-label="{{ 'altaeron_home.accessibility.play_named' | t: name: demo_accessibility_label | escape }}" data-video-open data-video-title="{{ block.settings.heading | default: demo_product.title | escape }}" data-video-src="{{ demo_video_source | escape }}"{% if demo_block_video.preview_image %} data-video-poster="{{ demo_block_video.preview_image | image_url: width: 960 }}"{% endif %} data-track="demonstration_video_play">▶</button>{% elsif block.settings.video_url != blank %}<a class="ah-play" href="{{ block.settings.video_url }}" target="_blank" rel="noopener" aria-label="{{ 'altaeron_home.accessibility.play_named' | t: name: demo_accessibility_label | escape }}" data-track="demonstration_video_play">▶</a>{% elsif block.settings.link != blank %}<a class="ah-video-card__link" href="{{ block.settings.link }}" aria-label="{{ demo_accessibility_label | escape }}"></a>{% endif %}</div>
              <h3>{{ block.settings.heading | default: demo_product.title }}</h3>
            </article>
          {%- endif -%}{%- endfor -%}
        </div><div class="ah-dots" data-slider-dots></div>
        {%- if has_demo_video -%}<dialog class="ah-video-modal" data-video-modal aria-labelledby="VideoModalTitle-{{ section.id }}"><div class="ah-video-modal__inner"><button class="ah-video-modal__close" type="button" data-video-close aria-label="{{ 'altaeron_home.accessibility.close_video' | t | escape }}">×</button><h3 id="VideoModalTitle-{{ section.id }}" data-video-modal-title>{{ section.settings.demo_heading }}</h3><video controls preload="none" playsinline><source type="video/mp4"></video></div></dialog>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  <section id="altaeron-values" class="ah-section ah-values" aria-labelledby="ValuesHeading-{{ section.id }}"><div class="ah-shell"><h2 id="ValuesHeading-{{ section.id }}">{{ section.settings.values_heading }}</h2><div class="ah-values__grid">
    {%- for block in section.blocks -%}{%- if block.type == 'value' -%}<article class="ah-value" {{ block.shopify_attributes }}><span class="ah-icon" aria-hidden="true">{% render 'altaeron-icon', type: block.settings.icon %}</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{%- endif -%}{%- endfor -%}
  </div></div></section>

  {%- liquid
    assign aggregate_review_count = 0
    assign aggregate_review_points = 0
    for product in popular_collection.products
      assign aggregate_data = product.metafields.judgeme.review_widget_data.value
      assign product_review_count = aggregate_data.number_of_reviews | default: 0 | plus: 0
      assign product_average = aggregate_data.average_rating | default: 0 | plus: 0
      assign product_points = product_average | times: product_review_count
      assign aggregate_review_count = aggregate_review_count | plus: product_review_count
      assign aggregate_review_points = aggregate_review_points | plus: product_points
    endfor
  -%}
  {%- capture review_cards -%}
    {%- assign review_count = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'testimonial' -%}
      {%- liquid
        assign testimonial_product = block.settings.product
        assign review_data = testimonial_product.metafields.judgeme.review_widget_data.value
        assign review_index = block.settings.review_number | minus: 1
        assign review = review_data.reviews[review_index]
        assign review_body = block.settings.quote | default: review.body | strip_html
        assign reviewer_name = block.settings.customer_name | default: review.reviewer_name
        assign review_rating = review.rating | default: block.settings.rating | plus: 0
        assign review_picture = review.pictures_urls.first.original
        assign testimonial_image = block.settings.image | default: testimonial_product.metafields.custom.homepage_card_image.value | default: testimonial_product.featured_image
      -%}
      {%- if review_body != blank and reviewer_name != blank -%}{%- assign review_count = review_count | plus: 1 -%}
        <article class="ah-review" {{ block.shopify_attributes }}>
          <div class="ah-review__media ah-media{% if block.settings.image == blank and review_picture == blank and block.settings.video == blank and block.settings.video_url == blank %} ah-review__media--product{% endif %}">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: controls: true, preload: 'none', image_size: '900x', class: 'ah-review__video' }}
            {%- elsif block.settings.video_url != blank -%}
              <a href="{{ block.settings.video_url }}" target="_blank" rel="noopener" aria-label="{{ 'altaeron_home.accessibility.play_testimonial' | t: name: block.settings.media_alt | escape }}" data-track="review_video_play">
                {%- if block.settings.poster != blank -%}{{ block.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 44vw', alt: block.settings.media_alt }}{%- elsif testimonial_image != blank -%}{{ testimonial_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 44vw', alt: block.settings.media_alt }}{%- endif -%}
                <span class="ah-review__play" aria-hidden="true">▶</span>
              </a>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 44vw', alt: block.settings.media_alt }}
            {%- elsif testimonial_image != blank -%}
              {{ testimonial_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 44vw', alt: block.settings.media_alt }}
              <span class="ah-review__context">{{ 'altaeron_home.reviews.reviewed_product' | t }}</span>
            {%- elsif review_picture != blank -%}
              <img src="{{ review_picture | escape }}" loading="lazy" width="900" height="560" alt="{{ block.settings.media_alt | default: reviewer_name | escape }}">
            {%- endif -%}
          </div>
          <div class="ah-review__body">
            {%- if review_rating > 0 -%}<span class="ah-stars" aria-label="{{ 'altaeron_home.reviews.rating' | t: rating: review_rating | escape }}">★★★★★</span>{%- endif -%}
            <blockquote>“{{ review_body | escape }}”</blockquote>
            <cite>— {{ reviewer_name | escape }}{% if block.settings.persona != blank %}, {{ block.settings.persona | escape }}{% endif %}</cite>
            {%- if block.settings.verified_label != blank -%}<span class="ah-review__verified">{{ block.settings.verified_label | escape }}</span>{%- endif -%}
            <a class="ah-review__link" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif testimonial_product != blank %}{{ testimonial_product.url }}#judgeme_product_reviews{% else %}#altaeron-reviews{% endif %}" data-track="review_click">{{ 'altaeron_home.reviews.read_review' | t }}<span aria-hidden="true"> →</span></a>
          </div>
        </article>
      {%- endif -%}
    {%- endif -%}{%- endfor -%}
  {%- endcapture -%}
  {%- if review_count > 0 -%}
    <section id="altaeron-reviews" class="ah-section ah-reviews" aria-labelledby="ReviewsHeading-{{ section.id }}"><div class="ah-shell"><div class="ah-centered"><h2 id="ReviewsHeading-{{ section.id }}">{{ section.settings.reviews_heading }}</h2>{% if aggregate_review_count > 0 %}{% assign aggregate_average = aggregate_review_points | divided_by: aggregate_review_count | round: 1 %}<p class="ah-review-summary"><span class="ah-stars" aria-hidden="true">★★★★★</span> {{ 'altaeron_home.reviews.summary' | t: rating: aggregate_average, count: aggregate_review_count }}</p>{% endif %}</div><div class="ah-review-rail ah-slider" data-slider tabindex="0">{{ review_cards }}</div><div class="ah-dots" data-slider-dots></div></div></section>
  {%- endif -%}

  {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
    <section class="ah-section ah-guides" aria-labelledby="GuidesHeading-{{ section.id }}"><div class="ah-shell"><div class="ah-section-head"><h2 id="GuidesHeading-{{ section.id }}">{{ section.settings.guides_heading }}</h2><a href="{{ section.settings.blog.url }}"><span>{{ section.settings.view_all_label }}</span><span aria-hidden="true">→</span></a></div><div class="ah-guide-grid">
      {%- for article in section.settings.blog.articles limit: 3 -%}
        {%- liquid
          assign article_cover = article.image | default: article.metafields.custom.cover_image.value
          assign article_words = article.content | strip_html | split: ' ' | size
          assign read_minutes = article_words | divided_by: 200 | plus: 1
          assign article_description = article.excerpt | default: article.content | strip_html | strip
        -%}
        <article class="ah-guide">
          <a href="{{ article.url }}" data-track="article_click">
            <div class="ah-guide__media ah-media">
              {% if article_cover %}{{ article_cover | image_url: width: 620 | image_tag: loading: 'lazy', widths: '240, 400, 620', sizes: '(min-width: 750px) 33vw, 28vw', alt: article.title }}{% endif %}
            </div>
            <div class="ah-guide__body">
              <h3>{{ article.title }}</h3>
              {%- if article_description != blank -%}<p class="ah-guide__description">{{ article_description }}</p>{%- endif -%}
              <p class="ah-guide__reading-time">{{ 'altaeron_home.guides.reading_time' | t: minutes: read_minutes }}</p>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div></div></section>
  {%- endif -%}

  <section id="altaeron-faq" class="ah-section ah-faq" aria-labelledby="FaqHeading-{{ section.id }}"><div class="ah-shell"><h2 id="FaqHeading-{{ section.id }}">{{ section.settings.faq_heading }}</h2><div class="ah-faq__grid">
    {%- for block in section.blocks -%}{%- if block.type == 'faq' and block.settings.question != blank -%}<details class="ah-faq__item" {{ block.shopify_attributes }}><summary data-track="faq_open">{{ block.settings.question }}{% render 'icon-accordion-chevron', class: 'ah-faq__chevron' %}</summary><div class="rte">{{ block.settings.answer }}</div></details>{%- endif -%}{%- endfor -%}
  </div></div></section>

  <section class="ah-newsletter" aria-labelledby="NewsletterHeading-{{ section.id }}"><div class="ah-shell ah-newsletter__inner"><div><h2 id="NewsletterHeading-{{ section.id }}">{{ section.settings.newsletter_heading }}</h2><p>{{ section.settings.newsletter_text }}</p></div>{%- form 'customer', class: 'ah-newsletter__form' -%}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label><input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ section.settings.newsletter_placeholder }}" required><button type="submit" data-track="newsletter_signup">{{ section.settings.newsletter_button }}</button>{%- if form.posted_successfully? -%}<p class="ah-newsletter__message" role="status">{{ 'newsletter.success' | t }}</p>{%- elsif form.errors -%}<p class="ah-newsletter__message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}{%- endform -%}{%- if section.settings.newsletter_privacy != blank -%}<p class="ah-newsletter__privacy">{{ section.settings.newsletter_privacy }}</p>{%- endif -%}</div></section>
</altaeron-home>

{% schema %}
{
  "name": "Altaeron homepage",
  "tag": "section",
  "class": "altaeron-home-section",
  "settings": [
    {"type":"text","id":"hero_heading","label":"Hero heading","default":"Support Every Step."},
    {"type":"richtext","id":"hero_text","label":"Hero text","default":"<p>Find the right support for bunions, heel pain, ankle instability and everyday foot discomfort.</p>"},
    {"type":"product","id":"hero_product","label":"Hero product fallback"},
    {"type":"image_picker","id":"hero_image","label":"Hero desktop image"},
    {"type":"image_picker","id":"hero_mobile_image","label":"Hero mobile image","info":"Optional. Uses the desktop image when left blank."},
    {"type":"text","id":"hero_image_alt","label":"Hero image alt text","default":"Foot support products for everyday comfort"},
    {"type":"range","id":"hero_desktop_x","label":"Desktop focal point horizontal","min":0,"max":100,"step":1,"unit":"%","default":50},
    {"type":"range","id":"hero_desktop_y","label":"Desktop focal point vertical","min":0,"max":100,"step":1,"unit":"%","default":50},
    {"type":"range","id":"hero_mobile_x","label":"Mobile focal point horizontal","min":0,"max":100,"step":1,"unit":"%","default":67},
    {"type":"range","id":"hero_mobile_y","label":"Mobile focal point vertical","min":0,"max":100,"step":1,"unit":"%","default":50},
    {"type":"range","id":"hero_mobile_overlay","label":"Mobile copy gradient strength","min":0,"max":100,"step":5,"unit":"%","default":85},
    {"type":"text","id":"primary_label","label":"Primary button","default":"Shop by Concern"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"Find Your Match"},
    {"type":"text","id":"concern_heading","label":"Concern heading","default":"Where Does It Hurt?"},
    {"type":"text","id":"explore_label","label":"Concern link label","default":"Explore"},
