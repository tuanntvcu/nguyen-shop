  #AltaeronPdp-{{ section.id }} .ngp-apdp-day__benefits article{background:var(--ngp-altaeron-off-white,#F8FAF9);border-color:var(--ngp-altaeron-border,#E4E7EC)}
  #AltaeronPdp-{{ section.id }} :where(.ngp-apdp-gallery-story__copy,.apdp-gallery-story__consequence){color:var(--ngp-altaeron-body,#344054)}
