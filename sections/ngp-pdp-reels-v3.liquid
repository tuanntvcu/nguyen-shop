  {% render 'ngp-reels-responsive-main', section_id: section.id, template_class: 'altaeron-reels-v3' %}</style>

<div
  id="AltaeronPdp-{{ section.id }}"
  class="ngp-pdp ngp-altaeron-pdp--cro-hero ngp-altaeron-pdp--reels-v3"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-save-label="{{ 'altaeron_pdp_reels_v2.common.save' | t | escape }}"
  data-save-template="{{ 'altaeron_pdp_reels_v2.common.save_template' | t | escape }}"
  data-add-to-cart-label="{{ ngp_reel_cta_label | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
>
  <section class="ngp-apdp-hero" aria-labelledby="AltaeronTitle-{{ section.id }}">
    <div class="ngp-apdp-shell ngp-apdp-hero__grid">
      <div class="ngp-apdp-gallery{% unless ngp_show_hero_video %} is-viewer-active{% endunless %}" data-apdp-gallery>
        <div class="ngp-apdp-gallery__thumbs" role="tablist" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.product_media' | t | escape }}">
          {%- if ngp_show_hero_video -%}
          <button type="button" class="ngp-apdp-gallery__thumb is-active" role="tab" aria-selected="true" aria-controls="AltaeronDemo-{{ section.id }}" data-apdp-thumb="demo" data-apdp-demo-thumb>
            {%- if ngp_hero_thumbnail != blank -%}
              {{ ngp_hero_thumbnail | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: ngp_support_demo_alt }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if ngp_hero_video != blank -%}<span class="ngp-apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
          </button>
          {%- endif -%}
          {%- for media in product.media -%}
            <button type="button" class="ngp-apdp-gallery__thumb{% if ngp_show_hero_video == false and forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if ngp_show_hero_video == false and forloop.first %}true{% else %}false{% endif %}" aria-controls="AltaeronMedia-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '58px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="ngp-apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        {%- if ngp_show_hero_video -%}
        <div id="AltaeronDemo-{{ section.id }}" class="ngp-apdp-gallery__stage ngp-apdp-gallery__hero is-active" role="tabpanel" data-apdp-media="demo" aria-hidden="false"{% if ngp_hero_poster != blank %} style="--ngp-apdp-hero-poster:url('{{ ngp_hero_poster }}')"{% endif %}>
          {%- if ngp_hero_video != blank -%}
            {%- liquid
              assign ngp_hero_mobile_source = blank
              assign ngp_hero_desktop_source = blank
              for ngp_hero_source in ngp_hero_video.sources
                if ngp_hero_source.format == 'mp4'
                  if ngp_hero_desktop_source == blank or ngp_hero_source.height > ngp_hero_desktop_source.height
                    assign ngp_hero_desktop_source = ngp_hero_source
                  endif
                  if ngp_hero_source.height <= 720
                    if ngp_hero_mobile_source == blank or ngp_hero_source.height > ngp_hero_mobile_source.height
                      assign ngp_hero_mobile_source = ngp_hero_source
                    endif
                  endif
                endif
              endfor
              assign ngp_hero_desktop_source = ngp_hero_desktop_source | default: ngp_hero_video.sources.first
              assign ngp_hero_mobile_source = ngp_hero_mobile_source | default: ngp_hero_desktop_source
            -%}
            <video data-apdp-hero-video autoplay muted playsinline loop preload="metadata" poster="{{ ngp_hero_poster }}" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.hero_video' | t | escape }}">
              {%- if ngp_hero_desktop_source.url == ngp_hero_mobile_source.url -%}
                <source src="{{ ngp_hero_desktop_source.url }}" type="{{ ngp_hero_desktop_source.mime_type | default: 'video/mp4' }}">
              {%- else -%}
                <source src="{{ ngp_hero_mobile_source.url }}" type="{{ ngp_hero_mobile_source.mime_type | default: 'video/mp4' }}" media="(max-width: 767px)">
                <source src="{{ ngp_hero_desktop_source.url }}" type="{{ ngp_hero_desktop_source.mime_type | default: 'video/mp4' }}" media="(min-width: 768px)">
              {%- endif -%}
            </video>
          {%- elsif ngp_hero_image != blank -%}
            {{ ngp_hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 1280px) 37vw, (min-width: 768px) 55vw, 100vw', alt: ngp_hero_image.alt | default: product.title }}
          {%- else -%}
            <div class="ngp-apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        {%- endif -%}
        <div class="ngp-apdp-gallery__viewer" aria-live="polite">
          {%- for media in product.media -%}
            <div id="AltaeronMedia-{{ section.id }}-{{ media.id }}" class="ngp-apdp-gallery__item{% if ngp_show_hero_video == false and forloop.first %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}" aria-hidden="{% if ngp_show_hero_video == false and forloop.first %}false{% else %}true{% endif %}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-apdp-zoom-width="{{ media.preview_image.width }}" data-apdp-zoom-height="{{ media.preview_image.height }}"{% endif %}{% unless ngp_show_hero_video == false and forloop.first %} hidden{% endunless %}>
              {%- if ngp_show_hero_video == false and forloop.first and media.media_type == 'image' -%}
                {% render 'ngp-pdp-media', media: media, product: product, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 560px, 55vw' %}
              {%- else -%}
                {% render 'ngp-pdp-media', media: media, product: product, loading: 'lazy', fetchpriority: 'auto', sizes: '(min-width: 1024px) 560px, 55vw', autoplay: true, loop: true, muted: true %}
              {%- endif -%}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="ngp-apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.open_image' | t: index: forloop.index | escape }}"><span aria-hidden="true">{% render 'ngp-icon-zoom' %}</span></button>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="ngp-apdp-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
          {%- if ngp_show_hero_video -%}
            <button type="button" class="ngp-apdp-gallery__return" data-apdp-return-demo aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.return_demo' | t | escape }}"><span aria-hidden="true">←</span> {{ 'altaeron_pdp_reels_v2.accessibility.back_to_demo' | t }}</button>
          {%- endif -%}
        </div>
      </div>

      <div class="ngp-apdp-narrative">
        {%- if ngp_review_count > 0 and ngp_review_rating > 0 -%}
          <a class="ngp-apdp-rating" href="#AltaeronV3Reviews" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.rating' | t: rating: ngp_review_rating_display, count: ngp_review_count | escape }}">
            {% render 'ngp-pdp-stars', rating: ngp_review_rating %}<strong>{{ 'altaeron_pdp_reels_v2.common.atf_rating' | t: rating: ngp_review_rating_display, count: ngp_review_count }}</strong>
          </a>
        {%- endif -%}
        <p class="ngp-apdp-narrative__product">{{ ngp_reel_product_name }}</p>
        <h1 id="AltaeronTitle-{{ section.id }}"><span class="ngp-apdp-title-lines">{{ ngp_reel_headline }}</span></h1>
        <p class="ngp-apdp-narrative__subheadline">{{ ngp_reel_subheadline | newline_to_br }}</p>
        <ul class="ngp-apdp-narrative__benefits" role="list">
          {%- for ngp_i in (1..4) -%}
            {%- capture ngp_benefit_key -%}altaeron_pdp_reels_v3.hero.benefit_{{ ngp_i }}{%- endcapture -%}
            {%- assign ngp_benefit_text = ngp_benefit_key | t | replace: '&lt;', '<' | replace: '&gt;', '>' -%}
            <li>{% render 'ngp-pdp-icon', icon: 'check' %}<span>{{ ngp_benefit_text }}</span></li>
          {%- endfor -%}
        </ul>
      </div>

      <aside id="AltaeronBuy-{{ section.id }}" class="ngp-apdp-buy" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.purchase' | t: product: product.title | escape }}" data-apdp-primary-purchase>
        <h2 class="ngp-apdp-buy__title">{{ 'altaeron_pdp_reels_v2.common.choose_bundle' | t }}</h2>
        <div class="ngp-apdp-buy__price-line">
          <div><p class="ngp-apdp-buy__from">{{ ngp_reel_price_label }}</p><div class="ngp-apdp-price" aria-live="polite"><span class="ngp-apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="ngp-apdp-price__compare" data-apdp-compare-price{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_compare_price | money }}</s></div></div>
          <span class="ngp-apdp-price__save" data-apdp-savings{% if ngp_savings <= 0 %} hidden{% endif %}>{{ 'altaeron_pdp_reels_v2.common.save_amount' | t: amount: ngp_savings_money }}</span>
        </div>
        {%- form 'product', product, id: ngp_product_form_id, class: 'ngp-apdp-form main-product-form', is: 'ngp-product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="ngp-product-form__error-message-wrapper" role="alert" hidden><div class="ngp-product-form__error-message alert alert--error" role="alert" hidden></div></div>
          {%- unless product.has_only_default_variant -%}
            <fieldset class="ngp-apdp-variants">
              <legend>{{ 'altaeron_pdp_reels_v2.buy.choose_option' | t }}</legend>
              {%- if product.variants.size > 6 -%}
                <label class="visually-hidden" for="AltaeronVariant-{{ section.id }}">{{ 'altaeron_pdp_reels_v2.buy.product_option' | t }}</label>
                <select id="AltaeronVariant-{{ section.id }}" data-apdp-variant-select>{%- for variant in product.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}</select>
              {%- else -%}
                <div class="ngp-apdp-variants__grid">{%- for variant in product.variants limit: 3 -%}<input class="visually-hidden" type="radio" id="AltaeronVariant-{{ section.id }}-{{ variant.id }}" name="apdp-variant" value="{{ variant.id }}" data-apdp-variant-option data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} checked{% endif %}><label for="AltaeronVariant-{{ section.id }}-{{ variant.id }}">{{ variant.title }}</label>{%- endfor -%}</div>
              {%- endif -%}
            </fieldset>
          {%- endunless -%}
          <bundle-deals-widget id="AltaeronBundles-{{ section.id }}" tabindex="-1" product-id="{{ product.id }}"></bundle-deals-widget>
          <p class="ngp-apdp-new-customer-offer">{{ 'altaeron_pdp_reels_v3.hero.purchase_clarification' | t }}</p>
          <button type="submit" name="add" class="ngp-apdp-button ngp-apdp-button--primary ngp-product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ ngp_reel_cta_label }}">{% if current_variant.available %}{{ ngp_reel_cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span><span data-apdp-cta-price{% unless current_variant.available %} hidden{% endunless %}>{% if current_variant.available %} — {{ current_variant.price | money }}{% endif %}</span></span><span class="loading__spinner hidden">{% render 'ngp-loading-spinner' %}</span></button>
          <p class="ngp-apdp-delivery-estimate" data-apdp-delivery-estimate data-locale="{{ request.locale.iso_code | escape }}">{% render 'ngp-pdp-icon', icon: 'truck' %}<span>{{ 'altaeron_pdp_reels_v3.hero.estimated_delivery' | t }}: <strong data-apdp-delivery-range></strong></span></p>
          <p class="ngp-apdp-cta-reassurance">{% render 'ngp-pdp-icon', icon: 'lock' %}<span>{{ 'altaeron_pdp_reels_v3.hero.trust_row' | t }}</span></p>
          <div class="ngp-apdp-payment-terms" data-apdp-installments>{{ 'altaeron_pdp_reels_v2.buy.installments' | t: amount: ngp_installment_amount }} <strong>shop<span>Pay</span></strong></div>
          {%- if shop.enabled_payment_types.size > 0 -%}
            {%- liquid
              assign ngp_mobile_payment_prefix = 'apdp-buy-mobile-' | append: section.id | append: '-'
              assign ngp_mobile_payment_id = ' id="' | append: ngp_mobile_payment_prefix
              assign ngp_mobile_payment_labelledby = 'aria-labelledby="' | append: ngp_mobile_payment_prefix
              assign ngp_mobile_payment_url = 'url(#' | append: ngp_mobile_payment_prefix
              assign ngp_mobile_payment_href = 'href="#' | append: ngp_mobile_payment_prefix
            -%}
            <details class="ngp-apdp-payment-options">
              <summary>{{ 'altaeron_pdp_reels_v2.buy.more_payment_options' | t: default: 'More payment options' }}</summary>
              <ul class="ngp-apdp-payment-icons list list-payment" role="list" aria-label="{{ 'altaeron_pdp_reels_v2.accessibility.payment_methods' | t | escape }}">
              {%- for ngp_type in shop.enabled_payment_types -%}
                {%- capture ngp_payment_svg -%}{{ ngp_type | payment_type_svg_tag: class: 'icon icon--full-color' }}{%- endcapture -%}
                <li class="list-payment__item">{{ ngp_payment_svg | replace: ' id="', ngp_mobile_payment_id | replace: 'aria-labelledby="', ngp_mobile_payment_labelledby | replace: 'url(#', ngp_mobile_payment_url | replace: 'href="#', ngp_mobile_payment_href }}</li>
              {%- endfor -%}
              </ul>
            </details>
          {%- endif -%}
        {%- endform -%}
        <div class="ngp-apdp-buy__trust ngp-apdp-buy__trust--three">
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{% render 'ngp-pdp-icon', icon: 'truck' %}<b>{{ 'altaeron_pdp_reels_v2.buy.shipping' | t }}</b></a>
          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{% render 'ngp-pdp-icon', icon: 'return' %}<b>{{ 'altaeron_pdp_reels_v2.buy.returns_30' | t: default: '30-Day Returns' }}</b></a>
          <a href="/pages/contact">{% render 'ngp-pdp-icon', icon: 'medical-cross' %}<b>{{ 'storefront.pdp.clinically_proven' | t: default: 'Clinically Proven' | escape }}</b></a>
        </div>
        <figure class="ngp-apdp-hero-review">
          <div class="ngp-apdp-tail-avatar">
            {%- if section.settings.review_avatar != blank -%}
              {{ section.settings.review_avatar | image_url: width: 160 | image_tag: loading: 'eager', widths: '80, 120, 160', sizes: '56px', alt: section.settings.review_avatar.alt | default: section.settings.reviewer_name }}
            {%- else -%}
              <span class="ngp-apdp-tail-avatar__initial" aria-hidden="true">{{ section.settings.reviewer_name | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <div>
            {% render 'ngp-pdp-stars', rating: 5 %}
            <blockquote>{{ ngp_reel_review_content }}</blockquote>
            <figcaption><strong>{{ section.settings.reviewer_name }}</strong> &middot; {{ 'altaeron_pdp.reviews.verified_buyer' | t }}</figcaption>
          </div>
        </figure>
      </aside>
    </div>
  </section>


  <div class="ngp-apdp-sticky" data-apdp-sticky hidden><div class="ngp-apdp-sticky__product">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '52px', alt: product.featured_image.alt | default: product.title }}{%- endif -%}<span><small><span>{{ ngp_reel_price_label }}</span> <b data-apdp-sticky-price>{{ current_variant.price | money }}</b> <s data-apdp-sticky-compare{% if ngp_savings <= 0 %} hidden{% endif %}>{{ ngp_compare_price | money }}</s></small><em data-apdp-sticky-savings{% if ngp_savings <= 0 %} hidden{% endif %}>{{ 'altaeron_pdp_reels_v2.common.save_amount' | t: amount: ngp_savings_money }}</em><small class="ngp-apdp-sticky__bundle-title" data-apdp-sticky-bundle-title hidden></small></span></div><button type="button" class="ngp-apdp-button ngp-apdp-button--primary" data-apdp-sticky-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-sticky-text>{% if current_variant.available %}{{ ngp_reel_cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span></button></div>
  <script type="application/json" data-apdp-product-json>{{ product.variants | json }}</script>
  <script>
    (() => {
      const ngp_root = document.getElementById('AltaeronPdp-{{ section.id }}');
      const ngp_gallery = ngp_root?.querySelector('[data-apdp-gallery]');
      const ngp_heroVideo = ngp_gallery?.querySelector('[data-apdp-hero-video]');
      const ngp_demoThumb = ngp_gallery?.querySelector('[data-apdp-demo-thumb]');
      const ngp_returnButton = ngp_gallery?.querySelector('[data-apdp-return-demo]');
      const ngp_desktop = window.matchMedia('(min-width: 1100px)');
      if (!ngp_gallery || !ngp_returnButton) return;

      const ngp_showDemo = (ngp_resume = false) => {
        ngp_gallery.classList.remove('is-viewer-active');
        ngp_gallery.querySelectorAll('[data-apdp-media] video').forEach((ngp_video) => ngp_video.pause());
        if (ngp_resume && ngp_heroVideo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          ngp_heroVideo.play().catch(() => {});
        }
      };

      ngp_gallery.querySelectorAll('[data-apdp-thumb]:not([data-apdp-demo-thumb])').forEach((ngp_thumb) => {
        ngp_thumb.addEventListener('click', () => {
          ngp_gallery.classList.add('is-viewer-active');
          ngp_heroVideo?.pause();
        });
      });
      ngp_demoThumb?.addEventListener('click', () => ngp_showDemo(true));
      ngp_returnButton.addEventListener('click', () => ngp_demoThumb ? ngp_demoThumb.click() : ngp_showDemo(true));
      ngp_desktop.addEventListener?.('change', (ngp_event) => {
        if (!ngp_event.matches) ngp_showDemo(false);
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Altaeron Reels V3 PDP",
  "tag": "section",
  "class": "section-altaeron-pdp section-altaeron-pdp-reels-v3",
  "settings": [
    { "type": "header", "content": "Reels hero" },
    { "type": "checkbox", "id": "show_hero_video", "label": "Show metafield video first in gallery", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Product name", "default": "Altaeron™ Adjustable Bunion Corrector" },
    { "type": "inline_richtext", "id": "headline", "label": "Core benefit", "default": "<strong>Straighten</strong> Your <strong>Big Toe</strong>. <strong>Reduce</strong> the <strong>Bunion Bump</strong>." },
    { "type": "textarea", "id": "subheadline", "label": "Explanation", "default": "<strong>Crooked big toe? Painful bunion bump?</strong> It's time to take <strong>action</strong>." },
    { "type": "header", "content": "Above-the-fold review" },
    { "type": "image_picker", "id": "review_avatar", "label": "Reviewer image" },
    { "type": "richtext", "id": "review_content", "label": "Review content", "default": "<p>I started with gentle tension and adjusted it until it felt comfortable. Simple to use and surprisingly supportive</p>" },
    { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Karen M." },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "From" },
    { "type": "text", "id": "cta_label", "label": "Add to cart label", "default": "ADD TO CART" }
  ],
  "blocks": [
    {
      "type": "education_media",
      "name": "Demonstration media",
      "settings": [
        { "type": "select", "id": "slot", "label": "Media position", "options": [
          { "value": "support_demo", "label": "How it works demo" },
          { "value": "day_story", "label": "How to use demo" }
        ], "default": "support_demo" },
        { "type": "image_picker", "id": "image", "label": "Image fallback" },
        { "type": "video", "id": "video", "label": "Video" }
      ]
    },
    {
      "type": "tail_media",
      "name": "Product media",
      "settings": [
        { "type": "select", "id": "slot", "label": "Media position", "options": [
          { "value": "spacer", "label": "Basic toe spacer" },
          { "value": "support", "label": "Altaeron support" },
          { "value": "cta_product", "label": "Final CTA product" }
        ], "default": "spacer" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [{ "name": "Altaeron Reels V3 PDP" }]
}
{% endschema %}
