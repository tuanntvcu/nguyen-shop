{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign ngp_mf = product.metafields.altaeron
  assign ngp_hero_video = ngp_mf.pdp_hero_video.value
  assign ngp_show_hero_video = false
  if section.settings.show_hero_video and ngp_hero_video != blank
    assign ngp_show_hero_video = true
  endif
  assign ngp_hero_image = ngp_mf.pdp_hero_image.value | default: product.featured_image
  assign ngp_hero_poster = ngp_hero_video.preview_image | image_url: width: 1200
  assign ngp_hero_thumbnail = ngp_hero_video.preview_image | default: ngp_hero_image
  assign ngp_review_data = product.metafields.judgeme.review_widget_data.value
  assign ngp_review_count = ngp_review_data.number_of_reviews | default: 0 | plus: 0
  assign ngp_review_rating = ngp_review_data.average_rating | default: 0 | plus: 0
  assign ngp_review_rating_display = ngp_review_rating | times: 10 | floor | divided_by: 10.0
  assign ngp_reel_product_name = section.settings.eyebrow
  assign ngp_reel_headline = section.settings.headline
  assign ngp_reel_subheadline = section.settings.subheadline
  assign ngp_reel_price_label = section.settings.price_label
  assign ngp_reel_cta_label = section.settings.cta_label
  assign ngp_reel_review_content = section.settings.review_content
  unless request.locale.iso_code == 'en'
    assign ngp_reel_product_name = 'altaeron_pdp_reels_v3.hero.product_name' | t
    assign ngp_reel_headline = 'altaeron_pdp_reels_v3.hero.headline_html' | t | replace: '&lt;', '<' | replace: '&gt;', '>'
    assign ngp_reel_subheadline = 'altaeron_pdp_reels_v3.hero.explanation' | t | replace: '&lt;', '<' | replace: '&gt;', '>'
    assign ngp_reel_price_label = 'altaeron_pdp_reels_v2.common.from' | t
    assign ngp_reel_review_content = 'altaeron_pdp_reels_v3.hero.review_content_html' | t | replace: '&lt;', '<' | replace: '&gt;', '>'
  endunless
  assign ngp_reel_cta_label = 'products.product.add_to_cart' | t
  assign ngp_reel_cta_label = ngp_reel_cta_label | remove: '→' | strip
  assign ngp_product_form_id = 'product-form-' | append: section.id
  assign ngp_compare_price = current_variant.compare_at_price
  
  assign ngp_savings = 0
  if ngp_compare_price > current_variant.price
    assign ngp_savings = ngp_compare_price | minus: current_variant.price
  endif
  assign ngp_savings_money = ngp_savings | money
  assign ngp_installment_amount = current_variant.price | divided_by: 4 | money
  assign ngp_support_demo_alt = 'altaeron_pdp_reels_v2.accessibility.support_demo' | t
-%}

<script src="{{ 'ngp-altaeron-pdp.js' | asset_url }}" defer="defer"></script>

