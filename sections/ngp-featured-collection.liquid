{%- liquid
  assign ngp_collection = collections[section.settings.collection]
  assign ngp_products_to_display = section.settings.limit
  if ngp_collection != blank and ngp_collection.all_products_count < ngp_products_to_display
    assign ngp_products_to_display = ngp_collection.all_products_count
  endif

  assign ngp_header_layout = section.settings.header_layout
  assign ngp_show_all_button_on_top = section.settings.show_all_button_on_top
  assign ngp_button_style = section.settings.button_style
  assign ngp_button_label = section.settings.button_label
  assign ngp_button_link = ngp_collection.url

  assign ngp_description = section.settings.description
  if section.settings.show_collection_description
    assign ngp_description = ngp_collection.description
  endif

  assign ngp_columns_desktop = section.settings.columns

  assign ngp_columns_tablet = ngp_columns_desktop | minus: 1
  if ngp_columns_desktop < 3 or request.design_mode
    assign ngp_columns_tablet = ngp_columns_desktop
  endif

  assign ngp_columns_mobile = section.settings.columns_mobile | plus: 0

  assign ngp_enable_swipe_mobile = false
  if section.settings.swipe_on_mobile and ngp_products_to_display > ngp_columns_mobile
    assign ngp_enable_swipe_mobile = true
  endif

  assign ngp_item_css_class = 'ngp-f-column'

  assign ngp_enable_slider = false
  if section.settings.enable_slider and ngp_products_to_display > ngp_columns_desktop
    assign ngp_enable_slider = true
    assign ngp_item_css_class = ngp_item_css_class | append: ' swiper-slide'
  endif

  assign ngp_is_metro = false
  if section.settings.grid_layout == 'metro' and ngp_enable_slider == false
    assign ngp_is_metro = true
  endif
-%}
{%- if ngp_is_metro -%}
  {%- render 'ngp-product-grid-metro-style',
    section_id: section.id,
    ngp_columns_desktop: ngp_columns_desktop,
    ngp_columns_tablet: ngp_columns_tablet,
    ngp_columns_mobile: ngp_columns_mobile
  -%}
{%- endif -%}
{%- capture ngp_image_sizes -%}
(max-width: 767px) calc((100vw - 30px) / {{ ngp_columns_mobile }}),
(max-width: 1023px) calc((100vw - 30px) / {{ ngp_columns_tablet }}),
{{ settings.page_width | divided_by: ngp_columns_desktop }}px
{%- endcapture -%}
{{ 'ngp-section-featured-collection.css' | asset_url | stylesheet_tag }}

{% render 'ngp-divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="ngp-section ngp-section-{{ section.id }}{% if ngp_enable_slider %} ngp-slider-enabled{% endif %} ngp-section--featured-collection ngp-section-header-{{ ngp_header_layout }} ngp-section--padding ngp-page-width ngp-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-id="{{ section.id }}"
>
  <div class="ngp-section__wrapper">
    <div class="ngp-section__header-wrap ngp-flex ngp-lg:ngp-flex-col ngp-justify-between">
      {% render 'ngp-section-heading',
        section_settings: section.settings,
        ngp_description: ngp_description,
        description_size: section.settings.text_size,
        button_visible: ngp_show_all_button_on_top,
        ngp_button_link: ngp_button_link,
        ngp_button_style: ngp_button_style,
        ngp_button_label: ngp_button_label,
        custom_css_class: 'flex-grow'
      %}
      {%- if ngp_enable_slider and ngp_header_layout == 'standing-column' -%}
        <div class="ngp-swiper-controls hidden ngp-md:ngp-flex ngp-items-center ngp-justify-start ngp-gap-2">
          <button
            class="swiper-button-prev ngp-btn"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            {% render 'ngp-icon-slider-prev' %}
          </button>
          <button
            class="swiper-button-next ngp-btn"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            {% render 'ngp-icon-slider-next' %}
          </button>
        </div>
      {%- endif -%}
    </div>
    <div class="ngp-section__content">
      <ngp-grid-list class="ngp-block ngp-relative ngp-swiper-show-nav-on-hover">
        <ngp-featured-collection
          class="ngp-block{% if ngp_enable_slider %} swiper ngp-f-grid--gap-{{ section.settings.column_gap }}{% endif %}{% if ngp_enable_swipe_mobile %} ngp-swipe-mobile ngp-swipe-mobile--{{ section.settings.columns_mobile }}-cols{% endif %}"
          data-section-id="{{ section.id }}"
          {% if ngp_enable_slider %}
            data-enable-slider="true"
            data-items="{{ ngp_columns_desktop }}"
            data-tablet-items="{{ ngp_columns_tablet }}"
            {% if ngp_header_layout == 'standing-column' %}
              data-calc-heading-column-height="true"
            {%- else -%}
              data-calc-button-position="true"
            {% endif %}
          {% endif %}
        >
          <div class="ngp-featured-collection__items ngp-products-list ngp-f-grid ngp-f-grid-{{ ngp_columns_mobile }}-cols ngp-md:ngp-f-grid-{{ ngp_columns_tablet }}-cols ngp-lg:ngp-f-grid-{{ ngp_columns_desktop }}-cols ngp-f-grid--gap-{{ section.settings.column_gap }} ngp-f-grid--row-gap-{{ section.settings.row_gap }}{% if ngp_enable_slider %} swiper-wrapper{% endif %}{% if ngp_enable_swipe_mobile %} ngp-swipe-mobile__inner{% endif %}">
            {%- for ngp_product in ngp_collection.products limit: ngp_products_to_display -%}
              <div class="{{ ngp_item_css_class }}">
                {%- if ngp_is_metro -%}
                  {%- render 'ngp-card-product-metro',
                    product: ngp_product,
                    ngp_image_sizes: ngp_image_sizes,
                    ngp_image_ratio: section.settings.pcard_image_ratio,
                    section_index: section.index,
                    index: forloop.index,
                    index0: forloop.index0,
                    ngp_columns_desktop: ngp_columns_desktop,
                    ngp_columns_tablet: ngp_columns_tablet,
                    ngp_columns_mobile: ngp_columns_mobile
                  -%}
                {%- else -%}
                  {%- render 'ngp-card-product',
                    product: ngp_product,
                    ngp_image_sizes: ngp_image_sizes,
                    ngp_image_ratio: section.settings.pcard_image_ratio,
                    section_index: section.index,
                    index: forloop.index
                  -%}
                {%- endif -%}
              </div>
            {%- else -%}
              {%- for ngp_i in (1..products_to_display) -%}
                <div class="{{ ngp_item_css_class }}">
                  {% render 'ngp-card-product-placeholder', image_ratio: section.settings.pcard_image_ratio %}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </ngp-featured-collection>
        {%- if ngp_enable_slider and ngp_header_layout != 'standing-column' -%}
          <div class="ngp-swiper-controls ngp-swiper-controls--{{ section.settings.controls_position }} hidden ngp-md:ngp-block">
            <button
              class="swiper-button-prev ngp-btn"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              {% render 'ngp-icon-slider-prev' %}
            </button>
            <button
              class="swiper-button-next ngp-btn"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              {% render 'ngp-icon-slider-next' %}
            </button>
          </div>
        {%- endif -%}
      </ngp-grid-list>
    </div>
  </div>
  {%- if ngp_button_label != blank and ngp_show_all_button_on_top != true -%}
    <div class="ngp-section__footer ngp-flex ngp-items-center ngp-justify-center">
      <a
        class="ngp-btn {{ ngp_button_style }}"
        {% if ngp_button_link != blank %}
          href="{{ ngp_button_link }}"
        {% else %}
          aria-disabled="true"
        {% endif %}
      >
        {{- ngp_button_label -}}
      </a>
    </div>
  {%- endif -%}
</div>
<script src="{{ 'ngp-featured-collection.js' | asset_url }}" defer="defer"></script>
