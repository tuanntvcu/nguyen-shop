{{ 'ngp-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ngp-facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'ngp-show-more.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign ngp_current_filter_size = 0
  assign ngp_columns_desktop = section.settings.columns_desktop
  assign ngp_columns_tablet = 3
  assign ngp_columns_mobile = section.settings.columns_mobile | times: 1

  for ngp_filter in collection.filters
    assign ngp_current_filter_size = ngp_current_filter_size | plus: ngp_filter.active_values.size
  endfor

  assign ngp_enable_sorting = section.settings.enable_sorting
  assign ngp_enable_filtering = section.settings.enable_filtering
  assign ngp_filter_type = section.settings.filter_type
  assign ngp_show_toolbar = false
  if ngp_enable_filtering or ngp_enable_sorting
    assign ngp_show_toolbar = true
  endif

  assign ngp_default_grid_mobile = 'ngp-f-grid-' | append: ngp_columns_mobile | append: '-cols'

  assign ngp_is_metro = false
  if section.settings.grid_layout == 'metro'
    assign ngp_is_metro = true
  endif
-%}
{%- if ngp_is_metro -%}
  {%- render 'ngp-product-grid-metro-style',
    section_id: section.id,
    desktop_breakpoint: 1280,
    ngp_columns_desktop: ngp_columns_desktop,
    ngp_columns_tablet: ngp_columns_tablet,
    ngp_columns_mobile: ngp_columns_mobile
  -%}
{%- endif -%}
{%- capture ngp_image_sizes -%}
(max-width: 767px) calc((100vw - 38px) / {{ ngp_columns_mobile }}),
(max-width: 1279px) calc((100vw - 90px) / {{ ngp_columns_tablet }}),
{%- if ngp_enable_filtering -%}
  calc({{ settings.page_width}}px / {{ ngp_columns_desktop | plus: 1 }})
{%- else -%}
{{ settings.page_width | divided_by: ngp_columns_desktop }}px
{%- endif -%}
{%- endcapture -%}

{% render 'ngp-divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="ngp-section--padding ngp-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ngp-collection ngp-page-width">
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="ngp-collection__content ngp-flex">
        {%- if collection.all_products_count > 0 -%}
          <div
            class="hidden{% if ngp_enable_filtering and ngp_filter_type == 'vertical' %} ngp-xl:ngp-block{% endif %}"
            id="FacetFiltersContainer"
          >
            <div class="ngp-sticky-element ngp-z-10">
              {%- render 'ngp-facets', context: 'vertical', results: collection -%}
            </div>
          </div>
        {%- endif -%}
        <div class="ngp-flex ngp-flex-col ngp-flex-grow{% if ngp_show_toolbar %} ngp-show-toolbar{% endif %}" id="ProductGridWrapper">
          <div class="ngp-sticky-element ngp-grid ngp-gap-5 ngp-z-10" style="--sticky-offset: 0px;">
            {%- if ngp_enable_filtering or ngp_enable_sorting -%}
              <div class="ngp-collection__toolbar ngp-flex ngp-items-center ngp-justify-between">
                {%- if ngp_filter_type == 'drawer' and collection.all_products_count > 0 and ngp_enable_filtering -%}
                  {%- render 'ngp-facets-drawer', results: collection, ngp_enable_sorting: ngp_enable_sorting -%}
                {%- endif -%}

                {%- if ngp_filter_type == 'vertical' and collection.all_products_count > 0 and ngp_enable_filtering -%}
                  <div class="ngp-flex ngp-xl:hidden">
                    {%- render 'ngp-facets-drawer', results: collection, ngp_enable_sorting: ngp_enable_sorting -%}
                  </div>
                {%- endif -%}

                <div class="ngp-gap-10 hidden ngp-md:ngp-flex ngp-items-center ngp-justify-between{% if ngp_filter_type == 'vertical' or ngp_enable_filtering == false %} ngp-xl:ngp-flex-grow{% endif %}">
                  {%- if collection.all_products_count > 0 -%}
                    <div data-facet-loading>
                      {%- render 'ngp-loading-spinner' -%}
                      <p id="ProductCount" class="ngp-m-0" role="status">
                        {%- liquid
                          if collection.results_count
                            echo 'products.facets.filters_selected' | t: terms: collection.terms, count: collection.results_count
                          elsif collection.products_count == collection.all_products_count
                            echo 'products.facets.product_count_simple' | t: count: collection.products_count
                          else
                            echo 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                          endif
                        -%}
                      </p>
                    </div>
                  {%- endif -%}
                  {%- if ngp_enable_sorting and collection.all_products_count > 0 -%}
                    <div class="ngp-flex ngp-items-center ngp-gap-3" id="SortByContainer">
                      {%- render 'ngp-facet-short',
                        results: collection,
                        icon_size: 'extra-small',
                        label_class: 'font-body-bolder'
                      -%}
                    </div>
                  {%- endif -%}
                </div>

                <ngp-layout-switcher class="ngp-flex ngp-md:hidden ngp-gap-2" style="--buttons-width: 4rem;">
                  {%- for ngp_per_row in (1..2) -%}
                    {%- assign ngp_layout = 'f-grid-' | append: ngp_per_row | append: '-cols' -%}
                    <button
                      class="ngp-btn ngp-btn--icon{% if ngp_layout == ngp_default_grid_mobile %} ngp-btn--active{% endif %}"
                      data-layout-mode="grid-{{ ngp_per_row }}"
                      aria-label="{{ 'accessibility.layout_switcher' | t: col: ngp_per_row }}"
                    >
                      {%- render 'ngp-icon-grid-column', ngp_layout: ngp_per_row, classes: 'pointer-events-none' -%}
                    </button>
                  {%- endfor -%}
                </ngp-layout-switcher>
              </div>
            {%- endif -%}
          </div>
          {%- liquid
            if ngp_enable_filtering
              render 'ngp-facets-active', results: collection
            endif
          -%}
          <div id="ProductGridContainer">
            {%- if collection.products.size == 0 -%}
              <div class="ngp-empty-state ngp-flex ngp-flex-col ngp-items-center ngp-justify-center ngp-gap-6 ngp-text-center">
                {%- if collection.all_products_count > 0 -%}
                  <div class="ngp-gap-3 ngp-flex ngp-flex-col ngp-items-center ngp-justify-center ngp-text-center">
                    {%- render 'ngp-icon-empty-state' -%}
                    <p class="ngp-h4">{{ 'collections.general.no_results' | t }}</p>
                    <p class="ngp-m-0">{{ 'collections.general.use_fewer_filters' | t }}</p>
                  </div>
                  <a class="ngp-btn ngp-btn--primary" href="{{ collection.url }}" is="ngp-facet-remove">
                    {{- 'products.facets.clear_all' | t -}}
                  </a>
                {%- else -%}
                  <div class="ngp-gap-3 ngp-flex ngp-flex-col ngp-items-center ngp-justify-center ngp-text-center">
                    {%- render 'ngp-icon-empty-state' -%}
                    <p class="ngp-h4">{{ 'collections.general.empty' | t }}</p>
                  </div>
                  <a class="ngp-btn ngp-btn--primary" href="{{ routes.all_products_collection_url }}">
                    {{ 'collections.general.continue_shopping' | t }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
            <ngp-grid-list
              id="ProductsList"
              class="ngp-grid-list ngp-products-list ngp-f-grid ngp-md:ngp-f-grid-{{ ngp_columns_tablet }}-cols ngp-xl:ngp-f-grid-{{ ngp_columns_desktop }}-cols {{ ngp_default_grid_mobile }} ngp-f-grid--gap-medium"
            >
              {%- for ngp_product in collection.products -%}
                <div class="ngp-f-column ngp-card">
                  {%- if ngp_is_metro -%}
                    {%- render 'ngp-card-product-metro',
                      product: ngp_product,
                      ngp_image_sizes: ngp_image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index,
                      index0: forloop.index0,
                      desktop_breakpoint: 1280,
                      ngp_columns_desktop: ngp_columns_desktop,
                      ngp_columns_tablet: ngp_columns_tablet,
                      ngp_columns_mobile: ngp_columns_mobile
                    -%}
                  {%- else -%}
                    {%- render 'ngp-card-product',
                      product: ngp_product,
                      ngp_image_sizes: ngp_image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index
                    -%}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </ngp-grid-list>
            {%- liquid
              if paginate.pages > 1
                render 'ngp-pagination', paginate: paginate, type: section.settings.pagination
              endif
            -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.ngp-main-collection-product-grid.name",
  "class": "collection-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://scalora.link/LgqT3v8)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 1,
      "default": 15,
      "label": "t:sections.ngp-main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.ngp-main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "grid_layout",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.product-tabs.settings.grid_layout.options__1.label"
        },
        {
          "value": "metro",
          "label": "t:sections.product-tabs.settings.grid_layout.options__2.label"
        }
      ],
      "default": "standard",
      "info": "t:sections.product-tabs.settings.grid_layout.info",
      "label": "t:sections.product-tabs.settings.grid_layout.label"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.ngp-main-collection-product-grid.settings.pagination.label",
      "options": [
        {
          "value": "infinite",
          "label": "t:sections.ngp-main-collection-product-grid.settings.pagination.options__1.label"
        },
        {
          "value": "load_more",
          "label": "t:sections.ngp-main-collection-product-grid.settings.pagination.options__2.label"
        },
        {
          "value": "number",
          "label": "t:sections.ngp-main-collection-product-grid.settings.pagination.options__3.label"
        }
      ],
      "default": "number"
    },
    {
      "type": "header",
      "content": "t:sections.ngp-main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatch",
      "label": "t:settings_schema.color_swatches.settings.enable_color_swatch.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.ngp-main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.ngp-main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "vertical",
          "label": "t:sections.ngp-main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.ngp-main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "vertical",
      "label": "t:sections.ngp-main-collection-product-grid.settings.filter_type.label",
      "info": "t:sections.ngp-main-collection-product-grid.settings.filter_type.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.ngp-main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "text",
      "id": "expand_filter_groups",
      "label": "t:sections.ngp-main-collection-product-grid.settings.expand_filter_groups.label",
      "placeholder": "Color, Price, Size",
      "info": "t:sections.ngp-main-collection-product-grid.settings.expand_filter_groups.info"
    },
    {
      "type": "header",
      "content": "t:sections.ngp-main-collection-product-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.ngp-main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.ngp-main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.ngp-main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:sections.all.divider.settings.divider_width.label"
    }
  ]
}
{% endschema %}
