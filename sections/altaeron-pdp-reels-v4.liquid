  data-save-label="{{ 'altaeron_pdp_reels_v2.common.save' | t | escape }}"
  data-save-template="{{ 'altaeron_pdp_reels_v2.common.save_template' | t | escape }}"
  data-add-to-cart-label="{{ cta_label | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
>
  <section class="apdp-hero" aria-labelledby="AltaeronV4Title-{{ section.id }}">
    <div class="apdp-shell apdp-hero__grid">
      <div class="apdp-gallery" data-apdp-gallery>
        <div class="apdp-gallery__thumbs" role="tablist" aria-label="Product media">
          {%- if show_hero_video -%}
            <button type="button" class="apdp-gallery__thumb is-active" role="tab" aria-selected="true" aria-controls="AltaeronV4Media-{{ section.id }}-hero" data-apdp-thumb="hero">
              {{ hero_video.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '62px', alt: 'Altaeron support demonstration' }}
              <span class="apdp-gallery__play" aria-hidden="true">▶</span>
            </button>
          {%- endif -%}
          {%- for media in product.media -%}
            <button type="button" class="apdp-gallery__thumb{% if show_hero_video == false and forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if show_hero_video == false and forloop.first %}true{% else %}false{% endif %}" aria-controls="AltaeronV4Media-{{ section.id }}-{{ media.id }}" data-apdp-thumb="{{ media.id }}" data-apdp-preview-src="{{ media.preview_image | image_url: width: 1600 }}" data-apdp-preview-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '62px', alt: media.alt | default: product.title }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="apdp-gallery__play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="apdp-gallery__viewer" aria-live="polite">
          {%- if show_hero_video -%}
            <div id="AltaeronV4Media-{{ section.id }}-hero" class="apdp-gallery__item is-active" role="tabpanel" data-apdp-media="hero" aria-hidden="false">
              {{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1200x' }}
            </div>
          {%- endif -%}
          {%- for media in product.media -%}
            <div id="AltaeronV4Media-{{ section.id }}-{{ media.id }}" class="apdp-gallery__item{% if show_hero_video == false and forloop.first %} is-active{% endif %}" role="tabpanel" data-apdp-media="{{ media.id }}" aria-hidden="{% if show_hero_video == false and forloop.first %}false{% else %}true{% endif %}"{% if media.media_type == 'image' %} data-apdp-zoom-src="{{ media.preview_image | image_url: width: 2400 }}"{% endif %}{% unless show_hero_video == false and forloop.first %} hidden{% endunless %}>
              {% render 'altaeron-pdp-media', media: media, product: product, loading: 'lazy', fetchpriority: 'auto', sizes: '(min-width: 1100px) 390px, (min-width: 768px) 48vw, calc(100vw - 30px)', autoplay: true, loop: true, muted: true %}
              {%- if media.media_type == 'image' -%}<button type="button" class="apdp-gallery__zoom" data-apdp-zoom aria-haspopup="dialog" aria-label="Open product image"><span aria-hidden="true">{% render 'icon-zoom' %}</span></button>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="apdp-narrative">
        {%- if review_count > 0 and review_rating > 0 -%}
          <a class="apdp-rating" href="#AltaeronV4Reviews" aria-label="{{ review_rating_display }} out of 5 from {{ review_count }} reviews">{% render 'altaeron-pdp-stars', rating: review_rating %}<strong>{{ review_rating_display }} · {{ review_count }} Reviews</strong></a>
        {%- endif -%}
        <h1 id="AltaeronV4Title-{{ section.id }}" class="v4-product-name">{{ section.settings.product_name }}</h1>
        <h2 class="v4-hero-headline">{{ section.settings.headline }}</h2>
        <p class="v4-hero-subhead">{{ section.settings.subheadline }}</p>
        <ul class="v4-hero-points" role="list">
          <li><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span>Adjustable to your comfort level</li>
          <li><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span>Soft fabric + silicone padding</li>
          <li><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span>Fits either foot</li>
        </ul>
      </div>

      <aside class="apdp-buy" aria-label="Purchase {{ product.title | escape }}" data-apdp-primary-purchase>
        <div class="apdp-buy__price-line"><div><p class="apdp-buy__from">{{ section.settings.price_label }}</p><div class="apdp-price" aria-live="polite"><span class="apdp-price__current" data-apdp-current-price>{{ current_variant.price | money }}</span><s class="apdp-price__compare" data-apdp-compare-price{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></div></div><span class="apdp-price__save" data-apdp-savings{% if savings <= 0 %} hidden{% endif %}>Save {{ savings_money }}</span></div>
        {%- form 'product', product, id: product_form_id, class: 'apdp-form main-product-form', is: 'product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-apdp-variant-id>
          <div class="product-form__error-message-wrapper" role="alert" hidden><div class="product-form__error-message alert alert--error" role="alert" hidden></div></div>
          {%- unless product.has_only_default_variant -%}
            <fieldset class="apdp-variants"><legend>Choose an option</legend><select data-apdp-variant-select>{%- for variant in product.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}</select></fieldset>
          {%- endunless -%}
          <bundle-deals-widget id="AltaeronV4Bundles-{{ section.id }}" tabindex="-1" product-id="{{ product.id }}"></bundle-deals-widget>
          <p class="apdp-new-customer-offer">1 corrector · Use on either foot</p>
          <button type="submit" name="add" class="apdp-button apdp-button--primary product-form__submit" data-apdp-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-submit-text><span data-apdp-submit-label data-available-text="{{ cta_label }}">{% if current_variant.available %}{{ cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span><span data-apdp-cta-price{% unless current_variant.available %} hidden{% endunless %}>{% if current_variant.available %} — {{ current_variant.price | money }}{% endif %}</span></span><span class="loading__spinner hidden">{% render 'loading-spinner' %}</span></button>
          <p class="v4-risk">Free &amp; Tracked Shipping · 30-Day Easy Returns</p>
          <div class="apdp-payment-terms" data-apdp-installments>or 4 interest-free payments of {{ installment_amount }} with <strong>shop<span>Pay</span></strong></div>
          {%- if shop.enabled_payment_types.size > 0 -%}<details class="apdp-payment-options"><summary>More payment options</summary><ul class="apdp-payment-icons list list-payment" role="list" aria-label="Payment methods">{%- for type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul></details>{%- endif -%}
        {%- endform -%}
        <figure class="v4-micro-review">
          <div class="v4-micro-review__avatar">
            {%- if section.settings.review_avatar != blank -%}
              {{ section.settings.review_avatar | image_url: width: 120 | image_tag: loading: 'eager', widths: '84, 120', sizes: '42px', alt: section.settings.reviewer_name }}
            {%- elsif section.settings.review_avatar_url != blank -%}
              <img src="{{ section.settings.review_avatar_url | escape }}" width="84" height="84" loading="eager" alt="{{ section.settings.reviewer_name | escape }}">
            {%- else -%}
              <span class="v4-micro-review__initial" aria-hidden="true">{{ section.settings.reviewer_name | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <div>{% render 'altaeron-pdp-stars', rating: 5 %}<blockquote>{{ 'altaeron_pdp_reels_v4.hero_review_quote' | t }}</blockquote><figcaption><strong>{{ section.settings.reviewer_name }}</strong>{% if section.settings.review_verified %} &middot; {{ 'altaeron_pdp.reviews.verified_buyer' | t }}{% endif %}</figcaption></div>
        </figure>
      </aside>
    </div>
  </section>

  <section class="v4-section" aria-labelledby="AltaeronV4Mechanism-{{ section.id }}"><div class="v4-shell v4-mechanism">
    <div class="v4-video v4-video--portrait">{%- if mechanism_video != blank -%}{%- capture mechanism_video_markup -%}{{ mechanism_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1200x' }}{%- endcapture -%}{{ mechanism_video_markup | replace: '<video ', '<video data-v4-mechanism-video ' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}</div>
    <div><p class="v4-eyebrow">How it works</p><h2 id="AltaeronV4Mechanism-{{ section.id }}" class="v4-heading">SEE WHAT IT DOES</h2><p class="v4-intro">Turn the dial to gradually apply outward support to the big toe. Stop where the tension feels comfortable for your foot.</p></div>
  </div></section>

  {% render 'altaeron-customer-proof',
    heading_id: proof_heading_id,
    eyebrow: section.settings.proof_eyebrow,
    title: section.settings.proof_title,
    avatar_1: section.settings.proof_avatar_1,
    avatar_url_1: section.settings.proof_avatar_url_1,
    reviewer_name_1: section.settings.proof_reviewer_name_1,
    review_content_1: section.settings.proof_review_content_1,
    avatar_2: section.settings.proof_avatar_2,
    avatar_url_2: section.settings.proof_avatar_url_2,
    reviewer_name_2: section.settings.proof_reviewer_name_2,
    review_content_2: section.settings.proof_review_content_2,
    review_count: review_count,
    review_rating: review_rating,
    review_rating_display: review_rating_display,
    reviews_link: '#AltaeronV4Reviews'
  %}

  <section class="v4-section" aria-labelledby="AltaeronV4Try-{{ section.id }}"><div class="v4-shell"><div class="v4-try">
    <div class="v4-try__media">{%- if section.settings.try_image != blank -%}{{ section.settings.try_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '220, 360, 520, 700', sizes: '(min-width: 1100px) 190px, (min-width: 768px) 170px, 110px', alt: section.settings.try_image.alt | default: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div>
    <div><p class="v4-eyebrow">Less risk, more control</p><h2 id="AltaeronV4Try-{{ section.id }}" class="v4-heading">EASY TO TRY AT HOME</h2><p class="v4-try__price" data-apdp-final-price>{{ current_variant.price | money }}</p><ul class="v4-try__points" role="list"><li><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span>Free &amp; Tracked Shipping</li><li><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span>30-Day Easy Returns</li></ul></div>
    <div class="v4-try__buy"><button type="button" class="apdp-button apdp-button--primary" data-apdp-final-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>{{ cta_label }}<span data-apdp-final-button-price{% unless current_variant.available %} hidden{% endunless %}> — {{ current_variant.price | money }}</span></button></div>
  </div></div></section>

  <section class="v4-section" aria-labelledby="AltaeronV4Details-{{ section.id }}"><div class="v4-shell">
    <header class="v4-header"><p class="v4-eyebrow">Product &amp; comfort details</p><h2 id="AltaeronV4Details-{{ section.id }}" class="v4-heading">Made for stable, cushioned support.</h2><p class="v4-intro">The parts that touch your foot are designed to feel supportive without adding unnecessary bulk.</p></header>
    <div class="v4-details">
      <article class="v4-detail"><div class="v4-detail__media">{%- if section.settings.detail_image_1 != blank -%}{{ section.settings.detail_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '320, 520, 760, 1100', sizes: '(min-width: 768px) 46vw, 42vw', alt: 'Altaeron structured support' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div><div class="v4-detail__copy"><h3>Structured support</h3><p>Helps keep support stable around the big toe while worn.</p></div></article>
      <article class="v4-detail"><div class="v4-detail__media">{%- if section.settings.detail_image_2 != blank -%}{{ section.settings.detail_image_2 | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '320, 520, 760, 1100', sizes: '(min-width: 768px) 46vw, 42vw', alt: 'Altaeron soft contact points' }}{%- else -%}{{ 'product-2' | placeholder_svg_tag }}{%- endif -%}</div><div class="v4-detail__copy"><h3>Soft contact points</h3><p>Soft fabric and silicone padding cushion the areas where the product contacts your foot.</p></div></article>
    </div>
  </div></section>

  <section class="v4-section" aria-labelledby="AltaeronV4Use-{{ section.id }}"><div class="v4-shell">
    <header class="v4-header"><p class="v4-eyebrow">How to use</p><h2 id="AltaeronV4Use-{{ section.id }}" class="v4-heading">Start gently. Build your routine.</h2></header>
    <div class="v4-use"><div class="v4-video">{%- if how_to_video != blank -%}{{ how_to_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1000x' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}</div><ol class="v4-steps"><li><strong>Fit the device correctly</strong><span>Secure it comfortably around the foot and big toe.</span></li><li><strong>Start with light support</strong><span>More force is not better.</span></li><li><strong>Adjust gradually</strong><span>Stop where the support feels firm but comfortable.</span></li><li><strong>Begin with 20–30 minutes</strong><span>Use it while sitting or relaxing, then build gradually as comfort allows.</span></li></ol></div>
  </div></section>

  <section class="v4-section v4-fit" aria-labelledby="AltaeronV4Fit-{{ section.id }}"><div class="v4-shell">
    <header class="v4-header"><p class="v4-eyebrow">Who it's for</p><h2 id="AltaeronV4Fit-{{ section.id }}" class="v4-heading">A practical option for at-home support.</h2></header>
    <div class="v4-fit-grid"><article class="v4-fit-card"><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span><h3>Mild–moderate bunions</h3><p>For a big toe that has started drifting toward the neighboring toes.</p></article><article class="v4-fit-card"><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span><h3>Pressure or crowding</h3><p>For discomfort around the big toe during everyday routines.</p></article><article class="v4-fit-card"><span class="v4-check" aria-hidden="true">{% render 'altaeron-pdp-icon', icon: 'check' %}</span><h3>Conservative support</h3><p>For people looking for adjustable, non-surgical support they can use at home.</p></article></div>
  </div></section>

  <section class="v4-section" aria-labelledby="AltaeronV4Research-{{ section.id }}"><div class="v4-shell">
    <header class="v4-header"><p class="v4-eyebrow">Research &amp; anatomy</p><h2 id="AltaeronV4Research-{{ section.id }}" class="v4-heading">Conservative support, explained.</h2><p class="v4-intro">Toe-alignment devices are intended to support positioning and comfort while worn. They are not a promise of permanent correction.</p></header>
    <div class="v4-research-grid"><div class="v4-anatomy">{%- if section.settings.anatomy_image != blank -%}{{ section.settings.anatomy_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '420, 700, 960, 1400', sizes: '(min-width: 768px) 44vw, calc(100vw - 30px)', alt: 'Big-toe alignment anatomy' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div><div><div class="v4-research-points"><article class="v4-research-card"><h3>Alignment and discomfort</h3><p>Clinical research on conservative supports suggests that orthoses and toe-alignment devices may help support alignment and reduce bunion-related discomfort.</p><a href="https://bmjopen.bmj.com/content/11/8/e047273" target="_blank" rel="noopener noreferrer">View study ↗</a></article><article class="v4-research-card"><h3>Support alongside exercise</h3><p>Conservative devices may be used alongside foot exercises as part of a broader at-home care approach.</p><a href="https://pubmed.ncbi.nlm.nih.gov/40973592/" target="_blank" rel="noopener noreferrer">View study ↗</a></article></div><p class="v4-disclaimer">Research findings vary by device, study design and individual. Stop use if pain, numbness or significant irritation occurs, and seek professional advice when needed.</p></div></div>
  </div></section>

  <section class="v4-section" aria-labelledby="AltaeronV4Faq-{{ section.id }}"><div class="v4-shell v4-faq-grid"><header><p class="v4-eyebrow">FAQ</p><h2 id="AltaeronV4Faq-{{ section.id }}" class="v4-heading">Still deciding?</h2><p class="v4-intro">The practical details to know before your first wear.</p></header><div class="apdp-tail-accordion">
    <details><summary>Can I use it on either foot?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>Yes. The adjustable design can be used on either the left or right foot. Each corrector is worn on one foot at a time.</p></details>
    <details><summary>Will it fit my foot?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>Altaeron uses adjustable straps designed to accommodate a wide range of adult foot sizes.</p></details>
    <details><summary>How long should I use it?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>Begin with approximately 20–30 minute sessions while sitting or relaxing, then increase gradually as comfort allows.</p></details>
    <details><summary>Can I walk while wearing it?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>Altaeron is designed primarily for seated, resting and low-activity use. Light walking around the home may be comfortable once the fit is secure.</p></details>
    <details><summary>What materials and components does it use?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>The product uses an ABS support structure, soft fabric and silicone contact areas, a dial-controlled steel-wire tension system and a rotating hinge design.</p></details>
    <details><summary>How much tension should I use?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>Start gently and increase only until the support feels firm but comfortable. Never force the toe into position.</p></details>
    <details><summary>What should I expect?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>It can take a few wears to get familiar with the fit and support. Reduce tension or stop if you feel pain, numbness or significant irritation.</p></details>
    <details><summary>How is it different from a basic toe spacer?{% render 'icon-accordion-chevron', class: 'apdp-tail-accordion__chevron' %}</summary><p>A basic spacer creates fixed spacing between toes. Altaeron combines spacing with structured, adjustable positioning support while worn.</p></details>
  </div></div></section>

  <section id="AltaeronV4Reviews" class="v4-section v4-full-reviews" aria-labelledby="AltaeronV4ReviewsHeading-{{ section.id }}" data-apdp-review-slider-group><div class="v4-shell apdp-review-summary"><header class="v4-header"><p class="v4-eyebrow">Customer reviews</p><h2 id="AltaeronV4ReviewsHeading-{{ section.id }}" class="v4-heading">Full Customer Reviews</h2>{%- if review_count > 0 -%}<p class="v4-intro">{{ review_rating_display }}/5 from {{ review_count }} Judge.me reviews</p>{%- endif -%}</header><div class="apdp-judgeme-widget"><div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false" data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">{%- if has_legacy_judgeme_widget -%}<div class="jdgm-legacy-widget-content" style="display:none">{{ product.metafields.judgeme.widget }}</div>{%- endif -%}</div>{%- if product.metafields.judgeme.review_widget_data -%}<script>window.jdgm=window.jdgm||{};window.jdgm.data=window.jdgm.data||{};window.jdgm.data.reviewWidget=window.jdgm.data.reviewWidget||{};window.jdgm.data.reviewWidget[{{ product.id | json }}]={{ product.metafields.judgeme.review_widget_data }};</script>{%- endif -%}<noscript><div class="apdp-tail-review-viewport"><div class="apdp-tail-review-grid">{% render 'altaeron-pdp-review-cards', reviews: reviews, limit: 10 %}</div></div></noscript></div></div></section>

  <div class="apdp-sticky" data-apdp-sticky hidden><div class="apdp-sticky__product">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '46px', alt: product.featured_image.alt | default: product.title }}{%- endif -%}<span><small>{{ section.settings.price_label }} <b data-apdp-sticky-price>{{ current_variant.price | money }}</b> <s data-apdp-sticky-compare{% if savings <= 0 %} hidden{% endif %}>{{ compare_price | money }}</s></small><em data-apdp-sticky-savings{% if savings <= 0 %} hidden{% endif %}>Save {{ savings_money }}</em><small class="apdp-sticky__bundle-title" data-apdp-sticky-bundle-title hidden></small></span></div><button type="button" class="apdp-button apdp-button--primary" data-apdp-sticky-submit{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}><span data-apdp-sticky-text>{% if current_variant.available %}{{ cta_label }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span></button></div>
  <script type="application/json" data-apdp-product-json>{{ product.variants | json }}</script>
  <script>
    (() => {
      const root = document.getElementById('AltaeronV4-{{ section.id }}');
      const video = root?.querySelector('[data-v4-mechanism-video]');
      if (!video || video.dataset.v4SegmentReady === 'true') return;
      video.dataset.v4SegmentReady = 'true';
      video.addEventListener('timeupdate', () => {
        const segmentEnd = Math.min(6, Number.isFinite(video.duration) ? video.duration : 6);
        if (video.currentTime >= segmentEnd) {
          video.currentTime = 0;
          if (!document.hidden && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(() => {});
        }
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Altaeron Reels V4 PDP",
  "tag": "section",
  "class": "section-altaeron-pdp section-altaeron-pdp-reels-v4",
  "settings": [
    { "type": "checkbox", "id": "show_hero_video", "label": "Show metafield video first in gallery", "default": false },
    { "type": "text", "id": "product_name", "label": "Product name", "default": "Altaeron™ Adjustable Bunion Corrector" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Take Pressure Off Your Bunion. Guide Your Big Toe Back Toward Alignment." },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Structured support applies controlled outward tension while worn." },
    { "type": "header", "content": "Above-the-fold review" },
    { "type": "image_picker", "id": "review_avatar", "label": "Reviewer image" },
    { "type": "text", "id": "review_avatar_url", "label": "Reviewer image URL fallback" },
    { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Megan Carter" },
    { "type": "checkbox", "id": "review_verified", "label": "Show Verified Buyer (only if confirmed)", "default": false },
    { "type": "video", "id": "mechanism_video", "label": "See What It Does video" },
