{%- liquid
  assign research_eyebrow = section.settings.eyebrow
  assign research_heading = section.settings.heading
  assign research_intro = section.settings.intro
  unless request.locale.iso_code == 'en'
    assign research_eyebrow = 'research_evidence.eyebrow' | t
    assign research_heading = 'research_evidence.heading' | t
    assign research_intro = 'research_evidence.intro' | t
  endunless
-%}

{%- if section.settings.show_section -%}
  <style>
    #AltaeronResearch-{{ section.id }} {
      --research-ink: var(--altaeron-navy, #102a43);
      --research-body: var(--altaeron-body, #344054);
      --research-accent: var(--altaeron-primary, #006b5e);
      --research-soft: var(--altaeron-soft-teal, #eaf5f2);
      --research-line: var(--altaeron-border, #e4e7ec);
      background: #fff;
      color: var(--research-body);
      padding: 48px 0 64px;
    }
    #AltaeronResearch-{{ section.id }} * { box-sizing: border-box; }
    #AltaeronResearch-{{ section.id }} .research__shell { margin-inline: auto; width: min(1240px, calc(100% - 80px)); }
    #AltaeronResearch-{{ section.id }} .research__header { margin: 0 auto 30px; max-width: 820px; text-align: center; }
    #AltaeronResearch-{{ section.id }} .research__eyebrow { align-items: center; color: var(--research-accent); display: flex; font-size: 12px; font-weight: 750; gap: 16px; justify-content: center; letter-spacing: .24em; line-height: 1.3; margin: 0 0 12px; text-transform: uppercase; }
    #AltaeronResearch-{{ section.id }} .research__eyebrow::before,
    #AltaeronResearch-{{ section.id }} .research__eyebrow::after { background: currentColor; content: ''; flex: 0 1 44px; height: 1px; opacity: .42; }
    #AltaeronResearch-{{ section.id }} .research__heading { color: var(--research-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: clamp(30px, 3.3vw, 46px); font-weight: 750; letter-spacing: -.035em; line-height: 1.08; margin: 0; }
    #AltaeronResearch-{{ section.id }} .research__intro { color: var(--research-body); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.5; margin: 12px auto 0; max-width: 760px; }
    #AltaeronResearch-{{ section.id }} .research__primary,
    #AltaeronResearch-{{ section.id }} .research__secondary { display: grid; gap: 20px; }
    #AltaeronResearch-{{ section.id }} .research__primary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #AltaeronResearch-{{ section.id }} .research__secondary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #AltaeronResearch-{{ section.id }} .research-card { background: #fff; border: 1px solid var(--research-line); border-radius: 18px; box-shadow: 0 12px 32px rgba(16,42,67,.06); min-width: 0; }
    #AltaeronResearch-{{ section.id }} .research-card--primary { display: flex; flex-direction: column; min-height: 390px; padding: 24px; }
    #AltaeronResearch-{{ section.id }} .research-card__head { align-items: center; display: grid; gap: 16px; grid-template-columns: 96px minmax(0, 1fr); }
    #AltaeronResearch-{{ section.id }} .research-card__icon { align-items: center; background: var(--research-soft); border-radius: 50%; color: var(--research-accent); display: flex; height: 96px; justify-content: center; width: 96px; }
    #AltaeronResearch-{{ section.id }} .research-card__icon :is(img, svg) { display: block; height: 72px; object-fit: contain; width: 72px; }
    #AltaeronResearch-{{ section.id }} .research-card__icon svg { stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
    #AltaeronResearch-{{ section.id }} .research-card h3 { color: var(--research-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: 21px; font-weight: 750; letter-spacing: -.025em; line-height: 1.2; margin: 0; }
    #AltaeronResearch-{{ section.id }} .research-card__meta { background: var(--research-soft); border-radius: 999px; color: var(--research-accent); display: inline-block; font-size: 13px; font-weight: 650; line-height: 1.25; margin: 9px 0 0; padding: 6px 12px; }
    #AltaeronResearch-{{ section.id }} .research-card__body { font-size: 16px; line-height: 1.5; margin: 18px 0 0; }
    #AltaeronResearch-{{ section.id }} .research-card__footer { align-items: center; border-top: 1px solid var(--research-line); display: flex; gap: 14px; justify-content: space-between; margin-top: auto; padding-top: 16px; }
    #AltaeronResearch-{{ section.id }} .research-card__citation { align-items: flex-start; display: flex; font-size: 13px; gap: 8px; line-height: 1.4; margin: 0; min-width: 0; }
    #AltaeronResearch-{{ section.id }} .research-card__citation svg { flex: 0 0 20px; height: 20px; margin-top: -1px; stroke: currentColor; width: 20px; }
    #AltaeronResearch-{{ section.id }} .research-link { align-items: center; color: var(--research-accent); display: inline-flex; flex: 0 0 auto; font-size: 14px; font-weight: 700; gap: 7px; line-height: 1.25; min-height: 40px; text-decoration: none; }
    #AltaeronResearch-{{ section.id }} .research-link__label { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
    #AltaeronResearch-{{ section.id }} .research-link__arrow { text-decoration: none; transition: transform .2s ease; }
    #AltaeronResearch-{{ section.id }} .research-link:hover .research-link__arrow { transform: translateX(3px); }
    #AltaeronResearch-{{ section.id }} :is(a, summary):focus-visible { outline: 3px solid rgba(0,107,94,.3); outline-offset: 3px; }
    #AltaeronResearch-{{ section.id }} .research__divider { align-items: center; color: #667085; display: flex; font-size: 12px; font-weight: 750; gap: 22px; justify-content: center; letter-spacing: .24em; line-height: 1.3; margin: 32px 0 20px; text-transform: uppercase; }
    #AltaeronResearch-{{ section.id }} .research__divider::before,
    #AltaeronResearch-{{ section.id }} .research__divider::after { background: var(--research-line); content: ''; flex: 1; height: 1px; }
    #AltaeronResearch-{{ section.id }} .research-card--secondary { align-items: center; display: grid; gap: 18px; grid-template-columns: 84px minmax(0, 1fr) auto; padding: 20px 22px; }
    #AltaeronResearch-{{ section.id }} .research-card--secondary .research-card__icon { height: 84px; width: 84px; }
    #AltaeronResearch-{{ section.id }} .research-card--secondary .research-card__icon :is(img, svg) { height: 62px; width: 62px; }
    #AltaeronResearch-{{ section.id }} .research-card--secondary h3 { font-size: 19px; }
    #AltaeronResearch-{{ section.id }} .research-card--secondary .research-card__body { font-size: 14px; line-height: 1.45; margin-top: 5px; }
    #AltaeronResearch-{{ section.id }} .research-card--secondary .research-card__citation { color: #667085; display: block; margin-top: 6px; }
    #AltaeronResearch-{{ section.id }} .research__disclaimer { color: #667085; font-size: 13px; line-height: 1.5; margin: 26px auto 0; max-width: 760px; text-align: center; }
    #AltaeronResearch-{{ section.id }} .research-sources { margin: 16px auto 0; max-width: 920px; }
    #AltaeronResearch-{{ section.id }} .research-sources summary { align-items: center; background: var(--research-accent); border-radius: 999px; color: #fff; cursor: pointer; display: flex; font-size: 15px; font-weight: 750; gap: 10px; justify-content: center; margin: 0 auto; min-height: 50px; padding: 12px 26px; transition: background .2s ease, box-shadow .2s ease; width: fit-content; }
    #AltaeronResearch-{{ section.id }} .research-sources summary::-webkit-details-marker { display: none; }
    #AltaeronResearch-{{ section.id }} .research-sources summary::marker { content: ''; }
    #AltaeronResearch-{{ section.id }} .research-sources summary:hover { background: #005b50; box-shadow: 0 8px 20px rgba(0,107,94,.16); }
    #AltaeronResearch-{{ section.id }} .research-sources summary span { transition: transform .2s ease; }
    #AltaeronResearch-{{ section.id }} .research-sources[open] summary span { transform: rotate(90deg); }
    #AltaeronResearch-{{ section.id }} .research-sources__panel { background: #f7f9f9; border: 1px solid var(--research-line); border-radius: 15px; margin-top: 16px; padding: 22px 26px; }
    #AltaeronResearch-{{ section.id }} .research-sources__panel h3 { color: var(--research-ink); font-family: var(--alta-font-family, var(--font-heading-family)); font-size: 20px; margin: 0 0 12px; }
    #AltaeronResearch-{{ section.id }} .research-sources__panel ol { margin: 0; padding-left: 21px; }
    #AltaeronResearch-{{ section.id }} .research-sources__panel li { font-size: 13px; line-height: 1.45; padding: 7px 0 7px 5px; }
    #AltaeronResearch-{{ section.id }} .research-sources__panel a { color: var(--research-accent); font-weight: 650; text-decoration: none; }
    #AltaeronResearch-{{ section.id }} .research-sources__panel a .research-link__label { text-underline-offset: 3px; }
    @media (hover: hover) {
      #AltaeronResearch-{{ section.id }} .research-card { transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
      #AltaeronResearch-{{ section.id }} .research-card:hover { border-color: rgba(0,107,94,.3); box-shadow: 0 14px 34px rgba(16,42,67,.08); transform: translateY(-2px); }
    }
    @media (min-width: 750px) and (max-width: 1099px) {
      #AltaeronResearch-{{ section.id }} .research__shell { width: min(920px, calc(100% - 48px)); }
      #AltaeronResearch-{{ section.id }} .research__primary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      #AltaeronResearch-{{ section.id }} .research-card--primary:last-child { grid-column: 1 / -1; min-height: 300px; }
      #AltaeronResearch-{{ section.id }} .research__secondary { grid-template-columns: 1fr; }
    }
    @media (max-width: 749px) {
      #AltaeronResearch-{{ section.id }} { padding: 22px 0 24px; }
      #AltaeronResearch-{{ section.id }} .research__shell { width: calc(100% - 30px); }
      #AltaeronResearch-{{ section.id }} .research__header { margin-bottom: 22px; }
      #AltaeronResearch-{{ section.id }} .research__eyebrow { font-size: 10px; gap: 9px; letter-spacing: .18em; margin-bottom: 9px; }
      #AltaeronResearch-{{ section.id }} .research__eyebrow::before,
      #AltaeronResearch-{{ section.id }} .research__eyebrow::after { flex-basis: 24px; }
      #AltaeronResearch-{{ section.id }} .research__heading { font-size: 29px; }
      #AltaeronResearch-{{ section.id }} .research__intro { font-size: 15px; line-height: 1.45; }
      #AltaeronResearch-{{ section.id }} .research__primary,
      #AltaeronResearch-{{ section.id }} .research__secondary { gap: 14px; grid-template-columns: 1fr; }
      #AltaeronResearch-{{ section.id }} .research-card { border-radius: 13px; }
      #AltaeronResearch-{{ section.id }} .research-card--primary { min-height: 0; padding: 18px 17px 14px; }
      #AltaeronResearch-{{ section.id }} .research-card__head { gap: 13px; grid-template-columns: 74px minmax(0, 1fr); }
      #AltaeronResearch-{{ section.id }} .research-card__icon { height: 74px; width: 74px; }
      #AltaeronResearch-{{ section.id }} .research-card__icon :is(img, svg) { height: 57px; width: 57px; }
      #AltaeronResearch-{{ section.id }} .research-card h3 { font-size: 18px; }
      #AltaeronResearch-{{ section.id }} .research-card__meta { border-radius: 10px; font-size: 11px; margin-top: 6px; padding: 5px 9px; }
      #AltaeronResearch-{{ section.id }} .research-card__body { font-size: 14px; line-height: 1.48; margin-top: 14px; }
      #AltaeronResearch-{{ section.id }} .research-card__footer { gap: 8px; margin-top: 14px; padding-top: 10px; }
      #AltaeronResearch-{{ section.id }} .research-card__citation { font-size: 11.5px; }
      #AltaeronResearch-{{ section.id }} .research-link { font-size: 13px; min-height: 44px; }
      #AltaeronResearch-{{ section.id }} .research__divider { font-size: 10px; gap: 14px; letter-spacing: .2em; margin: 26px 0 14px; }
      #AltaeronResearch-{{ section.id }} .research-card--secondary { align-items: center; gap: 13px; grid-template-columns: 70px minmax(0, 1fr); padding: 14px; }
      #AltaeronResearch-{{ section.id }} .research-card--secondary .research-card__icon { height: 70px; width: 70px; }
      #AltaeronResearch-{{ section.id }} .research-card--secondary .research-card__icon :is(img, svg) { height: 52px; width: 52px; }
      #AltaeronResearch-{{ section.id }} .research-card--secondary h3 { font-size: 17px; }
      #AltaeronResearch-{{ section.id }} .research-card--secondary .research-card__body { font-size: 12.5px; }
      #AltaeronResearch-{{ section.id }} .research-card--secondary .research-link { grid-column: 2; justify-self: start; min-height: 44px; }
      #AltaeronResearch-{{ section.id }} .research__disclaimer { font-size: 12px; margin-top: 20px; }
      #AltaeronResearch-{{ section.id }} .research-sources summary { font-size: 14px; min-height: 48px; padding: 11px 22px; }
      #AltaeronResearch-{{ section.id }} .research-sources__panel { padding: 18px; }
    }
    @media (max-width: 390px) {
      #AltaeronResearch-{{ section.id }} .research-card__footer { align-items: flex-start; flex-direction: column; }
      #AltaeronResearch-{{ section.id }} .research-card__footer .research-link { margin-left: 28px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #AltaeronResearch-{{ section.id }} *, #AltaeronResearch-{{ section.id }} *::before, #AltaeronResearch-{{ section.id }} *::after { scroll-behavior: auto !important; transition: none !important; }
    }
  </style>

  <section id="AltaeronResearch-{{ section.id }}" aria-labelledby="AltaeronResearchHeading-{{ section.id }}">
    <div class="research__shell">
      <header class="research__header">
        <p class="research__eyebrow">{{ research_eyebrow | escape }}</p>
        <h2 id="AltaeronResearchHeading-{{ section.id }}" class="research__heading">{{ research_heading | escape }}</h2>
        <p class="research__intro">{{ research_intro | escape }}</p>
      </header>

      <div class="research__primary">
        {%- assign primary_icons = 'alignment,angle,walking' | split: ',' -%}
        {%- assign primary_urls = 'https://bmjopen.bmj.com/content/11/8/e047273,https://pubmed.ncbi.nlm.nih.gov/28318407/,https://pubmed.ncbi.nlm.nih.gov/11368700/' | split: ',' -%}
        {%- for i in (1..3) -%}
          {%- assign zero_index = i | minus: 1 -%}
          {%- capture key_root -%}research_evidence.study_{{ i }}{%- endcapture -%}
          {%- capture image_key -%}study_{{ i }}_image{%- endcapture -%}
          {%- assign study_image = section.settings[image_key] -%}
          {%- assign study_title = key_root | append: '.title' | t -%}
          <article class="research-card research-card--primary">
            <div class="research-card__head">
              <div class="research-card__icon">
                {%- if study_image != blank -%}
                  {{ study_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '96, 144, 192, 240', sizes: '(min-width: 750px) 96px, 74px', alt: study_image.alt | default: study_title }}
                {%- else -%}
                  {% render 'altaeron-research-icon', icon: primary_icons[zero_index] %}
                {%- endif -%}
              </div>
              <div><h3>{{ study_title }}</h3><p class="research-card__meta">{{ key_root | append: '.meta' | t }}</p></div>
            </div>
            <p class="research-card__body">{{ key_root | append: '.body' | t }}</p>
            <footer class="research-card__footer">
              <p class="research-card__citation"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3 5.5c3-1.5 6-1.5 9 .5v14c-3-2-6-2-9-.5zm18 0c-3-1.5-6-1.5-9 .5v14c3-2 6-2 9-.5z"/></svg><span>{{ key_root | append: '.citation' | t }}</span></p>
              <a class="research-link" href="{{ primary_urls[zero_index] }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'research_evidence.view_study' | t | escape }}: {{ study_title | escape }}"><span class="research-link__label">{{ 'research_evidence.view_study' | t }}</span><span class="research-link__arrow" aria-hidden="true">→</span></a>
            </footer>
          </article>
        {%- endfor -%}
      </div>

      <p class="research__divider"><span>{{ 'research_evidence.more_research' | t }}</span></p>
      <div class="research__secondary">
        {%- assign secondary_icons = 'exercise,function' | split: ',' -%}
        {%- assign secondary_urls = 'https://pubmed.ncbi.nlm.nih.gov/40973592/,https://pubmed.ncbi.nlm.nih.gov/29683337/' | split: ',' -%}
        {%- for i in (4..5) -%}
          {%- assign zero_index = i | minus: 4 -%}
          {%- capture key_root -%}research_evidence.study_{{ i }}{%- endcapture -%}
          {%- capture image_key -%}study_{{ i }}_image{%- endcapture -%}
          {%- assign study_image = section.settings[image_key] -%}
          {%- assign study_title = key_root | append: '.title' | t -%}
          <article class="research-card research-card--secondary">
            <div class="research-card__icon">
              {%- if study_image != blank -%}
                {{ study_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '96, 144, 192, 240', sizes: '(min-width: 750px) 84px, 70px', alt: study_image.alt | default: study_title }}
              {%- else -%}
                {% render 'altaeron-research-icon', icon: secondary_icons[zero_index] %}
              {%- endif -%}
            </div>
            <div><h3>{{ study_title }}</h3><p class="research-card__body">{{ key_root | append: '.body' | t }}</p><p class="research-card__citation">{{ key_root | append: '.citation' | t }}</p></div>
            <a class="research-link" href="{{ secondary_urls[zero_index] }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'research_evidence.view_study' | t | escape }}: {{ study_title | escape }}"><span class="research-link__label">{{ 'research_evidence.view_study' | t }}</span><span class="research-link__arrow" aria-hidden="true">→</span></a>
          </article>
        {%- endfor -%}
      </div>

      <p class="research__disclaimer">{{ 'research_evidence.disclaimer' | t }}</p>
      <details class="research-sources">
        <summary>{{ 'research_evidence.view_all_sources' | t }} <span aria-hidden="true">→</span></summary>
        <div class="research-sources__panel">
          <h3>{{ 'research_evidence.sources_heading' | t }}</h3>
          <ol>
            {%- assign all_urls = 'https://bmjopen.bmj.com/content/11/8/e047273,https://pubmed.ncbi.nlm.nih.gov/28318407/,https://pubmed.ncbi.nlm.nih.gov/11368700/,https://pubmed.ncbi.nlm.nih.gov/40973592/,https://pubmed.ncbi.nlm.nih.gov/29683337/' | split: ',' -%}
            {%- for i in (1..5) -%}
              {%- capture source_key -%}research_evidence.source_{{ i }}{%- endcapture -%}
              <li>{{ source_key | t }} <a href="{{ all_urls[forloop.index0] }}" target="_blank" rel="noopener noreferrer"><span class="research-link__label">{{ 'research_evidence.view_source' | t }}</span> <span class="research-link__arrow" aria-hidden="true">↗</span></a></li>
            {%- endfor -%}
          </ol>
        </div>
      </details>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Altaeron: Research",
  "tag": "section",
  "class": "section-altaeron-custom",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "EVIDENCE-BASED SUPPORT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Does the Research Say?" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Clinical research on conservative bunion supports suggests that orthoses and toe-alignment devices may help support better alignment and reduce bunion-related discomfort." },
    { "type": "header", "content": "Study card images" },
    { "type": "image_picker", "id": "study_1_image", "label": "Better Toe Alignment image" },
    { "type": "image_picker", "id": "study_2_image", "label": "Reduced Bunion Angle & Pain image" },
    { "type": "image_picker", "id": "study_3_image", "label": "Short-Term Pain Relief image" },
    { "type": "image_picker", "id": "study_4_image", "label": "Support + Exercise image" },
    { "type": "image_picker", "id": "study_5_image", "label": "Strength & Function image" }
  ],
  "presets": [{ "name": "Altaeron: Research" }]
}
{% endschema %}
