<section
  class="ngp-apdp-promotion"
  data-apdp-promotion-card
  data-apdp-promotion-cta="{{ 'altaeron_pdp_reels_v2.promotion.cta' | t | escape_once }}"
  data-apdp-promotion-announcement-desktop="{{ 'altaeron_pdp_reels_v2.promotion.announcement_desktop' | t | escape_once }}"
  data-apdp-promotion-announcement-mobile="{{ 'altaeron_pdp_reels_v2.promotion.announcement_mobile' | t | escape_once }}"
  data-apdp-promotion-sync-announcement="{% if sync_announcement == false %}false{% else %}true{% endif %}"
  data-apdp-promotion-timer-label="{{ 'altaeron_pdp_reels_v2.promotion.timer_remaining' | t: days: '[days]', hours: '[hours]', minutes: '[minutes]', seconds: '[seconds]' | escape_once }}"
  aria-labelledby="AltaeronPromotionTitle-{{ section.id }}"
>
  <div class="ngp-apdp-promotion__copy">
    <p class="ngp-apdp-promotion__eyebrow">🔥 {{ 'altaeron_pdp_reels_v2.promotion.eyebrow' | t }}</p>
    <h3 id="AltaeronPromotionTitle-{{ section.id }}">{{ 'altaeron_pdp_reels_v2.promotion.title' | t }}</h3>
    <p class="ngp-apdp-promotion__offer"><strong>{{ 'altaeron_pdp_reels_v2.promotion.offer' | t }}</strong> <span>{{ 'altaeron_pdp_reels_v2.promotion.automatically_applied' | t }}</span></p>
  </div>
  <div class="ngp-apdp-promotion__footer">
    <p class="ngp-apdp-promotion__ends">{{ 'altaeron_pdp_reels_v2.promotion.ends_today' | t }}</p>
    <div class="ngp-apdp-promotion__countdown" data-apdp-promotion-countdown role="timer" aria-label="{{ 'altaeron_pdp_reels_v2.promotion.timer_initial' | t | escape_once }}">
      {%- for ngp_unit in (1..4) -%}
        {%- case ngp_unit -%}
          {%- when 1 -%}{%- assign ngp_unit_key = 'days' -%}{%- assign ngp_unit_label = 'altaeron_pdp_reels_v2.promotion.days' | t -%}
          {%- when 2 -%}{%- assign ngp_unit_key = 'hours' -%}{%- assign ngp_unit_label = 'altaeron_pdp_reels_v2.promotion.hours' | t -%}
          {%- when 3 -%}{%- assign ngp_unit_key = 'minutes' -%}{%- assign ngp_unit_label = 'altaeron_pdp_reels_v2.promotion.minutes' | t -%}
          {%- when 4 -%}{%- assign ngp_unit_key = 'seconds' -%}{%- assign ngp_unit_label = 'altaeron_pdp_reels_v2.promotion.seconds' | t -%}
        {%- endcase -%}
        <span class="ngp-apdp-promotion__time"><strong data-apdp-promotion-{{ ngp_unit_key }}>00</strong><small>{{ ngp_unit_label }}</small></span>
        {%- unless forloop.last -%}<span class="ngp-apdp-promotion__separator" aria-hidden="true">:</span>{%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
