{%- liquid
  assign ngp_active_values_count = 0
-%}

{%- capture ngp_active_facets -%}
  {%- for ngp_filter in results.filters -%}
    {%- if ngp_filter.type == 'price_range' -%}
      {%- if ngp_filter.max_value.value != blank or ngp_filter.min_value.value != blank -%}
        <a class="ngp-facet-remove ngp-btn ngp-btn--secondary ngp-flex ngp-relative" href="{{ ngp_filter.url_to_remove }}" aria-label="{{ 'products.facets.clear' | t: name: ngp_active_value.label | escape }}" is="ngp-facet-remove">
          <div class="ngp-flex ngp-items-center ngp-justify-between ngp-gap-3">
            <div class="facet-title ngp-text-wrap ngp-flex ngp-items-center ngp-gap-2">
              {{- ngp_filter.min_value.value | default: 0 | money_without_trailing_zeros }} - {{ ngp_filter.max_value.value | default: ngp_filter.range_max | money_without_trailing_zeros -}}
            </div>
            {%- render 'ngp-icon-close', size: 'small' -%}
          </div>
        </a>
        {%- assign ngp_active_values_count = ngp_active_values_count | plus: 1 -%}
      {%- endif -%}
    {%- else -%}
      {%- for ngp_active_value in ngp_filter.active_values -%}
        <a class="ngp-facet-remove ngp-btn ngp-btn--secondary ngp-flex ngp-relative" href="{{ ngp_active_value.url_to_remove }}" aria-label="{{ 'products.facets.clear' | t: name: ngp_active_value.label | escape }}" is="ngp-facet-remove">
          <div class="ngp-flex ngp-items-center ngp-justify-between ngp-gap-3">
            <div class="facet-title ngp-text-wrap ngp-flex ngp-items-center ngp-gap-2">
              {%- if ngp_filter.type == 'list' -%}
                {%- liquid
                  assign ngp_is_color = false
                  assign ngp_swatch_trigger = settings.color_swatch_trigger | downcase
                  assign ngp_downcase_label = ngp_filter.label | downcase
                  if ngp_swatch_trigger contains ngp_downcase_label
                    assign ngp_is_color = true
                  elsif ngp_swatch_trigger contains 'color' and ngp_downcase_label contains 'colour'
                    assign ngp_is_color = true
                  endif

                  if ngp_is_color or ngp_filter.presentation == 'swatch'
                    if ngp_filter.presentation == 'swatch'
                      render 'ngp-swatch', value: ngp_active_value.value, title: ngp_active_value.label, class: 'pointer-events-none', swatch: ngp_active_value.swatch
                    else
                      render 'ngp-swatch', value: ngp_active_value.label, title: ngp_active_value.label, class: 'pointer-events-none'
                    endif
                  endif
                -%}
              {%- endif -%}
              {%- liquid
                if ngp_filter.type == 'boolean'
                  echo ngp_filter.label | append: ': ' | append: ngp_active_value.label
                else
                  echo ngp_active_value.label
                endif
              -%}
            </div>
            {%- render 'ngp-icon-close', size: 'small' -%}
          </div>
        </a>
        {%- assign ngp_active_values_count = ngp_active_values_count | plus: 1 -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if ngp_active_values_count > 1 -%}
    {%- liquid
      if results.url
        assign ngp_results_url = results.url
      else
        assign ngp_terms = results.terms | escape
        assign ngp_results_url = routes.search_url | append: '?q=' | append: ngp_terms | append: '&options%5Bprefix%5D=last&type=product'
        if results.sort_by != blank
          assign ngp_results_url = ngp_results_url | append: '&sort_by=' | append: results.sort_by
        endif
      endif
    -%}

    <a href="{{ ngp_results_url }}" class="facet-clear-all ngp-btn--link" is="ngp-facet-remove">
      {{- 'products.facets.clear_all' | t -}}
    </a>
  {%- endif -%}
{%- endcapture -%}

<div class="ngp-facets-active ngp-flex ngp-flex-wrap ngp-items-center ngp-gap-3 ngp-z-1 ngp-relative" id="FacetFiltersActive">
  {{- ngp_active_facets -}}
</div>
