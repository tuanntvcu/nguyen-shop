{%- liquid
  assign icon_type = type | default: 'check'
  assign icon_class = class | default: 'apdp-line-icon'
-%}
<svg class="{{ icon_class }}" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  {%- case icon_type -%}
    {%- when 'fit' -%}
      <path d="M16 3.5 20 6l4.7.8.8 4.7L28 16l-2.5 4.5-.8 4.7-4.7.8-4 2.5-4-2.5-4.7-.8-.8-4.7L4 16l2.5-4.5.8-4.7L12 6l4-2.5Z"/>
      <circle cx="16" cy="16" r="2.6"/>
    {%- when 'heart' -%}
      <path d="M16 27S5 20.4 5 11.8C5 7.4 10.7 5 16 10c5.3-5 11-2.6 11 1.8C27 20.4 16 27 16 27Z"/>
    {%- when 'shield' -%}
      <path d="M16 3.5c3.2 2.5 6.2 3.5 9 3.8v7.9c0 6.1-3.7 10.7-9 13.3-5.3-2.6-9-7.2-9-13.3V7.3c2.8-.3 5.8-1.3 9-3.8Z"/>
      <path d="m12.2 16 2.5 2.5 5.3-5.3"/>
    {%- when 'alignment' -%}
      <path d="M16 3.5 20 6l4.7.8.8 4.7L28 16l-2.5 4.5-.8 4.7-4.7.8-4 2.5-4-2.5-4.7-.8-.8-4.7L4 16l2.5-4.5.8-4.7L12 6l4-2.5Z"/>
      <path d="m11.8 16.2 2.6 2.6 5.8-5.8"/>
    {%- when 'lock' -%}
      <rect x="7" y="13" width="18" height="15" rx="2"/>
      <path d="M11 13V9a5 5 0 0 1 10 0v4M16 19v4"/>
    {%- when 'shipping' -%}
      <path d="M3.5 8h16v13h-16zM19.5 13h4.8l4.2 4.3V21h-9z"/>
      <circle cx="9" cy="23.5" r="2.5"/><circle cx="24" cy="23.5" r="2.5"/>
    {%- when 'arrow' -%}
      <path d="M7 16h18M18.5 9.5 25 16l-6.5 6.5"/>
    {%- when 'volume' -%}
      <path d="M5 13h5l6-5v16l-6-5H5zM21 12c1.8 2.1 1.8 5.9 0 8M24.5 8.5c4 4.2 4 10.8 0 15"/>
    {%- else -%}
      <path d="m7 16 6 6L25 10"/>
  {%- endcase -%}
</svg>
