{%- liquid
  assign popular_collection = collections['best-sellers']
  assign popular_heading = 'Most Popular Solutions'
  assign view_all_label = 'View all'
-%}

{{ 'altaeron-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'altaeron-home.js' | asset_url }}" defer="defer"></script>

<style>
  .altaeron-home .ah-product__title{font-size:16px;line-height:1.3;margin-bottom:10px}
  .altaeron-home .ah-section-head h2{margin-bottom:0}
  @media(max-width:749px){.altaeron-home .ah-product__title{font-size:14px}}
</style>

<altaeron-home class="altaeron-home" style="display:block" data-section-id="{{ section.id }}" data-slide-label="{{ 'altaeron_home.accessibility.go_to_slide' | t | escape }}">
  {%- if popular_collection != blank and popular_collection.products_count > 0 -%}
    <section class="ah-section ah-popular" aria-labelledby="PopularHeading-{{ section.id }}">
      <div class="ah-shell">
        <div class="ah-section-head"><h2 id="PopularHeading-{{ section.id }}">{{ popular_heading }}</h2><a href="{{ popular_collection.url }}"><span>{{ view_all_label }}</span><span aria-hidden="true">→</span></a></div>
        <div class="ah-carousel-wrap"><button class="ah-slider-arrow ah-slider-arrow--prev" type="button" data-slider-prev aria-label="{{ 'altaeron_home.accessibility.previous_products' | t | escape }}">{% render 'icon-slider-prev' %}</button><div class="ah-products ah-slider" data-slider tabindex="0" aria-label="{{ popular_heading | escape }}">
          {%- for product in popular_collection.products limit: 8 -%}{% render 'altaeron-home-product', product: product %}{%- endfor -%}
        </div><button class="ah-slider-arrow ah-slider-arrow--next" type="button" data-slider-next aria-label="{{ 'altaeron_home.accessibility.next_products' | t | escape }}">{% render 'icon-slider-next' %}</button></div>
        <div class="ah-dots" data-slider-dots aria-label="{{ 'altaeron_home.accessibility.product_carousel_pagination' | t | escape }}"></div>
      </div>
    </section>
  {%- endif -%}
</altaeron-home>
