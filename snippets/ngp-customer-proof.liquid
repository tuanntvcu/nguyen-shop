<section class="ngp-customer-proof" aria-labelledby="{{ heading_id }}">
  <div class="ngp-altaeron-customer-proof__shell">
    <header class="ngp-altaeron-customer-proof__header">
      {%- if eyebrow != blank -%}<p class="ngp-altaeron-customer-proof__eyebrow">{{ eyebrow }}</p>{%- endif -%}
      <h2 id="{{ heading_id }}" class="ngp-altaeron-customer-proof__heading">{{ title }}</h2>
    </header>

    <div class="ngp-altaeron-customer-proof__grid">
      {%- for ngp_index in (1..2) -%}
        {%- liquid
          if ngp_index == 1
            assign ngp_avatar = avatar_1
            assign ngp_avatar_url = avatar_url_1
            assign ngp_reviewer_name = reviewer_name_1
            assign ngp_review_content = review_content_1
          else
            assign ngp_avatar = avatar_2
            assign ngp_avatar_url = avatar_url_2
            assign ngp_reviewer_name = reviewer_name_2
            assign ngp_review_content = review_content_2
          endif
        -%}
        <article class="ngp-altaeron-customer-proof__review">
          <div class="ngp-altaeron-customer-proof__reviewer">
            <div class="ngp-altaeron-customer-proof__avatar">
              {%- if ngp_avatar != blank -%}
                {{ ngp_avatar | image_url: width: 160 | image_tag: loading: 'lazy', widths: '104, 160', sizes: '52px', alt: ngp_reviewer_name }}
              {%- elsif ngp_avatar_url != blank -%}
                <img src="{{ ngp_avatar_url | escape }}" width="104" height="104" loading="lazy" alt="{{ ngp_reviewer_name | escape }}">
              {%- else -%}
                <span class="ngp-altaeron-customer-proof__initial" aria-hidden="true">{{ ngp_reviewer_name | slice: 0 }}</span>
              {%- endif -%}
            </div>
            <div><strong class="ngp-altaeron-customer-proof__name">{{ ngp_reviewer_name }}</strong>{% render 'ngp-pdp-stars', rating: 5 %}</div>
          </div>
          <blockquote class="ngp-altaeron-customer-proof__quote">{{ ngp_review_content }}</blockquote>
        </article>
      {%- endfor -%}
    </div>

    {%- if review_count > 0 and review_rating > 0 -%}
      <a class="ngp-altaeron-customer-proof__summary" href="{{ reviews_link | default: '#judgeme_product_reviews' | escape }}" aria-label="{{ review_rating_display }} out of 5 from {{ review_count }} reviews">
        {% render 'ngp-pdp-stars', rating: review_rating %}
        <span><strong>{{ review_rating_display }}</strong> from {{ review_count }} reviews</span>
      </a>
    {%- endif -%}
  </div>
</section>
