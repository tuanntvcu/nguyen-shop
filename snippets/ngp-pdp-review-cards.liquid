{%- for ngp_review in reviews limit: limit -%}
  {%- liquid
    assign ngp_review_body = ngp_review.body.value | default: ngp_review.body | strip_html | strip
    assign ngp_reviewer_name = ngp_review.reviewer_name.value | default: ngp_review.reviewer_name | strip
    assign ngp_review_rating = ngp_review.rating.value | default: ngp_review.rating | default: 0 | plus: 0
    assign ngp_displayed_review_body = ngp_review_body
    assign ngp_excerpt_word_limit = excerpt_words | default: 0 | plus: 0
    if ngp_excerpt_word_limit > 0
      assign ngp_displayed_review_body = ngp_review_body | truncatewords: ngp_excerpt_word_limit, '…'
    endif
    assign ngp_configured_review_image = ngp_review.review_image.value
    assign ngp_review_picture = ngp_review.pictures_urls.first.original
    assign ngp_reviewer_initial = ngp_reviewer_name | slice: 0 | upcase
    assign ngp_should_render = true
    if require_mock and ngp_review.is_mock.value != true
      assign ngp_should_render = false
    endif
  -%}
  {%- if ngp_should_render and ngp_review_body != blank and ngp_reviewer_name != blank -%}
    <article class="ngp-apdp-tail-review">
      <div class="ngp-apdp-tail-review__media-column">
        <div class="ngp-apdp-tail-avatar">
          <span class="ngp-apdp-tail-avatar__initial" aria-hidden="true">{{ ngp_reviewer_initial | escape }}</span>
        </div>
        {%- if ngp_configured_review_image != blank -%}
          <div class="ngp-apdp-tail-review__image">
            {{ ngp_configured_review_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '96, 144, 240, 360', sizes: '68px', alt: ngp_reviewer_name }}
          </div>
        {%- elsif ngp_review_picture != blank -%}
          <div class="ngp-apdp-tail-review__image">
            <img src="{{ ngp_review_picture | escape }}" loading="lazy" width="180" height="180" alt="{{ ngp_reviewer_name | escape }}">
          </div>
        {%- endif -%}
      </div>
      <div>
        {% render 'ngp-pdp-stars', rating: ngp_review_rating %}
        <blockquote>“{{ ngp_displayed_review_body | escape }}”</blockquote>
        <p>– {{ ngp_reviewer_name | escape }}</p>
      </div>
    </article>
  {%- endif -%}
{%- endfor -%}
